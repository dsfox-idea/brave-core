<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="7099479769133613710">Επανεκκίνηση για ενημέρωση του &amp;Chrome OS</translation>
<translation id="2479110114759182442">Το Growser συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="3814674848168165531">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Growser χρησιμοποιεί τους διακομιστές της Growser. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Growser μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="7577672138294294152">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Growser</translation>
<translation id="4408482856437790071">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του Growser, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="5918095577778020936">Το Growser θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">Το Growser είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="8522292744959221145">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο Growser<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">Κάντε κλικ στο μενού του Growser</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="8541922081612557424">Σχετικά με το Growser</translation>
<translation id="987734326276404793">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το Growser στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="1934377710648094656">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Growser στο Growser. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο Growser.</translation>
<translation id="583633806828413086">Εμφάνιση του Gemini στο Brave στη γραμμή μενού του Mac</translation>
<translation id="1631493536097460865">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο Growser, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="8799570501820813406">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Growser. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="8767381092474532098">Το Growser απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="3256289531845594061">Όταν συνδέεστε σε υπηρεσίες Growser, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL"/>, μπορείτε να συνδέεστε αυτόματα στο Growser με τον ίδιο λογαριασμό</translation>
<translation id="8508169558526580571">Λήψη του Growser στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">Ρυθμίστε το νέο σας προφίλ στο Growser</translation>
<translation id="4291722755910963157">Δοκιμάστε τη με το Gemini στο Growser</translation>
<translation id="878572309106296578">Το Growser χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="7562683844189283122">Συνδεθείτε στο Growser από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="108284536240904209">Να διαγραφούν επίσης δεδομένα από το Growser (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="3535301204632475895">Χρησιμοποιήστε την εφαρμογή Growser για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="7009295044271335553">&amp;Διαχείριση προφίλ Growser</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="3880714039086599943">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Growser στις Ρυθμίσεις συστήματος.</translation>
<translation id="1586284627848250203">Λήψη βοήθειας για το Growser for Testing</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="5147525139567260139">Μοιραστείτε μια καρτέλα του Growser</translation>
<translation id="721261350616678948">Σύνδεση στο Growser</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="51545890371361355">Καρφίτσωμα Growser</translation>
<translation id="6570689355868013775">Εργαλεία ασφάλειας του Growser</translation>
<translation id="1902837727299679178">Το Growser θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="1655849915812740665">Αξιοποιήστε τις καλύτερες λειτουργίες της Growser με την εφαρμογή Growser στο τηλέφωνό σας</translation>
<translation id="4449148723378534338">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Growser</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="509363484780540563">Μπορείτε να χρησιμοποιείτε το Growser κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME"/>.</translation>
<translation id="8004287232784878841">Το Growser θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="4197839351786449392">Το Growser θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="7814200940910057384">Διαγρ. δεδ. Growser</translation>
<translation id="9048361966237194186">Θα γίνει επανεκκίνηση του Growser σε <ph name="REMAINING_TIME"/></translation>
<translation id="5524150602137990006">Όταν δεν είναι διαθέσιμο το HTTPS, το Growser θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="6797402139308059782">Να επιτρέπεται στο Growser να εκτελείται στο παρασκήνιο</translation>
<translation id="5994491947936308173">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD"/>Ναι<ph name="END_BOLD"/> στην ειδοποίηση των Windows, για να καρφιτσώσετε το Growser στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="5875673934455379806">Επανεγκατάσταση του Growser</translation>
<translation id="4529028207655448215">Το Growser προσπαθεί να <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="7362761326208547489">Την επόμενη φορά που θα ανοίξετε το Growser στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Growser.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="3541642064306182066">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Growser, <ph name="BEGIN_LINK"/>αποσυνδεθείτε από το Growser<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">Κατεβάστε το Growser στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="4559627161887338743">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Growser. Οι Λογαριασμοί σας Growser χρησιμοποιούνται για το πρόγραμμα περιήγησης Growser, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Μάθετε περισσότερα<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="4528406859989804913">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Growser. Τα δεδομένα σας στο Growser, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Growser, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Growser. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Το Growser εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK"/></translation>
<translation id="8643267611122541711">Υπηρεσία Growser Updater</translation>
<translation id="1649714546770135458">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Growser, όπως το Gmail, χωρίς να συνδεθείτε στο Growser</translation>
<translation id="189297655255130768">Το Growser δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="8422047647688939115">Ο οργανισμός σας, <ph name="MANAGER"/>, απαιτεί να συνδεθείτε στο Growser</translation>
<translation id="4035053306113201399">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chrome OS.</translation>
<translation id="9048754176089806686">Το Growser απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE"/> λεπτά</translation>
<translation id="1775322105159056176">Το Growser δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="4372901050442507812">Μάθετε γιατί το Growser αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="2703425183860615504">Διατηρεί το λογισμικό Growser ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό Growser δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Growser που να τη χρησιμοποιεί.</translation>
<translation id="9220324636239049437">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Growser ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="5499149312981370855">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Growser για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Growser.</translation>
<translation id="5152523902653128156">Είναι ενσωματωμένη στο Growser για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="6959434860418352144">Κάντε κλικ στο κουμπί Προσαρμογή Growser στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο Growser</translation>
<translation id="2472891440303445472">Το Growser απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="2054358978145431867">Την επόμενη φορά που θα ανοίξετε το Growser iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME"/>.</translation>
<translation id="2726948994393234543">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Growser που αποθηκεύσατε στον Λογαριασμό σας Growser θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Growser, συνδεθείτε ξανά.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Growser δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Growser δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="5789330946301045610">Το Growser απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="142389341645668510">Προσαρμογή του Growser</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="8841019650931243995">Growser Origin - Σύνδεση δικτύου - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">Κατάργηση λογαριασμού από το Growser</translation>
<translation id="4022045673362955204">Χρησιμοποιήστε την εφαρμογή Growser για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="5550942974310218641">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο Growser για iOS</translation>
<translation id="6677253423995557759">Επικίνδυνος ιστότοπος. Το Growser κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="457168681575748148">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Growser μετά τη σύνδεσή σας.</translation>
<translation id="5659384504794665581">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Growser ακριβώς όπως θέλουν.</translation>
<translation id="2752319862668322390">Δεξιότητες στο Growser</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{Το Growser συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Growser συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="7810992039564280750">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Growser. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Growser μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="6485997157403727556">Η επέκταση <ph name="EXTENSION_NAME"/> θέλει να συνδεθείτε στο Growser</translation>
<translation id="7017760840808989683">Απενεργοποίηση του Growser, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="8491912023989916905">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS"/>, συνδεθείτε στο Growser.</translation>
<translation id="8418845734693287262">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Growser}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Growser}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Growser}}</translation>
<translation id="1248225940185478633">Το Growser χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="5298352791080868905">Ανοίξτε συνδέσμους στο Growser από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="2600233721598267627">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο Growser, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="2118275934191847461">Με τα <ph name="BEGIN_LINK"/>εργαλεία του Growser<ph name="END_LINK"/>, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="6381750314821942592">Το Growser θα κλείσει σύντομα</translation>
<translation id="6078442581074612226">Στο Growser</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="70183448213529602">Το Growser προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="7798069806040634998">Το Growser χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="2351700486811407088">Πρόγραμμα βοήθειας Growser Origin</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="3830890663494219270">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser</translation>
<translation id="6908148552215338695">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το Growser και να συνδεθείτε στον Λογαριασμό σας Growser.</translation>
<translation id="6252796827759111076">Συνέχεια χρήσης του Growser</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="7931230852267968641">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Growser</translation>
<translation id="2257221826278123061">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7048234400304379082">Για να αποχωρήσετε από το Gemini στο Growser ή να επιστρέψετε σε αυτό, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="7387051847644272380">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Growser ξανά.</translation>
<translation id="2648689842065142443">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Growser ακριβώς όπως θέλουν.</translation>
<translation id="1001521084148238686">Εύκολη πρόσβαση για χρήση του Gemini στο Growser σε όλη τη συσκευή σας, ακόμα και αν το Growser είναι ελαχιστοποιημένο.</translation>
<translation id="6791166902140255175">Καρτέλα Growser</translation>
<translation id="8372880274820509128">Για επιπλέον ασφάλεια, το Growser θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="8752006915531191162">Για να καταργήσετε τον Λογαριασμό σας Growser από το Growser, αποσυνδεθείτε</translation>
<translation id="5344406739101555055">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="1312769823139326127">Ορισμός του Growser ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="1187986649024576560">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Growser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="5962774139606909656">Το δικό σας Growser</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="1992849613617207128">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το Growser σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="777113543093865885">Κατάργηση από το Growser…</translation>
<translation id="5265419033369521352">Διατηρεί την ασφάλειά σας στο Growser και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Growser όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="2176825726964012531">Σχετικά με το &amp;Growser</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="2481553173340651149">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον Λογαριασμό σας Growser.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="2413255940314578781">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το Growser σε iOS</translation>
<translation id="3688936822855019158">Ο οργανισμός σας διαχειρίζεται το Growser</translation>
<translation id="8208853227947884571">Το Growser έχει ενημερωθεί</translation>
<translation id="5122472867956731189">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Growser μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="3963199983793987097">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Growser</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="7611046016537686219">{count,plural, =1{Το Growser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Growser και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το Growser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Growser και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="4202995875619419215">Άνοιγμα της διεύθυνσης <ph name="URL"/> σε νέα καρτέλα στο Growser.</translation>
<translation id="1266825212217391702">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας Growser και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του Growser</translation>
<translation id="8880183781256147665">Προσθήκη στο Growser…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="4503085212612536713">Άλλα προφίλ Growser</translation>
<translation id="2041039306630146369">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το Growser. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το Growser στις ανάγκες σας.</translation>
<translation id="7918740962659365265">Βοηθήστε μας να κάνουμε το Growser καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK"/> στην Growser</translation>
<translation id="6828757829023033545">Χρησιμοποιήστε την εφαρμογή Growser για να έχετε μαζί σας την ασφάλεια της Growser</translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Growser}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Growser}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Growser}}</translation>
<translation id="3700405816184340252">Ιστορικό Growser</translation>
<translation id="7365690458036015383">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Growser ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="6422885447166607802">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="8919461291440820124">Το Growser χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="8372436892102763334">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Growser να την απενεργοποιήσει.</translation>
<translation id="5949068186379578553">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Growser στις Ρυθμίσεις συστήματος</translation>
<translation id="4805806622840861220">Επανεκκίνηση Growser</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="1742948938503172561">Προσαρμόστε το νέο σας προφίλ Growser</translation>
<translation id="2430807206104224491">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο Growser. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4805865169608137960">Για να καταργήσετε τον Λογαριασμό σας Growser από το Growser, αποσυνδεθείτε από το Growser στη σελίδα Ρυθμίσεις</translation>
<translation id="1651639704310627074">Αργότερα, το Growser μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="2585240446624043880">Το Growser δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="8414435293910785169">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία Growser AI με το Growser σε iOS.</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="2339258256897053758">Λείπουν κλειδιά του Growser API. Ορισμένες λειτουργίες του Growser Growser θα απενεργοποιηθούν.</translation>
<translation id="8926637909431618259">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Growser είναι κλειστό</translation>
<translation id="518125528057094977">Το Growser θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="8652321858775514885">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Growser, εκτός από τον Λογαριασμό σας Growser εάν είστε συνδεδεμένοι στο Growser. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="7261356974224431851">Δεδομένα Growser στον λογαριασμό σας</translation>
<translation id="6610330853796830621">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το Growser στο τηλέφωνό σας</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="2297290224191497273">Εναλλαγή σε υπάρχον προφίλ Growser;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="2491221873705777076">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το Growser στο τηλέφωνό σας</translation>
<translation id="7304389940068374923">Προσαρμογή του Growser…</translation>
<translation id="5853262807109651878">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT"/> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Growser ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2024972335338126423">Με τη συντόμευση <ph name="SHORTCUT"/> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Growser</translation>
<translation id="8703492925273919597">Κλείστε όλα τα παράθυρα του Growser και δοκιμάστε ξανά.</translation>
<translation id="599091950194451698">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Growser στις Ρυθμίσεις συστήματος</translation>
<translation id="1447863765638888625">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Growser με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="7624624622436403494">Κωδικός QR για τη λήψη του προγράμματος περιήγησης Growser σε κινητές συσκευές</translation>
<translation id="8478154085901340543">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της Growser στην τσέπη σας</translation>
<translation id="8981774130895723211">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Growser στις Ρυθμίσεις συστήματος.</translation>
<translation id="2981961446160697133">Η Βελτιωμένη προστασία απενεργοποιεί τη βελτιστοποίηση JavaScript για ιστοτόπους που δεν αναγνωρίζει το Growser</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="4167284810587724062">Σύνδεση στο Growser</translation>
<translation id="3066805437003400520">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Growser ως <ph name="USER_EMAIL"/>.</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="1128485277465085828">Χρησιμοποιήστε τη <ph name="BEGIN_LINK"/>δική σας φράση πρόσβασης<ph name="END_LINK"/> για την κρυπτογράφηση όλων των δεδομένων Growser στον Λογαριασμό σας Growser. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Growser δεν θα συγχρονίζεται.</translation>
<translation id="1807774211756215222">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Growser</translation>
<translation id="387105482057676379">Σύνδεση του Growser και άλλων υπηρεσιών Growser για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="3867175562099983425">Διαχείριση προφίλ Growser</translation>
<translation id="308146532933302843">Μάθετε γιατί το Growser αποκλείει ορισμένες λήψεις</translation>
<translation id="2189149060536531804">Το Growser θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="6324134303015966238">Το Growser προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="4815742196440583661">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το Growser για iOS και συνδεθείτε στον Λογαριασμό σας Growser</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="6899774208752247219"><ph name="PAGE_TITLE"/> - Growser Origin</translation>
<translation id="1118754729376002185">Το Brave χρειάζεται άδεια τοπικού δικτύου για αυτόν τον ιστότοπο</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="6315734375101223238">Προσαρμογή και έλεγχος του Growser. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="7130675370997202556">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Growser και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="4920958997042285125">Ο χρήστης <ph name="EXISTING_USER"/> είναι συνδεδεμένος ήδη με αυτό το προφίλ Growser. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Growser μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="8744239658215739511">Π&amp;ροσαρμογή του Growser</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="8090497651549769448">Το Growser προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="4256965182800026277">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Growser θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Growser, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="4194619960643453552">Μάθετε πώς σας προστατεύει το Growser</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="1486377520191913768">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Growser στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="1311808042904310985">Σχετικά με το &amp;Growser for Testing</translation>
<translation id="1152920704813762236">Σχετικά με το Chrome OS</translation>
<translation id="8282895427217902177">Όταν επισκέπτεστε έναν ιστότοπο, το Growser στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK"/>Ασφαλή περιήγηση Growser<ph name="END_LINK"/> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="3703994572283698466">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS"/>περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">Ανοίξτε συνδέσμους στο Growser από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="6056473803837713617">Συμβάλετε στη βελτίωση του Growser, αναφέροντας τις <ph name="BEGIN_LINK"/>τρέχουσες ρυθμίσεις<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="6217792792122501564">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Growser όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Growser όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="5794951150713244901">Μετάβαση στη σελίδα Σχετικά με το Growser</translation>
<translation id="10925962326134232">Προσαρμόστε το Growser για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="6596295505984504022">Π&amp;ροσαρμογή του Growser</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="5011704081781303429"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου - Growser Origin</translation>
<translation id="2871190378186459992">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Growser.</translation>
<translation id="462105622535258178">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Growser</translation>
<translation id="6670140629169983459">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Growser στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="1853997773668795891">Να συνδεθούν τα δεδομένα σας στο Growser με αυτόν το λογαριασμό;</translation>
<translation id="4732930052828648898">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Growser στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Growser.</translation>
<translation id="2201661640076600072">Αποσύνδεση από το Growser</translation>
<translation id="3262506503470845422">Λήψη βοήθειας σχετικά με το Growser</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="7691786510374174420">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το Growser εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="6368144843345980623">Εξαγωγή κωδικών πρόσβασης από το Growser</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="242356249838681145">Άνοιγμα του Growser κατά την εκκίνηση των Windows</translation>
<translation id="4747339441562331861">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Growser θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="9183662282810237335">Να γίνει έξοδος από το Growser ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="4065288863231444640">Να επιτρέπεται στο Growser να εκτελείται στο παρασκήνιο</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{Το Growser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}other{Το Growser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">Προσαρμογή και έλεγχος του Growser</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413">Ο οργανισμός <ph name="MANAGER"/> διαχειρίζεται το Growser</translation>
<translation id="3579012341787637143">Προσθήκη προφίλ Growser</translation>
<translation id="6786534271003695094">Σχετικά με το Growser for Testing</translation>
<translation id="526235294307144732">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον Λογαριασμό σας Growser, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="8594994021633965927">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Growser προτείνει να την καταργήσετε.</translation>
<translation id="770557926599450702">Καλωσορίσατε στο Growser Origin. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="137732229629632648">Το Growser χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="5036046007335188949">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS"/> σε άλλο προφίλ Growser</translation>
<translation id="1878185978731985193">Το Growser προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="8669339108356170796">Το Growser απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="7583343841997441047">Δοκιμάστε το Google Lens με το Growser στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="7776200949522126045">Εφαρμογές Growser Origin</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4970880042055371251">Έκδοση Chrome OS</translation>
<translation id="2182657378556811785">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Growser για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="6311668361877328515">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Growser, αλλά καθιστά το Growser ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="7402642357351265733">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Growser, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME"/>: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="8142245354207161805">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Growser (<ph name="PROCESS_ID"/>) σε άλλο υπολογιστή (<ph name="HOST_NAME"/>). Το Growser έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Growser.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="2014343159590733363">Ορισμένα δεδομένα του Growser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Growser. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="2408746614080689238">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Growser στο Growser. Η συντόμευση <ph name="SHORTCUT"/> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Growser.</translation>
<translation id="847561904663814268">Κάποιο άτομο συνδέθηκε προηγουμένως στο Growser σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST"/>. Δημιουργήστε έναν νέο χρήστη του Growser, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="3834935463915107022">Να τερματιστεί η λειτουργία του Growser ούτως ή άλλως;</translation>
<translation id="8668413672647811944">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Growser. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="4941816441131888792">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Growser κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="COUNT"/> ακόμη.</translation>
<translation id="844451748565342664">Εάν το Gemini στο Growser είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="215320507915280336">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Growser. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Growser. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="2899369907387169108">Χρήση του Growser χωρίς λογαριασμό</translation>
<translation id="1833893255023048385">Εισερχόμενος κανόνας για το Growser Origin για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="711601904575862069">Επανεκκίνηση για ενημέρωση του &amp;Growser</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="8797356639448065696">Το Growser εκτελείται στο παρασκήνιο.</translation>
<translation id="1895567721497166950">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Growser</translation>
<translation id="2692971232706994729">Με τα προφίλ του Growser μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Growser. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="7406627712452599344">Οι επισκέπτες μπορούν να χρησιμοποιούν το Growser χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="844471735881341044">Ο λογαριασμός σας στο Growser</translation>
<translation id="5952898964075639679">Προσθήκη του εαυτού σας στο Growser</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="4877750182157975795">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της Growser με το Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="1204184037023366446">Το Growser χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="5406591571925937375">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Growser κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="8157129267754368853">Ο λογαριασμός Growser απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="758175943316138760">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το Growser σε iOS.</translation>
<translation id="6234515504547364178">Αποσύνδεση από το Growser</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="7690383309583926074">Αποκτήστε την εφαρμογή Growser για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="8586264863973514035">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Growser</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="7264453786974905915">Λήψη της εφαρμογής Growser</translation>
<translation id="6944930779012811739">Εσωτερική υπηρεσία Growser Updater</translation>
<translation id="6214255602211289863">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο Growser</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="4672413209491548018">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο Growser</translation>
<translation id="7573068992266397941">Το Growser εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="8174413867995118050">Άλλα προφίλ Growser</translation>
<translation id="1659922362001329844">Δεν ήταν δυνατή η αποθήκευση δεδομένων Growser στον Λογαριασμό σας Growser από το ChromeOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="7708394612738038097">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Growser. Τα δεδομένα σας στο Growser, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Growser, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE"/>.</translation>
<translation id="2487133103111559902">Για εξατομίκευση, συμπεριλάβετε το Growser στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="5154625106151193600">Μάθετε γιατί το Growser αποκλείει ορισμένα αρχεία</translation>
<translation id="1786715389543715322">Ενημέρωση του Growser (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="7021823858304886493">Να επιτρέπεται η σύνδεση στο Growser</translation>
<translation id="5267531627648004734">Κατάργηση από το Growser</translation>
<translation id="4620757336635063467">Μειώνει την απόδοση αλλά καθιστά το Growser πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="239760341987199724">Ορισμός του Growser ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="5165277482382778404"><ph name="PAGE_TITLE"/> - Growser Origin Beta</translation>
<translation id="604223321106006231">{NUM_TABS,plural, =1{Το Growser συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Growser συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="894936507076470937">Το Growser ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="2596557398669145729">Το Growser απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="1744365871163268756">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Growser.</translation>
<translation id="3861679447659630159">Το Growser προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="8535558155562097643">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το Growser.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="232381795826373334">Άνοιγμα PDF στο Growser</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK"/>σχετικά με αυτή την καρτέλα</translation>
<translation id="3940190010522469883">Για λόγους ασφαλείας, το Growser απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="7074160267408082133">Εμφάνιση του Gemini στο Growser στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="3588973534877826647">Χρήση Growser από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="1026406809507858026">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Growser}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Growser}other{Υπάρχει μια διαθέσιμη ενημέρωση του Growser για # ημέρες}}</translation>
<translation id="1023472437588692618">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Growser</translation>
<translation id="5646769069113654257">Επανεκκινήστε το Growser τώρα</translation>
<translation id="3117204675033805491">Dmitry Golubnichiy</translation>
<translation id="2335583906071111058">Να εμφανίζεται το Growser σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="1834213228893578875">Το Growser αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Growser γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK"/></translation>
<translation id="899523323751802352">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK"/> τα δεδομένα του Growser στον λογαριασμό σας</translation>
<translation id="82926023981336111">Προσαρμογή και έλεγχος του Growser. Ορίστε το Growser ως προεπιλογή.</translation>
<translation id="5660546041996455312">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το Brave ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="95980832839683236">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Growser, αλλά καθιστά το Growser ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="1224606669200461217">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον Λογαριασμό σας Growser, ενημερώστε το Growser</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="4467664627714200493">Καλώς ήρθατε στο Growser Origin</translation>
<translation id="4026807082142463673">Ενεργοποιεί πρόσθετες λειτουργίες για την παροχή των ισχυρότερων μέτρων προστασίας του Growser</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="8054200348483755053">Το Growser εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="3955583201925082436">Το Growser ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="1275716786566134844">Ας ετοιμάσουμε το Growser</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="5768962901674164501">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser</translation>
<translation id="5101892358689285100">Εξατομίκευση του Growser</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5977420883993828287">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά τις Εργασίες με βάση τα συμφραζόμενα από τη γραμμή εργαλείων</translation>
<translation id="4357808717322635817">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Growser όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Growser όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="3598551856834560515">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Growser</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS"/> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="9138151530563359301">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="700488072601322385">Για την προστασία των δεδομένων σας, επιτρέψτε στο Growser να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="9071554113102421877">&amp;Άνοιγμα στο Growser</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="7861579472672677409">Η επέκταση <ph name="EXTENSION_NAME"/> έχει προστεθεί στο Growser</translation>
<translation id="5849446944780602366">Προσαρμόστε και ελέγξτε το Growser. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="5711722515923392428">Ενεργή • Το Growser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="6355366566986893068">Ο λογαριασμός σας στο Growser</translation>
<translation id="7433698744896946664">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Growser</translation>
<translation id="4168372721886011198">Το αρχείο <ph name="FILE_NAME"/> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Growser.</translation>
<translation id="991182453936521413">Το Growser θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="4060970194201477024">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας Growser</translation>
<translation id="7815000350132166985">Εάν επιτρέπεται η λήψη cookie, το Growser μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="5739368447874065758">Διαγράψετε τα δεδομένα του Growser στον λογαριασμό σας</translation>
<translation id="6685697979743742605">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK"/>Το Growser μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Growser, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="4368341489795135329">Βεβαιωθείτε ότι έχετε συνδεθεί στο Growser στη συσκευή σας <ph name="TARGET_DEVICE_NAME"/> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="8320964054148936490">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Growser. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Growser και κατεβάστε το ξανά.</translation>
<translation id="3574823187131579180">{0,plural, =0{Η επανεκκίνηση του Growser θα γίνει τώρα}=1{Η επανεκκίνηση του Growser θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Growser θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="5980269616827212166">Το Growser χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="7651600795135059130">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Growser</translation>
<translation id="5019879183386042809">Ορισμός Growser ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="1481716298194191711">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της Growser εν κινήσει, με την εφαρμογή Growser στο τηλέφωνό σας</translation>
<translation id="7445061995866044926">Θέλετε να αποσυνδεθείτε από το Growser;</translation>
<translation id="4659866260728515512">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Growser να τις απενεργοποιήσει.</translation>
<translation id="6806912298071949921">Προσαρμόστε το προφίλ σας Growser</translation>
<translation id="3792238845239580301">Ονομάστε το προφίλ σας στο Growser</translation>
<translation id="5874208157501051620">Μια επέκταση θέλει να συνδεθείτε στο Growser</translation>
<translation id="3561569806301739367">Το αρχείο <ph name="FILE_NAME"/> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Growser.</translation>
<translation id="3205074487970075628">Το Growser χρησιμοποιεί την κάμερά σας.</translation>
<translation id="1819119299840995223">Μια άλλη λειτουργία στο Growser βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="8616874628011103667">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Growser με το Λογαριασμό σας Growser και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="5213389303624223677">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="4264606872840545968">Συντόμευση Growser</translation>
<translation id="6890616081898535725">Το Growser απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="335632367599648646">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Growser;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="7920857181125123335">Για να συνεχίσετε, συνδεθείτε στο Growser ως <ph name="EMAIL"/>. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="3256100650978957522">Λογότυπο Growser μέσα σε οθόνη υπολογιστή.</translation>
<translation id="5880764554173582719">Το Growser Origin είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="4091049150278654573">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα Growser στον Λογαριασμό σας Growser, επαληθεύστε την ταυτότητά σας</translation>
<translation id="2532326772258858491">Το Growser εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2139300032719313227">Επανεκκίνηση Chrome OS</translation>
<translation id="638302211119176182">Το Growser προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="7167975344637731051">Κατεβάστε το Growser στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="890319829408077946">Ανενεργή • Το Growser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="1684121725014454063">Καλώς ήρθατε στα προφίλ του Growser</translation>
<translation id="8211983866539058675">Την επόμενη φορά που θα ανοίξετε το Growser στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="7906693299331092358">Κατάργηση λογαριασμού από το Growser</translation>
<translation id="2675662665675552980">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Growser.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="5590013613412457132">Απεγκατάσταση Growser</translation>
<translation id="7185585387858242335">Οι συντομεύσεις ανοίγουν στο Growser</translation>
<translation id="3617744907966785605">Ο οργανισμός σας κλείνει το Growser όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="8646609321956191980">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Growser, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6756656512757374876">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK"/>πώς το Growser διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του Growser.</translation>
<translation id="3396870972301571614">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του Growser.</translation>
<translation id="2535436634051789953">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Growser</translation>
<translation id="6376474391582629025">Χρησιμοποιήστε την εφαρμογή Growser για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="2312399718665761438">Για τη διόρθωση ορθογραφικών λαθών, το Growser στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Growser</translation>
<translation id="3507835409099344374">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Growser</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="9156965752763025780">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Growser.</translation>
<translation id="3387992981600748596">Το Growser ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="3119017564683030312">Συνεχίστε από εκεί που σταματήσατε: Το Growser έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="245693535809364497">Το Growser χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="9210457680074341078">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Growser, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Growser και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="1363996462118479832">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="4694512973195649124">Κατάργηση των δεδομένων αυτής της εφαρμογής από το Growser</translation>
<translation id="1257247502847251159">Το Growser χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="1489465648257900784">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του Growser.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Growser.</translation>
<translation id="1505112054322049777">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Growser στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Growser</translation>
<translation id="6666624454809779082">Το Growser είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="5848830584656405219">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Growser αφού συνδεθείτε.</translation>
<translation id="4020203987234748583">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Growser, αλλά καθιστά το Growser ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="3848421741245997269">{count,plural, =1{Ορισμένα δεδομένα του Growser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Growser. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του Growser δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Growser. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="3136039682492230890">Το Growser συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="1547295885616600893">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="8211837073776713955">Το Growser σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME"/> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="8237613041998823669">Growser Origin - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="3028928628792374067">Το Growser εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME"/>.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="862687584320433626">Ορίστε το Growser ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="1991562568473125499">&amp;Διαχείριση προφίλ Growser</translation>
<translation id="6995921847081718550">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS"/>
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK"/>
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK"/>
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK"/>
            • Θα επαναφέρει τις συντομεύσεις του Growser
            <ph name="LINE_BREAKS"/>
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="5529781826378237601">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT"/> σελιδοδεικτών του Growser, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Growser.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="3453763134178591239">Όροι του Chrome OS</translation>
<translation id="6643520655691573653">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="280382502853897110">Προσαρμόστε το Growser για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="1705567146636171298">Ενημέρωση Growser</translation>
<translation id="5499063270485366718">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Growser θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Growser.</translation>
<translation id="1196733835766994012">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="7166289504510860270">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Growser στο τηλέφωνό σας</translation>
<translation id="5966368554860795750">Προσαρμογή του Growser for Testing</translation>
<translation id="792838367208896130">Μπορείτε να χρησιμοποιείτε το Growser κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="375314543563594498">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME"/> από το Growser</translation>
<translation id="2332301637111071062">Ο οργανισμός σας διαγράφει τα δεδομένα του Growser όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION"/>. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="1008530050039597147">Το Growser χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="1197672524850678392">Δεν ήταν δυνατή η εκκίνηση του Growser. Προσπάθησε ξανά.</translation>
<translation id="5020151688261063547">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο Brave</translation>
<translation id="3625983487600668413">Διατηρήστε το Growser στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="5755581833598928580">Χρησιμοποιήστε το Growser κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="5516268345616100622">Διαχείριση Εργασιών - Growser</translation>
<translation id="1871621397473741084">Ξεκινήστε άμεσα την περιήγηση: Το Growser μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{Το Growser προτείνει να την καταργήσετε}other{Το Growser προτείνει να τις καταργήσετε}}</translation>
<translation id="4600669988724328687">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το Growser. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Growser.</translation>
<translation id="9068395155143628872">Η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το Growser που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="1864557848095568223">Ενημέρωση του Growser</translation>
<translation id="3403365884036456766">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το Growser δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="3511996232906761537">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Growser.</translation>
<translation id="1754899895078387289">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Growser, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK"/>διαγράψετε τα δεδομένα του Growser στον λογαριασμό σας<ph name="END_LINK"/>.</translation>
<translation id="5380963249588143069">Ο διαχειριστής συστήματος έχει διαμορφώσει το Growser ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME"/> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="6085660187823915017">Για τη λήψη μελλοντικών ενημερώσεων του Growser, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="2865744782251083875">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Growser κατάργησε τις άδειες <ph name="PERMISSION_1"/> και <ph name="PERMISSION_2"/>.</translation>
<translation id="3871306442916198768">Εμφάνιση του Gemini στο Brave στην περιοχή ειδοποιήσεων</translation>
<translation id="4104934885375476361">Το Growser είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7951152294775418909">Συνεχίστε από το σημείο που σταματήσατε: Το Growser επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="3191314862567596053">Εισαγωγή κωδικών πρόσβασης στο Growser</translation>
<translation id="284799389314308801">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL"/> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2"/> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3"/> στην ειδοποίηση των Windows για να καρφιτσώσετε το Growser στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="4864311514218370796"><ph name="PAGE_TITLE"/> - Growser Origin Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7129342855140808694">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Growser στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="5296583608321648908">Για τη λήψη μελλοντικών ενημερώσεων του Growser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="3962395975456095331">Επανεκκίνηση του Growser;</translation>
<translation id="2619516027171717873">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του Growser που εκτελείται αυτήν τη στιγμή. Κλείστε το Growser και δοκιμάστε ξανά.</translation>
<translation id="6607863494375614497">Υπενθύμιση: Οι καλύτερες λειτουργίες της Growser στην τσέπη σας</translation>
<translation id="5337027666828618338">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Growser, εκτός από τον Λογαριασμό σας Growser εάν είστε συνδεδεμένοι στο Growser.</translation>
<translation id="3186363903915641692">{0,plural, =1{Η επανεκκίνηση του Growser θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Growser θα γίνει σε # λεπτά}}</translation>
<translation id="552342471964912391">Για την προστασία των δεδομένων σας, επιτρέψτε στο Growser να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="3826701455067637694">Ανοίξτε αυτόματα το Growser, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME"/></translation>
<translation id="3293668930608086049">Το Growser χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="2827121003398607864">Το Growser έγινε ακόμα καλύτερο</translation>
<translation id="3071313329776323836">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο Growser</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="222435847253721602">Λήψη της εφαρμογής Growser</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="3343095737966473035">Το Growser δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="5477319665405831211">Συγχρονίστε και εξατομικεύστε το Growser στις συσκευές σας</translation>
<translation id="2339273275658335597">Ενημέρωση Growser</translation>
<translation id="4870714623113535320">Η εργασία σας προστατεύεται στο Growser</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME"/>. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="4784414698887946907">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Growser ως <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="8543787950557226450">Επαναφορά της προεπιλογής Growser</translation>
<translation id="4859382825808018797">Για την προστασία της εργασίας σας στο Brave, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο Brave.</translation>
<translation id="4976450819672499783">Ορίστε το Growser ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="1978509466033734608">Κάντε το Growser πιο γρήγορο</translation>
<translation id="8607348724092473027"><ph name="PAGE_TITLE"/> - Growser Origin Canary</translation>
<translation id="2684504034454188774">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Growser χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="1652855885539187849">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Growser με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="7397737266068428588">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του Growser. Για την προστασία σας, το Growser την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="9148690296223500734">Προσαρμόστε το Growser για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="7963515534397191222">Δεν ήταν δυνατή η ενημέρωση του Growser στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS"/> δευτερόλεπτα.</translation>
<translation id="5545136190679883344">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK"/>διαγράψτε τα δεδομένα του Growser στον λογαριασμό σας<ph name="END_LINK"/></translation>
<translation id="9044562649276955255">Ανοίξτε γρήγορα το Gemini στο Growser όποτε το χρειάζεστε</translation>
<translation id="5687542525349822727">Ορισμός του Growser ως προεπιλογής</translation>
<translation id="6396151137840491551">Το Growser αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="2925193881330501265">Συνδεθήκατε στο Growser ως <ph name="USER_EMAIL_ADDRESS"/>. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="6915252145142862992">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Growser και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="7766756101194440006">Αξιοποιήστε τις καλύτερες λειτουργίες της Growser με την εφαρμογή Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="7685904775439037072">Όταν το Growser αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="3230755314472063687">Καρφιτσώστε το Growser στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="6175141682081019059">Απενεργοποίηση του Growser, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="5528402763209637578"><ph name="PAGE_TITLE"/> – Growser Origin for Testing</translation>
<translation id="2061155704815580583">Το Growser χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="3576319845915562805">Την επόμενη φορά που θα ανοίξετε το Growser στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="3728025339793417202">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή Growser στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="4449306641116952869">Εξατομικεύστε το Growser</translation>
<translation id="5334309298019785904">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="5775051495647233404">Ανοίξτε το Gemini στο Growser με μια συντόμευση πληκτρολογίου.</translation>
<translation id="1081849497974110565">Πρόσθετοι όροι παροχής υπηρεσιών του Growser</translation>
<translation id="9067428552314418522">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Growser.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="6219250889396046657">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον λογαριασμό σας, <ph name="USER_EMAIL"/></translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="8377926237617998195">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Growser στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="1755067029031059271">Το Growser δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Growser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="8207657266087451193">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Growser θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Growser. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="7792526144795244436">Σύνδεση στο Growser με νέο προφίλ;</translation>
<translation id="183102473074922918">Εμφάνιση του Gemini στο Growser στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="976541154724186511"><ph name="BEGIN_LINK"/>Το Growser σας προειδοποιεί<ph name="END_LINK"/> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="8060549744348950090">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Growser κατάργησε την άδεια <ph name="PERMISSION"/>.</translation>
<translation id="7402663241490331652">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή Growser iOS</translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="6098476632210317894">Ο οργανισμός σας κλείνει το Growser όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="2591326305549412656">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS"/> χρησιμοποιούσε το Growser στο παρελθόν</translation>
<translation id="6771602601399828881">Ενεργοποίηση Δεξιοτήτων στο Growser</translation>
<translation id="5592122595094519401">Ενημερώστε το Growser, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Growser στον Λογαριασμό σας Growser, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="2569754604093464025">Για τη λήψη μελλοντικών ενημερώσεων του Growser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="7296197595428914424">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Growser. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Growser αφού συνδεθείτε.</translation>
<translation id="9098234372282930719">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Growser.</translation>
<translation id="1327729221471951979">Το Growser προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/></translation>
<translation id="8577108764439626300">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Growser, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="4234753748520037091">Το Growser πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Growser και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="5337999052834672687">{0,plural, =1{Επανεκκίνηση του Growser σε μία ημέρα}other{Επανεκκίνηση του Growser σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="2936579431423833666">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο Growser</translation>
<translation id="6914496861676471566">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Growser ξανά.</translation>
<translation id="4378573854226202617">Το Growser απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="6431861494713261006">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chrome OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Growser.</translation>
<translation id="8691137711639873980">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Growser στον Λογαριασμό σας Growser, επαληθεύστε την ταυτότητά σας</translation>
<translation id="3251012123600267109">Εμφάνιση οδηγιών για σύνδεση στο Growser</translation>
<translation id="2097604701283463988">Το Growser δεν είναι ενημερωμένο</translation>
<translation id="6080203201796279095">Σας ευχαριστούμε που ορίσατε το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="871233388178581868">Το Growser μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="909104880763805392">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="3667461919057407535">Λάβετε ειδοποίηση, εάν το Growser εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="7998982887712810347">Ορισμένες λειτουργίες και επεκτάσεις του Growser διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="839677568225616901">Πολλοί οργανισμοί διαχειρίζονται το Growser</translation>
<translation id="8121009781989288430">Πνευματικά δικαιώματα <ph name="YEAR"/> Οι συντάκτες του Growser. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8601359445272098721">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας, επιλέγοντας το κουμπί Μετάφραση οθόνης</translation>
<translation id="3052349005266761501">Εκκίνηση του Growser…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="5128665650717824082">Το Growser for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2433912322225810055">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Growser ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="4100716194836114130">Ορίστε το δικό σας Growser</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="1419543648228375718">Σύνδεση στο Growser;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="1588296410638341457">Μοιραστείτε αυτό το έγγραφο με το Gemini στο Growser για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="64216977793816291">Σύνδεση στο Growser;</translation>
<translation id="7447364954121496869">Ορισμός Growser ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="6933858244219479645">Σύστημα Chrome OS</translation>
<translation id="9084132286318231275">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Growser</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="7289323009146924152">Προσθήκη προφίλ Growser</translation>
<translation id="2922281028449999368">Δεν ήταν δυνατή η αποθήκευση δεδομένων Growser στον Λογαριασμό σας Growser από το ChromeOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="1150745254876977823">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Growser</translation>
<translation id="8285294305439559616">Το Growser προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="4684884244620579559">Το Growser δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="6389268239133412586">Δεν είναι δυνατή η ενημέρωση του Growser</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS"/>
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK"/>
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK"/>
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS"/>
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="7731184591599776500">Λογότυπο Growser Enterprise</translation>
<translation id="2001474182910589370">Απολαύστε την ασφάλεια της Growser εν κινήσει με την εφαρμογή Growser στη συσκευή <ph name="DEVICE_TYPE"/></translation>
<translation id="6500340165622970282">Δεν είναι δυνατή η έναρξη του Growser, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το Growser.</translation>
<translation id="3424657754843264466">Διαχείριση προφίλ Growser</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="82609232232243542">Σύνδεση στο Growser</translation>
<translation id="7055223246119657449">Το Growser απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="8341362078156319636">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Growser ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Growser θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="8965179855019347124">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της Growser με την εφαρμογή Growser στο τηλέφωνό σας</translation>
<translation id="9049928023195059068">Σύνδεση στο Growser όταν συνδέεστε σε άλλες υπηρεσίες Growser</translation>
<translation id="4561046754724442504">Το Growser έκλεισε αυτόματα</translation>
<translation id="5173820533850252773">Το Growser δεν είναι ενημερωμένο</translation>
<translation id="310518206836658214">{0,plural, =1{Η επανεκκίνηση του Growser θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Growser θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="5190991181158966940">Για τη λήψη μελλοντικών ενημερώσεων του Growser, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="7863882214613921971">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Growser</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="2792073155252170448">Συνεχίστε από το σημείο που σταματήσατε: Το Growser μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="2444257125841652328">Ο διαχειριστής συστήματος έχει διαμορφώσει το Growser έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7902365066753170041">Επανεκκίνηση για ενημέρωση του &amp;Growser</translation>
<translation id="538146372587193686">Growser Origin (mDNS-In)</translation>
<translation id="296137235951584143">Εξατομίκευση του Growser</translation>
<translation id="7977787072794666032">Το Growser μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="8462937515915443472">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της Growser με το Growser.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="4484434718272972655">Ποιος χρησιμοποιεί το Growser;</translation>
<translation id="7173394303099002355">Λάβετε την ισχυρότερη προστασία του Growser</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="8435446479956716379">Χρήση του Growser χωρίς λογαριασμό</translation>
<translation id="8992261409816268381">Οι συντάκτες του Growser</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="3146636448190445245">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Growser στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το Growser ξανά.</translation>
<translation id="1743665722170667430">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Growser συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="5840822070878669614">Ανοίξτε το Διαδικτυακό κατάστημα</translation>
<translation id="6184592406110188164">Η επέκταση αυτή παραβιάζει την πολιτική του διαδικτυακού καταστήματος. Αφαιρέστε τη από τον Growser, για να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα στους ιστότοπους που επισκέπτεστε, ούτε τα προσωπικά στοιχεία σας.</translation>
<translation id="1299765473362724475">Προειδοποίηση: Το Growser δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτήν την επέκταση σε Ιδιωτική λειτουργία, καταργήστε αυτήν την επιλογή.</translation>
<translation id="1448049584457347995">Για να κάνουμε το Growser πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="8848045066928358658">Για να κάνουμε το Growser πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="4624945300945265642">Ανοίξτε τον σύνδεσμο σε &amp;ιδιωτικό παράθυρο Growser</translation>
<translation id="1069969567644851798">Άνοιγμα συνδέσμου στο Growser &amp;σε παράθυρο ανώνυμης περιήγησης</translation>
<translation id="6554952862405000915">Άνοιγμα συνδέσμου σε &amp;Ιδιωτικό παράθυρο Growser</translation>
<translation id="8274659559228306809">{COUNT, plural,
          =0 {Μια νέα ενημέρωση για το Growser είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}
          =1 {Μια νέα ενημέρωση για το Growser είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
          other {Μια νέα ενημέρωση για το Growser είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7347727235538318126">Αυτό θα σας επιτρέψει να κοινοποιείτε περιεχόμενο από το Growser στις τοπικές σας συσκευές, όπως μια τηλεόραση ή ένας ηχείο.</translation>
<translation id="3829358914761176693">{COUNT, plural,
              =0 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Growser για να εφαρμόσετε αυτήν την ενημέρωση}
              =1 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Growser για να εφαρμόσετε αυτήν την ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Growser για να εφαρμόσετε αυτήν την ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="552349673358711446">{COUNT, plural,
              =0 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση}
              =1 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1400696845469684552">{COUNT, plural,
              =0 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση}
              =1 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση. Το ιδιωτικό σας παράθυρο δεν ανοίγει ξανά.}
              other {Η Προστασία για προχωρημένους απαιτεί να επανεκκινήσετε το Growser για να εφαρμόσετε μια ενημέρωση. Τα # ιδιωτικά παράθυρα δεν ανοίγουν ξανά.}}</translation>
<translation id="5749154344207139683">Βοηθήστε μας να βελτιώσουμε το Private, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="79269250264141507">Όταν πληκτρολογείτε κάτι στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Growser στέλνει το περιεχόμενο που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησής σας για να λαμβάνετε καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ιδιωτική λειτουργία.</translation>
<translation id="2589970573128789862">Ιδιωτική λειτουργία Growser</translation>
<translation id="5994282802285556682">Κατά την Ανώνυμη Περιήγηση, ο Growser θα σας προειδοποιεί πριν φορτώσετε κάποια ιστοσελίδα με μη ασφαλή σύνδεση</translation>
<translation id="7813580490378477695">Ο συνεργάτης <ph name="PARTNER_NAME"/> πρόσθεσε μια επέκταση που ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6204677860546245308">Χρήση προτεινόμενων ρυθμίσεων προγράμματος περιήγησης του Growser</translation>
<translation id="1404026649028693342">Να εμφανίζεται πάντα η Λειτουργία AI</translation>
<translation id="1530633922026945685">Το Growser χρειάζεται άδεια πρόσβασης στην κάμερά σας, για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="1680687534629375545">Ερώτηση στην Αναζήτηση με εικόνες σχετικά με αυτή τη σελίδα</translation>
<translation id="3643631442346149414">Για την προστασία της εργασίας σας στο Growser, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες</translation>
<translation id="1898804291554630487">Ρωτήστε σχετικά με αυτή τη σελίδα</translation>
<translation id="2066690553719545730">Να εμφανίζεται πάντα η Λειτουργία AI</translation>
<translation id="9095263438435683933">Για να στείλετε από εδώ έναν αριθμό στο τηλέφωνό σας Android, συνδεθείτε στο Growser και στις δύο συσκευές.</translation>
<translation id="3225882094369124157">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε ένα θέμα, το οποίο ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3369405342922656244">Αναζήτηση αυτής της σελίδας με την Αναζήτηση με εικόνες</translation>
<translation id="7029305463989165490">Για να στείλετε έναν αριθμό από το <ph name="ORIGIN"/> στο τηλέφωνό σας Android, συνδεθείτε στο Growser και στις δύο συσκευές.</translation>
<translation id="6654312501894761082">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε μια επέκταση, η οποία ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="5254739261293693943">Ερώτηση σχετικά με αυτό το βίντεο</translation>
<translation id="696826782632239602">Το Growser χρειάζεται πρόσβαση στην τοποθεσία σας, για να την κοινοποιήσει σε αυτόν τον ιστότοπο</translation>
<translation id="5968400720580217226">Λειτουργία AI</translation>
<translation id="3038354906709778538">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε μια εφαρμογή, η οποία ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6239161312595354541">Ερώτηση στην Αναζήτηση με εικόνες σχετικά με αυτό το βίντεο</translation>
<translation id="6934579572334859869">Ερώτηση στην Αναζήτηση εικόνων σχετικά με αυτή την εικόνα</translation>
<translation id="3335606533094650083">Το Growser χρειάζεται άδεια, για να αποκτήσει πρόσβαση στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="2034072705932785495">Το Growser χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα για αυτόν τον ιστότοπο</translation>
<translation id="7877212753140190672">Ερώτηση σχετικά με αυτή την εικόνα</translation>
<translation id="4831743161813926460">Το Growser χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα και στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
</translationbundle>