<translation id="5924017743176219022">درحال متصل شدن به اینترنت…</translation>
<translation id="1275716786566134844">‏بیایید Growser را آماده کنیم</translation>
<translation id="5941711191222866238">کوچک کردن</translation>
<translation id="5768962901674164501">‏برای دریافت این نشانک و موارد بیشتر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="5101892358689285100">‏‫Growser را مخصوص خودتان کنید</translation>
<translation id="5960071705175224773">برنامه‌ای ناشناس تنظیمات شما را تغییر داد</translation>
