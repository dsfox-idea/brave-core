<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="7099479769133613710">‏راه‌اندازی مجدد برای به‌روزرسانی ChromeOS</translation>
<translation id="2479110114759182442">‏Growser توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="3814674848168165531">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Growser از سرورهای Growser استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Growser متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="7577672138294294152">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Growser خاموش کرده است</translation>
<translation id="4408482856437790071">‏برای جستجو کردن افزونه یا ویژگی خاص Growser، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="5918095577778020936">‏Growser می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">‏Growser مرورگر پیش‌فرضتان است</translation>
<translation id="8522292744959221145">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم Growser وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">‏روی منو Growser کلیک کنید</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="8541922081612557424">‏درباره Growser</translation>
<translation id="987734326276404793">‏با Growser در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE"/></translation>
<translation id="1934377710648094656">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Growser» خود در Growser استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Growser» بروید.</translation>
<translation id="583633806828413086">‏نمایش «Gemini در Growser» در نوار منو Mac</translation>
<translation id="1631493536097460865">‏برای انتخاب بخشی از صفحه در «Gemini در Growser»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="8799570501820813406">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Growser حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="8767381092474532098">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="3256289531845594061">‏وقتی با <ph name="USER_EMAIL"/> به سیستم سرویس‌های Growser مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Growser وارد شوید</translation>
<translation id="8508169558526580571">‏دریافت کردن Growser در تلفن</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">‏راه‌اندازی نمایه Growser جدید</translation>
<translation id="4291722755910963157">‏با «Gemini در Growser» امتحان کنید</translation>
<translation id="878572309106296578">‏‫Growser برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="7562683844189283122">‏ورود به سیستم Growser در تلفن</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="108284536240904209">‏داده‌ها از Growser هم حذف شود (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1356661055722410047">جدید! می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="3535301204632475895">‏برای ادامه مرور در حرکت، از برنامه Growser استفاده کنید</translation>
<translation id="7009295044271335553">‏مدیریت نمایه‌های Growser</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="3880714039086599943">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید.</translation>
<translation id="1586284627848250203">‏دریافت راهنمایی درباره Growser for Testing</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="5147525139567260139">‏هم‌رسانی برگه Growser</translation>
<translation id="721261350616678948">‏ورود به سیستم Growser</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="51545890371361355">‏سنجاق کردن Growser</translation>
<translation id="6570689355868013775">‏ابزارهای ایمنی Growser</translation>
<translation id="1902837727299679178">‏‫Growser می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="1655849915812740665">‏با برنامه Growser در تلفنتان، بیشترین بهره را از Growser ببرید</translation>
<translation id="4449148723378534338">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Growser</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1665602916345474427">با <ph name="USER_NAME"/>، <ph name="USER_EMAIL"/>، عضویت به سیستم وارد شده‌اید. باز کردن منو حساب</translation>
<translation id="509363484780540563">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Growser باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME"/> ارائه می‌دهد.</translation>
<translation id="8004287232784878841">‏Growser به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="4197839351786449392">‏Growser سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="7814200940910057384">‏داده‌های Growser پاک شد</translation>
<translation id="9048361966237194186">‏Growser تا <ph name="REMAINING_TIME"/> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="5524150602137990006">‏وقتی HTTPS دردسترس نباشد، Growser بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="6797402139308059782">‏اجازه به Growser برای اجرا در پس‌زمینه</translation>
<translation id="5994491947936308173">‏روی <ph name="BEGIN_BOLD"/>بله<ph name="END_BOLD"/> در اعلان Windows کلیک کنید تا Growser را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="5875673934455379806">‏نصب مجدد Growser</translation>
<translation id="4529028207655448215">‏Growser در تلاش است <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="7362761326208547489">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Growser» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="3541642064306182066">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Growser»، <ph name="BEGIN_LINK"/>از سیستم Growser خارج شوید<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">‏با بارگیری Growser در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="4559627161887338743">‏می‌توانید «حساب‌های Growser» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Growser» شما در مرورگر Growser، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE"/> خود اضافه کنید. <ph name="LINK_BEGIN"/>بیشتر بدانید<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="2963742289915075304">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="4528406859989804913">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Growser خود را می‌دهید. داده‌های Growser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Growser حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Growser موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">‏‫Growser با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="8643267611122541711">‏سرویس به‌روزرسان Growser</translation>
<translation id="1649714546770135458">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Growser به سیستم سایت‌های Growser مانند Gmail وارد شوید</translation>
<translation id="189297655255130768">‏Growser پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="8422047647688939115">‏سازمانتان (<ph name="MANAGER"/>) شما را ملزم می‌کند به سیستم Growser وارد شوید</translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، ChromeOS باید بازراه‌اندازی شود.</translation>
<translation id="9048754176089806686">‏‫Growser این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE"/> دقیقه باقی مانده است</translation>
<translation id="1775322105159056176">‏Growser نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="197326043290947695">با «جستجوی تصویر» هوشمندانه‌تر مرور کنید</translation>
<translation id="4372901050442507812">‏ببینید چرا Growser برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="2703425183860615504">‏نرم‌افزار Growser را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Growser به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Growser از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="9220324636239049437">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="5499149312981370855">‏انتخاب کنید که آیا سابقه Growser برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Growser لحاظ شود یا نه</translation>
<translation id="5152523902653128156">‏این ویژگی در Growser تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="6959434860418352144">‏روی دکمه «سفارشی‌سازی Growser» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Growser ببخشید</translation>
<translation id="2472891440303445472">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="2054358978145431867">‏دفعه بعد که Growser iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME"/>» خواهید دید.</translation>
<translation id="2726948994393234543">‏گذرواژه‌ها و دیگر داده‌های Growser که در «حساب Growser» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Growser، دوباره به سیستم وارد شوید.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2125838419757773031">بخشی از صفحه‌نمایش را برای جستجو انتخاب کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="5789330946301045610">‏‫Growser این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="142389341645668510">‏سفارشی کردن Growser</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="8841019650931243995">‏Growser Origin - ورود به سیستم شبکه - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">خطای بررسی به‌روزرسانی: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">‏برداشتن حساب از Growser</translation>
<translation id="4022045673362955204">‏برای داشتن بهترین ابزارهای خرید درحرکت، از برنامه Growser استفاده کنید</translation>
<translation id="5550942974310218641">‏با «مرور ایمن پیشرفته» در Growser برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="6677253423995557759">‏سایت خطرناک. ‫Growser اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="457168681575748148">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="5659384504794665581">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Growser را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="2752319862668322390">‏مهارت‌ها در Growser</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Growser توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="7810992039564280750">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Growser ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Growser ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="2356070529366658676">سؤال شود</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="6485997157403727556">‏افزونه «<ph name="EXTENSION_NAME"/>» از شما می‌خواهد به سیستم Growser وارد شوید</translation>
<translation id="7017760840808989683">‏غیرفعال کردن اجرای Growser در پس‌زمینه برای برنامه‌ها</translation>
<translation id="8491912023989916905">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS"/>، به سیستم Growser وارد شوید.</translation>
<translation id="8418845734693287262">‏ChromeOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Growser به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Growser به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Growser به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Growser به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="1248225940185478633">‏Growser برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="5298352791080868905">‏پیوندها را از هر برنامه‌ای در Growser باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="2600233721598267627">‏برای هم‌رسانی این سند با Gemini در Growser و دریافت مرور کوتاه و پرسیدن سؤالات تعقیبی، روی دکمه «خلاصه کردن» کلیک کنید</translation>
<translation id="2118275934191847461">‏با <ph name="BEGIN_LINK"/>ابزارهای Growser<ph name="END_LINK"/>، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="7508460698788470991">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین گذرواژه‌هایتان و اطلاعات دیگر را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
<translation id="6381750314821942592">‏Growser به‌زودی بسته می‌شود</translation>
<translation id="6078442581074612226">‏در Growser</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2513154137948333830">بازراه‌اندازی لازم است: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">نوشتاری را برای استفاده از «جستجوی تصویر» انتخاب کنید</translation>
<translation id="70183448213529602">‏Growser می‌خواهد گذواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="7798069806040634998">‏Growser برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="2351700486811407088">Growser Origin Helper</translation>
<translation id="2575822587468774919">هرچیزی را می‌خواهید انتخاب کنید تا با «جستجوی تصویر» جستجو شود</translation>
<translation id="3830890663494219270">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="6908148552215338695">‏برای بارگیری Growser و ورود به سیستم «حساب Growser»، رمزینه پاسخ‌سریع را با تلفنتان اسکن کنید.</translation>
<translation id="6252796827759111076">‏ادامه استفاده از Growser</translation>
<translation id="259935314519650377">نصب‌کننده بارگیری‌شده در حافظه نهان ذخیره نشد. خطا: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">سیستم</translation>
<translation id="7931230852267968641">‏سازمانتان می‌تواند داده‌های مرور، مثل نشانک‌ها، سابقه، و گذرواژه‌هایتان را ببیند و مدیریت کند. سازمانتان نمی‌تواند داده‌های مرور دیگر نمایه‌های Growser را ببیند</translation>
<translation id="2257221826278123061">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، هویت خود را درستی‌سنجی کنید</translation>
<translation id="7048234400304379082">‏برای ترک کردن یا برگشتن به «Gemini در Growser»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="5655607968417451974">‏شروع Growser</translation>
<translation id="7387051847644272380">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً Growser را دوباره نصب کنید.</translation>
<translation id="2648689842065142443">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Growser را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="1001521084148238686">‏دسترسی آسان به «Gemini در Growser» در سراسر دستگاه، حتی اگر Growser کوچک شده باشد.</translation>
<translation id="6791166902140255175">‏برگه Growser</translation>
<translation id="8372880274820509128">‏برای امنیت بیشتر، Growser داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="8752006915531191162">‏برای برداشتن «حساب Growser» خود از Growser، از سیستم خارج شوید</translation>
<translation id="5344406739101555055">‏برای دریافت گذرواژه‌ها، نشانک‌ها، و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="2738871930057338499">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۳ ممنوع است. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="2753623023919742414">برای جستجو، کلیک کنید</translation>
<translation id="1312769823139326127">‏تنظیم Growser به‌عنوان نمایشگر PDF پیش‌فرض</translation>
<translation id="1187986649024576560">‏این افزونه حاوی بدافزار است و ناامن است. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2799223571221894425">راه‌اندازی مجدد</translation>
<translation id="5962774139606909656">‏‫Growser شما</translation>
<translation id="2816462166102338036">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="1992849613617207128">‏محصولات را با دوربین خود کشف کنید، افت قیمت‌ها را دنبال کنید و موارد بیشتری را در حرکت با Growser روی iOS انجام دهید.</translation>
<translation id="2841525013647267359">ترجمه کردن از</translation>
<translation id="2846251086934905009">خطای نصب: نصب‌کننده کامل نشد. نصب لغو شد.</translation>
<translation id="777113543093865885">‏حذف از Growser...</translation>
<translation id="5265419033369521352">‏وقتی به سیستم وارد شده باشید، امنیت شما را در Growser حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر Growser استفاده شود</translation>
<translation id="2885378588091291677">مدیر وظایف</translation>
<translation id="2176825726964012531">‏درباره &amp;Growser</translation>
<translation id="2915996080311180594">بازراه‌اندازی در فرصتی دیگر</translation>
<translation id="2481553173340651149">‏داده‌هایتان بااستفاده از گذرعبارت شما رمزگذاری شده است. برای استفاده از داده‌های Growser و ذخیره کردن این داده‌ها در «حساب Growser»، این گذرعبارت را وارد کنید.</translation>
<translation id="2945997411976714835">خطای نصب: فرایند نصب‌کننده شروع نشد.</translation>
<translation id="2413255940314578781">‏با گذرواژه‌های ذخیره‌شده برای Growser در iOS، در سایت‌ها سریع‌تر به سیستم وارد شوید</translation>
<translation id="3688936822855019158">‏سازمان شما Growser را مدیریت می‌کند</translation>
<translation id="8208853227947884571">‏Growser به‌روز است</translation>
<translation id="5122472867956731189">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Growser ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="3963199983793987097">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به سیستم Growser وارد شوید</translation>
<translation id="3003694935412297923">همه تکلیف‌ها</translation>
<translation id="7611046016537686219">{count,plural, =1{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="4202995875619419215">‏‫<ph name="URL"/> در زبانه جدیدی در Growser باز می‌شود.</translation>
<translation id="1266825212217391702">‏نوآوری‌های هوشواره، مانند «مهارت‌ها»، در «حساب Growser» شما ذخیره می‌شود و جدا از همگام‌سازی Growser مدیریت می‌شوند</translation>
<translation id="8880183781256147665">‏افزودن به Growser…</translation>
<translation id="3038232873781883849">درانتظار نصب…</translation>
<translation id="3045032126857188731">زبان ترجمه‌شده: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">بستن کادر گفتگوی بازخورد</translation>
<translation id="4503085212612536713">‏دیگر نمایه‌های Growser</translation>
<translation id="2041039306630146369">‏افزونه‌ها برافزاهایی هستند که به شما امکان می‌دهند Growser را سفارشی‌سازی کنید. از مرتب ماندن گرفته تا ساده‌سازی تکالیف روزمره، افزونه‌ها به شما کمک می‌کنند Growser را مختص خودتان کنید.</translation>
<translation id="7918740962659365265">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK"/> به Growser، به بهبود Growser کمک کنید</translation>
<translation id="6828757829023033545">‏برای داشتن ایمنی Growser در حرکت، از برنامه Growser استفاده کنید</translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Growser به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه Growser به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه Growser به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه Growser به # دستگاه USB دسترسی دارند}}</translation>
<translation id="3700405816184340252">‏سابقه Growser</translation>
<translation id="7365690458036015383">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره Growser را بارگیری کنید.</translation>
<translation id="310459126943037700">تکلیف(ها) پایان نیافت.</translation>
<translation id="3104828284009500087">جستجو کردن هر چیزی در صفحه</translation>
<translation id="6422885447166607802">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Growser، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="8919461291440820124">‏Growser درحال استفاده از میکروفون شما است.</translation>
<translation id="3130333203120345554">جستجوی جدید</translation>
<translation id="3137969841538672700">برای جستجو، بخش موردنظر را بکشید</translation>
<translation id="8372436892102763334">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Growser آن را غیرفعال کند.</translation>
<translation id="5949068186379578553">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید</translation>
<translation id="4805806622840861220">‏اجرای مجدد Growser</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="1742948938503172561">‏سفارشی کردن نمایه جدید Growser</translation>
<translation id="2430807206104224491">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم Growser وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="4805865169608137960">‏برای برداشتن «حساب Growser» خود از Growser، در صفحه «تنظیمات» از سیستم Growser خارج شوید</translation>
<translation id="1651639704310627074">‏بعداً Growser می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="2585240446624043880">‏Growser نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="8414435293910785169">‏با Growser در iOS، ابزارهای هوشواره Growser دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="2339258256897053758">‏کلیدهای Growser API وجود ندارند. برخی از عملکردهای Growser از کار خواهند افتاد.</translation>
<translation id="8926637909431618259">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Growser بسته می‌شود</translation>
<translation id="518125528057094977">‏Growser قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="8652321858775514885">‏وقتی همه پنجره‌های Growser را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Growser وارد شده باشید از «حساب Growser» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="TOP"/> بالا</translation>
<translation id="7261356974224431851">‏داده‌های Growser در حساب شما</translation>
<translation id="6610330853796830621">‏از گذرواژه‌هایتان با Growser در تلفنتان استفاده کنید</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="2297290224191497273">‏به نمایه Growser موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="2491221873705777076">‏«مرور ایمن پیشرفته» را با Growser در تلفنتان گسترش دهید</translation>
<translation id="7304389940068374923">‏درحال شخصی‌سازی Growser…</translation>
<translation id="5853262807109651878">‏این کار <ph name="ITEMS_COUNT"/> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="2024972335338126423">‏با <ph name="SHORTCUT"/> می‌توانید بین نمایه‌های Growser جابه‌جا شوید</translation>
<translation id="8703492925273919597">‏لطفاً همه پنجره‌های Growser را ببندید و دوباره سعی کنید.</translation>
<translation id="599091950194451698">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید</translation>
<translation id="1447863765638888625">‏‫<ph name="EXISTING_USER"/> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید.</translation>
<translation id="7624624622436403494">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر Growser در دستگاه‌های همراه</translation>
<translation id="8478154085901340543">‏یادآور: بهترین ویژگی‌های ایمنی Growser در جیب شما</translation>
<translation id="8981774130895723211">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید.</translation>
<translation id="2981961446160697133">‏محافظت بهبودیافته، بهینه‌سازی جاوا اسکریپت را برای سایت‌هایی که Growser آن‌ها را نمی‌شناسد، خاموش می‌کند</translation>
<translation id="3597003331831379823">راه‌اندازی با امتیازهای عالی اجرا نشد. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="4167284810587724062">‏ورود به سیستم Growser</translation>
<translation id="3066805437003400520">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="1128485277465085828">‏استفاده از <ph name="BEGIN_LINK"/>گذرعبارت خودتان<ph name="END_LINK"/> برای رمزگذاری همه داده‌های Growser موجود در «حساب Growser» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Growser همگام‌سازی نخواهد شد.</translation>
<translation id="1807774211756215222">‏باز کردن پیوند در &amp;برگه جدید Growser</translation>
<translation id="387105482057676379">‏برای شخصی‌سازی و اهداف بیشتر، Growser و دیگر سرویس‌های Growser را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="3867175562099983425">‏مدیریت نمایه‌های Growser</translation>
<translation id="308146532933302843">‏ببینید چرا Growser برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="2189149060536531804">‏اگر موردی نیاز به بررسی داشته باشد، Growser به شما اطلاع می‌دهد</translation>
<translation id="6324134303015966238">‏‫Growser صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="4815742196440583661">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Growser ویژه iOS را بارگیری کنید، و به سیستم «حساب Growser» وارد شوید</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="6899774208752247219"><ph name="PAGE_TITLE"/> - Growser Origin</translation>
<translation id="1118754729376002185">‏‫Growser برای این سایت به اجازه شبکه محلی نیاز دارد</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="6315734375101223238">‏Growser را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="7130675370997202556">‏برای باز کردن Growser و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="4920958997042285125">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه Growser وارد شده است. برای جدا نگه داشتن مرور، Growser می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="8744239658215739511">‏سفارشی‌سازی Growser</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="8090497651549769448">‏Growser می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4256965182800026277">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Growser» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Growser، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="4194619960643453552">‏ببینید Growser چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="3967822245660637423">بارگیری کامل شد</translation>
<translation id="1486377520191913768">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Growser چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="1311808042904310985">‏درباره Growser for Testing</translation>
<translation id="1152920704813762236">‏درباره ChromeOS</translation>
<translation id="8282895427217902177">‏وقتی‌که از سایتی بازدید می‌کنید، Growser بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK"/>مرور ایمن Growser<ph name="END_LINK"/> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="4016217212818346953">با «مدیر گذرواژه» ایمن بمانید</translation>
<translation id="3703994572283698466">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS"/>محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS"/> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">‏پیوندها را از هر برنامه‌ای در Growser باز کنید. همچنین برای دسترسی آسان، Growser به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="6056473803837713617">‏با گزارش <ph name="BEGIN_LINK"/>تنظیمات کنونی<ph name="END_LINK"/>، به بهتر شدن Growser کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="6217792792122501564">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="5794951150713244901">‏رفتن به صفحه «درباره Growser»</translation>
<translation id="10925962326134232">‏با سفارشی‌سازی Growser، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="6596295505984504022">‏سفارشی‌سازی Growser</translation>
<translation id="4148957013307229264">درحال نصب…</translation>
<translation id="5011704081781303429">‏<ph name="PAGE_TITLE"/> - ورود به سیستم شبکه - Growser Origin</translation>
<translation id="2871190378186459992">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Growser را کشف کنید.</translation>
<translation id="462105622535258178">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="6670140629169983459">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه Growser بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS"/> به سیستم وارد شده‌اید</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="1853997773668795891">‏داده‌های Growser به این حساب مرتبط شود؟</translation>
<translation id="4732930052828648898">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Growser قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Growser را رد کنید.</translation>
<translation id="2201661640076600072">‏خروج از سیستم Growser</translation>
<translation id="3262506503470845422">‏دریافت کمک برای Growser</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="7691786510374174420">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Growser در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="6368144843345980623">‏صادر کردن گذرواژه‌ها از Growser</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334241893986177674">جستجو کردن این نماگرفت</translation>
<translation id="242356249838681145">‏راه‌اندازی Growser هنگام شروع Windows</translation>
<translation id="4400772909124543403">به‌روزرسانی دردسترس نیست</translation>
<translation id="9183662282810237335">‏درهرصورت از Growser خارج می‌شوید؟</translation>
<translation id="4413205837991854510">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="4065288863231444640">‏اجازه به Growser برای اجرا در پس‌زمینه</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}one{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}other{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">‏سفارشی کردن و کنترل Growser</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413">‏‫<ph name="MANAGER"/> ‏Growser را مدیریت می‌کند</translation>
<translation id="3579012341787637143">‏افزودن نمایه Growser</translation>
<translation id="6786534271003695094">‏درباره Growser for Testing</translation>
<translation id="526235294307144732">‏برای ذخیره کردن داده‌های Growser در «حساب Growser» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="8594994021633965927">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Growser توصیه می‌کند آن را حذف کنید.</translation>
<translation id="770557926599450702">‏به Growser Origin خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="137732229629632648">‏‫Growser برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="5036046007335188949">‏قبلاً با <ph name="USER_EMAIL_ADDRESS"/> در نمایه Growser دیگری به سیستم وارد شده‌اید</translation>
<translation id="1878185978731985193">‏‫Growser صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK"/>درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
<translation id="8669339108356170796">‏‫Growser این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="7583343841997441047">‏«لنز Growser» را با Growser در تلفنتان امتحان کنید</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="7776200949522126045">‏برنامه‌های Growser Origin</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4970880042055371251">‏نسخه ChromeOS</translation>
<translation id="2182657378556811785">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Growser را راه‌اندازی مجدد کنید.</translation>
<translation id="6311668361877328515">‏سرعت سایت‌ها را با موتورV8 مرورگر Growser بالاتر می‌برد اما مقاومت Growser را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="7402642357351265733">‏اگر گزارش‌های استفاده از Growser را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="4673710618874938871">با <ph name="USER_NAME"/>، عضویت به سیستم وارد شدید. باز کردن منو حساب</translation>
<translation id="8142245354207161805">‏ظاهراً نمایه توسط فرایند Growser دیگری (<ph name="PROCESS_ID"/>) در رایانه‌ای دیگر (<ph name="HOST_NAME"/>) در حال استفاده است. Growser نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرایندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Growser را مجدداً راه‌اندازی کنید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="2014343159590733363">‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="2408746614080689238">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Growser» خود در Growser استفاده کنید. ‫<ph name="SHORTCUT"/> می‌تواند تنظیمات سرویس‌های Growser را تغییر دهد.</translation>
<translation id="847561904663814268">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST"/> به سیستم Growser در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Growser جدیدی ایجاد کنید.</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="3834935463915107022">‏درهرصورت از Growser خارج می‌شوید؟</translation>
<translation id="8668413672647811944">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Growser اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="4941816441131888792">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="COUNT"/> مورد دیگر را برداشت.</translation>
<translation id="844451748565342664">‏اگر «Gemini در Growser» باز باشد، پانل کناری هنگام ایجاد زبانه‌های جدید باز می‌ماند</translation>
<translation id="215320507915280336">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Growser استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Growser ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="2899369907387169108">‏استفاده از Growser بدون حساب</translation>
<translation id="1833893255023048385">‏قانون ترافیک ورودی برای Growser Origin جهت اجازه به ترافیک mDNS.</translation>
<translation id="711601904575862069">‏راه‌اندازی مجدد برای به‌روزرسانی Growser</translation>
<translation id="4918086044614829423">می‌پذیرم</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="8797356639448065696">‏Growser در حالت پس‌زمینه است.</translation>
<translation id="1895567721497166950">‏برای بستن کادر گفتگوی ورود به سیستم Growser، کلیک کنید</translation>
<translation id="2692971232706994729">‏با نمایه‌های Growser می‌توانید همه چیزهای مربوط به Growser را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="7406627712452599344">‏مهمان‌ها می توانند از Growser استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="844471735881341044">‏حساب شما در Growser</translation>
<translation id="5952898964075639679">‏افرودن خودتان به Growser</translation>
<translation id="504699503110800016">باز کردن منو سرریز</translation>
<translation id="4877750182157975795">‏با Growser در <ph name="DEVICE_TYPE"/> خود، به همه موارد دلخواه Growser دسترسی پیدا کنید</translation>
<translation id="1204184037023366446">‏‫Growser برای ردیابی کردن دست‌های شما به اجازه نیاز دارد</translation>
<translation id="5406591571925937375">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="PERMISSION_3"/> را برداشت.</translation>
<translation id="5174969993834422967">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان ارسال کند، روی نماد اعلان در گوشه چپ نوار نشانی کلیک کنید.</translation>
<translation id="5174983315706567306">فضای دیسک کافی نیست.</translation>
<translation id="8157129267754368853">‏حساب Growser به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="758175943316138760">‏ادامه کار را دقیقاً از همان جایی که در Growser روی iOS متوقف کرده بودید، از سر بگیرید.</translation>
<translation id="6234515504547364178">‏خروج از سیستم Growser</translation>
<translation id="5234764350956374838">بستن</translation>
<translation id="7690383309583926074">‏برای ذخیره کردن گذرواژه‌ها درحرکت، برنامه Growser را دریافت کنید</translation>
<translation id="8586264863973514035">‏برای اعمال تغییراتتان، Growser را راه‌اندازی مجدد کنید</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>
<translation id="7264453786974905915">‏دریافت برنامه Growser</translation>
<translation id="6944930779012811739">‏سرویس داخلی به‌روزرسان Growser</translation>
<translation id="6214255602211289863">‏از آن‌ها در کنار دیگر ویژگی‌های Gemini در Growser استفاده کنید</translation>
<translation id="5346389065299425353">جستجویتان را با افزودن چند زبانه، فایل، و ابزار عمیق‌تر کنید</translation>
<translation id="4672413209491548018">‏با «Gemini در Growser»، مروری کوتاه از این سند دریافت کنید و سؤال بپرسید</translation>
<translation id="7573068992266397941">‏Growser چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="8174413867995118050">‏دیگر نمایه‌های Growser</translation>
<translation id="1659922362001329844">‏‫ChromeOS نتوانست داده‌های Growser را در «حساب Growser» شما ذخیره کند زیرا جزئیات ورود به سیستم حسابتان به‌روز نیست</translation>
<translation id="7708394612738038097">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Growser خود را می‌دهید. داده‌های Growser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Growser حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE"/>.</translation>
<translation id="2487133103111559902">‏برای گرفتن شخصی‌سازی‌ها، Growser را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="5154625106151193600">‏ببینید چرا Growser برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="1786715389543715322">‏درحال به‌روزرسانی Growser (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="7021823858304886493">‏مجاز کردن ورود به سیستم Growser</translation>
<translation id="5267531627648004734">‏حذف از Growser</translation>
<translation id="4620757336635063467">‏عملکرد را کاهش می‌دهد اما Growser را دربرابر حملات مقاوم‌تر می‌کند</translation>
<translation id="239760341987199724">‏تنظیم Growser به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="5165277482382778404"><ph name="PAGE_TITLE"/> - Growser Origin Beta</translation>
<translation id="604223321106006231">{NUM_TABS,plural, =1{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Growser توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="894936507076470937">‏Growser ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="2596557398669145729">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="1744365871163268756">‏وقتی Growser جدیدترین به‌روزرسانی‌های سیستم را نصب می‌کند، لطفاً صبر کنید.</translation>
<translation id="3861679447659630159">‏Growser می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8535558155562097643">‏با Growser، در حرکت، به‌صورت یکپارچه با برنامه‌های موردعلاقه‌تان مانند Google Drive و YouTube کار کنید.</translation>
<translation id="5524890928877629608">‏گوشه بالا سمت راست ناحیه جستجو: ‎٪<ph name="LEFT"/> سمت راست، ‎٪<ph name="TOP"/> بالا</translation>
<translation id="232381795826373334">‏باز کردن فایل‌های PDF در Growser</translation>
<translation id="5536164441519929134">درباره این زبانه<ph name="LINE_BREAK"/>بپرسید</translation>
<translation id="3940190010522469883">‏برای حفظ امنیت، وقتی برای اولین‌بار از سایتی بازدید می‌کنید، Growser «بهینه‌سازی جاوا اسکریپت» را خاموش می‌کند.

اگر این صفحه طبق انتظار کار نمی‌کند، «بهینه‌سازی» را مجاز کنید.</translation>
<translation id="7074160267408082133">‏نشان دادن «Gemini در Growser» در نوار منو Mac و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="2938507901464407819">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین اطلاعات ذخیره‌شده و اطلاعات دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="5579324208890605088">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش کاربر معمولی اجرا کنید، نه با نقش سرپرست.</translation>
<translation id="3588973534877826647">‏استفاده کردن از Growser به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن</translation>
<translation id="5596627076506792578">گزینه‌های بیشتر</translation>
<translation id="5605834417512968703">هرچیزی را که می‌خواهید برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید «گریز» را فشار دهید</translation>
<translation id="5618818588972826921">‏نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید Escape را فشار دهید</translation>
<translation id="1026406809507858026">{0,plural, =0{‏به‌روزرسانی Growser دردسترس است}=1{‏به‌روزرسانی Growser دردسترس است}one{‏به‌روزرسانی Growser از # روز پیش دردسترس است}other{‏به‌روزرسانی Growser از # روز پیش دردسترس است}}</translation>
