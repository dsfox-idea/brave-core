<translation id="5646769069113654257">‏لطفاً اکنون Growser را بازراه‌اندازی کنید</translation>
<translation id="3117204675033805491">Dmitry Golubnichiy</translation>
<translation id="2335583906071111058">‏نمایش Growser به این زبان</translation>
<translation id="569897634095159764">اتصال به اینترنت برقرار نشد. سرور پروکسی به اصالت‌سنجی نیاز دارد.</translation>
<translation id="1834213228893578875">‏‫Growser حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌های فعال و سایر برنامه‌ها اختصاص داده می‌شود و سرعت بالای Growser حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی حافظه» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="899523323751802352">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، داده‌های Growser ذخیره‌شده در حسابتان را <ph name="SETTINGS_LINK"/></translation>
<translation id="82926023981336111">‏‫Growser را سفارشی‌سازی و کنترل کنید. ‫Growser را به‌عنوان مرورگر پیش‌فرض تنظیم کنید.</translation>
<translation id="5660546041996455312">‏با تعیین Growser به‌عنوان مرورگر پیش‌فرض، گذرواژه‌ها، نشانک‌ها و سابقه مرورتان را کاملاً در همه دستگاه‌ها همگام‌سازی کنید.</translation>
<translation id="5809516625706423866">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۱ مجاز نیست. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="95980832839683236">‏با این کار سرعت سایت‌ها با موتور Growser نسخه ۸ بالاتر می‌رود اما مقاومت Growser دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم خاموش است.</translation>
<translation id="1224606669200461217">‏برای استفاده و ذخیره کردن داده‌های Growser در «حساب Growser» خود، Growser را به‌روز کنید</translation>
<translation id="5824893331272123205">این پانل بارگیری نشد، دوباره امتحان کنید</translation>
<translation id="4467664627714200493">‏به Growser Origin خوش آمدید</translation>
<translation id="4026807082142463673">‏ویژگی‌های اضافی را روشن می‌کند تا قدرتمندترین محافظت‌های Growser را ارائه دهد</translation>
<translation id="5871205389137001634">برای خارج شدن از «جستجوی تصویر»، کلیک کنید</translation>
<translation id="8054200348483755053">‏Growser متوجه شده است که این موارد حاوی بدافزار هستند:</translation>
<translation id="3955583201925082436">‏Growser به‌طور منظم بررسی می‌کند تا مطمئن شود مرورگرتان ایمن‌ترین تنظیمات را دارد. اگر موردی به بازبینی شما نیاز داشته باشد، به شما اطلاع خواهیم داد.</translation>
