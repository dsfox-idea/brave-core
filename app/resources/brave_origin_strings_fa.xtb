<translation id="7861579472672677409">‏<ph name="EXTENSION_NAME"/> به Growser اضافه شد</translation>
<translation id="5849446944780602366">‏سفارشی کردن و کنترل Growser. به‌روزرسانی‌ دردسترس است.</translation>
<translation id="5711722515923392428">‏روشن • Growser نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="6355366566986893068">‏حساب شما در Growser</translation>
<translation id="7433698744896946664">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار Growser</translation>
<translation id="4168372721886011198">‏<ph name="FILE_NAME"/> خطرناک است، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="991182453936521413">‏Growser به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="4060970194201477024">‏می‌توانید در اینجا بین نمایه‌های Growser جابه‌جا شوید</translation>
<translation id="7815000350132166985">‏اگر کوکی‌ها را مجاز کنید، ممکن است Growser از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="5739368447874065758">‏داده‌های Growser ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="6685697979743742605">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK"/>اگر گذرواژه را ارائه دهید، Growser می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن Growser» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="4368341489795135329">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME"/> به سیستم Growser وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="8320964054148936490">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Growser است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Growser را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="3574823187131579180">{0,plural, =0{‏Growser هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Growser ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Growser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Growser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="5980269616827212166">‏Growser برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="7651600795135059130">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Growser ذخیره شده است مقایسه می‌کند</translation>
<translation id="5019879183386042809">‏Growser  مرورگر پیش‌فرض شود</translation>
<translation id="6248988683584659830">تنظیمات جستجو</translation>
<translation id="1481716298194191711">‏با برنامه Growser در تلفنتان، بهترین ویژگی‌های ایمنی Growser را درحال حرکت دریافت کنید</translation>
<translation id="7445061995866044926">‏از Growser خارج می‌شوید؟</translation>
<translation id="4659866260728515512">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Growser آن‌ها را غیرفعال کند.</translation>
<translation id="6806912298071949921">‏سفارشی کردن نمایه Growser</translation>
<translation id="3792238845239580301">‏نام‌گذاری نمایه Growser</translation>
<translation id="5874208157501051620">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Growser وارد شوید</translation>
<translation id="3561569806301739367">‏<ph name="FILE_NAME"/> ممکن است خطرناک باشد، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="3205074487970075628">‏Growser درحال استفاده از دوربین شما است.</translation>
<translation id="1819119299840995223">‏عملیات دیگری در Growser درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="8616874628011103667">‏اکنون استفاده از Growser با حساب Growser شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="5213389303624223677">‏با تنظیم کردن Growser به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="4264606872840545968">‏میان‌بر Growser</translation>
<translation id="6890616081898535725">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="335632367599648646">‏آیا مطمئن هستید که می‌خواهید Growser را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="7920857181125123335">‏برای ادامه دادن، با حساب <ph name="EMAIL"/> به سیستم Growser وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="3256100650978957522">‏نشان‌واره Growser درون صفحه‌نمایش رایانه.</translation>
<translation id="5880764554173582719">‏‫Growser Origin یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Growser Origin، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="4091049150278654573">‏برای اینکه مطمئن شوید همیشه می‌توانید از داده‌های Growser در «حساب Growser» خود استفاده کنید و آن‌ها را ذخیره کنید، هویتتان را درستی‌سنجی کنید</translation>
<translation id="2532326772258858491">‏‫Growser سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="2139300032719313227">‏بازراه‌اندازی ChromeOS</translation>
<translation id="638302211119176182">‏‫Growser صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="7167975344637731051">‏با بارگیری Growser در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="890319829408077946">‏خاموش • Growser نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="1684121725014454063">‏به نمایه‌های Growser خوش‌آمدید</translation>
<translation id="8211983866539058675">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="7906693299331092358">‏برداشتن حساب از Growser</translation>
<translation id="2675662665675552980">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Growser نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="5590013613412457132">‏حذف نصب Growser </translation>
<translation id="7185585387858242335">‏میان‌برها در Growser باز می‌شود</translation>
<translation id="3617744907966785605">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="8646609321956191980">‏هرکدام از نمایه‌ها دارای اطلاعات Growser مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6756656512757374876">‏درباره اینکه <ph name="BEGIN_LINK"/>Growser چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK"/> بیشتر بدانید</translation>
<translation id="3556601443414636547">‏پس‌از بازراه‌اندازی Growser، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="3396870972301571614">‏افزونه‌هایتان را با کلیک کردن روی «افزونه‌ها» در منوِ اصلی Growser مدیریت کنید.</translation>
<translation id="2535436634051789953">‏برای دیدن گذرواژه‌های نمایه Growser دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="6376474391582629025">‏برای داشتن بهترین ابزارهای هوشواره درحرکت، از برنامه Growser استفاده کنید</translation>
<translation id="2312399718665761438">‏برای رفع خطاهای املائی، Growser نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Growser ارسال می‌کند</translation>
<translation id="3507835409099344374">‏رفتن به تنظیمات اعلان Growser</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="9156965752763025780">‏دفعه بعدی که Growser را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="3387992981600748596">‏اکنون Growser با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="3119017564683030312">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="245693535809364497">‏Growser برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="9210457680074341078">‏اگر نشانک‌ها را در «حساب Growser» هم ذخیره کنید، می‌توانید قیمت محصولات را در Growser پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="1363996462118479832">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="4694512973195649124">‏برداشتن داده‌های این برنامه از Growser</translation>
<translation id="1257247502847251159">‏Growser برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="1489465648257900784">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Growser است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Growser استفاده کنید.</translation>
<translation id="1505112054322049777">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Growser را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Growser اضافه کنید</translation>
<translation id="6666624454809779082">‏Growser از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="5848830584656405219">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="4020203987234748583">‏با این کار سرعت سایت‌ها با موتور Growser نسخه ۸ بالاتر می‌رود اما مقاومت Growser دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="3848421741245997269">{count,plural, =1{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="3136039682492230890">‏Growser توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="1547295885616600893">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی ممکن شده است.</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="8211837073776713955">‏Growser می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME"/> در فهرست مجازها باشد.</translation>
<translation id="8237613041998823669">Growser Origin - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="3028928628792374067">‏Growser متوجه شده است که «<ph name="EXTENSION_NAME"/>» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="BOTTOM"/> پایین</translation>
<translation id="6896758677409633944">کپی کردن</translation>
<translation id="6898028264630240901">می‌توانید «تکالیف بافتاری» را سنجاق کنید تا هنگام مرور کردن به‌راحتی سؤالات خود را بپرسید</translation>
<translation id="862687584320433626">‏‫Growser را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="1991562568473125499">‏مدیریت نمایه‌های Growser</translation>
<translation id="6995921847081718550">‏این کنش:
          <ph name="LINE_BREAKS"/>
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK"/>
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK"/>
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK"/>
            • میان‌برهای Growser را بازنشانی می‌کند
            <ph name="LINE_BREAKS"/>
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="5529781826378237601">‏به حداکثر تعداد نشانک‌های Growser (<ph name="BOOKMARK_LIMIT"/>) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Growser» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="3453763134178591239">‏شرایط ChromeOS</translation>
<translation id="6643520655691573653">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="280382502853897110">‏Growser را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="1705567146636171298">‏به‌روزرسانی Growser</translation>
<translation id="5499063270485366718">‏اگر تصویری توضیح مفیدی نداشته باشد، Growser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Growser ارسال می‌شود.</translation>
<translation id="1196733835766994012">‏هنگام استفاده از برنامه Growser در <ph name="DEVICE_TYPE"/>، قدرت هوشواره را تجربه کنید</translation>
<translation id="7166289504510860270">‏با برنامه Growser در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="5966368554860795750">‏سفارشی‌سازی Growser for Testing</translation>
<translation id="792838367208896130">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Growser باز کنید</translation>
<translation id="375314543563594498">‏حذف <ph name="EXTENSION_NAME"/> از Growser</translation>
<translation id="2332301637111071062">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="1008530050039597147">‏Growser برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="1197672524850678392">‏Growser راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="5020151688261063547">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در Growser» بپرسید</translation>
<translation id="3625983487600668413">‏‫Growser را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="5755581833598928580">‏از Growser برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="7216228761061470870">‏وقتی در رایانه از «جستجوی تصویر» استفاده می‌کنید، عنوان صفحه، نشانی وب، و محتوا ازجمله فایل‌های PDF به سرور ارسال می‌شود.</translation>
<translation id="5516268345616100622">‏مدیر وظایف - Growser</translation>
<translation id="2416155625082200759">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="1871621397473741084">‏مرور را فوراً شروع کنید: اکنون Growser می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{‏Growser توصیه می‌کند آن را بردارید}one{‏Growser توصیه می‌کند آن را بردارید}other{‏Growser توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="4600669988724328687">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Growser مجاز کنید. سپس باید Growser را بازراه‌اندازی کنید.</translation>
<translation id="1864557848095568223">‏در حال به‌روزرسانی Growser</translation>
<translation id="3403365884036456766">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
Growser قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="3511996232906761537">‏وب، نشانک‌ها و موارد دیگر Growser شما در اینجا هستند.</translation>
<translation id="1754899895078387289">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Growser ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK"/>داده‌های Growser ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/>.</translation>
<translation id="5380963249588143069">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME"/> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Growser را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="6085660187823915017">‏برای دریافت به‌روزرسانی‌های بعدی Growser، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="2865744782251083875">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/> و <ph name="PERMISSION_2"/> را برداشت.</translation>
<translation id="3871306442916198768">‏نمایش «Gemini در Growser» در سینی سیستم</translation>
<translation id="4104934885375476361">‏‫Growser اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="7951152294775418909">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="3191314862567596053">‏وارد کردن گذرواژه‌ها به Growser</translation>
<translation id="284799389314308801">‏۱. روی <ph name="BUTTON_LABEL"/> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2"/> در تنظیمات Windows کلیک کنید
۳. روی <ph name="BUTTON_3"/> در اعلان Windows کلیک کنید تا Growser را برای دسترسی سریع به نوار وظیفه سنجاق کنید</translation>
<translation id="4864311514218370796"><ph name="PAGE_TITLE"/> - Growser Origin Dev</translation>
<translation id="7450541714075000668">نوشتار کپی شد</translation>
<translation id="7129342855140808694">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="5296583608321648908">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="3962395975456095331">‏Growser راه‌اندازی مجدد شود؟</translation>
<translation id="2619516027171717873">‏نمی‌توانید Growser دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً Growser را ببندید و دوباره سعی کنید.</translation>
<translation id="6607863494375614497">‏یادآور: بهترین‌های Growser در جیب شما</translation>
<translation id="5337027666828618338">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Growser را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Growser وارد شده باشید از «حساب Growser» خارج نخواهید شد.</translation>
<translation id="3186363903915641692">{0,plural, =1{‏Growser ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏Growser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏Growser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="552342471964912391">‏برای محافظت از داده‌هایتان، به Growser اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="3826701455067637694">‏برای شروع فوری مرور، Growser را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME"/></translation>
<translation id="3293668930608086049">‏Growser درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="2827121003398607864">‏Growser اکنون بهتر شده است</translation>
<translation id="3071313329776323836">‏اکنون ویژگی‌های بیشتری در Growser دردسترس شما قرار دارد</translation>
<translation id="7624307931717240213">ما از اطلاعات برای بهبود این سرویس استفاده می‌کنیم. به «خط‌مشی رازداری» و «شرایط خدمات» مراجعه کنید.</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="222435847253721602">‏دریافت برنامه Growser</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="3343095737966473035">‏Growser مرورگر پیش‌فرض شما نیست</translation>
<translation id="5477319665405831211">‏Growser را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="2339273275658335597">‏به‌روزرسانی Growser</translation>
<translation id="4870714623113535320">‏کارهای شما در Growser ایمن است</translation>
<translation id="7716950018788545737">تکلیف(ها) پایان یافت.</translation>
<translation id="77283119132245232">سرویس‌های ردیابی سیستم را برای <ph name="BROWSER_NAME"/> ارائه می‌دهد. اگر این سرویس غیرفعال باشد، ردیابی‌های عملکردی که مرورگر ایجاد می‌کند شامل رویدادهای در سطح سیستم مانند رویدادهای تغییر زمینه و آماده‌سازی رشته نخواهد بود.</translation>
<translation id="4784414698887946907">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="8543787950557226450">‏بازنشانی به Growser پیش‌فرض</translation>
<translation id="4859382825808018797">‏برای حفظ امنیت کارهای شما در Growser، سازمان‌تان می‌تواند اطلاعات خاصی را هنگام ورود به سیستم Growser مشاهده یا مدیریت کند.</translation>
<translation id="4976450819672499783">‏‫Growser را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="1978509466033734608">‏سرعت Growser را افزایش دهید</translation>
<translation id="8607348724092473027"><ph name="PAGE_TITLE"/> - Growser Origin Canary</translation>
<translation id="2684504034454188774">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Growser برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="7810005234485217901">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید</translation>
<translation id="1652855885539187849">‏درحال‌حاضر یک نمایه Growser با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="7397737266068428588">‏موتور جستجوی شما از خارج‌از Growser تغییر کرد. برای محافظت از شما، Growser آن را به پیش‌فرض اصلی‌اش بازنشانی کرد. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="9148690296223500734">‏با سفارشی‌سازی Growser، ظاهری جدید به آن ببخشید</translation>
<translation id="7963515534397191222">‏Growser به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS"/> ثانیه باقی مانده است</translation>
<translation id="5545136190679883344">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK"/>داده‌های Growser ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/></translation>
<translation id="9044562649276955255">‏هر زمان که نیاز داشتید، «Gemini در Growser» به‌سرعت باز می‌شود</translation>
<translation id="5687542525349822727">‏تنظیم Growser به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="6396151137840491551">‏‫Growser اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="2925193881330501265">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم Growser شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="3744141798014187630">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین نشانک‌ها و اطلاعات دیگر در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="6915252145142862992">‏این نصب ثانویه Growser است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="7766756101194440006">‏با برنامه Growser در <ph name="DEVICE_TYPE"/>، بیشترین بهره را از Growser ببرید</translation>
<translation id="8004582292198964060">مرورگر</translation>
<translation id="8010081455002666927">شناسایی خودکار</translation>
<translation id="7685904775439037072">‏وقتی Growser دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="3230755314472063687">‏‫Growser را به نوار وظیفه سنجاق کنید تا هرزمان خواستید سریع‌تر به آن دسترسی داشته باشید</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="8054112667659782652">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="8069447462453318634">«سنجاق کردن به نوارابزار» را انتخاب کنید</translation>
<translation id="6175141682081019059">‏غیرفعال کردن اجرای Growser در پس‌زمینه برای برنامه‌ها</translation>
<translation id="80790299200510644">جستجوی تصویر</translation>
<translation id="8086881907087796310">نصب انجام نشد زیرا رایانه شما با حداقل شرایط سخت‌افزاری مطابقت ندارد.</translation>
<translation id="5528402763209637578"><ph name="PAGE_TITLE"/> - Growser Origin for Testing</translation>
<translation id="2061155704815580583">‏Growser برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="3576319845915562805">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای فعال کردن هشدارهای ردگیری قیمت خواهید دید.</translation>
<translation id="3728025339793417202">‏با برنامه Growser در تلفنتان، برای کالاهایی که به آن‌ها علاقه‌مندید هشدار کاهش قیمت دریافت کنید</translation>
<translation id="8118331347066725040">درباره جستجو با «لنز»، بازخورد ارسال کنید</translation>
<translation id="4449306641116952869">‏‫Growser را مخصوص خودتان کنید</translation>
<translation id="5334309298019785904">‏ChromeOS نتوانست داده‌هایتان را همگام‌سازی کند زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="5775051495647233404">‏‫«Gemini در Growser» را با میان‌بر صفحه‌کلید باز کنید.</translation>
<translation id="1081849497974110565">‏شرایط خدمات تکمیلی Growser</translation>
<translation id="9067428552314418522">‏این فایل خطرناک است، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="8177472873527554730">محتوای موردنظر در صفحه پیدا نشد</translation>
<translation id="6219250889396046657">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="8221491193165283816">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان بفرستد، اینجا را کلیک کنید.</translation>
<translation id="8377926237617998195">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="1755067029031059271">‏‫Growser نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="8207657266087451193">‏اگر تصویری توضیح مفیدی نداشته باشد، Growser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Growser ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="7792526144795244436">‏در نمایه جدید به سیستم Growser وارد می‌شوید؟</translation>
<translation id="784788600549915416">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین گذرواژه‌ها و اطلاعات دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="183102473074922918">‏نشان دادن «Gemini در Growser» در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="976541154724186511">‏‫Growser درباره سایت‌ها و بارگیری‌های ناامن <ph name="BEGIN_LINK"/>به شما هشدار می‌دهد<ph name="END_LINK"/></translation>
<translation id="8060549744348950090">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION"/> را برداشت.</translation>
<translation id="7402663241490331652">‏در برنامه Growser ویژه iOS، با دوربینتان آنچه را می‌بینید بخرید، ترجمه کنید، و شناسایی کنید</translation>
<translation id="4470171586042711152">‏رمزینه پاسخ‌سریع برای ورود به سیستم Growser با <ph name="USER_NAME"/></translation>
<translation id="8313851650939857356">خطای راه‌اندازی: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="6098476632210317894">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="8321888067342493336">ذخیره کردن به‌عنوان تصویر</translation>
<translation id="2591326305549412656">‏<ph name="USER_EMAIL_ADDRESS"/> قبلاً از Growser استفاده می‌کرد</translation>
<translation id="6771602601399828881">‏فعال کردن «مهارت‌ها» در Growser</translation>
<translation id="5592122595094519401">‏برای ادامه استفاده از داده‌های Growser ذخیره‌شده در «حساب Growser» خود (<ph name="ACCOUNT_EMAIL"/>)،‏ Growser را به‌روز کنید</translation>
<translation id="2569754604093464025">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="8362914115861174987">ترجمه به</translation>
<translation id="8367705492654390392">هرچه می‌خواهید بپرسید</translation>
<translation id="7296197595428914424">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="9098234372282930719">‏سپس باید Growser را بازراه‌اندازی کنید.</translation>
<translation id="1327729221471951979">‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="8577108764439626300">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="4234753748520037091">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را تأیید کند. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="5337999052834672687">{0,plural, =1{‏Growser را ظرف یک روز راه‌اندازی مجدد کنید}one{‏Growser را ظرف # روز راه‌اندازی مجدد کنید}other{‏Growser را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="8438543370129609977">‏وقتی از «جستجوی تصویر» استفاده می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="2936579431423833666">‏درباره جستجو کردن با «جستجوی تصویر» در Growser بیشتر بدانید</translation>
<translation id="6914496861676471566">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً Growser را دوباره را بارگیری کنید.</translation>
<translation id="4378573854226202617">‏Growser به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="6431861494713261006">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Growser، به بهبود ویژگی‌ها و عملکرد ChromeOS کمک کنید.</translation>
<translation id="8691137711639873980">‏برای ذخیره کردن داده‌های Growser در «حساب Growser» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="3251012123600267109">‏پیام‌واره‌های ورود به سیستم Growser را نشان می‌دهد</translation>
<translation id="2097604701283463988">‏نسخه Growser قدیمی است</translation>
<translation id="6080203201796279095">‏از اینکه Growser را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="871233388178581868">‏‫Growser زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="8525579356836940628">نصب متوقف شد</translation>
<translation id="909104880763805392">‏با برنامه Growser در<ph name="DEVICE_TYPE"/>، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحرکت همراه خود داشته باشید</translation>
<translation id="3667461919057407535">‏اگر Growser یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="7998982887712810347">‏برخی‌از ویژگی‌ها و افزونه‌های Growser دارای میان‌بر هستند. می‌توانید انتخاب کنید که آن‌ها را دوباره روشن کنید.</translation>
<translation id="8556420416730706394">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
<translation id="856656450041460113">جستجوی فهرست زبان‌ها</translation>
<translation id="839677568225616901">‏چندین سازمان Growser را مدیریت می‌کنند</translation>
<translation id="8121009781989288430">‏حق نشر <ph name="YEAR"/> نویسندگان Growser. کلیه حقوق محفوظ است.</translation>
<translation id="8601359445272098721">جدید! با انتخاب دکمه «ترجمه کردن صفحه‌نمایش»، می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="3052349005266761501">‏درحال راه‌اندازی Growser…</translation>
<translation id="8624541899164515475">«تنظیمات»، در زبانه جدیدی باز می‌شود.</translation>
<translation id="5128665650717824082">‏نمی‌توان Growser for Testing را به‌عنوان مرورگر پیش‌فرض تنظیم کرد.</translation>
<translation id="2433912322225810055">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Growser یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="4100716194836114130">‏این Growser شماست</translation>
<translation id="8712637175834984815">متوجه شدم</translation>
<translation id="1419543648228375718">‏به سیستم Growser وارد می‌شوید؟</translation>
<translation id="8747073452963259673">‏گوشه پایین سمت راست ناحیه جستجو: ‎٪<ph name="LEFT"/> سمت راست، ‎٪<ph name="BOTTOM"/> پایین</translation>
<translation id="878572486461146056">خطای نصب: سرپرست شبکه شما «خط‌مشی گروهی» اعمال کرده است که از نصب جلوگیری می‌کند: <ph name="INSTALL_ERROR"/></translation>
<translation id="8813277370772331957">بعداً به من یادآوری شود</translation>
<translation id="1588296410638341457">‏این سند را با «Gemini در Growser» هم‌رسانی کنید تا مرور کوتاهی از آن داشته باشید و سؤالات تعقیبی بپرسید</translation>
<translation id="64216977793816291">‏به سیستم Growser وارد می‌شوید؟</translation>
<translation id="7447364954121496869">‏تنظیم کردن Growser به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="6933858244219479645">‏سیستم ChromeOS</translation>
<translation id="9084132286318231275">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Growser استفاده می‌شود</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="7289323009146924152">‏افزودن نمایه Growser</translation>
<translation id="2922281028449999368">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های Growser را در «حساب Growser» شما ذخیره کند</translation>
<translation id="1150745254876977823">‏سازمانتان شما را ملزم می‌کند به سیستم Growser وارد شوید</translation>
<translation id="8285294305439559616">‏Growser در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="4684884244620579559">‏‫Growser دیگر مرورگر پیش‌فرض شما نیست. Growser  مرورگر پیش‌فرض شود</translation>
<translation id="6389268239133412586">‏به‌روزرسانی Growser امکان‌پذیر نیست</translation>
<translation id="8944232836376404813">این کنش:
          <ph name="LINE_BREAKS"/>
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK"/>
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK"/>
            • کوکی‌ها و سایر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAKS"/>
            نشانک‌ها، سابقه و گذرواژه‌های ذخیره‌شده شما تحت تأثیر قرار نخواهند گرفت.</translation>
<translation id="7731184591599776500">‏نشان‌واره Growser Enterprise</translation>
<translation id="2001474182910589370">‏با برنامه Growser در <ph name="DEVICE_TYPE"/>، ایمنی Growser را درحرکت داشته باشید</translation>
<translation id="6500340165622970282">‏‫Growser شروع نشد، زیرا هنگام باز کردن نمایه‌تان مشکلی پیش آمد. ‫Growser را بازراه‌اندازی کنید.</translation>
<translation id="3424657754843264466">‏مدیریت نمایه‌های Growser</translation>
<translation id="9018218886431812662">نصب کامل شد</translation>
<translation id="82609232232243542">‏ورود به سیستم Growser</translation>
<translation id="7055223246119657449">‏‫Growser این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="8341362078156319636">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Growser، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید. ‫Growser برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="8965179855019347124">‏با برنامه Growser در تلفنتان از بهترین ابزارهای هوشواره Growser استفاده کنید</translation>
<translation id="9049928023195059068">‏ورود به سیستم Growser هنگام وارد شدن به سیستم دیگر سرویس‌های Growser</translation>
<translation id="4561046754724442504">‏Growser به‌طور خودکار بسته شد</translation>
<translation id="5173820533850252773">‏نسخه Growser قدیمی است</translation>
<translation id="310518206836658214">{0,plural, =1{‏Growser یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Growser # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Growser # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="9106236359747881194">نوشتاری را برای جستجو انتخاب کنید</translation>
<translation id="5190991181158966940">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="7863882214613921971">‏باز کردن پیوند در &amp;برگه جدید Growser</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9134482777260927479">کمک در تکالیف</translation>
<translation id="9148058034647219655">خارج شدن</translation>
<translation id="2792073155252170448">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser می‌تواند هربار که آن را بازراه‌اندازی می‌کنید، زبانه‌هایتان را بازگرداند. برای روشن کردن این ویژگی، به اینجا بروید:</translation>
<translation id="2444257125841652328">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Growser را پیکربندی کرده است.</translation>
<translation id="7902365066753170041">‏راه‌اندازی مجدد برای به‌روزرسانی Growser</translation>
<translation id="538146372587193686">‏Growser Origin‏ (mDNS ورودی)</translation>
<translation id="296137235951584143">‏شخصی‌سازی کردن Growser</translation>
<translation id="7977787072794666032">‏Growser ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="8462937515915443472">‏با Growser، بهترین ویژگی‌های ایمنی Growser را در حرکت دریافت کنید.</translation>
<translation id="945522503751344254">ارسال بازخورد</translation>
<translation id="4484434718272972655">‏چه‌کسی از Growser استفاده می‌کند؟</translation>
<translation id="7173394303099002355">‏دریافت قوی‌ترین امنیت Growser</translation>
<translation id="983803489796659991">نصب انجام نشد چون سرور به‌روزرسانی هیچ‌گونه داده درهمی برای برنامه ندارد.</translation>
<translation id="8435446479956716379">‏استفاده از Growser بدون حساب</translation>
<translation id="8992261409816268381">Growser Authors</translation>
<translation id="989970834842471429">نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید</translation>
<translation id="3146636448190445245">‏برای استفاده از مکان، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="137466361146087520">‏Google Chrome نسخه بتا</translation>
<translation id="7535429826459677826">‏Google Chrome نسخه Dev</translation>
<translation id="6283840329609797763">‏به دلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره Growser را بارگیری کنید.</translation>
<translation id="1743665722170667430">افزونه‌ها، برنامه‌ها و طرح‌های زمینه دریافتی از منابع ناشناخته می‌توانند به دستگاه شما آسیب بزنند. Growser توصیه می‌کند که آنها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> نصب کنید</translation>
<translation id="5840822070878669614">باز کردن فروشگاه وب</translation>
<translation id="6184592406110188164">این افزونه خط‌مشی فروشگاه وب را نقض می‌کند و ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما را در سایت هایی که بازدید می‌کنید، از جمله اطلاعات شخصی شما، ببیند و تغییر دهد.</translation>
<translation id="1299765473362724475">‏هشدار: Growser نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت خصوصی»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="1448049584457347995">‏برای ایمن‌تر کردن Growser، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="8848045066928358658">‏برای ایمن‌تر کردن Growser، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="4624945300945265642">‏باز کردن پیوند در پنجره &amp;ناشناس Growser</translation>
<translation id="1069969567644851798">لینک را در پنجرهٔ خصوصی Growser &amp;باز کنید</translation>
<translation id="6554952862405000915">‏باز کردن پیوند در پنجره &amp;ناشناس Growser</translation>
<translation id="8274659559228306809">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7347727235538318126">این امکان را به شما می‌دهد تا محتوا از Growser را به دستگاه‌های محلی خود، مثل تلویزیون یا بلندگو، به اشتراک بگذارید.</translation>
<translation id="3829358914761176693">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="552349673358711446">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1400696845469684552">{COUNT, plural,
              =0 {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید}
              =1 {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. پنجرهٔ خصوصی شما باز نخواهد شد.}
              other {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. # پنجرهٔ خصوصی شما باز نخواهد شد.}}</translation>
<translation id="5749154344207139683">با پاسخ به این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید تا حریم خصوصی را بهبود دهیم.</translation>
<translation id="79269250264141507">وقتی در نوار آدرس یا کادر جستجو تایپ می‌کنید، Growser آنچه را که تایپ می‌کنید به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادات بهتری دریافت کند. این قابلیت در حالت «خصوصی» خاموش است.</translation>
<translation id="2589970573128789862">Growser خصوصی</translation>
<translation id="5994282802285556682">هنگام مرور صفحات در حالت خصوصی، Growser قبل از بارگیری سایت با استفاده از اتصال ناامن به شما هشدار می‌دهد.</translation>
<translation id="4747339441562331861">‏با تنظیم کردن Growser به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید. ‫Growser برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="9068395155143628872">‏سنجش آگهی به سایت‌هایی که بازدید می‌کنید امکان می‌دهد اطلاعاتی را از Growser درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="7813580490378477695">‏‫<ph name="PARTNER_NAME"/> افزونه‌ای اضافه کرده است که ممکن است نحوه کارکرد Growser را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6204677860546245308">‏استفاده از تنظیمات مرورگر توصیه‌شده Growser</translation>
<translation id="1404026649028693342">همیشه نشان دادن «حالت هوشواره‌ای»</translation>
<translation id="1530633922026945685">‏Growser برای ایجاد نقشه سه‌بعدی محیط شما باید اجازه دسترسی به دوربین داشته باشد</translation>
<translation id="1680687534629375545">پرسیدن از «جستجوی تصویر» درباره این صفحه</translation>
<translation id="3643631442346149414">‏برای حفظ امنیت کارهای شما در Growser، سازمانتان می‌تواند اطلاعات خاصی را مشاهده یا مدیریت کند</translation>
<translation id="1898804291554630487">پرسش درباره این صفحه</translation>
<translation id="2066690553719545730">همیشه نشان دادن «حالت هوشواره‌ای»</translation>
<translation id="9095263438435683933">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم Growser وارد شوید.</translation>
<translation id="3225882094369124157">‏برنامه‌ای دیگر در رایانه شما یک زمینه اضافه کرده است که ممکن است نحوه کارکرد Growser را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3369405342922656244">جستجوی این صفحه با «جستجوی تصویر»</translation>
<translation id="7029305463989165490">‏برای ارسال شماره از <ph name="ORIGIN"/> به تلفن Android خود، در هر دو دستگاه به سیستم Growser وارد شوید.</translation>
<translation id="6654312501894761082">‏برنامه‌ای دیگر در رایانه شما یک افزونه اضافه کرده است که ممکن است نحوه کارکرد Growser را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="5254739261293693943">پرسش درباره این ویدیو</translation>
<translation id="696826782632239602">‏Growser برای هم‌رسانی مکانتان با این سایت باید به مکان شما دسترسی داشته باشد</translation>
<translation id="5968400720580217226">حالت هوشواره‌ای</translation>
<translation id="3038354906709778538">‏برنامه‌ای دیگر در رایانه شما یک برنامه اضافه کرده است که ممکن است نحوه کارکرد Growser را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6239161312595354541">پرسیدن از «جستجوی تصویر» درباره این ویدیو</translation>
<translation id="6934579572334859869">پرسیدن از «جستجوی تصویر» درباره این تصویر</translation>
<translation id="3335606533094650083">‏Growser برای این سایت به مجوز دسترسی به میکروفون نیاز دارد</translation>
<translation id="2034072705932785495">‏Growser برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="7877212753140190672">پرسش درباره این تصویر</translation>
<translation id="4831743161813926460">‏Growser به مجوز دسترسی به دوربین و میکروفون برای این سایت نیاز دارد</translation>
<translation id="8205521782011095964">‏Growser راه‌اندازی مجدد شود؟</translation>
<translation id="7037156181243335421">‏درباره Growser</translation>
<translation id="7515599367379971106">‏دریافت کمک برای Growser</translation>
<translation id="8416991531338761401">‏در حال به‌روزرسانی Growser</translation>
<translation id="8770857967909676107">‏درحال به‌روزرسانی Growser (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="346757664779831044">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Growser را راه‌اندازی مجدد کنید.</translation>
<translation id="2650508013505165205">‏Growser به‌روز است</translation>
<translation id="3200946347371759843">‏بعداً Growser می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="7243338164717709748">‏Growser مرورگر پیش‌فرضتان است</translation>
<translation id="7277679420564469675">‏از اینکه Growser را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="35923942544154783">‏Growser  مرورگر پیش‌فرض شود</translation>
<translation id="994633498366956162">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Growser باز کنید</translation>
<translation id="7288435464896223584">‏تنظیم کردن Growser به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="7461989139354277116">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Growser باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="6431627979142927047">‏Growser نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="7308866255223104829">‏این نصب ثانویه Growser است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="4504082803766914072">‏‫Growser صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3401428775806957501">‏‫Growser صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="8141887178647215353">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Growser از سرورهای Growser استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Growser متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1271058958147950277">‏اگر کوکی‌ها را مجاز کنید، ممکن است Growser از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="5234814558013903655">‏برای رفع خطاهای املائی، Growser نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Growser ارسال می‌کند</translation>
<translation id="8726113584675530379">‏برای اعمال تغییراتتان، Growser را راه‌اندازی مجدد کنید</translation>
<translation id="4460646088962270578">‏مجاز کردن ورود به سیستم Growser</translation>
<translation id="8580164386690167203">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Growser به سیستم سایت‌های Growser مانند Gmail وارد شوید</translation>
<translation id="6063118066268728021">‏پیام‌واره‌های ورود به سیستم Growser را نشان می‌دهد</translation>
<translation id="8515482144762238082">‏باز کردن فایل‌های PDF در Growser</translation>
<translation id="7829076036652026699">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="3655976315179790904">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="253855664515325912">‏برای استفاده از مکان، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Growser دسترسی دهید</translation>
<translation id="4271865901183602712">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Growser را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Growser وارد شده باشید از «حساب Growser» خارج نخواهید شد.</translation>
<translation id="5557082829776963235">‏داده‌های سایت همواره بعداز بستن Growser از دستگاه حذف شود</translation>
<translation id="9207580816899273196">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Growser</translation>
<translation id="379655406321095090">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Growser ذخیره شده است مقایسه می‌کند</translation>
<translation id="8275128723495316330">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Growser ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="3851725041229117316">‏انتخاب کنید که آیا سابقه Growser برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Growser لحاظ شود یا نه</translation>
<translation id="2532521073042432089">‏اگر نشانک‌ها را در «حساب Growser» هم ذخیره کنید، می‌توانید قیمت محصولات را در Growser پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="5506213471123571520">‏اگر گزارش‌های استفاده از Growser را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="8667163300845015983">‏برای محافظت از داده‌هایتان، به Growser اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="3741049178292606172">‏برای محافظت از داده‌هایتان، به Growser اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="7897676437903604219">‏وقتی به سیستم وارد شده باشید، امنیت شما را در Growser حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر Growser استفاده شود</translation>
<translation id="1436737925236366970">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Growser ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Growser ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="26820592415134595">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Growser قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Growser را رد کنید.</translation>
<translation id="2596255110055314857">‏درباره اینکه <ph name="BEGIN_LINK"/>Growser چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK"/> بیشتر بدانید</translation>
<translation id="1424526236256834880">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Growser برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="5642661650787602526">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="3768734606957734727">‏این کار <ph name="ITEMS_COUNT"/> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="6299784287136192533">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="2755385414880971807">‏سفارشی کردن نمایه Growser</translation>
<translation id="944044386485012271">‏نام‌گذاری نمایه Growser</translation>
<translation id="7600637573105809724">‏Growser را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="5785325624181446291">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="1565826711257446701">‏برای دریافت گذرواژه‌ها، نشانک‌ها، و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="532235697976793028">‏‫Growser شما</translation>
<translation id="5558883390084503315">‏ورود به سیستم Growser هنگام وارد شدن به سیستم دیگر سرویس‌های Growser</translation>
<translation id="1251633817912319480">‏وقتی با <ph name="USER_EMAIL"/> به سیستم سرویس‌های Growser مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Growser وارد شوید</translation>
<translation id="3307078631581490570">‏شخصی‌سازی کردن Growser</translation>
<translation id="2351593629310703051">‏برای امنیت بیشتر، Growser داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="1259388744073810191">‏از Growser خارج می‌شوید؟</translation>
<translation id="9169221857116438752">وقتی در نوار آدرس یا کادر جستجو تایپ می‌کنید، Growser آنچه را که تایپ می‌کنید به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادات بهتری دریافت کند. این قابلیت در حالت «خصوصی» خاموش است.</translation>
<translation id="4957232603755077331">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Growser چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="8036772746721690521">‏برای گرفتن شخصی‌سازی‌ها، Growser را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="3451707486972433991">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Growser را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Growser اضافه کنید</translation>
<translation id="8047912236350375816">‏برای شخصی‌سازی و اهداف بیشتر، Growser و دیگر سرویس‌های Growser را به‌هم پیوند دهید</translation>
<translation id="6427980796643211404">‏برای ذخیره کردن داده‌های Growser در «حساب Growser» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="3428609694125857206">‏برای ذخیره کردن داده‌های Growser در «حساب Growser» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="1665909624294813568">‏برای استفاده و ذخیره کردن داده‌های Growser در «حساب Growser» خود، Growser را به‌روز کنید</translation>
<translation id="2387112365181977568">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، هویت خود را درستی‌سنجی کنید</translation>
<translation id="7683515834168183549">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="5149870313087650519">‏خروج از سیستم Growser</translation>
<translation id="5711577032890967039">‏داده‌های Growser در حساب شما</translation>
<translation id="8654124943375331353">‏استفاده از <ph name="BEGIN_LINK"/>گذرعبارت خودتان<ph name="END_LINK"/> برای رمزگذاری همه داده‌های Growser موجود در «حساب Growser» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Growser همگام‌سازی نخواهد شد.</translation>
<translation id="7780172332158033724">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Growser ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK"/>داده‌های Growser ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/>.</translation>
<translation id="2686650186700338357">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK"/>داده‌های Growser ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/></translation>
<translation id="1809277674049831383">‏‫Growser حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌های فعال و سایر برنامه‌ها اختصاص داده می‌شود و سرعت بالای Growser حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی حافظه» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="2291585760853183200">‏‫Growser با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="1682800916777749580">‏‫Growser صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK"/>درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="402162951774350647">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Growser استفاده می‌شود</translation>
<translation id="8805133586567519017">‏نمایش Growser به این زبان</translation>
<translation id="8591647532181583895">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Growser بسته می‌شود</translation>
<translation id="874444355953071561">‏با گزارش <ph name="BEGIN_LINK"/>تنظیمات کنونی<ph name="END_LINK"/>، به بهتر شدن Growser کمک کنید</translation>
<translation id="3679843915482636388">‏Growser به‌طور منظم بررسی می‌کند تا مطمئن شود مرورگرتان ایمن‌ترین تنظیمات را دارد. اگر موردی به بازبینی شما نیاز داشته باشد، به شما اطلاع خواهیم داد.</translation>
<translation id="871327634046506456">‏Growser چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="5870462911436512809">‏اگر موردی نیاز به بررسی داشته باشد، Growser به شما اطلاع می‌دهد</translation>
<translation id="6778041046588219956">‏به‌روزرسانی Growser</translation>
<translation id="8631258373552178402">‏‫Growser زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="4953704839431887057">‏ببینید Growser چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="2098538061544589012">‏ابزارهای ایمنی Growser</translation>
<translation id="5106845103941223465">Growser خصوصی</translation>
<translation id="1823139539047733938">‏نسخه Growser قدیمی است</translation>
<translation id="3889510386895645466">‏رفتن به صفحه «درباره Growser»</translation>
<translation id="5355906654071803286">‏اجرای مجدد Growser</translation>
<translation id="1845386291973952879">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION"/> را برداشت.</translation>
<translation id="2862776496369054243">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/> و <ph name="PERMISSION_2"/> را برداشت.</translation>
<translation id="1716896251043080937">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="PERMISSION_3"/> را برداشت.</translation>
<translation id="6004231461565424151">‏اخیراً بازدیدی نداشته‌اید. ‫Growser ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="COUNT"/> مورد دیگر را برداشت.</translation>
<translation id="7004957294549886182">‏سایت خطرناک. ‫Growser اعلان‌ها را برداشت.</translation>
<translation id="6471042403370247137">‏اگر Growser یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="7428539203382021688">‏وقتی‌که از سایتی بازدید می‌کنید، Growser بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK"/>مرور ایمن Growser<ph name="END_LINK"/> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="884461539799798691">‏محافظت بهبودیافته، بهینه‌سازی جاوا اسکریپت را برای سایت‌هایی که Growser آن‌ها را نمی‌شناسد، خاموش می‌کند</translation>
<translation id="4988080734949099436">‏ویژگی‌های اضافی را روشن می‌کند تا قدرتمندترین محافظت‌های Growser را ارائه دهد</translation>
<translation id="1067311274732729769">‏‫Growser اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="670179099341597407">‏Growser سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="4425557811257826479">‏Growser قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="5645629562949365020">هنگام مرور صفحات در حالت خصوصی، Growser قبل از بارگیری سایت با استفاده از اتصال ناامن به شما هشدار می‌دهد.</translation>
<translation id="4580029190698428074">‏وقتی HTTPS دردسترس نباشد، Growser بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="3663107808518609955">‏مهارت‌ها در Growser</translation>
<translation id="2633082168331745826">‏فعال کردن «مهارت‌ها» در Growser</translation>
<translation id="1250270158726651995">‏نوآوری‌های هوشواره، مانند «مهارت‌ها»، در «حساب Growser» شما ذخیره می‌شود و جدا از همگام‌سازی Growser مدیریت می‌شوند</translation>
<translation id="2538647080660844366">‏از آن‌ها در کنار دیگر ویژگی‌های Gemini در Growser استفاده کنید</translation>
<translation id="533266489027134219">‏‫Growser Origin یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Growser Origin، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="673036578543849083">‏به Growser Origin خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="1965498718920182710">‏نشان‌واره Growser Enterprise</translation>
<translation id="4386526138370156983">‏مدیر وظایف - Growser</translation>
<translation id="8453989966828373461">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK"/> به Growser، به بهبود Growser کمک کنید</translation>
<translation id="8206181081400544446">‏به حداکثر تعداد نشانک‌های Growser (<ph name="BOOKMARK_LIMIT"/>) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Growser» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="1017204948504403705">‏این کنش:
          <ph name="LINE_BREAKS"/>
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK"/>
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK"/>
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK"/>
            • میان‌برهای Growser را بازنشانی می‌کند
            <ph name="LINE_BREAKS"/>
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="4568984170127239210"><ph name="PAGE_TITLE"/> - Growser Origin</translation>
<translation id="6459239167457312120">‏<ph name="PAGE_TITLE"/> - ورود به سیستم شبکه - Growser Origin</translation>
<translation id="6745075221093696000"><ph name="PAGE_TITLE"/> - Growser Origin Beta</translation>
<translation id="6074833775480425395"><ph name="PAGE_TITLE"/> - Growser Origin Dev</translation>
<translation id="4323067727951356041"><ph name="PAGE_TITLE"/> - Growser Origin Canary</translation>
<translation id="991626836426968088">‏Growser ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="4457833723877519566">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="9149493049588690437">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="2563731540262721385">‏برای دریافت به‌روزرسانی‌های آتی Growser، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="7206064056082910371">‏Growser پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="7023812228648650687">‏‫Growser شروع نشد، زیرا هنگام باز کردن نمایه‌تان مشکلی پیش آمد. ‫Growser را بازراه‌اندازی کنید.</translation>
<translation id="5663443051888305985">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME"/> به سیستم Growser وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="6369294759786885485">‏لطفاً همه پنجره‌های Growser را ببندید و دوباره سعی کنید.</translation>
<translation id="5284106950707887274">‏آیا مطمئن هستید که می‌خواهید Growser را حذف نصب کنید؟</translation>
<translation id="2901628274067661379">‏حذف نصب Growser </translation>
<translation id="4255250495838298167">‏‫Growser دیگر مرورگر پیش‌فرض شما نیست. Growser  مرورگر پیش‌فرض شود</translation>
<translation id="4701159144509985041">‏تنظیم Growser به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="6674282510961658141">‏با تعیین Growser به‌عنوان مرورگر پیش‌فرض، گذرواژه‌ها، نشانک‌ها و سابقه مرورتان را کاملاً در همه دستگاه‌ها همگام‌سازی کنید.</translation>
<translation id="3496230475498196433">‏روی <ph name="BEGIN_BOLD"/>بله<ph name="END_BOLD"/> در اعلان Windows کلیک کنید تا Growser را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="6464100105052674345">‏اجازه به Growser برای اجرا در پس‌زمینه</translation>
<translation id="2352438365274458200">‏غیرفعال کردن اجرای Growser در پس‌زمینه برای برنامه‌ها</translation>
<translation id="3603873186590845064">‏Growser نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="7115504355633983767">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Growser است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Growser استفاده کنید.</translation>
<translation id="7177756814169573929">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
Growser قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="5275543333441987572">‏Growser می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="1035991880709407996">‏Growser در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2664084576825991761">‏Growser می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="710677211601200975">‏Growser می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="3885229565492284399">‏Growser می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5936702863757232592">‏‫Growser می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="611478306146432511">‏Growser می‌خواهد گذواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="1376071392587482621">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Growser است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Growser را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="1050525229259104976">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Growser در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="1546359662928074286">‏نمی‌توانید Growser دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً Growser را ببندید و دوباره سعی کنید.</translation>
<translation id="3833584860377545037">‏Growser به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="4781953614981114721">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً Growser را دوباره نصب کنید.</translation>
<translation id="2600782055031781597">‏عملیات دیگری در Growser درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="1604254854986540549">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره Growser را بارگیری کنید.</translation>
<translation id="2537082917266688552">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً Growser را دوباره را بارگیری کنید.</translation>
<translation id="8195217592446260650">‏Growser از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="1910107682631098314">‏وارد کردن گذرواژه‌ها به Growser</translation>
<translation id="4667068515417581301">‏صادر کردن گذرواژه‌ها از Growser</translation>
<translation id="2101485830489784531">‏‫Growser را به نوار وظیفه سنجاق کنید تا هرزمان خواستید سریع‌تر به آن دسترسی داشته باشید</translation>
<translation id="7869602180589455024">‏سنجاق کردن Growser</translation>
<translation id="835779925169785097">‏Growser مرورگر پیش‌فرض شما نیست</translation>
<translation id="490167989515294785">‏‫Growser را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="6061362658834310773">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Growser، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="6718288934577794159">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Growser، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید. ‫Growser برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="3269099019844253754">‏با تنظیم کردن Growser به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="7771912457179667546">‏‫Growser اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="2573722769951653092">‏۱. روی <ph name="BUTTON_LABEL"/> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2"/> در تنظیمات Windows کلیک کنید
۳. روی <ph name="BUTTON_3"/> در اعلان Windows کلیک کنید تا Growser را برای دسترسی سریع به نوار وظیفه سنجاق کنید</translation>
<translation id="5811554469028257346">‏تنظیم Growser به‌عنوان نمایشگر PDF پیش‌فرض</translation>
<translation id="8293526299624183342">‏با «Gemini در Growser»، مروری کوتاه از این سند دریافت کنید و سؤال بپرسید</translation>
<translation id="2186818126392784824">‏این سند را با «Gemini در Growser» هم‌رسانی کنید تا مرور کوتاهی از آن داشته باشید و سؤالات تعقیبی بپرسید</translation>
<translation id="7396783440261871557">‏برای هم‌رسانی این سند با Gemini در Growser و دریافت مرور کوتاه و پرسیدن سؤالات تعقیبی، روی دکمه «خلاصه کردن» کلیک کنید</translation>
<translation id="5798781567599261116">افزونه‌ها، برنامه‌ها و طرح‌های زمینه دریافتی از منابع ناشناخته می‌توانند به دستگاه شما آسیب بزنند. Growser توصیه می‌کند که آنها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> نصب کنید</translation>
<translation id="865184523435673529">‏ببینید چرا Growser برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="3351202378639482227">‏افزودن به Growser…</translation>
<translation id="3937559951479784717">‏<ph name="FILE_NAME"/> ممکن است خطرناک باشد، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="5605446327850749599">‏این فایل خطرناک است، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="2429964733523607630">‏<ph name="FILE_NAME"/> خطرناک است، بنابراین Growser آن را مسدود کرده است.</translation>
<translation id="1697170583693084369">‏Growser توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="678869972624164693">‏‫Growser این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="66329522109859812">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="4139585934875332203">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="4565356641434588554">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="5240054142173352667">‏‫Growser این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="5105701610060488629">‏‫Growser این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="1097259831896030507">‏‫Growser این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="5850866806592808363">‏‫Growser این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="2428874045337441912">‏ببینید چرا Growser برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="4809275852638676593">‏ببینید چرا Growser برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="298316392131030974">‏درهرصورت از Growser خارج می‌شوید؟</translation>
<translation id="8789969163606798208">‏کلیدهای Growser API وجود ندارند. برخی از عملکردهای Growser از کار خواهند افتاد.</translation>
<translation id="4439116282575412593">‏<ph name="EXTENSION_NAME"/> به Growser اضافه شد</translation>
<translation id="7107774338871938246">‏داده‌ها از Growser هم حذف شود (<ph name="URL"/>)</translation>
<translation id="8681923442156080194">‏Growser متوجه شده است که «<ph name="EXTENSION_NAME"/>» حاوی بدافزار است</translation>
<translation id="7909554267169146203">‏Growser متوجه شده است که این موارد حاوی بدافزار هستند:</translation>
<translation id="9036207213609798450">‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="4531215791397816557">{NUM_EXTENSIONS,plural, =1{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}one{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}other{‏‫Growser توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}}</translation>
<translation id="7649195130965340504">‏حذف <ph name="EXTENSION_NAME"/> از Growser</translation>
<translation id="6063341597504985882">‏افزونه‌ها برافزاهایی هستند که به شما امکان می‌دهند Growser را سفارشی‌سازی کنید. از مرتب ماندن گرفته تا ساده‌سازی تکالیف روزمره، افزونه‌ها به شما کمک می‌کنند Growser را مختص خودتان کنید.</translation>
<translation id="992371788707480262">‏این افزونه حاوی بدافزار است و ناامن است. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2067832607013415103">این افزونه خط‌مشی فروشگاه وب را نقض می‌کند و ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما را در سایت هایی که بازدید می‌کنید، از جمله اطلاعات شخصی شما، ببیند و تغییر دهد.</translation>
<translation id="4087978185310570098">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="7679253003086815797">‏Growser توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="1265858790092343669">‏‫Growser نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از Growser حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2056744103082155431">‏روشن • Growser نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="961997018599108270">‏خاموش • Growser نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="3369174930406579134">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Growser توصیه می‌کند آن را حذف کنید.</translation>
<translation id="979422849829153593">{NUM_EXTENSIONS,plural, =1{‏Growser توصیه می‌کند آن را بردارید}one{‏Growser توصیه می‌کند آن را بردارید}other{‏Growser توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="5658559420185486900">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار Growser</translation>
<translation id="6712113911906650320">‏هشدار: Growser نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت خصوصی»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="4498223799912841817">‏حذف از Growser</translation>
<translation id="7796731196254627036">‏در Growser</translation>
<translation id="5543269213556225156">‏پس‌از بازراه‌اندازی Growser، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="8347277579804870421">‏برای ایمن‌تر کردن Growser، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="200860377832188522">‏برای ایمن‌تر کردن Growser، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="7222463235177542287">‏سفارشی کردن و کنترل Growser</translation>
<translation id="5917910893193436830">‏سفارشی کردن و کنترل Growser. به‌روزرسانی‌ دردسترس است.</translation>
<translation id="4868069852456700682">‏Growser را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="8280755857245979104">‏&amp;باز کردن در Growser</translation>
<translation id="7325947590026326087">‏درباره &amp;Growser</translation>
<translation id="8976026755762050029">‏راه‌اندازی مجدد برای به‌روزرسانی Growser</translation>
<translation id="8960392361082788520">‏سفارشی‌سازی Growser</translation>
<translation id="6259076805350049778">‏دیگر نمایه‌های Growser</translation>
<translation id="1010305914532246247">‏مدیریت نمایه‌های Growser</translation>
<translation id="8203764833458154734">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم Growser شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="2446003269146099857">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST"/> به سیستم Growser در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Growser جدیدی ایجاد کنید.</translation>
<translation id="9125589141018116978">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="2230025109234282630">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="5091609952921728083">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Growser می‌تواند هربار که آن را بازراه‌اندازی می‌کنید، زبانه‌هایتان را بازگرداند. برای روشن کردن این ویژگی، به اینجا بروید:</translation>
<translation id="6981289061161925147">‏سازمانتان شما را ملزم می‌کند به سیستم Growser وارد شوید</translation>
<translation id="7683929270400648323">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم Growser وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="4848148717409470937">‏داده‌های Growser به این حساب مرتبط شود؟</translation>
<translation id="725420540356336095">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Growser خود را می‌دهید. داده‌های Growser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Growser حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE"/></translation>
<translation id="4812467331272188817">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Growser خود را می‌دهید. داده‌های Growser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Growser حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Growser موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE"/></translation>
<translation id="7983659884458865927">‏سازمانتان (<ph name="MANAGER"/>) شما را ملزم می‌کند به سیستم Growser وارد شوید</translation>
<translation id="721653618740784654">‏به سیستم Growser وارد می‌شوید؟</translation>
<translation id="8507996842912472741">‏سازمان شما Growser را مدیریت می‌کند</translation>
<translation id="358564474092167395">‏‫<ph name="MANAGER"/> ‏Growser را مدیریت می‌کند</translation>
<translation id="6951536873223673192">‏چندین سازمان Growser را مدیریت می‌کنند</translation>
<translation id="8798183420443630372">‏برای ادامه دادن، با حساب <ph name="EMAIL"/> به سیستم Growser وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="2152295677712126834">‏افزونه «<ph name="EXTENSION_NAME"/>» از شما می‌خواهد به سیستم Growser وارد شوید</translation>
<translation id="8372687623821354675">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS"/>، به سیستم Growser وارد شوید.</translation>
<translation id="5712065245433424708">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Growser وارد شوید</translation>
<translation id="3564601079476815667">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Growser را پیکربندی کرده است.</translation>
<translation id="4196436705957683122">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME"/> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Growser را پیکربندی کرده است.</translation>
<translation id="6868193750403948178">‏سفارشی کردن Growser</translation>
<translation id="7639726495501398295">‏‫Growser را مخصوص خودتان کنید</translation>
<translation id="2750070264345787533">‏بازنشانی به Growser پیش‌فرض</translation>
<translation id="3567433952279331449">‏با سفارشی‌سازی Growser، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="3824156531292282468">‏دریافت کردن Growser در تلفن</translation>
<translation id="533320084486051444">‏برای ذخیره کردن گذرواژه‌ها درحرکت، برنامه Growser را دریافت کنید</translation>
<translation id="3480945185701684503">‏با سفارشی‌سازی Growser، ظاهری جدید به آن ببخشید</translation>
<translation id="5994594536097299968">‏روی دکمه «سفارشی‌سازی Growser» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Growser ببخشید</translation>
<translation id="8965689322246910580">‏<ph name="USER_EMAIL_ADDRESS"/> قبلاً از Growser استفاده می‌کرد</translation>
<translation id="2091195305139378373">‏استفاده از Growser بدون حساب</translation>
<translation id="6364383883668105509">‏در نمایه جدید به سیستم Growser وارد می‌شوید؟</translation>
<translation id="4703768442253680671">‏به نمایه Growser موجود می‌روید؟</translation>
<translation id="8789001990221708313">‏قبلاً با <ph name="USER_EMAIL_ADDRESS"/> در نمایه Growser دیگری به سیستم وارد شده‌اید</translation>
<translation id="8301131823005186282">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه Growser بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS"/> به سیستم وارد شده‌اید</translation>
<translation id="5123925581213723416">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه Growser وارد شده است. برای جدا نگه داشتن مرور، Growser می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="5245337343687738049">‏‫<ph name="EXISTING_USER"/> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید.</translation>
<translation id="6515876849360167659">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین گذرواژه‌ها و اطلاعات دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="6426933876042535118">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="6873553785695129772">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین اطلاعات ذخیره‌شده و اطلاعات دیگر را از <ph name="DEVICE"/> دریافت خواهید کرد.</translation>
<translation id="1882791237209046433">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین گذرواژه‌هایتان و اطلاعات دیگر را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="3931250744648698087">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین نشانک‌ها و اطلاعات دیگر در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="1150972610527825536">‏‫<ph name="EXISTING_USER"/> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Growser وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="3505846189507037800">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به سیستم Growser وارد شوید</translation>
<translation id="4245415605080139322">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Growser» خود در Growser استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Growser» بروید.</translation>
<translation id="4193690350845293524">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Growser» خود در Growser استفاده کنید. ‫<ph name="SHORTCUT"/> می‌تواند تنظیمات سرویس‌های Growser را تغییر دهد.</translation>
<translation id="5706634855830381675">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Growser» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Growser، دوباره به سیستم وارد شوید.</translation>
<translation id="7732285442926914510">‏گذرواژه‌ها و دیگر داده‌های Growser که در «حساب Growser» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Growser، دوباره به سیستم وارد شوید.</translation>
<translation id="6329013037771952423">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را تأیید کند. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="3868792775078424070">{count,plural, =1{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Growser» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Growser باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="1996684507882597880">‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="5454014972880493315">{count,plural, =1{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Growser هنوز در «حساب Growser» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="8809645441864753749">‏وقتی همه پنجره‌های Growser را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Growser وارد شده باشید از «حساب Growser» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="1341243441016287837">‏برای بستن کادر گفتگوی ورود به سیستم Growser، کلیک کنید</translation>
<translation id="6533707658235722780">‏حساب Growser به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="3621973672138363787">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="8776917651555598219">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="2049149594032125973">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، داده‌های Growser ذخیره‌شده در حسابتان را <ph name="SETTINGS_LINK"/></translation>
<translation id="281969887027206923">‏داده‌های Growser ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="3036914571297916959">‏داده‌هایتان بااستفاده از گذرعبارت شما رمزگذاری شده است. برای استفاده از داده‌های Growser و ذخیره کردن این داده‌ها در «حساب Growser»، این گذرعبارت را وارد کنید.</translation>
<translation id="2846495268487848913">‏سفارشی کردن نمایه جدید Growser</translation>
<translation id="8886382435167457658">‏ورود به سیستم Growser</translation>
<translation id="3251892005336702042">‏برداشتن حساب از Growser</translation>
<translation id="3269077286059832796">‏مدیریت نمایه‌های Growser</translation>
<translation id="2196448886818266718">‏افزودن نمایه Growser</translation>
<translation id="3639562449300546186">‏ورود به سیستم Growser در تلفن</translation>
<translation id="3104294450494567786">‏رمزینه پاسخ‌سریع برای ورود به سیستم Growser با <ph name="USER_NAME"/></translation>
<translation id="7206238340597832726">‏برداشتن داده‌های این برنامه از Growser</translation>
<translation id="7293870171608700967">‏برنامه‌های Growser Origin</translation>
<translation id="7006775661509770321">‏Growser درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="7486895119563497312">‏Growser درحال استفاده از میکروفون شما است.</translation>
<translation id="7217169501546612735">‏Growser درحال استفاده از دوربین شما است.</translation>
<translation id="2862054712093958084">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Growser به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Growser به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Growser به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Growser به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="4900468470970697620">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Growser به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه Growser به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه Growser به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه Growser به # دستگاه USB دسترسی دارند}}</translation>
<translation id="2408132906637962509">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL"/> به سیستم Growser وارد شوید.</translation>
<translation id="8644436666850606965">‏Growser اکنون بهتر شده است</translation>
<translation id="1922416787694103058">‏اکنون استفاده از Growser با حساب Growser شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="1313706874534089954">‏این Growser شماست</translation>
<translation id="3664328838662453022">‏وب، نشانک‌ها و موارد دیگر Growser شما در اینجا هستند.</translation>
<translation id="1352463651587972742">‏مهمان‌ها می توانند از Growser استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="5373192533257204771">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Growser را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="2703664622551952828">‏برای باز کردن Growser و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="4721530170808832000">‏افرودن خودتان به Growser</translation>
<translation id="1167105492426667502">‏روی منو Growser کلیک کنید</translation>
<translation id="8841802346141697094">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Growser نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8595898309743593721">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Growser یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="4972491789724320305">‏برای جستجو کردن افزونه یا ویژگی خاص Growser، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="635937903974893482">‏برخی‌از ویژگی‌ها و افزونه‌های Growser دارای میان‌بر هستند. می‌توانید انتخاب کنید که آن‌ها را دوباره روشن کنید.</translation>
<translation id="1044931877878380188">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Growser را کشف کنید.</translation>
<translation id="7912473483251131078">‏Growser Origin‏ (mDNS ورودی)</translation>
<translation id="5752926014208072629">‏قانون ترافیک ورودی برای Growser Origin جهت اجازه به ترافیک mDNS.</translation>
<translation id="5850632525405222774">‏اگر تصویری توضیح مفیدی نداشته باشد، Growser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Growser ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="8076549662907665888">‏اگر تصویری توضیح مفیدی نداشته باشد، Growser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Growser ارسال می‌شود.</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Growser استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Growser ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="8427574149019275290">‏باز کردن پیوند در &amp;برگه جدید Growser</translation>
<translation id="595588262476414049">‏باز کردن پیوند در پنجره &amp;ناشناس Growser</translation>
<translation id="2181537491813999211">لینک را در پنجرهٔ خصوصی Growser &amp;باز کنید</translation>
<translation id="2067566126130974290">‏درحال شخصی‌سازی Growser…</translation>
<translation id="8080616114300165633">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Growser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1895016014993159555">‏نصب مجدد Growser</translation>
<translation id="5882995408983292483">‏به‌روزرسانی Growser امکان‌پذیر نیست</translation>
<translation id="7464495236419160803">‏Growser به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="6560728661781075049">‏به‌روزرسانی Growser</translation>
<translation id="5590207435958825988">‏برای استفاده از داده‌های Growser و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="3972229311347141416">‏برای ادامه استفاده از داده‌های Growser ذخیره‌شده در «حساب Growser» خود (<ph name="ACCOUNT_EMAIL"/>)،‏ Growser را به‌روز کنید</translation>
<translation id="1736682310984251274">‏به‌روزرسانی Growser برای شروع همگام‌سازی</translation>
<translation id="2752277240592513256">‏Growser تا <ph name="REMAINING_TIME"/> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="5400854089653049720">‏لطفاً اکنون Growser را بازراه‌اندازی کنید</translation>
<translation id="816220834424790470">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Growser اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="1919911732281489663">‏برگه Growser</translation>
<translation id="7409041475941023206">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید</translation>
<translation id="441969162224012576">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید.</translation>
<translation id="394268994831024181">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید</translation>
<translation id="2582654120037508629">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Growser مجاز کنید.</translation>
<translation id="6116099631091261014">‏سپس باید Growser را بازراه‌اندازی کنید.</translation>
<translation id="6021184685703509695">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Growser مجاز کنید. سپس باید Growser را بازراه‌اندازی کنید.</translation>
<translation id="4951278105276220905">‏سابقه Growser</translation>
<translation id="1377013856314636263">‏درباره جستجو کردن با «جستجوی تصویر» در Growser بیشتر بدانید</translation>
<translation id="8167292520237678091">‏رفتن به تنظیمات اعلان Growser</translation>
<translation id="5059006473359604360">{0,plural, =0{‏به‌روزرسانی Growser دردسترس است}=1{‏به‌روزرسانی Growser دردسترس است}one{‏به‌روزرسانی Growser از # روز پیش دردسترس است}other{‏به‌روزرسانی Growser از # روز پیش دردسترس است}}</translation>
<translation id="3845814901430915361">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1737138554912368806">{0,plural, =1{‏Growser را ظرف یک روز راه‌اندازی مجدد کنید}one{‏Growser را ظرف # روز راه‌اندازی مجدد کنید}other{‏Growser را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="2491249190431914147">{0,plural, =1{‏Growser یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Growser # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Growser # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="3793354223050135117">{0,plural, =1{‏Growser ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏Growser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏Growser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="613909147715352806">{0,plural, =0{‏Growser هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Growser ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Growser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Growser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="965250208426515456">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Growser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="2931180980997688910">{COUNT, plural,
              =0 {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید}
              =1 {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. پنجرهٔ خصوصی شما باز نخواهد شد.}
              other {محافظت پیشرفته نیاز دارد که Growser را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. # پنجرهٔ خصوصی شما باز نخواهد شد.}}</translation>
<translation id="7647966250244920458">‏درحال راه‌اندازی Growser…</translation>
<translation id="1703246464233448026">‏Growser راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="4579792724359199960">‏هم‌رسانی برگه Growser</translation>
<translation id="7852626102884722088">‏Growser به‌طور خودکار بسته شد</translation>
<translation id="437858582924654858">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="5167454534917906339">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="6366172032470723642">‏اگر <ph name="TIMEOUT_DURATION"/> از Growser استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="6054526434774152867">‏Growser به‌زودی بسته می‌شود</translation>
<translation id="3627058067394924065">‏Growser به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="5362825177670454785">‏Growser به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="6890068496140419087">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}one{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}other{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}}</translation>
<translation id="880802755497979140">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="5869235325726258967">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Growser استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="8111900445721786828">‏ادامه استفاده از Growser</translation>
<translation id="8542920192059400312">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Growser خاموش کرده است</translation>
<translation id="8715818129986086186">‏سازمانتان می‌تواند داده‌های مرور، مثل نشانک‌ها، سابقه، و گذرواژه‌هایتان را ببیند و مدیریت کند. سازمانتان نمی‌تواند داده‌های مرور دیگر نمایه‌های Growser را ببیند</translation>
<translation id="7643432817438780110">‏به نمایه‌های Growser خوش‌آمدید</translation>
<translation id="5226489290885369540">‏چه‌کسی از Growser استفاده می‌کند؟</translation>
<translation id="6837913888298763198">‏با نمایه‌های Growser می‌توانید همه چیزهای مربوط به Growser را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="8262880716247261976">‏راه‌اندازی نمایه Growser جدید</translation>
<translation id="6539809395143501177">‏هرکدام از نمایه‌ها دارای اطلاعات Growser مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6359748718028735107">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Growser را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="5254830036533869365">‏درحال‌حاضر یک نمایه Growser با این حساب در این دستگاه وجود دارد</translation>
<translation id="7671828190113127067">‏شروع Growser</translation>
<translation id="3109033858283726964">‏ورود به سیستم Growser</translation>
<translation id="3194774009976956730">‏بیایید Growser را آماده کنیم</translation>
<translation id="3040770245079391216">‏استفاده کردن از Growser به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن</translation>
<translation id="9209134737432231581">‏از Growser برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="1402212206440388621">‏پیوندها را از هر برنامه‌ای در Growser باز کنید. همچنین برای دسترسی آسان، Growser به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="7559168009716862834">‏نشان‌واره Growser درون صفحه‌نمایش رایانه.</translation>
<translation id="1935622100168295198">‏‫Growser را سفارشی‌سازی و کنترل کنید. ‫Growser را به‌عنوان مرورگر پیش‌فرض تنظیم کنید.</translation>
<translation id="982715935470582799">‏تنظیم Growser به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="5550473017271508801">‏‫Growser را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="7562201679288302002">‏پیوندها را از هر برنامه‌ای در Growser باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="455043483084727114">‏می‌توانید در اینجا بین نمایه‌های Growser جابه‌جا شوید</translation>
<translation id="2577604806976743079">‏با <ph name="SHORTCUT"/> می‌توانید بین نمایه‌های Growser جابه‌جا شوید</translation>
<translation id="8615520477965823239">‏برای دیدن گذرواژه‌های نمایه Growser دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="842256045450098075">‏برای برداشتن «حساب Growser» خود از Growser، از سیستم خارج شوید</translation>
<translation id="6677784415412949473">‏برای برداشتن «حساب Growser» خود از Growser، در صفحه «تنظیمات» از سیستم Growser خارج شوید</translation>
<translation id="8235635284210221172">‏این ویژگی در Growser تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="4166648098896027129">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در Growser» بپرسید</translation>
<translation id="6168558359146786659">‏‫Growser را مخصوص خودتان کنید</translation>
<translation id="2789075374752545467">‏دفعه بعدی که Growser را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="519862482935410613">‏‫Growser برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3879869835592882268">‏دریافت قوی‌ترین امنیت Growser</translation>
<translation id="2018156653799562033">‏راه‌اندازی Growser هنگام شروع Windows</translation>
<translation id="6194017441174235829">‏برای شروع فوری مرور، Growser را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="3927803834677784549">‏مرور را فوراً شروع کنید: اکنون Growser می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="6362404093595382654">‏اکنون Growser با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="1459201843502305963">‏با این کار سرعت سایت‌ها با موتور Growser نسخه ۸ بالاتر می‌رود اما مقاومت Growser دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="8148152948885197973">‏با این کار سرعت سایت‌ها با موتور Growser نسخه ۸ بالاتر می‌رود اما مقاومت Growser دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم خاموش است.</translation>
<translation id="3256611564871760291">‏سرعت سایت‌ها را با موتورV8 مرورگر Growser بالاتر می‌برد اما مقاومت Growser را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="8218123929138221080">‏‫Growser سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="3531624950074038621">‏عملکرد را کاهش می‌دهد اما Growser را دربرابر حملات مقاوم‌تر می‌کند</translation>
<translation id="299509295551938426">‏سرویس به‌روزرسان Growser</translation>
<translation id="4068751299154562321">‏سرویس داخلی به‌روزرسان Growser</translation>
<translation id="6016191786267407731">‏نرم‌افزار Growser را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Growser به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Growser از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="638207715601170321">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Growser حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="1309483419808224148">‏سرعت Growser را افزایش دهید</translation>
<translation id="5153670453251236235">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Growser آن‌ها را غیرفعال کند.</translation>
<translation id="2829313098211569787">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Growser آن را غیرفعال کند.</translation>
<translation id="1891457457620013910">{NUM_TABS,plural, =1{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Growser توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Growser توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2066016210194753134">‏میان‌برها در Growser باز می‌شود</translation>
<translation id="343431853267837448">‏داده‌های Growser پاک شد</translation>
<translation id="2016973756696213156">‏با «Gemini در Growser» امتحان کنید</translation>
<translation id="3446744630960564006">‏هر زمان که نیاز داشتید، «Gemini در Growser» به‌سرعت باز می‌شود</translation>
<translation id="1985505085856398819">‏نشان دادن «Gemini در Growser» در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="7843414100742664106">‏نمایش «Gemini در Growser» در سینی سیستم</translation>
<translation id="5912735934441585874">‏دسترسی آسان به «Gemini در Growser» در سراسر دستگاه، حتی اگر Growser کوچک شده باشد.</translation>
<translation id="635775285804478675">‏‫«Gemini در Growser» را با میان‌بر صفحه‌کلید باز کنید.</translation>
<translation id="6403063362298585665">‏اگر «Gemini در Growser» باز باشد، پانل کناری هنگام ایجاد زبانه‌های جدید باز می‌ماند</translation>
<translation id="3816137493832455715">‏برای انتخاب بخشی از صفحه در «Gemini در Growser»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="4869198816388260769">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="3143930395666972687">‏برای دریافت این نشانک و موارد بیشتر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید</translation>
<translation id="4626379744082113715">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Growser وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Growser» شما ذخیره خواهد شد.</translation>
<translation id="5399404694319519684">‏اکنون ویژگی‌های بیشتری در Growser دردسترس شما قرار دارد</translation>
<translation id="6243750565468992770">‏حساب شما در Growser</translation>
<translation id="285864776837103618">‏با «مرور ایمن پیشرفته» در Growser برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="7183287313310808593">‏«مرور ایمن پیشرفته» را با Growser در تلفنتان گسترش دهید</translation>
<translation id="6665383679021314581">‏با گذرواژه‌های ذخیره‌شده برای Growser در iOS، در سایت‌ها سریع‌تر به سیستم وارد شوید</translation>
<translation id="7909057381664913954">‏از گذرواژه‌هایتان با Growser در تلفنتان استفاده کنید</translation>
<translation id="1262698330790070522">‏دریافت برنامه Growser</translation>
<translation id="1369136842285731495">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر Growser در دستگاه‌های همراه</translation>
<translation id="1839309260370506060">‏دفعه بعد که Growser iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME"/>» خواهید دید.</translation>
<translation id="3957046550690757228">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Growser» خواهید دید.</translation>
<translation id="4913468027546625856">‏در برنامه Growser ویژه iOS، با دوربینتان آنچه را می‌بینید بخرید، ترجمه کنید، و شناسایی کنید</translation>
<translation id="5334429916836219509">‏«لنز Growser» را با Growser در تلفنتان امتحان کنید</translation>
<translation id="2393075722810632447">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Growser ویژه iOS را بارگیری کنید، و به سیستم «حساب Growser» وارد شوید</translation>
<translation id="4853439800347640587">‏با بارگیری Growser در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="5026029776800944167">‏با Growser در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1827860507749134214">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای فعال کردن هشدارهای ردگیری قیمت خواهید دید.</translation>
<translation id="7260886862936286198">‏با بارگیری Growser در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="3179906250938065566">‏دفعه بعد که Growser را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="3670946997425275779">‏برای بارگیری Growser و ورود به سیستم «حساب Growser»، رمزینه پاسخ‌سریع را با تلفنتان اسکن کنید.</translation>
<translation id="8016699923481728837">‏با برنامه Growser در تلفنتان از بهترین ابزارهای هوشواره Growser استفاده کنید</translation>
<translation id="6085139155476935700">‏با Growser در iOS، ابزارهای هوشواره Growser دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="85912115868085406">‏هنگام استفاده از برنامه Growser در <ph name="DEVICE_TYPE"/>، قدرت هوشواره را تجربه کنید</translation>
<translation id="7502110432835833029">‏برای داشتن بهترین ابزارهای هوشواره درحرکت، از برنامه Growser استفاده کنید</translation>
<translation id="4872784071286727545">‏با برنامه Growser در تلفنتان، بیشترین بهره را از Growser ببرید</translation>
<translation id="1665059346664283754">‏با Growser، در حرکت، به‌صورت یکپارچه با برنامه‌های موردعلاقه‌تان مانند Google Drive و YouTube کار کنید.</translation>
<translation id="5910135615577427412">‏با برنامه Growser در <ph name="DEVICE_TYPE"/>، بیشترین بهره را از Growser ببرید</translation>
<translation id="6333239663501390375">‏با Growser در <ph name="DEVICE_TYPE"/> خود، به همه موارد دلخواه Growser دسترسی پیدا کنید</translation>
<translation id="7510190804000607802">‏یادآور: بهترین‌های Growser در جیب شما</translation>
<translation id="8546612205554583655">‏با برنامه Growser در تلفنتان، بهترین ویژگی‌های ایمنی Growser را درحال حرکت دریافت کنید</translation>
<translation id="6240129247678023389">‏با Growser، بهترین ویژگی‌های ایمنی Growser را در حرکت دریافت کنید.</translation>
<translation id="5102419700069897472">‏با برنامه Growser در <ph name="DEVICE_TYPE"/>، ایمنی Growser را درحرکت داشته باشید</translation>
<translation id="8211080268209414722">‏برای داشتن ایمنی Growser در حرکت، از برنامه Growser استفاده کنید</translation>
<translation id="354621070532799440">‏یادآور: بهترین ویژگی‌های ایمنی Growser در جیب شما</translation>
<translation id="6395357110827382630">‏با برنامه Growser در تلفنتان، برای کالاهایی که به آن‌ها علاقه‌مندید هشدار کاهش قیمت دریافت کنید</translation>
<translation id="2888272008248198017">‏محصولات را با دوربین خود کشف کنید، افت قیمت‌ها را دنبال کنید و موارد بیشتری را در حرکت با Growser روی iOS انجام دهید.</translation>
<translation id="8988632212716006521">‏بااستفاده از برنامه Growser در <ph name="DEVICE_TYPE"/>، از خرید آنلاین بهره بیشتری ببرید</translation>
<translation id="5919080786404908840">‏برای داشتن بهترین ابزارهای خرید درحرکت، از برنامه Growser استفاده کنید</translation>
<translation id="1777651200954348103">‏با برنامه Growser در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="5424525786912503458">‏ادامه کار را دقیقاً از همان جایی که در Growser روی iOS متوقف کرده بودید، از سر بگیرید.</translation>
<translation id="1207412468280310003">‏با برنامه Growser در<ph name="DEVICE_TYPE"/>، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحرکت همراه خود داشته باشید</translation>
<translation id="8718912430754999757">‏برای ادامه مرور در حرکت، از برنامه Growser استفاده کنید</translation>
<translation id="8909343812503299574">‏موتور جستجوی شما از خارج‌از Growser تغییر کرد. برای محافظت از شما، Growser آن را به پیش‌فرض اصلی‌اش بازنشانی کرد. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="785283387498656820">‏برای حفظ امنیت، وقتی برای اولین‌بار از سایتی بازدید می‌کنید، Growser «بهینه‌سازی جاوا اسکریپت» را خاموش می‌کند.

اگر این صفحه طبق انتظار کار نمی‌کند، «بهینه‌سازی» را مجاز کنید.</translation>
<translation id="4165169774507632897">‏ورود به سیستم Growser</translation>
<translation id="8633519672432360220">‏کارهای شما در Growser ایمن است</translation>
<translation id="2298918301821382774">‏برای حفظ امنیت کارهای شما در Growser، سازمان‌تان می‌تواند اطلاعات خاصی را هنگام ورود به سیستم Growser مشاهده یا مدیریت کند.</translation>
<translation id="5670438198445413111">‏به دلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره Growser را بارگیری کنید.</translation>
<translation id="4217571870635786043">املا</translation>
</translationbundle>