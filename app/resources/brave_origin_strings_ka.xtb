<translation id="1705567146636171298">განაახლეთ Growser</translation>
<translation id="5499063270485366718">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Growser შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Growser-ში.</translation>
<translation id="1196733835766994012">მიიღეთ ხელოვნური ინტელექტის შესაძლებლობები, როცა Growser აპს იყენებთ თქვენს <ph name="DEVICE_TYPE"/>-ზე</translation>
<translation id="7166289504510860270">თქვენი პაროლები, ჩანართები და სხვა მონაცემები მუდამ თქვენთანაა Growser აპით თქვენს ტელეფონში</translation>
<translation id="5966368554860795750">Growser for Testing-ის მორგება</translation>
<translation id="792838367208896130">შეგიძლიათ გამოიყენოთ Growser, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="375314543563594498">ამოშალეთ <ph name="EXTENSION_NAME"/> Growser-იდან</translation>
<translation id="2332301637111071062">თქვენი ორგანიზაცია შლის Growser-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="1008530050039597147">Growser საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1197672524850678392">Growser-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="5020151688261063547">იკითხეთ ნებისმიერი რამ პირდაპირ იქ, სადაც ხართ, Gemini-ს მეშვეობით Brave-ში</translation>
<translation id="3625983487600668413">დატოვეთ Growser თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="5755581833598928580">გამოიყენეთ Growser შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="7216228761061470870">როცა სურათების ძიებას იყენებთ დესკტოპზე, გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, იგზავნება სერვერზე</translation>
<translation id="5516268345616100622">დავალებათა მენეჯერი - Growser</translation>
<translation id="1871621397473741084">მომენტალურად დაიწყეთ დათვალიერება: Growser-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{Growser გირჩევთ, ამოშალოთ ის}other{Growser გირჩევთ, ამოშალოთ ისინი}}</translation>
<translation id="4600669988724328687">სისტემის აუდიოს გასაზიარებლად გახსენით სისტემის პარამეტრები და დაუშვით „მხოლოდ სისტემის აუდიოს ჩაწერა“ Growser-ისთვის. დაგჭირდებათ Growser-ის გადატვირთვა.</translation>
<translation id="9068395155143628872">რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Growser-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="1864557848095568223">მიმდინარეობს Growser-ის განახლება</translation>
<translation id="3403365884036456766">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Growser ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="3511996232906761537">თქვენი ვები, სანიშნეები და Growser-ის სხვა მასალა არის აქ.</translation>
<translation id="1754899895078387289">თქვენი დაშიფრული მონაცემების წაკითხვა შეუძლია მხოლოდ მას, ვინც თქვენი საიდუმლო ფრაზა იცის. საიდუმლო ფრაზა არ იგზავნება Growser-ში და არ ინახება მის მიერ. თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>თქვენს ანგარიშში Growser მონაცემების<ph name="END_LINK"/> წაშლა მოგიწევთ.</translation>
<translation id="5380963249588143069">თქვენი სისტემის ადმინისტრატორმა მოახდინა Growser-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME"/>-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME"/>-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="6085660187823915017">მომავალში Growser-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="2865744782251083875">ბოლო დროს არ ყოფილხართ. Growser-მა ამოშალა <ph name="PERMISSION_1"/> და <ph name="PERMISSION_2"/>.</translation>
<translation id="3871306442916198768">Gemini-ს ჩვენება Brave-ის სისტემურ არეში</translation>
<translation id="4104934885375476361">Growser ახლა თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="7951152294775418909">გააგრძელეთ იქიდან, სადაც გაჩერდით: Growser აღადგენს თქვენს ჩანართებს ყოველი გადატვირთვის შემდეგ. ამის გამოსართავად გადადით</translation>
<translation id="3191314862567596053">Growser-ში პაროლების იმპორტი</translation>
<translation id="284799389314308801">1. დააწკაპუნეთ <ph name="BUTTON_LABEL"/>-ზე ქვემოთ
2. დააწკაპუნეთ <ph name="BUTTON_2"/>ზე Windows-ის პარამეტრებში
3. დააწკაპუნეთ <ph name="BUTTON_3"/>-ზე Windows-ის შეტყობინებაში, რომ ჩაამაგროთ Growser ამოცანათა ზოლში სწრაფი წვდომისთვის</translation>
<translation id="4864311514218370796"><ph name="PAGE_TITLE"/> — Growser Origin Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7129342855140808694">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK"/>სისტემის პარამეტრები<ph name="END_LINK"/> და მიანიჭეთ Growser-ს წვდომა</translation>
<translation id="5296583608321648908">Growser-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="3962395975456095331">გსურთ Growser-ის ხელახლა გაშვება?</translation>
<translation id="2619516027171717873">შეუძლებელია იმავე Growser-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Growser და ხელახლა სცადეთ.</translation>
<translation id="6607863494375614497">შეხსენება: Growser-ის საუკეთესო შესაძლებლობები თქვენს ხელთ</translation>
<translation id="5337027666828618338">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Growser-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Growser ანგარიში, თუ მასში შესული ხართ Growser-იდან.</translation>
<translation id="3186363903915641692">{0,plural, =1{Growser ხელახლა გაეშვება 1 წუთში}other{Growser ხელახლა გაეშვება # წუთში}}</translation>
<translation id="552342471964912391">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Growser-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="3826701455067637694">გაუშვით Growser ავტომატურად, რომ მომენტალურად დაიწყოთ დათვალიერება.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ინსტალატორი</translation>
<translation id="3293668930608086049">Growser იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="2827121003398607864">Growser გაუმჯობესდა</translation>
<translation id="3071313329776323836">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია Growser-ში</translation>
<translation id="7624307931717240213">ინფორმაციას ვიყენებთ ამ სერვისის გასაუმჯობესებლად. იხილეთ კონფიდენციალურობის დებულება და მომსახურების პირობები.</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="222435847253721602">Growser აპის ჩამოტვირთვა</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="3343095737966473035">Growser არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="5477319665405831211">მოახდინეთ Growser-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="2339273275658335597">Growser-ის განახლება</translation>
<translation id="4870714623113535320">თქვენი ნამუშევარი დაცულია Growser-ში</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME"/>-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="4784414698887946907">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Growser-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="8543787950557226450">ნაგულისხმევ Growser-ზე გადაყენება</translation>
<translation id="4859382825808018797">Brave-ში თქვენი ნამუშევრის დაცვის უზრუნველსაყოფად თქვენი ორგანიზაცია შეძლებს გარკვეული ინფორმაციის ნახვას ან მართვას, როდესაც Brave-ში ხართ შესული.</translation>
<translation id="4976450819672499783">დააყენეთ Growser ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="1978509466033734608">ააჩქარეთ Growser-ის მუშაობა</translation>
<translation id="8607348724092473027"><ph name="PAGE_TITLE"/> — Growser Origin Canary</translation>
<translation id="2684504034454188774">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Growser იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="1652855885539187849">Growser პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7397737266068428588">თქვენი საძიებო სისტემა შეიცვალა Growser-ს მიღმა. თქვენი დაცვის მიზნით, Growser-მა დააბრუნა ის თავდაპირველ ნაგულისხმევ პარამეტრებზე. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="9148690296223500734">მოირგეთ Growser, რათა მას ახალი იერი შესძინოთ</translation>
<translation id="7963515534397191222">Growser ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS"/> წამი</translation>
<translation id="5545136190679883344">თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>წაშალეთ თქვენს ანგარიშში Growser მონაცემები<ph name="END_LINK"/></translation>
<translation id="9044562649276955255">სწრაფად გახსენით Gemini Growser-ში, როდესაც ის დაგჭირდებათ</translation>
<translation id="5687542525349822727">Growser-ის დაყენება ნაგულისხმევად</translation>
<translation id="6396151137840491551">Growser ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="2925193881330501265">თქვენ შესული ხართ Growser-ში როგორც <ph name="USER_EMAIL_ADDRESS"/>. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="6915252145142862992">ეს Growser-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="7766756101194440006">მაქსიმალურად გამოიყენეთ Growser თქვენს <ph name="DEVICE_TYPE"/>-ზე Growser აპის მეშვეობით</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="7685904775439037072">Growser-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="3230755314472063687">ჩაამაგრეთ Growser ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="8069447462453318634">აირჩიეთ „ხელსაწყოთა ზოლში ჩამაგრება“</translation>
<translation id="6175141682081019059">Growser-ის აპების ფონურ რეჟიმში მუშაობის გათიშვა</translation>
<translation id="80790299200510644">სურათების ძიება</translation>
<translation id="8086881907087796310">ინსტალაცია ვერ მოხერხდა, რადგან თქვენი კომპიუტერი არ აკმაყოფილებს მინიმალურ მოთხოვნებს აპარატურის კუთხით.</translation>
<translation id="5528402763209637578"><ph name="PAGE_TITLE"/> — Growser Origin for Testing</translation>
<translation id="2061155704815580583">Growser საჭიროებს მდებარეობაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="3576319845915562805">შემდეგ ჯერზე, როცა გახსნით Growser-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას ფასისთვის თვალყურის დევნების გაფრთხილებების ჩართვის შესახებ.</translation>
<translation id="3728025339793417202">მიიღეთ გაფრთხილებები ფასის დაწევის შესახებ იმ ერთეულებზე, რომლებიც გაინტერესებთ, Growser აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="8118331347066725040">გამოხმაურება Lens-ით ძიების შესახებ</translation>
<translation id="4449306641116952869">მოირგეთ Growser</translation>
<translation id="5334309298019785904">ChromeOS-ის საშუალებით ვერ მოხერხდა თქვენი მონაცემების სინქრონიზაცია, რადგან თქვენს დომენზე სინქრონიზაცია მიუწვდომელია.</translation>
<translation id="813913629614996137">მიმდინარეობს ინიცირება…</translation>
<translation id="5775051495647233404">გახსენით Gemini Growser-ში კლავიატურის მალსახმობით.</translation>
<translation id="1081849497974110565">Growser-ის მომსახურების დამატებითი პირობები</translation>
<translation id="9067428552314418522">Growser-მა დაბლოკა ეს ფაილი, რადგან ის სახიფათოა.</translation>
<translation id="8177472873527554730">გვერდზე კონტენტი ვერ მოიძებნა</translation>
<translation id="6219250889396046657">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ Growser-ის მონაცემები თქვენს ანგარიშში, <ph name="USER_EMAIL"/></translation>
<translation id="8221491193165283816">როგორც წესი, თქვენ ბლოკავთ შეტყობინებებს. ამ საიტისგან შეტყობინებების მისაღებად დააწკაპუნეთ აქ.</translation>
<translation id="8377926237617998195">თქვენი კამერა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK"/>სისტემის პარამეტრები<ph name="END_LINK"/> და მიანიჭეთ Growser-ს წვდომა</translation>
<translation id="1755067029031059271">Growser ვერ ადასტურებს ამ გაფართოების წარმომავლობას და შესაძლოა, ის სახიფათო იყოს. წაშალეთ ის Growser-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="8207657266087451193">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Growser შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Growser-ში. ამის გამორთვა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="7792526144795244436">გსურთ, შეხვიდეთ Growser-ის ახალ პროფილში?</translation>
<translation id="183102473074922918">Gemini-ს Growser-ის სისტემურ არეში ჩვენება და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="976541154724186511"><ph name="BEGIN_LINK"/>Growser გაგაფრთხილებთ<ph name="END_LINK"/> არაუსაფრთხო საიტებისა და ჩამოტვირთვების შესახებ</translation>
<translation id="8060549744348950090">ბოლო დროს არ ყოფილხართ. Growser-მა ამოშალა <ph name="PERMISSION"/>.</translation>
<translation id="7402663241490331652">შეიძინეთ, თარგმნეთ და ამოიცანით, რასაც ხედავთ თქვენი კამერის მეშვეობით Growser iOS აპში</translation>
<translation id="8313851650939857356">გაშვების შეცდომა: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="6098476632210317894">თქვენი ორგანიზაცია ხურავს Growser-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება.</translation>
<translation id="8321888067342493336">სურათად შენახვა</translation>
<translation id="2591326305549412656"><ph name="USER_EMAIL_ADDRESS"/> ადრე იყენებდა Growser-ს</translation>
<translation id="6771602601399828881">უნარების ჩართვა Growser-ში</translation>
<translation id="5592122595094519401">განაახლეთ Growser, რომ განაგრძოთ Growser-ის მონაცემების გამოყენება თქვენს Growser ანგარიშში, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="2569754604093464025">Growser-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8-ს.</translation>
<translation id="8362914115861174987">თარგმნა შემდეგ ენაზე:</translation>
<translation id="8367705492654390392">იკითხეთ, რაც გსურთ</translation>
<translation id="7296197595428914424">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Growser-ში. შესვლის შემდეგ ეს პაროლი შეინახება თქვენს Growser ანგარიშში.</translation>
<translation id="9098234372282930719">დაგჭირდებათ Growser-ის გადატვირთვა.</translation>
<translation id="1327729221471951979">Growser გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK"/></translation>
<translation id="8577108764439626300">ამ გაფართოების გამოქვეყნება გაუქმდა მისი დეველოპერის მიერ და ის, შესაძლოა, არ იყოს უსაფრთხო. წაშალეთ ის Growser-იდან, რომ მას აღარ შეეძლოს თქვენი მონაცემების (მათ შორის, პერსონალური ინფორმაციის) ნახვა და შეცვლა თქვენ მიერ მონახულებულ საიტებზე.</translation>
<translation id="4234753748520037091">Growser საჭიროებს თქვენი ვინაობის დადასტურებას, სანამ მონაცემები Growser ანგარიშში შეინახება და თქვენს მოწყობილობებში გამოიყენება. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="5337999052834672687">{0,plural, =1{ხელახლა გაუშვით Growser დღის განმავლობაში}other{ხელახლა გაუშვით Growser # დღის განმავლობაში}}</translation>
<translation id="8438543370129609977">სურათით ძიების გამოყენებისას სერვერზე გაიგზავნება გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით. <ph name="LEARN_MORE"/></translation>
<translation id="2936579431423833666">შეიტყვეთ მეტი Growser-ში სურათების ძიების გამოყენების შესახებ</translation>
<translation id="6914496861676471566">ინსტალაციის პროგრამის არქივი დაზიანებულია ან არასწორია. ხელახლა ჩამოტვირთეთ Growser.</translation>
<translation id="4378573854226202617">Growser-ის მუშაობისთვის საჭიროა Windows 10 ან უფრო ახალი ვერსია.</translation>
<translation id="6431861494713261006">არასავალდებულო: ChromeOS-ის ფუნქციებისა და წარმადობის გაუმჯობესების ხელშეწყობა დიაგნოსტიკური და გამოყენების მონაცემების Growser-ისთვის ავტომატურად გაგზავნის მეშვეობით.</translation>
<translation id="8691137711639873980">თქვენს Growser ანგარიშში Growser მონაცემები რომ შეინახოთ და გამოიყენოთ ისინი, დაადასტურეთ ვინაობა</translation>
<translation id="3251012123600267109">აჩვენებს Growser-ში შესვლის მოთხოვნებს</translation>
<translation id="2097604701283463988">Growser მოძველდა</translation>
<translation id="6080203201796279095">გმადლობთ, რომ Growser აირჩიეთ ნაგულისხმევ ბრაუზერად!</translation>
<translation id="871233388178581868">პაროლების შემოწმებას Growser შეძლებს მათი შენახვის შემდეგ</translation>
<translation id="8525579356836940628">ინსტალაცია გაჩერდა</translation>
<translation id="909104880763805392">თან იქონიეთ პაროლები, ჩანართები და სხვა კონტენტი გზაში Growser-ის მეშვეობით თქვენს <ph name="DEVICE_TYPE"/>-ზე</translation>
<translation id="3667461919057407535">მიიღეთ გაფრთხილება, თუ Growser აღმოაჩენს თქვენს რომელიმე პაროლს მონაცემთა საჯარო დარღვევაში</translation>
