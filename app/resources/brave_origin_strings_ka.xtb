<translation id="4970880042055371251">ChromeOS-ის ვერსია</translation>
<translation id="2182657378556811785">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Growser.</translation>
<translation id="6311668361877328515">აჩქარებს Growser-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Growser ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="7402642357351265733">თუ Growser-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4673710618874938871">შესული ხართ, როგორც <ph name="USER_NAME"/>, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="8142245354207161805">როგორც ჩანს, პროფილი გამოიყენება სხვა Growser პროცესის მიერ (<ph name="PROCESS_ID"/>) სხვა კომპიუტერში (<ph name="HOST_NAME"/>). Growser-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Growser.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="2014343159590733363">თქვენი Growser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Growser ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="2408746614080689238">როცა შესული ხართ, Growser-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Growser ანგარიშიდან. <ph name="SHORTCUT"/> შეცვლის თქვენი Growser სერვისების პარამეტრებს.</translation>
<translation id="847561904663814268">Growser-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST"/>. გთხოვთ, შექმნათ Growser-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="3834935463915107022">მაინც გსურთ Growser-იდან გასვლა?</translation>
<translation id="8668413672647811944">Growser-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4941816441131888792">ბოლო დროს არ ყოფილხართ. Growser-მა ამოშალა <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> და კიდევ <ph name="COUNT"/>.</translation>
<translation id="844451748565342664">თუ Gemini Growser-ში გახსნილია, გვერდითი პანელი ღია რჩება ახალი ჩანართების შექმნისას</translation>
<translation id="215320507915280336">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Growser-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
