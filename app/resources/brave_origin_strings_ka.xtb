<translation id="1497802159252041924">შეცდომა ინსტალაციისას: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ეს გვერდი დაცულია</translation>
<translation id="5147525139567260139">Growser ჩანართის გაზიარება</translation>
<translation id="721261350616678948">Growser-ში შესვლა</translation>
<translation id="1547469039832541117">დაასრულებს მონიშნულ ამოცანას.</translation>
<translation id="51545890371361355">Growser-ის ჩამაგრება</translation>
<translation id="6570689355868013775">Growser-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="1902837727299679178">Growser-ს სურს თქვენი პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="1655849915812740665">მიიღეთ Growser-ის საუკეთესო ფუნქციები Growser აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="4449148723378534338">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Growser-ში</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1665602916345474427">შესული ხართ, როგორც <ph name="USER_NAME"/>, <ph name="USER_EMAIL"/>, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="509363484780540563">შეგიძლიათ გამოიყენოთ Growser, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ. ის ასევე ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="1709772298389099340">უზრუნველყოფს მაღალ პრივილეგიებს <ph name="BROWSER_NAME"/>-ისთვის.</translation>
<translation id="8004287232784878841">Growser მალე წაშლის დათვალიერების მონაცემებს</translation>
<translation id="4197839351786449392">Growser შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="7814200940910057384">Growser-ის მონაცემები გასუფთავდა</translation>
<translation id="9048361966237194186">Growser გაეშვება <ph name="REMAINING_TIME"/>-ში</translation>
<translation id="5524150602137990006">როცა HTTPS მიუწვდომელია, Growser გამოიყენებს დაუცველ კავშირს თქვენი გაფრთხილების გარეშე</translation>
<translation id="6797402139308059782">დავრთოთ ნება Growser-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="5994491947936308173">აირჩიეთ <ph name="BEGIN_BOLD"/>დიახ<ph name="END_BOLD"/> Windows-ის შეტყობინებაში, რომ ჩაამაგროთ Growser ამოცანათა ზოლში სწრაფი წვდომისთვის.</translation>
<translation id="5875673934455379806">Growser-ის ხელახალი ინსტალაცია</translation>
<translation id="4529028207655448215">Growser ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="7362761326208547489">შემდეგ ჯერზე, როცა გახსნით Growser-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას Growser პაროლების მმართველის გამოყენების შესახებ.</translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="3541642064306182066">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Growser ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK"/>გამოდით Growser-იდან<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">ჩამოტვირთეთ Growser თქვენს ტელეფონში, რომ გახსნათ ან შექმნათ ჩანართების ახალი ჯგუფები გზიდან.</translation>
<translation id="4559627161887338743">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Growser ანგარიშები. თქვენი Growser ანგარიშები გამოიყენება Growser ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE"/>-ს. <ph name="LINK_BEGIN"/>შეიტყვეთ მეტი<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="4528406859989804913">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Growser-ის პროფილზე. თქვენი Growser-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME"/>-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Growser ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Growser-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Growser დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK"/></translation>
<translation id="8643267611122541711">Growser-ის განმაახლებელი სერვისი</translation>
<translation id="1649714546770135458">ამ პარამეტრის გამორთვის შემთხვევაში, Growser-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Growser-ში შესვლის გარეშე</translation>
<translation id="189297655255130768">Growser არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="8422047647688939115">თქვენი ორგანიზაცია, <ph name="MANAGER"/>, მოითხოვს, რომ Growser-ში შეხვიდეთ</translation>
<translation id="4035053306113201399">განახლების მისასადაგებლად ChromeOS უნდა გადაიტვირთოს.</translation>
<translation id="9048754176089806686">Growser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE"/> წუთი</translation>
<translation id="1775322105159056176">Growser ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="197326043290947695">დაათვალიერეთ უფრო ჭკვიანურად სურათების ძიების მეშვეობით</translation>
<translation id="4372901050442507812">შეიტყვეთ, რატომ ბლოკავს Growser ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="2703425183860615504">იზრუნებს, რომ თქვენი Growser-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Growser-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Growser-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="9220324636239049437">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Growser-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2039417478970545937">პარამეტრები.</translation>
<translation id="5499149312981370855">აირჩიეთ, დაერთოს თუ არა Growser ისტორია, Growser სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="5152523902653128156">ჩაშენებულია Growser-ში, რათა დაგეხმაროთ ძლიერი პაროლების შექმნაში, შენახვასა და ავტომატურად შევსებაში. დაამატეთ მალსახმობი მარტივი წვდომისთვის.</translation>
<translation id="6959434860418352144">დააწკაპუნეთ ღილაკზე „Growser-ის მორგება“ ახალი ჩანართის გვერდზე, რათა Growser-ს ახალი იერი შესძინოთ</translation>
<translation id="2472891440303445472">Growser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="2054358978145431867">Growser iOS-ის მომდევნო ჯერზე გახსნისას ნახავთ მოთხოვნას <ph name="FEATURE_NAME"/>-ის ცდის შესახებ.</translation>
<translation id="2726948994393234543">თქვენი პაროლები და Growser-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Growser ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Growser-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Growser არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Growser არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
