<translation id="5874208157501051620">გაფართოების გამოსაყენებლად შედით Growser-ში</translation>
<translation id="3561569806301739367">Growser-მა დაბლოკა <ph name="FILE_NAME"/>, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="3205074487970075628">Growser იყენებს თქვენს კამერას.</translation>
<translation id="1819119299840995223">Growser-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="8616874628011103667">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა Growser ანგარიშით Growser-ის გამოყენება.</translation>
<translation id="5213389303624223677">დააყენეთ Growser ნაგულისხმევ ბრაუზერად და მიიღეთ მარტივი წვდომა იმ ფუნქციებზე, რომლებსაც იცნობთ, გიყვართ და ენდობით.</translation>
<translation id="4264606872840545968">Growser-ის მალსახმობი</translation>
<translation id="6890616081898535725">Growser-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="335632367599648646">ნამდვილად გსურთ მოახდინოთ Growser-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="7920857181125123335">გასაგრძელებლად შედით Growser-ში ანგარიშით <ph name="EMAIL"/>. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="3256100650978957522">Growser-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="5880764554173582719">Growser Origin არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Growser Origin-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="4091049150278654573">დაადასტურეთ ვინაობა, რომ თქვენს Growser ანგარიშში გამოიყენოთ და შეინახოთ Growser-ის მონაცემები</translation>
<translation id="2532326772258858491">Growser უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="2139300032719313227">გადატვირთეთ ChromeOS</translation>
<translation id="638302211119176182">Growser წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="7167975344637731051">ჩამოტვირთეთ Growser თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="890319829408077946">გამორთული • Growser ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="1684121725014454063">მოგესალმებათ Growser პროფილები</translation>
<translation id="8211983866539058675">შემდეგ ჯერზე, როცა გახსნით Growser-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="7906693299331092358">ანგარიშის ამოშლა Growser-იდან</translation>
<translation id="2675662665675552980">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Growser-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="5590013613412457132">Growser-ის დეინსტალაცია</translation>
<translation id="7185585387858242335">მალსახმობები იხსნება Growser-ში</translation>
<translation id="3617744907966785605">თქვენი ორგანიზაცია ხურავს Growser-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8646609321956191980">თითოეულ პროფილში ინახება საკუთარი Growser ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6756656512757374876">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK"/>როგორ ინარჩუნებს Growser თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">ამ პარამეტრის ცვლილება ამოქმედდება Growser-ის გადატვირთვისთანავე.</translation>
<translation id="3396870972301571614">მართეთ თქვენი გაფართოებები Growser-ის მთავარ მენიუში „გაფართოებებზე“ დაწკაპუნებით.</translation>
<translation id="2535436634051789953">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Growser პროფილიდან რომ ნახოთ</translation>
<translation id="6376474391582629025">გამოიყენეთ Growser აპი, რომ საუკეთესო AI ხელსაწყოები თან იქონიოთ</translation>
<translation id="2312399718665761438">მართლწერის შეცდომების გასასწორებლად, Growser თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Growser-ს უგზავნის</translation>
<translation id="3507835409099344374">Growser-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="9156965752763025780">თქვენი ცვლილებები გააქტიურდება Growser-ის შემდეგი გაშვებისას.</translation>
<translation id="3387992981600748596">Growser ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="3119017564683030312">გააგრძელეთ იქიდან, სადაც გაჩერდით: Growser-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="245693535809364497">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Growser საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="9210457680074341078">თუ თქვენს სანიშნეებს Growser ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Growser-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="1363996462118479832">ChromeOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="4694512973195649124">ამ აპის მონაცემების Growser-იდან ამოშლა</translation>
<translation id="1257247502847251159">Growser საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="1489465648257900784">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Growser-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Growser-ის ახალი ვერსია.</translation>
<translation id="1505112054322049777">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Growser როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Growser სერვისებს</translation>
<translation id="6666624454809779082">Growser უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="5848830584656405219">შედით Growser-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Growser ანგარიშში.</translation>
<translation id="4020203987234748583">აჩქარებს Growser-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Growser ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="3848421741245997269">{count,plural, =1{თქვენი Growser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Growser ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი Growser-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Growser ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="3136039682492230890">Growser გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="1547295885616600893">ChromeOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="8211837073776713955">Growser გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME"/> დაშვებულთა სიაშია.</translation>
<translation id="8237613041998823669">Growser Origin — <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">შეეხეთ გასაგრძელებლად</translation>
<translation id="6862030660799253820">სურათების ძიების მეშვეობით ამ სურათის ძიება</translation>
<translation id="3028928628792374067">Growser-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME"/>“ შეიცავს მავნე პროგრამას</translation>
<translation id="6877155553248388166">ძიების არეალის ქვედა მარჯვენა კუთხე: მარჯვნივ <ph name="RIGHT"/>%, ქვემოთ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">კოპირება</translation>
<translation id="6898028264630240901">შეგიძლიათ ჩაამაგროთ კონტექსტური ამოცანები, რათა დასვათ კითხვები დათვალიერებისას</translation>
<translation id="862687584320433626">დააყენეთ Growser ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის თქვენს ამოცანათა ზოლში</translation>
<translation id="1991562568473125499">Growser პროფილების &amp;მართვა</translation>
<translation id="6995921847081718550">ეს მოქმედება:
          <ph name="LINE_BREAKS"/>
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK"/>
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK"/>
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAK"/>
            • გადააყენებს Growser-ის მალსახმობებს
            <ph name="LINE_BREAKS"/>
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="5529781826378237601">თქვენ მიაღწიეთ Growser-ის <ph name="BOOKMARK_LIMIT"/> სანიშნის ლიმიტს, ამიტომ თქვენი ზოგიერთი სანიშნე ჯერ არ შენახულა თქვენს Growser ანგარიშში.

ახალი სანიშნეების შენახვა თქვენს ანგარიშში ვერ მოხერხდება, სანამ რამდენიმეს არ წაშლით. ახლა გასვლის შემთხვევაში შეუნახავი სანიშნები წაიშლება.</translation>
