<translation id="6040143037577758943">إغلاق</translation>
<translation id="9138151530563359301">‏تجربة تسوّق أكثر تميزًا على الإنترنت بانتظارك مع تطبيق Growser على "<ph name="DEVICE_TYPE"/>"</translation>
<translation id="700488072601322385">‏لحماية بياناتك، يمكنك السماح لمتصفِّح Growser بإزالة الأذونات من المواقع الإلكترونية التي لم تزُرها مؤخرًا. لا يؤدي تفعيل هذا الإعداد إلى إيقاف الإشعارات.</translation>
<translation id="9071554113102421877">‏&amp;فتح في Growser</translation>
<translation id="6069027071882229820">نسخ كصورة</translation>
<translation id="7861579472672677409">‏تمت إضافة <ph name="EXTENSION_NAME"/> إلى Growser</translation>
<translation id="5849446944780602366">‏تخصيص Growser والتحكُّم فيه. هناك تحديث متوفر.</translation>
<translation id="5711722515923392428">‏مفعَّلة • لا يمكن لمتصفّح Growser التحقُّق من مصدر هذه الإضافة</translation>
<translation id="6355366566986893068">‏حسابك في Growser</translation>
<translation id="7433698744896946664">‏السماح للإضافة بعرض طلبات الوصول في شريط أدوات Growser</translation>
<translation id="4168372721886011198">‏ملف <ph name="FILE_NAME"/> ضار، لذلك فقد حظره Growser.</translation>
<translation id="991182453936521413">‏سيتم إغلاق Growser وحذف بيانات التصفُّح قريبًا</translation>
<translation id="4060970194201477024">‏يمكنك من هنا التبديل بين الملفات الشخصية على Growser.</translation>
<translation id="7815000350132166985">‏في حال السماح بملفات تعريف الارتباط، قد يستخدمها Growser في عملية التحميل المُسبق.</translation>
<translation id="6165508094623778733">مزيد من المعلومات</translation>
<translation id="5739368447874065758">‏محو بيانات Growser في حسابك</translation>
<translation id="6685697979743742605">‏قد يكون هذا الملف خطيرًا.<ph name="LINE_BREAK"/>بإمكان Growser التحقُّق من عملية التنزيل هذه في حال أدخلت كلمة المرور. وتُرسل معلومات حول الملف إلى ميزة "التصفّح الآمن من Growser"، ولكن يظل محتوى الملف وكلمة المرور على جهازك.</translation>
<translation id="6182736845697986886">تعذَّر تثبيت التطبيق بسبب حدوث خطأ داخلي في خادم التحديث.</translation>
<translation id="4368341489795135329">‏يُرجى التأكُّد من تسجيل الدخول إلى متصفِّح Growser على جهازك <ph name="TARGET_DEVICE_NAME"/> ثم محاولة الإرسال مرة أخرى.</translation>
<translation id="3038354906709778538">‏ثبَّتَ برنامج آخر على جهاز الكمبيوتر تطبيقًا قد يؤدي إلى تغيير طريقة عمل Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="8320964054148936490">‏يحتوي هذا الكمبيوتر فعلاً على إصدار أحدث من Growser. إذا كان البرنامج لا يعمل، يُرجى إزالة Growser وإعادة المحاولة.</translation>
<translation id="3574823187131579180">{0,plural, =0{‏ستتم إعادة تشغيل Growser الآن}=1{‏ستتم إعادة تشغيل Growser في غضون ثانية واحدة}two{‏ستتم إعادة تشغيل Growser في غضون ثانيتين}few{‏ستتم إعادة تشغيل Growser في غضون # ثوان}many{‏ستتم إعادة تشغيل Growser في غضون # ثانيةً}other{‏ستتم إعادة تشغيل Growser في غضون # ثانية}}</translation>
<translation id="6239161312595354541">طرح أسئلة حول هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="5980269616827212166">‏يحتاج Growser إلى إذن للوصول إلى مساحة التخزين من أجل تنزيل الملفات.</translation>
<translation id="7651600795135059130">‏يعمل هذا الوضع على التحقّق من عناوين URL باستخدام قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Growser.</translation>
<translation id="5019879183386042809">‏جعل Growser المتصفح التلقائي</translation>
<translation id="6248988683584659830">البحث في الإعدادات</translation>
<translation id="1481716298194191711">‏يمكنك الاستفادة من أفضل ميزات الأمان من Growser أثناء التنقل باستخدام تطبيق Growser على هاتفك</translation>
<translation id="7445061995866044926">‏هل تريد الخروج من Growser؟</translation>
<translation id="4659866260728515512">‏تستخدم علامات التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Growser بإيقاف علامات التبويب هذه.</translation>
<translation id="6806912298071949921">‏تخصيص ملفك الشخصي في Growser</translation>
<translation id="3792238845239580301">‏تسمية ملفك الشخصي على Growser</translation>
<translation id="5874208157501051620">‏تطلب منك إحدى الإضافات تسجيل الدخول إلى Growser</translation>
<translation id="3561569806301739367">‏قد يكون ملف <ph name="FILE_NAME"/> ضارًا، لذلك فقد حظره Growser.</translation>
<translation id="3205074487970075628">‏يستخدم Growser الكاميرا.</translation>
<translation id="1819119299840995223">‏عملية أخرى على Growser قيد التقدم. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="8616874628011103667">‏الآن أصبح استخدام Growser مع حسابك في Growser وفي أجهزة الكمبيوتر المشتركة أكثر سهولة.</translation>
<translation id="5213389303624223677">‏يمكنك الوصول بسهولة إلى الميزات المفضَّلة والموثوقة لديك من خلال ضبط Growser كمتصفِّحك التلقائي.</translation>
<translation id="4264606872840545968">‏اختصار Growser</translation>
<translation id="6890616081898535725">‏حَظَر Growser عملية التنزيل هذه لأنّ الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="335632367599648646">‏هل تريد فعلًا إزالة Growser؟</translation>
<translation id="6375219077595103062">إضافة اختصار إلى "مدير كلمات المرور"</translation>
<translation id="6388799252195623474">أريد مساعدة بخصوص هذا المحتوى</translation>
<translation id="7920857181125123335">‏للمتابعة، يُرجى تسجيل الدخول إلى Growser باستخدام حساب <ph name="EMAIL"/>. ويضمن ذلك أنّك قد اطّلعت على سياسات مؤسستك.</translation>
<translation id="3256100650978957522">‏شعار Growser على شاشة كمبيوتر</translation>
<translation id="6373767849825830651">‏ إن Growser هو متصفح ويب يشغّل صفحات الويب والتطبيقات بسرعة مذهلة. إنه سريع وثابت وسهل الاستخدام. يمكنك تصفح الويب بشكل أكثر أمانًا من خلال ميزات الحماية من البرامج الضارة والتصيّد الاحتيالي المدمجة في Growser.</translation>
<translation id="4091049150278654573">‏لضمان إمكانية استخدامك لبيانات Growser وحفظها في حسابك على Growser متى شئت، يجب إثبات هويتك</translation>
<translation id="2532326772258858491">‏سيعمل Growser بشكل أسرع ومن المفترض أن تعمل الميزات التي تستخدِم JavaScript على النحو المطلوب</translation>
<translation id="6436260184216827876">ميزة "البحث بالصور" ليست متوفرة. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="2139300032719313227">‏إعادة تشغيل نظام التشغيل Growser</translation>
<translation id="638302211119176182">‏يُحمِّل Growser مسبقًا المزيد من الصفحات التي يُحتمل أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="7167975344637731051">‏يكفي تنزيل متصفِّح Growser على هاتفك لتتبُّع الأسعار والحصول على تنبيهات عند انخفاضها على أي موقع إلكتروني</translation>
<translation id="890319829408077946">‏غير مفعَّلة • لا يمكن لمتصفّح Growser التحقُّق من مصدر هذه الإضافة</translation>
<translation id="1684121725014454063">‏مرحبًا بك في الملفات الشخصية على Growser</translation>
<translation id="8211983866539058675">‏عند فتح Growser على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام مجموعات علامات التبويب.</translation>
<translation id="7906693299331092358">‏إزالة الحساب من Growser</translation>
<translation id="2675662665675552980">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Growser.</translation>
<translation id="648319183876919572">تعزِّز ميزة "الحماية المُحسّنة للتصفّح الآمن" حمايتك من المواقع الإلكترونية الضارة وعمليات التنزيل الخطيرة.</translation>
<translation id="5590013613412457132">‏إزالة Growser</translation>
<translation id="7185585387858242335">‏يتم فتح الاختصارات في Growser</translation>
<translation id="3617744907966785605">‏تغلق مؤسستك Growser في حال عدم استخدامه لمدّة <ph name="TIMEOUT_DURATION"/>. تم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="8646609321956191980">‏يحتفظ كل ملف شخصي بالمعلومات الخاصة به على Growser، مثل الإشارات المرجعية والسجلّ وكلمات المرور وغير ذلك.</translation>
<translation id="6756656512757374876">‏مزيد من المعلومات حول <ph name="BEGIN_LINK"/>الطريقة التي يتّبعها Growser للحفاظ على خصوصية بياناتك<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">‏سيتم تطبيق التغييرات في هذا الإعداد بعد إعادة تشغيل Growser.</translation>
<translation id="3396870972301571614">‏يمكنك إدارة الإضافات من خلال النقر على "الإضافات" في قائمة Growser الرئيسية.</translation>
<translation id="2535436634051789953">‏يمكنك التبديل للاطّلاع على كلمات المرور من ملف شخصي آخر في Growser.</translation>
<translation id="6376474391582629025">‏أفضل أدوات الذكاء الاصطناعي ستكون متاحة لك أثناء التنقل عند استخدام تطبيق Growser</translation>
<translation id="2312399718665761438">‏لإصلاح الأخطاء الإملائية، يُرسِل Growser ما تكتبه في حقول النص إلى Growser</translation>
<translation id="3507835409099344374">‏الانتقال إلى إعدادات الإشعارات في Growser</translation>
<translation id="6600016381025017075">البحث عن أي محتوى على هذه الصفحة</translation>
<translation id="9156965752763025780">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Growser.</translation>
<translation id="3387992981600748596">‏يتم الآن فتح Growser تلقائيًا عند بدء تشغيل Windows، ما يتيح لك بدء التصفّح على الفور. ويمكنك إيقاف هذا الإجراء من خلال الإعدادات.</translation>
<translation id="3119017564683030312">‏المتابعة من حيث توقفت: استعاد Growser علامات التبويب من جلستك الأخيرة. يمكنك إيقاف هذه الميزة في</translation>
<translation id="245693535809364497">‏يحتاج Growser إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للمكان حولك.</translation>
<translation id="9210457680074341078">‏إذا حفظت أيضًا إشاراتك المرجعية في حسابك على Growser، يمكنك تتبُّع أسعار المنتجات من خلال Growser وتلقّي إشعارات عند انخفاض السعر.</translation>
<translation id="6676384891291319759">الدخول إلى الإنترنت</translation>
<translation id="1363996462118479832">‏تعذّر على نظام التشغيل Growser مزامنة بياناتك بسبب حدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="4694512973195649124">‏إزالة بيانات هذا التطبيق من Growser</translation>
<translation id="1257247502847251159">‏يحتاج Growser إلى إذن للوصول إلى الميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="6712881677154121168">حدث خطأ في عملية التنزيل: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="1489465648257900784">‏لا يمكن استخدام ملفك الشخصي نظرًا لأنه من إصدار أحدث من Growser.

قد تكون بعض الميزات غير متاحة. يُرجى تحديد دليل ملف شخصي مختلف أو استخدام إصدار أحدث من Growser.</translation>
<translation id="1505112054322049777">‏للحصول على خيارات مخصَّصة والاستفادة من ميزات أخرى، يمكنك تضمين متصفّح Growser في "النشاط على الويب وفي التطبيقات" وخدمات Growser المرتبطة</translation>
<translation id="6666624454809779082">‏يتم تثبيت Growser بالفعل لجميع المستخدمين على جهاز الكمبيوتر.</translation>
<translation id="5848830584656405219">‏يتيح لك تسجيل الدخول إلى Growser الوصول إلى الإشارات المرجعية وغيرها على جميع أجهزتك. وسيتم حفظ هذه الإشارة المرجعية في حسابك على Growser بعد تسجيل الدخول إليه.</translation>
<translation id="4020203987234748583">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في Growser، مع تقليل قدرة Growser على مقاومة الهجمات قليلاً. هذا الإعداد مفعَّل.</translation>
<translation id="3848421741245997269">{count,plural, =1{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="3136039682492230890">‏ينصح متصفِّح Growser بفحص هذا الملف لأنّه قد يكون خطيرًا.</translation>
<translation id="1547295885616600893">‏أصبح نظام التشغيل Growser متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS"/>برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">ترجمة</translation>
<translation id="8211837073776713955">‏يتم إعلامك من خلال Growser في حال تم اختراق كلمات المرور في أي وقت.</translation>
<translation id="684888714667046800">يتعذّر الاتصال بالإنترنت. في حال استخدام جدار حماية، يُرجى التأكّد من إدراج <ph name="PRODUCT_EXE_NAME"/> في القائمة المسموح بها.</translation>
<translation id="7830723774663008396">Growser - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">‏يجب النقر على مفتاح Tab للمتابعة</translation>
<translation id="6862030660799253820">البحث عن هذه الصورة باستخدام ميزة "البحث بالصور"</translation>
<translation id="3028928628792374067">‏رصد Growser أنّ الإضافة "<ph name="EXTENSION_NAME"/>" تحتوي على برامج ضارة.</translation>
<translation id="6877155553248388166">أسفل يسار مساحة البحث: %<ph name="RIGHT"/> من الجهة اليسرى و%<ph name="BOTTOM"/> من الأسفل</translation>
<translation id="6896758677409633944">نسخ</translation>
<translation id="6898028264630240901">يمكنك تثبيت "المهام السياقية" لطرح الأسئلة أثناء التصفّح</translation>
<translation id="862687584320433626">‏ننصحك بضبط Growser كمتصفّح تلقائي وتثبيته في شريط المهام</translation>
<translation id="1991562568473125499">‏&amp;إدارة الملفات الشخصية على Growser</translation>
<translation id="6995921847081718550">‏سيؤدي هذا الإجراء إلى ما يلي:
          <ph name="LINE_BREAKS"/>
            • إعادة ضبط صفحة بدء التشغيل وصفحة علامة التبويب الجديدة ومحرك البحث وعلامات التبويب المثبَّتة
            <ph name="LINE_BREAK"/>
            • إيقاف الإضافات
            <ph name="LINE_BREAK"/>
            • حذف ملفات تعريف الارتباط وبيانات الموقع الإلكتروني المؤقَّتة الأخرى
            <ph name="LINE_BREAK"/>
            • إعادة ضبط اختصارات Growser
            <ph name="LINE_BREAKS"/>
            لن يؤثّر هذا الإجراء في الإشارات المرجعية والسجلّ وكلمات المرور المحفوظة.</translation>
<translation id="6934579572334859869">طرح أسئلة حول هذه الصورة باستخدام ميزة "البحث بالصور"</translation>
<translation id="5529781826378237601">‏لقد بلغت الحدّ الأقصى لعدد الإشارات المرجعية في Growser، وهو <ph name="BOOKMARK_LIMIT"/>، لذا لم يتم حفظ بعض إشاراتك المرجعية في حسابك على Growser حتى الآن.

ولا يمكن حفظ إشارات مرجعية جديدة في حسابك إلا بعد حذف بعض الإشارات. وفي حال سجّلت الخروج الآن، سيتم حذف الإشارات المرجعية غير المحفوظة.</translation>
<translation id="6965382102122355670">حسنًا</translation>
<translation id="3453763134178591239">‏بنود نظام التشغيل Growser</translation>
<translation id="3335606533094650083">‏يحتاج Growser إلى إذن للوصول إلى الميكروفون من أجل الموقع الإلكتروني هذا.</translation>
<translation id="6643520655691573653">‏يُرجى إدخال عبارة المرور لاستخدام بيانات Growser وحفظها في حسابك (<ph name="ACCOUNT_EMAIL"/>)</translation>
<translation id="7011190694940573312">تعذّر تثبيت هذا الإصدار من نظام التشغيل لأنّه غير متوافق.</translation>
<translation id="7024536598735240744">حدث خطأ في فك ضغط الحزمة: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="280382502853897110">‏اجعل Growser متصفِّحك الدائم</translation>
<translation id="7047386856539490735">هل هذه النتائج مفيدة؟</translation>
<translation id="1705567146636171298">‏تحديث Growser</translation>
<translation id="5499063270485366718">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Growser توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Growser.</translation>
<translation id="1196733835766994012">‏إمكانات الذكاء الاصطناعي ستكون متاحة لك عند استخدام تطبيق Growser على "<ph name="DEVICE_TYPE"/>"</translation>
<translation id="7166289504510860270">‏يمكنك استخدام كلمات المرور وعلامات التبويب وغيرها من البيانات أثناء التنقل من خلال تطبيق Growser على هاتفك</translation>
<translation id="5966368554860795750">‏تخصيص Growser for Testing</translation>
<translation id="792838367208896130">‏يمكنك استخدام Growser في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="375314543563594498">‏إزالة "<ph name="EXTENSION_NAME"/>" من Growser</translation>
<translation id="2332301637111071062">‏تحذف مؤسستك بيانات Growser في حال عدم استخدامها لمدّة <ph name="TIMEOUT_DURATION"/>. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="1008530050039597147">‏يحتاج Growser إلى إذن للوصول إلى الكاميرا من أجل هذا الموقع الإلكتروني.</translation>
<translation id="1197672524850678392">‏تعذَّر إطلاق Growser. يُرجى إعادة المحاولة.</translation>
<translation id="3625983487600668413">‏يمكنك الاحتفاظ بمتصفِّح Growser في شريط التطبيقات (Dock) للوصول إليه بسرعة في أي وقت</translation>
<translation id="5755581833598928580">‏يمكنك فتح Growser عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="7216228761061470870">‏عند استخدام ميزة "البحث بالصور" على الكمبيوتر المكتبي، يتم إرسال عنوان الصفحة ومحتواها وعنوان URL الخاص بها، بما في ذلك ملفات PDF، إلى الخادم.</translation>
<translation id="5516268345616100622">‏إدارة المهام - Growser</translation>
<translation id="1871621397473741084">‏بدء التصفّح على الفور: يمكن الآن فتح Growser تلقائيًا عند بدء تشغيل Windows.</translation>
<translation id="7274695763216404502">تمّ تثبيت اللوحة. يمكنك استخدام ميزة "البحث بالصور" مرة أخرى من خلال شريط الأدوات</translation>
<translation id="7288567540154601580">علامات التبويب والإضافات</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{‏ينصح متصفّح Growser بإزالتها}zero{‏ينصح متصفّح Growser بإزالتها}two{‏ينصح متصفّح Growser بإزالتهما}few{‏ينصح متصفّح Growser بإزالتها}many{‏ينصح متصفّح Growser بإزالتها}other{‏ينصح متصفّح Growser بإزالتها}}</translation>
<translation id="4600669988724328687">‏لمشاركة صوت النظام، افتح "إعدادات النظام" (System Settings) وفعِّل خيار "تسجيل صوت النظام فقط" (System Audio Recording Only) لمتصفّح Growser، ثم أعِد تشغيل المتصفّح.</translation>
<translation id="9068395155143628872">‏تسمح ميزة "قياس أداء الإعلانات" للمواقع الإلكترونية التي تزورها بطلب معلومات من Growser تساعد الموقع الإلكتروني في قياس أداء الإعلانات التي يعرضها. وتحدّ هذه الميزة من عملية تتبّع البيانات ونشاط التصفّح على المواقع الإلكترونية، وذلك من خلال نقل أقل قدر ممكن من المعلومات بينها.</translation>
<translation id="1864557848095568223">‏تحديث Growser</translation>
<translation id="3403365884036456766">‏ملف الإعدادات المفضّلة تالف أو غير صالح.

يتعذر على Growser استعادة إعداداتك.</translation>
<translation id="3511996232906761537">‏الويب والإشارات المرجعية وغيرها من عناصر Growser توجد هنا.</translation>
<translation id="1754899895078387289">‏لا يمكن لأحد الوصول إلى بياناتك المشفّرة بدون استخدام عبارة المرور. ولا تحصل Growser على عبارة المرور هذه أو تخزّنها. وفي حال نسيتها أو أردت تغيير هذه الإعدادات، يجب <ph name="BEGIN_LINK"/>حذف بيانات Growser في حسابك<ph name="END_LINK"/>.</translation>
<translation id="5380963249588143069">‏ضَبَط مشرف النظام Growser لفتح <ph name="ALTERNATIVE_BROWSER_NAME"/> للوصول إلى <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">حدث خطأ</translation>
<translation id="6085660187823915017">‏للحصول على تحديثات Growser في المستقبل، يجب استخدام كمبيوتر يعمل بنظام التشغيل macOS 13 أو إصدار أحدث. ويعمل هذا الكمبيوتر بنظام التشغيل macOS 12.</translation>
<translation id="2865744782251083875">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Growser إذنَي <ph name="PERMISSION_1"/> و<ph name="PERMISSION_2"/>.</translation>
<translation id="4104934885375476361">‏تم ضبط Growser كمتصفّحك التلقائي</translation>
<translation id="7951152294775418909">‏المتابعة من حيث توقفت: يمكن لمتصفّح Growser استعادة علامات التبويب كلما أعدت تشغيله. لإيقاف هذه الميزة، يُرجى الانتقال إلى</translation>
<translation id="3191314862567596053">‏استيراد كلمات المرور إلى Growser</translation>
<translation id="284799389314308801">‏‫1. انقر على <ph name="BUTTON_LABEL"/> أدناه
‫2. انقر على <ph name="BUTTON_2"/> في إعدادات Windows
‫3. انقر على <ph name="BUTTON_3"/> في إشعار Windows لتثبيت Growser في شريط التطبيقات والوصول إليه بسرعة</translation>
<translation id="3943696263619956191">‏<ph name="PAGE_TITLE"/> - إصدار قناة مطوري البرامج من Growser</translation>
<translation id="7450541714075000668">تم نسخ النص.</translation>
<translation id="2034072705932785495">‏يحتاج Growser إلى إذن للوصول إلى الكاميرا من أجل الموقع الإلكتروني هذا.</translation>
<translation id="7129342855140808694">‏لاستخدام الميكروفون، يجب منح Growser إذن الوصول في <ph name="BEGIN_LINK"/>إعدادات النظام<ph name="END_LINK"/></translation>
<translation id="5296583608321648908">‏للحصول على تحديثات Growser في المستقبل، يجب استخدام جهاز يعمل بنظام التشغيل Windows 10 أو إصدار أحدث. يعمل هذا الكمبيوتر بنظام التشغيل Windows 7.</translation>
<translation id="3962395975456095331">‏هل تريد إعادة تشغيل Growser؟</translation>
<translation id="2619516027171717873">‏لا يمكن تثبيت إصدار Growser ذاته الذي يتم تشغيله حاليًا. يُرجى إغلاق Growser وإعادة المحاولة.</translation>
<translation id="6607863494375614497">‏تذكير: أفضل ما تقدّمه Growser في متناول يدك</translation>
<translation id="5337027666828618338">‏من المحتمل أن تعمل المواقع الإلكترونية على النحو المتوقَّع. وسيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ Growser، باستثناء حسابك على Growser إذا كنت مسجلاً الدخول إلى Growser.</translation>
<translation id="3186363903915641692">{0,plural, =1{‏ستتم إعادة تشغيل Growser في غضون دقيقة واحدة}zero{‏ستتم إعادة تشغيل Growser في غضون # دقيقة}two{‏ستتم إعادة تشغيل Growser في غضون دقيقتين}few{‏ستتم إعادة تشغيل Growser في غضون # دقائق}many{‏ستتم إعادة تشغيل Growser في غضون # دقيقةً}other{‏ستتم إعادة تشغيل Growser في غضون # دقيقة}}</translation>
<translation id="552342471964912391">‏لحماية بياناتك، يمكنك السماح لمتصفِّح Growser بإزالة الأذونات من المواقع الإلكترونية التي لم تتم زيارتها مؤخرًا.</translation>
<translation id="3826701455067637694">‏يمكنك فتح Growser تلقائيًا لبدء التصفّح على الفور.</translation>
<translation id="7583399374488819119">أداة تثبيت <ph name="COMPANY_NAME"/></translation>
<translation id="3293668930608086049">‏يستخدم Growser الكاميرا والميكروفون.</translation>
<translation id="2827121003398607864">‏Growser أصبح أفضل</translation>
<translation id="3071313329776323836">‏تتوفّر الآن ميزات إضافية في Growser</translation>
<translation id="7624307931717240213">نستخدم المعلومات لتحسين هذه الخدمة. يُرجى مراجعة "سياسة الخصوصية" و"بنود الخدمة".</translation>
<translation id="7649070708921625228">مساعدة</translation>
<translation id="222435847253721602">‏تنزيل تطبيق Growser</translation>
<translation id="7658239707568436148">إلغاء</translation>
<translation id="3343095737966473035">‏Growser ليس متصفحك التلقائي.</translation>
<translation id="5477319665405831211">‏يمكنك مزامنة Growser وتخصيصه على جميع أجهزتك.</translation>
<translation id="2339273275658335597">‏تحديث Growser</translation>
<translation id="4870714623113535320">‏عملك محفوظ بأمان على Growser</translation>
<translation id="7716950018788545737">انتهت المهام.</translation>
<translation id="77283119132245232">تقدِّم هذه الخدمة خدمات تتبُّع النظام لـ <ph name="BROWSER_NAME"/>. وفي حال إيقاف هذه الخدمة، لن تتضمّن بيانات تتبُّع الأداء التي ينشئها المتصفّح الأحداث على مستوى النظام، مثل أحداث تبديل السياق وأحداث سلسلة التعليمات الجاهزة.</translation>
<translation id="4784414698887946907">‏سيؤدي هذا إلى حذف بيانات التصفح من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Growser كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">تعذر على أداة المثبِّت إنشاء دليل مؤقت. يُرجى التحقق من وجود مساحة خالية على القرص وتوفر الإذن اللازم لتثبيت البرنامج.</translation>
<translation id="8543787950557226450">‏إعادة ضبط Growser على المظهر التلقائي</translation>
<translation id="4976450819672499783">‏ضبط Growser كمتصفّح تلقائي وتثبيته في شريط المهام</translation>
<translation id="1978509466033734608">‏زيادة سرعة متصفِّح Growser</translation>
<translation id="6236814935154483927"><ph name="PAGE_TITLE"/> - Growser Canary</translation>
<translation id="2684504034454188774">‏يمكنك جعل الاطّلاع على المواقع الإلكترونية التي تزورها أكثر صعوبة على الجهات التي يمكنها الوصول إلى حركة مرور بياناتك على الإنترنت. يستخدم Growser اتصالاً آمنًا للبحث عن عنوان IP الخاص بأي موقع إلكتروني في نظام أسماء النطاقات (DNS).</translation>
<translation id="7810005234485217901">يمكنك تثبيت ميزة "البحث بالصور" للوصول إليها بسهولة</translation>
<translation id="1652855885539187849">‏يتوفّر حاليًا على هذا الجهاز ملف شخصي لهذا الحساب على Growser.</translation>
<translation id="7845233973568007926">شكرًا على التثبيت. عليك إعادة تشغيل الكمبيوتر قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="7397737266068428588">‏تم تغيير محرك البحث من مصدر خارج Growser. ولحمايتك، أعاد Growser ضبطه على الخيار التلقائي الأصلي. <ph name="LEARN_MORE_LINK"/></translation>
