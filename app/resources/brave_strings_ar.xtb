<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1026101648481255140">استئناف التثبيت</translation>
<translation id="7099479769133613710">‏إعادة التشغيل لتحديث نظام التشغيل &amp;Growser</translation>
<translation id="2479110114759182442">‏ينصح Growser بمراجعة هذه الإضافة</translation>
<translation id="3814674848168165531">‏عندما يطلب موقع إلكتروني تحميل الروابط في صفحته مسبقًا بخصوصية تامة، يستخدم Growser خوادم Growser. يؤدي هذا الإجراء إلى إخفاء هويتك عن الموقع الإلكتروني الذي يتم تحميله مسبقًا، ولكن تبقى Growser على اطّلاع بالمواقع الإلكترونية التي يتم تحميلها مسبقًا.</translation>
<translation id="1065672644894730302">لا يمكن قراءة إعداداتك المفضّلة. قد تكون بعض الميزات غير متاحة، ولن يتم حفظ التغييرات في الإعدادات المفضّلة.</translation>
<translation id="7577672138294294152">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح Growser.</translation>
<translation id="4408482856437790071">‏للبحث عن ميزة أو إضافة محدّدة في Growser، عليك كتابة اختصارها في شريط العناوين متبوعًا بمفتاح لوحة المفاتيح الذي تم اختياره</translation>
<translation id="5918095577778020936">‏يرغب Growser في تصدير كلمات المرور، لذا يُرجى كتابة كلمة مرور Windows للسماح بذلك.</translation>
<translation id="112640046208448578">يمكنك التعرّف على الصور أو الأماكن ونسخ النصوص أو ترجمتها. وعند استخدام ميزة "البحث بالصور"، يتمّ إرسال لقطة شاشة للصفحة إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">‏Growser هو متصفحك التلقائي</translation>
<translation id="8522292744959221145">‏للتحقُّق مما إذا كانت كلمات المرور آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK"/>تسجيل الدخول إلى Growser<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">‏انقر على قائمة Growser.</translation>
<translation id="1157985233335035034">أحدث اللغات</translation>
<translation id="7813580490378477695">‏ثبَّت الشريك <ph name="PARTNER_NAME"/> إضافة جديدة قد تؤدي إلى تغيير طريقة عمل Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">‏تعذَّر التثبيت بسبب عدم توافُق الإصدار الذي تستخدمه من نظام التشغيل Windows.</translation>
<translation id="8541922081612557424">‏لمحة عن Growser</translation>
<translation id="987734326276404793">‏تلقّي تنبيهات ميزة "تتبُّع الأسعار" باستخدام Growser على هاتفك</translation>
<translation id="1203500561924088507">شكرًا على التثبيت. عليك إعادة تشغيل المتصفِّح قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">‏عند فتح ميزة "البحث بالصور"، سيتم تلقائيًا إرسال عنوان الصفحة وعنوان URL والمحتوى (بما في ذلك ملفات PDF) إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="1934377710648094656">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على Growser في Growser. لتغيير ذلك، يُرجى الانتقال إلى "حسابك في Growser".</translation>
<translation id="1631493536097460865">‏يمكنك استخدام اختصار لوحة المفاتيح لاختيار جزء من الشاشة في "Gemini في Growser".</translation>
<translation id="8799570501820813406">‏عندما كانت علامة التبويب هذه غير نشطة، تم إخلاء مساحة في الذاكرة للحفاظ على سرعة Growser. يمكنك اختيار أن يظل هذا الموقع الإلكتروني نشطًا دائمًا.</translation>
<translation id="8767381092474532098">‏حَظَر Growser عملية التنزيل هذه لأنّ الملف خطير.</translation>
<translation id="3256289531845594061">‏عند تسجيل الدخول إلى خدمات Growser، مثل Gmail أو YouTube باستخدام <ph name="USER_EMAIL"/>، يمكنك تسجيل الدخول تلقائيًا إلى Growser باستخدام الحساب نفسه</translation>
<translation id="8508169558526580571">‏تنزيل Growser على هاتفك</translation>
<translation id="1290883685122687410">حدث خطأ أثناء الإعداد: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">‏إعداد ملفك الشخصي الجديد على Growser</translation>
<translation id="4291722755910963157">‏يمكنك تجربة "Gemini في Growser"</translation>
<translation id="878572309106296578">‏يجب منح Growser الإذن بالوصول إلى البلوتوث لاستكشاف 
الأجهزة التي تتضمّن بلوتوث. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="7562683844189283122">‏تسجيل الدخول إلى Growser على الهاتف</translation>
<translation id="1330562121671411446">رصد اللغة</translation>
<translation id="6204677860546245308">‏استخدام إعدادات المتصفِّح المقترَحة من Growser</translation>
<translation id="108284536240904209">‏حذف البيانات من Growser أيضًا (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">تمّ تثبيت اللوحة. يمكنك الوصول إلى ميزة "البحث بالصور" مرة أخرى من خلال الزر الجديد في شريط الأدوات</translation>
<translation id="1356661055722410047">ميزة جديدة: يمكنك ترجمة كل من النص والصور على شاشتك</translation>
<translation id="1383876407941801731">البحث</translation>
<translation id="3535301204632475895">‏يمكنك استخدام تطبيق Growser لمواصلة التصفّح أثناء التنقل</translation>
<translation id="7009295044271335553">‏&amp;إدارة الملفات الشخصية على Growser</translation>
<translation id="1404026649028693342">‏عرض "وضع AI" دائمًا</translation>
<translation id="141901961143729572">شارِك أفكارك</translation>
<translation id="3880714039086599943">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Growser ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="1586284627848250203">‏الحصول على مساعدة بشأن Growser for Testing</translation>
<translation id="1497802159252041924">حدث خطأ أثناء التثبيت: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">هذه الصفحة محمية</translation>
<translation id="5147525139567260139">‏مشاركة علامة تبويب Growser</translation>
<translation id="721261350616678948">‏تسجيل الدخول إلى Growser</translation>
<translation id="1547469039832541117">يؤدي النقر على هذا الزر إلى إنهاء المهمّة المحدّدة.</translation>
<translation id="1530633922026945685">‏يحتاج Growser إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للبيئة المحيطة بك.</translation>
<translation id="51545890371361355">‏تثبيت Growser</translation>
<translation id="6570689355868013775">‏أدوات الأمان في Growser</translation>
<translation id="1902837727299679178">‏يريد Growser حذف بياناتك في "مدير كلمات المرور". للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="1655849915812740665">‏يمكنك الاستفادة من أفضل ميزات Growser باستخدام تطبيق Growser على هاتفك</translation>
<translation id="4449148723378534338">‏يمكنك مراجعة العناصر الرئيسية للتحكّم في الخصوصية والأمان في Growser.</translation>
<translation id="1640672724030957280">جارٍ التنزيل...</translation>
<translation id="1680687534629375545">طرح أسئلة حول محتوى هذه الصفحة باستخدام ميزة "البحث بالصور"</translation>
<translation id="509363484780540563">‏يمكنك استخدام Growser في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى. وسيتم أيضًا تثبيته في شريط التطبيقات.</translation>
<translation id="1709772298389099340">توفِّر الخدمة أذونات مميّزة وعالية المستوى لمتصفِّح <ph name="BROWSER_NAME"/>.</translation>
<translation id="8004287232784878841">‏سيحذف Growser بيانات التصفُّح قريبًا</translation>
<translation id="4197839351786449392">‏سيحاول Growser ترقية عمليات الانتقال إلى بروتوكول HTTPS.</translation>
<translation id="7814200940910057384">‏تم محو بيانات Growser</translation>
<translation id="9048361966237194186">‏ستتم إعادة تشغيل Growser خلال <ph name="REMAINING_TIME"/></translation>
<translation id="5524150602137990006">‏سيستخدم Growser اتصالاً غير آمن بدون تحذيرك في حال عدم توفُّر بروتوكول HTTPS.</translation>
<translation id="6797402139308059782">‏دع Growser يعمل في الخلفية</translation>
<translation id="5994491947936308173">‏انقر على <ph name="BEGIN_BOLD"/>نعم<ph name="END_BOLD"/> في إشعار Windows لتثبيت Growser في شريط التطبيقات والوصول إليه بسرعة.</translation>
<translation id="5875673934455379806">‏إعادة تثبيت Growser</translation>
<translation id="4529028207655448215">‏يحاول Growser <ph name="AUTHENTICATION_PURPOSE"/>.</translation>
<translation id="7362761326208547489">‏عند فتح Growser على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام "مدير كلمات المرور في Growser".</translation>
<translation id="1838374766361614909">محو البحث</translation>
<translation id="3643631442346149414">‏لحماية عملك على Growser، يمكن لمؤسستك الاطلاع على بعض المعلومات أو إدارتها</translation>
<translation id="3541642064306182066">‏لحذف بيانات التصفّح من هذا الجهاز فقط والاحتفاظ بها في حسابك على Growser، يُرجى <ph name="BEGIN_LINK"/>تسجيل الخروج من Growser<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">‏يكفي تنزيل متصفِّح Growser على هاتفك لفتح مجموعات علامات التبويب أو إنشائها أثناء التنقّل.</translation>
<translation id="4559627161887338743">‏يمكنك إدارة حسابات Growser التي تم تسجيل الدخول إليها. يتم استخدام حساباتك على Growser في متصفّح Growser و"متجر Play" وGmail والمزيد. إذا أردت إضافة حساب لمستخدم آخر، مثل أحد أفراد العائلة، أضِف شخصًا جديدًا إلى <ph name="DEVICE_TYPE"/> بدلاً من ذلك. <ph name="LINK_BEGIN"/>مزيد من المعلومات<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">البحث باستخدام ميزة "البحث بالصور"</translation>
<translation id="1880677175115548835">اختيار نص</translation>
<translation id="4528406859989804913">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على Growser. وستكون بياناتك في Growser مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME"/>. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات Growser، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. ويُمكنك اختيار إنشاء ملف شخصي جديد للإبقاء على بياناتك الحالية في Growser بشكل مستقل. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">‏يحافظ Growser على طاقة البطارية من خلال الحدّ من الأنشطة في الخلفية والتأثيرات المرئية، مثل التمرير السلس وعدد اللقطات في الثانية للفيديو. <ph name="BEGIN_LINK"/>مزيد من المعلومات حول ميزة "توفير البطارية"<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">طرح سؤال حول هذه الصفحة</translation>
<translation id="8643267611122541711">‏خدمة Growser Updater</translation>
<translation id="1649714546770135458">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع Growser" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى Growser</translation>
<translation id="189297655255130768">‏لا يستجيب Growser. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="8422047647688939115">‏تطلُب المؤسسة (<ph name="MANAGER"/>) منك تسجيل الدخول إلى Growser</translation>
<translation id="4035053306113201399">‏يجب إعادة تشغيل نظام التشغيل Growser حتى يتم تطبيق التحديث.</translation>
<translation id="9048754176089806686">‏حَظَر Growser عملية التنزيل هذه لأنّ نوع الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="1953553007165777902">جارٍ التنزيل… عدد الدقائق المتبقّية: <ph name="MINUTE"/></translation>
<translation id="1775322105159056176">‏يتعذَّر على Growser تحديد المتصفح التلقائي أو تعيينه</translation>
<translation id="197326043290947695">التصفّح أذكى مع ميزة "البحث بالصور"</translation>
<translation id="4372901050442507812">‏التعرّف على سبب حظر بعض الملفات في Growser، يتم فتح الرابط في علامة تبويب جديدة</translation>
<translation id="2703425183860615504">‏تساعد هذه الخدمة على تحديث برامج Growser باستمرار. لذا في حال إيقافها بشكل نهائي أو مؤقت، لن يتم تحديث برامج Growser باستمرار، ما يعني أنّه لا يمكن إصلاح الثغرات الأمنية التي قد تحدث وقد لا تعمل بعض الميزات. ويتمّ إلغاء تثبيت هذه الخدمة تلقائيًا من الجهاز عند عدم استخدام أي من برامج Growser لها.</translation>
<translation id="9220324636239049437">‏سيعمل هذا على حذف عنصر واحد من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Growser كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">تعذّر التثبيت. يُرجى إعادة المحاولة.</translation>
<translation id="2039417478970545937">الإعدادات</translation>
<translation id="5499149312981370855">‏اختَر ما إذا كنت تريد تضمين سجلّ Growser للحصول على تجارب أكثر تخصيصًا في خدمات Growser.</translation>
<translation id="5152523902653128156">‏هذه الخدمة مضمّنة في Growser لمساعدتك في إنشاء كلمات مرور قوية وحفظها وملئها تلقائيًا. ويمكنك إضافة اختصار للوصول إليها بسهولة.</translation>
<translation id="6959434860418352144">‏يمكنك النقر على زر "تخصيص Growser" في صفحة "علامة تبويب جديدة" لإضفاء مظهر جديد عليه</translation>
<translation id="2066690553719545730">‏عرض "وضع AI" دائمًا</translation>
<translation id="2472891440303445472">‏حَظَر Growser عملية التنزيل هذه لأنّ الملف مخادع وقد يُجري تغييرات غير متوقعة على جهازك.</translation>
<translation id="2054358978145431867">‏ستظهر لك رسالة تطلب منك تجربة "<ph name="FEATURE_NAME"/>" عند فتح Growser على iOS في المرة القادمة.</translation>
<translation id="2726948994393234543">‏ستتم إزالة كلمات المرور وبيانات Growser الأخرى التي تم حفظها في حسابك على Growser من هذا الجهاز. ولاستخدامها مرة أخرى في Growser، عليك تسجيل الدخول مجددًا.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة دقيقة واحدة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة دقيقتَين. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}few{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة # دقائق. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}many{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Growser لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}}</translation>
<translation id="2125838419757773031">يمكنك تحديد أي محتوى على الشاشة للبحث عنه</translation>
<translation id="2126108037660393668">تعذَّر التحقق من الملف الذي تم تنزيله.</translation>
<translation id="2135919691573380097">الإبلاغ عن هذا الموقع الإلكتروني</translation>
<translation id="2137162749895930932">إغلاق شاشة الترجمة</translation>
<translation id="5789330946301045610">‏حَظَر Growser عملية التنزيل هذه لأنّ الموقع الإلكتروني لا يستخدم اتصالاً آمنًا وربما تمّ التلاعب بالملف.</translation>
<translation id="2170098639895543546">اختيار أي محتوى على الصفحة</translation>
<translation id="142389341645668510">‏تخصيص Growser</translation>
<translation id="2174917724755363426">لم يكتمل التثبيت. هل تريد فعلاً الإلغاء؟</translation>
<translation id="8745514854244955877">‏Growser - تسجيل الدخول إلى الشبكة - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">خطأ في عملية التحقق من التحديث: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">‏إزالة الحساب من Growser</translation>
<translation id="4022045673362955204">‏أفضل أدوات التسوق ستكون متاحة لك أثناء التنقل باستخدام تطبيق Growser</translation>
<translation id="5550942974310218641">‏يمكنك الحفاظ على أمانك أثناء التنقّل باستخدام ميزة "الحماية المحسّنة للتصفّح الآمن" في Growser على أجهزة iOS</translation>
<translation id="6677253423995557759">‏هذا الموقع الإلكتروني خطير، لذلك أزال Growser إذن الإشعارات.</translation>
<translation id="2236949375853147973">نشاطي</translation>
<translation id="457168681575748148">‏يمكنك تسجيل الدخول إلى Growser للوصول إلى العناوين وغيرها على جميع أجهزتك. وسيتم حفظ هذا العنوان في حسابك على Growser بعد تسجيل الدخول.</translation>
<translation id="5659384504794665581">‏إذا كنت تشارك الكمبيوتر مع أصدقائك وعائلتك، فبإمكانهم التصفح على حدة وإعداد Growser على النحو الذي يريدونه.</translation>
<translation id="2752319862668322390">‏"المهارات" في Growser</translation>
<translation id="2283803047247799269">البحث في علامة التبويب هذه باستخدام ميزة "البحث بالصور"</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{‏ينصح Growser بإيقاف علامة التبويب التي تبطئ المتصفّح مؤقتًا}zero{‏ينصح Growser بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}two{‏ينصح Growser بإيقاف علامتَي التبويب اللتين تبطئان المتصفّح مؤقتًا}few{‏ينصح Growser بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}many{‏ينصح Growser بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}other{‏ينصح Growser بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}}</translation>
<translation id="2307973900865360088">‏إبقاء التطبيق في شريط التطبيقات (Dock)</translation>
<translation id="7810992039564280750">‏يعمل هذا الوضع على التحقّق من عناوين URL التي تحتوي على قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Growser. وإذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسل متصفِّح Growser أيضًا عناوين URL تتضمّن أجزاء من محتوى الصفحة إلى "التصفُّح الآمن".</translation>
<translation id="9095263438435683933">‏لإرسال رقم من هذا الجهاز إلى جهازك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Growser على الجهازَين.</translation>
<translation id="2356070529366658676">طلب</translation>
<translation id="2359808026110333948">متابعة</translation>
<translation id="6485997157403727556">‏تطلب منك الإضافة "<ph name="EXTENSION_NAME"/>" تسجيل الدخول إلى Growser</translation>
<translation id="7017760840808989683">‏إيقاف تشغيل Growser في الخلفية أثناء عمل التطبيقات</translation>
<translation id="8491912023989916905">‏لاستخدام هذه الإضافة على الحساب <ph name="USER_EMAIL_ADDRESS"/>، عليك تسجيل الدخول إلى Growser.</translation>
<translation id="8418845734693287262">‏تعذّر على نظام التشغيل Growser مزامنة بياناتك لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Growser تصل إلى جهاز HID واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى جهاز HID واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى جهازَي HID}few{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # أجهزة HID}many{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # جهاز HID}other{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # جهاز HID}}</translation>
<translation id="1248225940185478633">‏يحتاج Growser إلى إذن للوصول إلى الكاميرا والميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="2403703063067034158">خطأ في بدء التشغيل: هناك عملية إعداد أخرى قيد التشغيل حاليًا. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="5298352791080868905">‏يمكنك فتح الروابط من أي تطبيق على Growser والوصول إلى المتصفّح بسهولة من خلال شريط المهام</translation>
<translation id="2600233721598267627">‏يمكنك النقر على زر "تلخيص" لمشاركة هذا المستند مع "Gemini في Growser" والحصول على نظرة عامة سريعة وطرح أسئلة إضافية</translation>
<translation id="2118275934191847461">‏باستخدام <ph name="BEGIN_LINK"/>أدوات من Growser<ph name="END_LINK"/>، يمكنك التصفُّح بأمان والتحكُّم بشكل كامل</translation>
<translation id="2451727308784734061">استخدِم الاختصار للوصول بسرعة إلى "مدير كلمات المرور". بإمكانك نقل هذا الاختصار إلى الشاشة الرئيسية أو مشغِّل التطبيقات في جهاز الكمبيوتر.</translation>
<translation id="6381750314821942592">‏سيتم إغلاق Growser قريبًا</translation>
<translation id="6078442581074612226">‏في Growser</translation>
<translation id="2485422356828889247">إزالة التثبيت</translation>
<translation id="2513154137948333830"><ph name="INSTALL_SUCCESS"/>: يجب إعادة التشغيل.</translation>
<translation id="2542968102051442371">اختيار نص باستخدام ميزة "بحث بالصور"</translation>
<translation id="70183448213529602">‏يحاول Growser استبدال كلمات المرور الحالية. للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="7798069806040634998">‏يحتاج Growser إلى الوصول إلى مساحة التخزين لتنزيل الملفات.</translation>
<translation id="8447483940522230788">‏أداة مساعدة Growser</translation>
<translation id="2575822587468774919">انقر أي محتوى للبحث عنه باستخدام ميزة "البحث بالصور"</translation>
<translation id="3830890663494219270">‏سجِّل الدخول إلى Growser للوصول إلى كلمات المرور وغيرها على جميع أجهزتك</translation>
<translation id="6908148552215338695">‏يمكنك مسح رمز الاستجابة السريعة ضوئيًا باستخدام هاتفك لتنزيل تطبيق Growser وتسجيل الدخول إلى حساب Growser.</translation>
<translation id="6252796827759111076">‏مواصلة استخدام Growser</translation>
<translation id="259935314519650377">تعذَّر إجراء تخزين مؤقت للمثبّت الذي تم تنزيله. الخطأ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">النظام</translation>
<translation id="7931230852267968641">‏يمكن لمؤسستك الاطّلاع على بيانات التصفّح وإدارتها، مثل الإشارات المرجعية والسجلّ وكلمات المرور. ولا يمكنها الاطّلاع على بيانات التصفّح في الملفات الشخصية الأخرى على Growser</translation>
<translation id="2257221826278123061">‏يُرجى إثبات هويتك لاستخدام بيانات Growser وحفظها في حسابك (<ph name="ACCOUNT_EMAIL"/>)</translation>
<translation id="7048234400304379082">‏للخروج من "Gemini في Growser" أو العودة إليه، بإمكانك استخدام اختصار لوحة المفاتيح.</translation>
<translation id="7387051847644272380">‏حدث خطأ في نظام التشغيل أثناء عملية التثبيت. يُرجى إعادة تنزيل Growser.</translation>
<translation id="2648689842065142443">‏في حال مشاركة جهاز مع الأصدقاء والعائلة، يمكنهم الحصول على تجربة تصفّح منفصلة وإعداد Growser على النحو المفضّل لديهم.</translation>
<translation id="1001521084148238686">‏يتيح لك هذا الزر الوصول بسهولة إلى "Gemini في Growser" واستخدامه على جهازك، حتى إذا كان Growser مصغّرًا.</translation>
<translation id="6791166902140255175">‏علامة تبويب Growser</translation>
<translation id="8372880274820509128">‏لمزيد من الأمان، سيشفر Growser بياناتك</translation>
<translation id="8752006915531191162">‏لإزالة حسابك على Growser من Growser، يجب تسجيل الخروج</translation>
<translation id="5344406739101555055">‏للوصول إلى كلمات المرور والإشارات المرجعية وغيرهما على جميع أجهزتك، يجب تسجيل الدخول إلى Growser</translation>
<translation id="2738871930057338499">‏تعذر الاتصال بالإنترنت. بروتوكول HTTP 403 محظور. يُرجى التحقق من إعدادات الخادم الوكيل.</translation>
<translation id="2753623023919742414">انقر للبحث</translation>
<translation id="1312769823139326127">‏ضبط Growser كعارض PDF التلقائي</translation>
<translation id="1187986649024576560">‏هذه الإضافة غير آمنة وتحتوي على برامج ضارة. يُرجى إزالة هذه الإضافة من Growser كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="2799223571221894425">إعادة تشغيل</translation>
<translation id="5962774139606909656">‏بياناتك على Growser</translation>
<translation id="2816462166102338036">البحث عن هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="1992849613617207128">‏يمكنك اكتشاف المنتجات باستخدام الكاميرا وتتبُّع انخفاض الأسعار وتنفيذ مهام أخرى أثناء التنقّل من خلال Growser على iOS.</translation>
<translation id="2841525013647267359">ترجمة من</translation>
<translation id="2846251086934905009">خطأ في التثبيت: لم تكتمل أداة التثبيت. تم إلغاء عملية التثبيت.</translation>
<translation id="777113543093865885">‏إزالة من Growser</translation>
<translation id="5265419033369521352">‏يوفّر لك هذا الوضع حماية في Growser، ويمكن استخدامه لتحسين مستوى أمانك في تطبيقات Growser الأخرى عندما تكون مسجلاً دخولك.</translation>
<translation id="2885378588091291677">إدارة المهام</translation>
<translation id="2176825726964012531">‏حو&amp;ل Growser</translation>
<translation id="2915996080311180594">إعادة التشغيل لاحقًا</translation>
<translation id="2481553173340651149">‏تم تشفير بياناتك باستخدام عبارة المرور. عليك إدخال عبارة المرور لاستخدام بيانات Growser وحفظها في حسابك على Growser.</translation>
<translation id="2945997411976714835">خطأ في التثبيت: تعذّر بدء عملية التثبيت.</translation>
<translation id="2413255940314578781">‏يمكنك تسجيل الدخول بشكل أسرع إلى المواقع الإلكترونية باستخدام كلمات المرور المحفوظة في Growser على أجهزة iOS</translation>
<translation id="3688936822855019158">‏تدير مؤسستك متصفِّح Growser</translation>
<translation id="8208853227947884571">‏Growser محدّث</translation>
<translation id="5122472867956731189">‏إذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسِل متصفِّح Growser أيضًا عناوين URL تتضمّن أجزاءً من محتوى الصفحة إلى خدمة "التصفُّح الآمن".</translation>
<translation id="3963199983793987097">‏للحفاظ على أمانك على الإنترنت من خلال خيارات أحد والدَيك، سجِّل الدخول إلى Growser</translation>
<translation id="3003694935412297923">كل المهام</translation>
<translation id="7611046016537686219">{count,plural, =1{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏يحتاج Growser إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Growser واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="4202995875619419215">‏افتح <ph name="URL"/> في علامة تبويب جديدة في Growser.</translation>
<translation id="1266825212217391702">‏يتم حفظ ابتكارات الذكاء الاصطناعي، مثل المهارات، في حسابك على Growser وإدارتها بشكل منفصل عن ميزة "مزامنة Growser"</translation>
<translation id="8880183781256147665">‏جارٍ الإضافة إلى Growser...</translation>
<translation id="3038232873781883849">في انتظار التثبيت...</translation>
<translation id="3045032126857188731">اللغة الهدف: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">إغلاق مربّع حوار الملاحظات</translation>
<translation id="4503085212612536713">‏الملفات الشخصية الأخرى على Growser</translation>
<translation id="2041039306630146369">‏تتيح لك الإضافات تخصيص متصفِّح Growser وإضفاء طابعك الشخصي عليه، مع الحفاظ على التنظيم وتبسيط المهام اليومية.</translation>
<translation id="7918740962659365265">‏يمكنك المساعدة في تحسين Growser عن طريق إرسال تقارير الأعطال و<ph name="UMA_LINK"/> إلى Growser</translation>
<translation id="6828757829023033545">‏ميزات الأمان من Growser ستكون متاحة لك أثناء التنقل باستخدام تطبيق Growser</translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Growser تصل إلى جهاز USB واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى جهاز USB واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # جهازَي USB}few{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # أجهزة USB}many{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # جهاز USB}other{‏تصل إضافة واحدة أو أكثر من إضافات Growser إلى # جهاز USB}}</translation>
<translation id="3700405816184340252">‏سجلّ Growser</translation>
<translation id="7365690458036015383">‏تعذّرت أداة التثبيت في فك ضغط الأرشيف. يُرجى إعادة تنزيل Growser.</translation>
<translation id="310459126943037700">تعذَّر إنهاء المهام.</translation>
<translation id="3104828284009500087">البحث عن أي محتوى على الصفحة</translation>
<translation id="6422885447166607802">‏يمكنك الحفاظ على مزامنة كلمات المرور والإشارات المرجعية والسجلّ بشكل مثالي على جميع الأجهزة، وكذلك الوصول بسهولة إلى الميزات المألوفة والمفضَّلة لديك من خلال ضبط Growser كمتصفِّحك التلقائي.</translation>
<translation id="8919461291440820124">‏يستخدم Growser الميكروفون.</translation>
<translation id="3130333203120345554">بحث جديد</translation>
<translation id="3137969841538672700">اسحب للبحث</translation>
<translation id="8372436892102763334">‏تستخدم علامة التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Growser بإيقاف علامة التبويب هذه.</translation>
<translation id="5949068186379578553">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Growser ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="4805806622840861220">‏إعادة تشغيل Growser</translation>
<translation id="3161522574479303604">كل اللغات</translation>
<translation id="3225882094369124157">‏أضاف برنامج آخر على جهاز الكمبيوتر مظهرًا قد يؤدي إلى تغيير طريقة عمل Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1742948938503172561">‏يمكنك الآن تخصيص ملفك الشخصي الجديد على Growser.</translation>
<translation id="2430807206104224491">‏يمكنك مواصلة المحادثة مع "وضع AI" بدون التبديل بين علامات التبويب، فما عليك سوى تسجيل الدخول إلى Growser للبدء. بإمكانك أيضًا الوصول إلى كلمات المرور وغيرها من البيانات على جميع أجهزتك.</translation>
<translation id="4805865169608137960">‏لإزالة حسابك على Growser من Growser، يجب تسجيل الخروج من Growser في صفحة "الإعدادات"</translation>
<translation id="1651639704310627074">‏يمكن أن يسألك متصفِّح Growser لاحقًا عن رغبتك في استخدام المعلومات المحفوظة لملء النماذج تلقائيًا بالنيابة عنك</translation>
<translation id="2585240446624043880">‏يتعذر على Growser القراءة والكتابة في دليل البيانات الخاص به:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="8414435293910785169">‏أدوات ذكاء Growser الاصطناعي المفضّلة لديك ستكون متاحة لك أثناء التنقل باستخدام Growser على iOS.</translation>
<translation id="3286538390144397061">إعادة التشغيل الآن</translation>
<translation id="2339258256897053758">‏مفاتيح واجهة برمجة تطبيقات Growser مفقودة. وسيترتب على ذلك توقف بعض وظائف Growser عن العمل.</translation>
<translation id="8926637909431618259">‏استمرار تشغيل تطبيقات الخلفية عند إغلاق Growser</translation>
<translation id="518125528057094977">‏سيحذرك Growser قبل تحميل أي موقع إلكتروني يستخدم اتصالاً غير آمن.</translation>
<translation id="8652321858775514885">‏سيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ Growser، باستثناء حسابك على Growser إذا كنت مسجلاً الدخول إلى Growser. للسماح للمواقع الإلكترونية بتذكُّر بياناتك، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">أعلى يسار مساحة البحث: %<ph name="RIGHT"/> من الجهة اليسرى و%<ph name="TOP"/> من الأعلى</translation>
<translation id="7261356974224431851">‏بيانات Growser في حسابك</translation>
<translation id="3369405342922656244">البحث في محتوى هذه الصفحة باستخدام ميزة "البحث بالصور"</translation>
<translation id="6610330853796830621">‏بتنزيل Growser، يمكنك استخدام كلمات المرور الخاصة بك على هاتفك</translation>
<translation id="2645435784669275700">‏نظام التشغيل Growser</translation>
<translation id="2297290224191497273">‏هل تريد الانتقال إلى الملف الشخصي الحالي على Growser؟</translation>
<translation id="3412460710772753638">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="2491221873705777076">‏بتنزيل Growser، ستكون "الحماية المحّسنة للتصفح الآمن" متاحة على هاتفك أيضًا</translation>
<translation id="7304389940068374923">‏جارٍ تخصيص Growser…</translation>
<translation id="5853262807109651878">‏سيعمل هذا على حذف <ph name="ITEMS_COUNT"/> من العناصر من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Growser كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="2024972335338126423">‏يعمل الاختصار <ph name="SHORTCUT"/> على التبديل بين الملفات الشخصية على Growser.</translation>
<translation id="8703492925273919597">‏يُرجى إغلاق جميع نوافذ Growser وإعادة المحاولة.</translation>
<translation id="599091950194451698">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Growser ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="1447863765638888625">‏سبق أن تم تسجيل الدخول إلى حساب "<ph name="EXISTING_USER"/>".  للحصول على تجربة تصفّح منفصلة، سجِّل الدخول إلى Growser في ملفك الشخصي باستخدام العنوان <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="7624624622436403494">‏يُرجى مسح رمز الاستجابة السريعة ضوئيًا لتنزيل متصفّح Growser على الأجهزة الجوّالة</translation>
<translation id="8478154085901340543">‏تذكير: أفضل ميزات الأمان من Growser في متناول يدك</translation>
<translation id="8981774130895723211">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Growser ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="2981961446160697133">‏يؤدي تفعيل ميزة "الحماية المحسّنة" إلى إيقاف ميزة تحسين JavaScript للمواقع الإلكترونية التي لا يتعرّف عليها Growser</translation>
<translation id="3597003331831379823">تعذَّر إجراء عملية الإعداد باستخدام أذونات مميزة وعالية المستوى. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="4167284810587724062">‏سجِّل الدخول إلى Growser</translation>
<translation id="3066805437003400520">‏ستُحذَف بيانات تصفُّح هذا المستخدم من هذا الجهاز. ولاسترداد البيانات، سجّل الدخول إلى Growser بصفتك <ph name="USER_EMAIL"/>.</translation>
<translation id="7029305463989165490">‏لإرسال رقم من <ph name="ORIGIN"/> إلى هاتفك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Growser على الجهازَين.</translation>
<translation id="3667616615096815454">يتعذّر تثبيت التطبيق لأنّه غير معروف لدى الخادم.</translation>
<translation id="1128485277465085828">‏لتشفير جميع بيانات Growser في حسابك على Growser، يمكنك استخدام <ph name="BEGIN_LINK"/>عبارة المرور الخاصة بك<ph name="END_LINK"/>. لن يتم تشفير طُرق الدفع والعناوين من Google Pay. ولن تتم مزامنة سجلّ التصفُّح من Growser.</translation>
<translation id="1807774211756215222">‏فتح الرابط في علامة تبويب جديدة في Growser</translation>
<translation id="387105482057676379">‏ربط متصفّح Growser وخدمات Growser الأخرى لأغراض تخصيص الخيارات وأغراض أخرى</translation>
<translation id="3729187154190517324">يمكنك تعزيز نتائج بحثك عن طريق إضافة علامات تبويب وملفات وأدوات متعدّدة باستخدام زر "إضافة علامة تبويب والمزيد".</translation>
<translation id="3867175562099983425">‏إدارة الملفات الشخصية على Growser</translation>
<translation id="308146532933302843">‏تعرّف على سبب حظر Growser لبعض عمليات التنزيل</translation>
<translation id="2189149060536531804">‏سيُعلِمك Growser في حال العثور على اقتراحات مطلوب مراجعتها.</translation>
<translation id="6324134303015966238">‏يُحمِّل Growser مسبقًا الصفحات التي من المرجَح أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="3810973564298564668">إدارة</translation>
<translation id="4815742196440583661">‏لاستخدام كلمات المرور المحفوظة، يُرجى مسح رمز الاستجابة السريعة ضوئيًا وتنزيل Growser لجهاز iOS، ثم تسجيل الدخول إلى حسابك على Growser</translation>
<translation id="3846683726093018685">**تلخيص:** أريد وصفًا للموضوع الرئيسي وهدف محتوى لقطة الشاشة في جملة واحدة لا تزيد عن 30 كلمة.

          **اقتراح أسئلة:** أريد قائمة نقطية تتضمّن من 3 إلى 5 أسئلة تشجّع على التفكير ويمكن للمستخدم طرحها لفهم لقطة الشاشة بشكل أفضل. يجب أن تتضمّن هذه الأسئلة سؤالاً واحدًا على الأقل يتعلّق بعنصر مرئي أو تصميمه أو موضعه تحديدًا.</translation>
<translation id="5381622442243174305"><ph name="PAGE_TITLE"/> - Growser</translation>
<translation id="3885770153807205175">أداة اختيار اللغة</translation>
<translation id="6315734375101223238">‏تخصيص Growser والتحكُّم فيه معلومات مهمة - انقر للحصول على التفاصيل.</translation>
<translation id="7130675370997202556">‏انقر على اسمك لفتح Growser وبدء التصفح.</translation>
<translation id="3892148308691398805">نسخ النص</translation>
<translation id="4920958997042285125">‏سبَق تسجيل دخول <ph name="EXISTING_USER"/> إلى هذا الملف الشخصي على Growser. لتوفير تجربة تصفّح منفصلة دائمًا، يمكن لمتصفِّح Growser إنشاء ملف شخصي خاص بك.</translation>
<translation id="8744239658215739511">‏تخصيص Growser</translation>
<translation id="3941890832296813527">خطأ في التثبيت: اسم ملف أداة التثبيت غير صالح أو غير متوافق.</translation>
<translation id="8090497651549769448">‏يحاول Growser نسخ كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="4256965182800026277">‏ستتم إزالة كلمات المرور وطرق الدفع والعناوين التي حفظتها في حسابك على Growser من هذا الجهاز. ولاستخدامها مرة أخرى في Growser، عليك تسجيل الدخول مجددًا.</translation>
<translation id="395904275706073188">لا يمكن قراءة الصفحات المحمية. ننصحك بتجربة الميزة على صفحة مختلفة.</translation>
<translation id="4194619960643453552">‏تعرّف على الطريقة التي يحافظ بها Growser على أمانك</translation>
<translation id="3967822245660637423">اكتمل التنزيل</translation>
<translation id="1486377520191913768">‏عند الكتابة في شريط العناوين أو مربّع البحث، يرسل Growser ما تمّت كتابته إلى أدوات البحث والذكاء الاصطناعي والوكلاء في مؤسستك للحصول على اقتراحات.</translation>
<translation id="1311808042904310985">‏لمحة عن الإصدار Growser for Testing</translation>
<translation id="1152920704813762236">‏لمحة عن نظام التشغيل Growser</translation>
<translation id="8282895427217902177">‏عند الانتقال إلى موقع إلكتروني، يرسل متصفِّح Growser جزءًا مشفّرًا من عنوان URL إلى <ph name="BEGIN_LINK"/>ميزة "التصفّح الآمن من Growser"<ph name="END_LINK"/> من خلال خادم لحماية الخصوصية يُخفي عنوان IP الخاص بجهازك. وفي حال رصد سلوك مريب على موقع إلكتروني، يتم أيضًا إرسال عناوين URL الكاملة وأجزاء من محتوى الصفحة.</translation>
<translation id="4016217212818346953">أنت في أمان مع "مدير كلمات المرور"</translation>
<translation id="3703994572283698466">‏أصبح نظام التشغيل Growser متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS"/>برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS"/>، كما هو الحال في <ph name="BEGIN_LINK_LINUX_OSS"/>بيئة تطوير Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">ترجمة محتوى الشاشة</translation>
<translation id="4023601594785368013">اللغة الأصلية: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">‏يمكنك فتح الروابط من أي تطبيق في Growser، ويمكن تثبيته في شريط المهام للوصول إليه بسهولة.</translation>
<translation id="6056473803837713617">‏ساعد في تحسين Growser بالإبلاغ عن <ph name="BEGIN_LINK"/>الإعدادات الحالية<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">تحسينات الأمان المهمة والميزات الجديدة متاحة في أحدث إصدار.</translation>
<translation id="4055805654398742145">مدير كلمات المرور</translation>
<translation id="6654312501894761082">‏ثبَّتَ برنامج آخر موجود على الكمبيوتر إضافة جديدة قد تؤدي إلى تغيير طريقة عمل Growser.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6217792792122501564">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة دقيقة واحدة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}two{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة دقيقتَين. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}few{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة # دقائق. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}many{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}other{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Growser تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}}</translation>
<translation id="5794951150713244901">‏الانتقال إلى صفحة "لمحة عن Growser"</translation>
<translation id="10925962326134232">‏تخصيص Growser لإضفاء مظهر جديد على المتصفّح</translation>
<translation id="6596295505984504022">‏تخصيص Growser</translation>
<translation id="4148957013307229264">جارٍ التثبيت...</translation>
<translation id="4658486203392098459">‏<ph name="PAGE_TITLE"/> - تسجيل الدخول إلى الشبكة - Growser</translation>
<translation id="2871190378186459992">‏اكتشف تطبيقات، وألعاب، وإضافات، ومظاهر رائعة لمتصفح Growser.</translation>
<translation id="462105622535258178">‏يمكنك تسجيل الدخول إلى Growser للحصول على هذه الإضافة وغيرها على جميع أجهزة الكمبيوتر الخاصة بك</translation>
<translation id="6670140629169983459">‏للحفاظ على أمانك على الإنترنت من خلال خيارات أحد والدَيك، انتقِل إلى ملفك الشخصي على Growser الذي سجّلت الدخول إليه من قبل باستخدام الحساب <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">جارٍ الإلغاء...</translation>
<translation id="4224210481850767180">تم إلغاء عملية التثبيت.</translation>
<translation id="1853997773668795891">‏هل ترغب في ربط بياناتك في Growser بهذا الحساب؟</translation>
<translation id="4732930052828648898">‏ستتلقّى تحذيرات بشأن المواقع الإلكترونية الخطيرة، بما فيها المواقع الإلكترونية التي لم يتعرّف عليها محرك بحث Growser، من خلال تحليل قدر أكبر من البيانات الواردة من مواقع إلكترونية، مقارنةً بالحماية العادية. يمكنك اختيار تخطّي تحذيرات Growser.</translation>
<translation id="2201661640076600072">‏تسجيل الخروج من Growser</translation>
<translation id="3262506503470845422">‏الحصول على مساعدة في Growser</translation>
<translation id="4281844954008187215">بنود الخدمة</translation>
<translation id="7691786510374174420">‏تعذّر إتمام عملية التثبيت بسبب خطأ غير محدد. إذا كان Growser في حالة التشغيل حاليًا، يُرجى إغلاقه وإعادة المحاولة.</translation>
<translation id="6368144843345980623">‏تصدير كلمات المرور من Growser</translation>
<translation id="4304713468139749426">مدير كلمات المرور</translation>
<translation id="4334241893986177674">البحث في لقطة الشاشة هذه</translation>
<translation id="242356249838681145">‏يمكنك فتح Growser تلقائيًا عند بدء تشغيل Windows</translation>
<translation id="4747339441562331861">‏يمكنك الوصول بسهولة إلى الميزات المفضَّلة والموثوقة لديك من خلال ضبط Growser كمتصفِّحك التلقائي وتثبيته في شريط المهام للوصول إليه بسرعة.</translation>
<translation id="4400772909124543403">ما مِن تحديث متاح</translation>
<translation id="9183662282810237335">‏هل تريد الخروج من Growser على أي حال؟</translation>
<translation id="4413205837991854510">عرض اختصار ميزة "البحث بالصور" دائمًا</translation>
<translation id="4065288863231444640">‏السماح بتشغيل Growser في الخلفية</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{‏ينصح Growser بإزالة هذه الإضافة. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}zero{‏ينصح Growser بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}two{‏ينصح Growser بإزالة هاتين الإضافتَين. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}few{‏ينصح Growser بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}many{‏ينصح Growser بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}other{‏ينصح Growser بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">‏تخصيص Growser والتحكم فيه</translation>
<translation id="4427306783828095590">يؤدي تفعيل إعداد "الحماية المُحسَّنة" إلى حظر التصيّد الاحتيالي والبرامج الضارّة.</translation>
<translation id="4434353761996769206">خطأ في أداة التثبيت: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413">‏تدير "<ph name="MANAGER"/>" متصفِّح Growser</translation>
<translation id="3579012341787637143">‏إضافة ملف شخصي على Growser</translation>
<translation id="6786534271003695094">‏لمحة عن الإصدار Growser for Testing</translation>
<translation id="526235294307144732">‏عليك إدخال عبارة المرور لاستخدام بيانات Growser وحفظها في حسابك على Growser</translation>
<translation id="4493028449971051158">خطأ في بدء التشغيل: يُرجى تشغيل أداة التثبيت بصفتك مشرفًا.</translation>
<translation id="4501471624619070934">تعذّر تثبيت التطبيق بسبب حظر الدخول المفروض في هذا البلد.</translation>
<translation id="8594994021633965927">‏لم تنشر هذه الإضافة الممارسات المتعلقة بالخصوصية، مثل كيفية جمعها للبيانات واستخدامها. ينصح متصفِّح Growser بإزالتها.</translation>
<translation id="7084397798469173252">‏مرحبًا بك في Growser. تم فتح نافذة متصفّح جديدة.</translation>
<translation id="137732229629632648">‏يحتاج Growser إلى إذن لتتبُّع اليدين وإنشاء خريطة للبيئة المحيطة بك</translation>
<translation id="5036046007335188949">‏سبق أن سجّلت الدخول باستخدام الحساب <ph name="USER_EMAIL_ADDRESS"/> في ملف شخصي آخر على Growser</translation>
<translation id="1878185978731985193">‏يُحمِّل Growser الصفحات مسبقًا لزيادة سرعة التصفُّح والبحث. <ph name="BEGIN_LINK"/>مزيد من المعلومات حول التحميل المُسبَق للصفحات<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">يمكنك المساهمة في تحسين الأمان على الإنترنت للجميع عند الإبلاغ عن أي موقع إلكتروني في اعتقادك أنّه ضار.</translation>
<translation id="8669339108356170796">‏حَظَر Growser عملية التنزيل هذه لأنّك أوقفت ميزة "التصفُّح الآمن" ولا يمكن التحقّق من الملف.</translation>
<translation id="7583343841997441047">‏"عدسة Growser" بانتظارك في Growser على هاتفك</translation>
<translation id="4594305310729380060">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="3349475100979552835">‏تطبيقات Growser</translation>
<translation id="4598116752460667024">يمكنك البحث عن أي عملية ضِمن القائمة.</translation>
<translation id="4970880042055371251">‏إصدار نظام التشغيل Growser</translation>
<translation id="2182657378556811785">‏أوشك التحديث على الانتهاء! إعادة تشغيل Growser لإنهاء التحديث.</translation>
<translation id="6311668361877328515">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في Growser، ولكنه يحد قليلاً من قدرة Growser على مقاومة الهجمات</translation>
<translation id="7402642357351265733">‏في حال مشاركة تقارير استخدام Growser أيضًا، ستتضمّن هذه التقارير عناوين URL التي تنتقل إليها.</translation>
<translation id="8142245354207161805">‏يبدو أن الملف الشخصي قيد الاستخدام بواسطة عملية أخرى في Growser (<ph name="PROCESS_ID"/>) على جهاز كمبيوتر آخر (<ph name="HOST_NAME"/>). وقد تمّ قفل الملف الشخصي من جانب Growser لضمان عدم تعرضه للتلف. فإذا كنت واثقًا من عدم وجود عمليات أخرى قيد التشغيل على جهاز الكمبيوتر، فيُمكنك فتح قفل الملف الشخصي وإعادة تشغيل Growser مجددًا.</translation>
<translation id="4680828127924988555">إلغاء التثبيت</translation>
<translation id="2014343159590733363">‏لم يتم حفظ بعض بيانات Growser في حسابك على Growser إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجّلت الخروج الآن، فسيتم حذف هذه البيانات.</translation>
<translation id="2408746614080689238">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على Growser في Growser. يمكنك تغيير إعدادات خدمات Growser باستخدام <ph name="SHORTCUT"/>.</translation>
<translation id="847561904663814268">‏سجّل شخص ما الدخول من قبل إلى Growser على جهاز الكمبيوتر هذا باسم <ph name="ACCOUNT_EMAIL_LAST"/>. يُرجى إنشاء حساب مستخدم جديد في Growser للإبقاء على معلوماتك بشكلٍ منفصل.</translation>
<translation id="4724676981607797757">تعذَّر تثبيت التطبيق بسبب استخدام بروتوكول غير متوافق.</translation>
<translation id="3834935463915107022">‏هل تريد الخروج من Growser على أي حال؟</translation>
<translation id="8668413672647811944">‏تم للتو تطبيق تحديث أمان خاص لمتصفِّح Growser. يمكنك إعادة التشغيل الآن وستتم استعادة علامات التبويب.</translation>
<translation id="4941816441131888792">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Growser إذنَي <ph name="PERMISSION_1"/> و<ph name="PERMISSION_2"/> وأذونات أخرى (<ph name="COUNT"/>).</translation>
<translation id="844451748565342664">‏إذا كان "Gemini في Growser" مفتوحًا، ستبقى اللوحة الجانبية مفتوحة عند إنشاء علامات تبويب جديدة</translation>
<translation id="215320507915280336">‏يستخدم ذلك المدقق الإملائي نفسه الذي يتم استخدامه في "بحث Growser". ويتم إرسال النص الذي تكتبه في المتصفّح إلى Growser. يمكنك دائمًا تغيير هذا السلوك في الإعدادات.</translation>
<translation id="2899369907387169108">‏استخدام Growser بدون حساب</translation>
