<translation id="7963515534397191222">‏تعذّرت إعادة التحميل Growser إلى آخر إصدار، لذلك قد تفوتك الميزات الجديدة وعمليات إصلاح الأمان.</translation>
<translation id="7872446069773932638">جارٍ التنزيل… الثواني المتبقّية: <ph name="SECONDS"/></translation>
<translation id="5545136190679883344">‏في حال نسيت عبارة المرور أو أردت تغيير هذه الإعدادات، يمكنك <ph name="BEGIN_LINK"/>حذف بيانات Growser في حسابك<ph name="END_LINK"/></translation>
<translation id="9044562649276955255">‏يمكنك فتح "Gemini في Growser" بسرعة متى احتجت إليه</translation>
<translation id="7877212753140190672">طرح أسئلة حول هذه الصورة</translation>
<translation id="5687542525349822727">‏ضبط Growser كمتصفّح تلقائي</translation>
<translation id="6396151137840491551">‏يرقِّي متصفِّح Growser الاتصالات غير الآمنة إلى اتصالات عبر بروتوكول HTTPS تلقائيًا إن أمكن ذلك</translation>
<translation id="2925193881330501265">‏تم تسجيل دخولك إلى Growser باعتبارك <ph name="USER_EMAIL_ADDRESS"/>. يُرجى استخدام الحساب نفسه لتسجيل الدخول مرة أخرى.</translation>
<translation id="6915252145142862992">‏هذا تثبيت ثانوي من Growser، ولا يمكن جعله متصفحك التلقائي.</translation>
<translation id="7766756101194440006">‏أفضل إمكانات Growser ستكون متاحة لك باستخدام تطبيق Growser على "<ph name="DEVICE_TYPE"/>"</translation>
<translation id="8004582292198964060">المتصفّح</translation>
<translation id="8010081455002666927">الرصد التلقائي</translation>
<translation id="7685904775439037072">‏بعد حصول Growser على إمكانية الوصول، ستتمكن المواقع الإلكترونية من مطالبتك بإمكانية الوصول.</translation>
<translation id="3230755314472063687">‏يمكنك تثبيت Growser على شريط المهام للوصول إليه بسرعة في أي وقت</translation>
<translation id="80471789339884597">شكرًا على التثبيت. عليك إعادة تشغيل جميع المتصفِّحات قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">عرض اختصار ميزة "البحث بالصور" دائمًا</translation>
<translation id="8069447462453318634">يمكنك اختيار "تثبيت في شريط الأدوات"</translation>
<translation id="6175141682081019059">‏إيقاف تشغيل Growser في الخلفية أثناء عمل التطبيقات</translation>
<translation id="80790299200510644">البحث بالصور</translation>
<translation id="8086881907087796310">تعذّر تثبيت التطبيق لعدم استيفاء جهاز الكمبيوتر للحد الأدنى من متطلبات الأجهزة.</translation>
<translation id="8263061319795838019">‏صفحة "<ph name="PAGE_TITLE"/>": إصدار Growser for Testing</translation>
<translation id="2061155704815580583">‏يحتاج Growser إلى إذن تحديد الموقع الجغرافي من أجل هذا الموقع الإلكتروني.</translation>
<translation id="3576319845915562805">‏عند فتح Growser على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك تفعيل تنبيهات ميزة "تتبُّع الأسعار".</translation>
<translation id="3728025339793417202">‏يمكنك الحصول على تنبيهات عند انخفاض أسعار المنتجات التي تهمّك باستخدام تطبيق Growser على هاتفك</translation>
<translation id="8118331347066725040">‏إرسال ملاحظات عن البحث باستخدام "عدسة Growser"</translation>
<translation id="4449306641116952869">‏تخصيص Growser</translation>
<translation id="5334309298019785904">‏تعذّر على نظام التشغيل Growser مزامنة بياناتك لأن المزامنة غير متاحة لنطاقك.</translation>
<translation id="813913629614996137">تجري التهيئة...</translation>
<translation id="5775051495647233404">‏يمكنك فتح "Gemini في Growser" باستخدام اختصار لوحة مفاتيح.</translation>
<translation id="1081849497974110565">‏بنود الخدمة الإضافية لمتصفّح Growser</translation>
<translation id="9067428552314418522">‏هذا الملف ضار، لذلك فقد حظره Growser.</translation>
<translation id="8177472873527554730">يتعذّر العثور على المحتوى في الصفحة</translation>
<translation id="6219250889396046657">‏يجب إدخال عبارة المرور لاستخدام بيانات Growser وحفظها في حسابك (<ph name="USER_EMAIL"/>)</translation>
<translation id="8221491193165283816">أنت تحظر الإشعارات عادةً. للسماح لهذا الموقع الإلكتروني بإرسال إشعارات لك، انقر هنا.</translation>
<translation id="8377926237617998195">‏لاستخدام الكاميرا، يجب منح Growser إذن الوصول في <ph name="BEGIN_LINK"/>إعدادات النظام<ph name="END_LINK"/></translation>
<translation id="1755067029031059271">‏لا يمكن لمتصفّح Growser معرفة مصدر هذه الإضافة، وقد تكون غير آمنة. يُرجى إزالة هذه الإضافة من Growser كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="8207657266087451193">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Growser توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Growser. ويمكنك إيقاف هذه الميزة في الإعدادات في أي وقت.</translation>
<translation id="7792526144795244436">‏هل تريد تسجيل الدخول إلى Growser في ملف شخصي جديد؟</translation>
<translation id="183102473074922918">‏عرض "Gemini في Growser" في لوحة النظام وتفعيل اختصار لوحة المفاتيح</translation>
<translation id="976541154724186511">‏<ph name="BEGIN_LINK"/>يحذرك Growser<ph name="END_LINK"/> بشأن المواقع الإلكترونية وعمليات التنزيل غير الآمنة</translation>
<translation id="8060549744348950090">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Growser إذن <ph name="PERMISSION"/>.</translation>
<translation id="7402663241490331652">‏باستخدام الكاميرا في تطبيق Growser على iOS، يمكنك تسوّق ما يظهر لك أو ترجمته أو التعرّف عليه</translation>
<translation id="8313851650939857356">خطأ في بدء التشغيل: <ph name="STARTUP_ERROR"/></translation>
