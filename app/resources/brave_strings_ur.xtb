<translation id="6388799252195623474">اس کے ساتھ میری مدد کریں</translation>
<translation id="7920857181125123335">‏جاری رکھنے کے لئے Growser میں <ph name="EMAIL"/> سے سائن ان کریں۔ یہ یقینی بناتا ہے کہ آپ کو اپنی تنظیم کی پالیسیاں مل گئی ہیں۔</translation>
<translation id="3256100650978957522">‏کمپیوٹر اسکرین کے اندر Growser لوگو۔</translation>
<translation id="6373767849825830651">‏Growser ایک ایسا ویب براؤزر ہے جو ویب صفحات اور ایپلیکیشنز کو روشنی کی رفتار سے چلاتا ہے۔ Growser میں پہلے سے شامل میلویئر اور فریب دہی تحفظ کے ساتھ ویب کو مزید محفوظ طور پر براؤز کریں۔</translation>
<translation id="4091049150278654573">‏یہ یقینی بنانے کے لیے کہ آپ اپنے Growser اکاؤنٹ میں Growser ڈیٹا ہمیشہ استعمال اور محفوظ کر سکیں، تصدیق کریں کہ یہ آپ ہی ہیں</translation>
<translation id="2532326772258858491">‏‫Growser تیزی سے چلتا ہے اور JavaScript استعمال کرنے والی خصوصیات کو ڈیزائن کے مطابق کام کرنا چاہیے (تجویز کردہ)</translation>
<translation id="6436260184216827876">تصاویر کا استعمال کر کے تلاش دستیاب نہیں ہے۔ بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="2139300032719313227">‏ChromeOS کو ری سٹارٹ کریں</translation>
<translation id="638302211119176182">‏Growser ایسے اور بھی مزید صفحات کو پیشگی لوڈ کرتا ہے جنہیں آپ ممکنہ طور پر ملاحظہ کر سکتے ہیں، تاکہ وہ آپ کے ملاحظہ کرتے وقت مزید تیزی سے لوڈ ہو سکیں</translation>
<translation id="7167975344637731051">‏قیمتوں کو ٹریک کرنے اور کسی بھی سائٹ پر قیمت کم ہونے پر الرٹس حاصل کرنے کے لیے اپنے فون پر Growser ڈاؤن لوڈ کریں</translation>
<translation id="890319829408077946">‏آف • Growser اس بات کی تصدیق نہیں کر سکتا کہ یہ ایکسٹینشن کہاں سے آتی ہے</translation>
<translation id="1684121725014454063">‏Growser کی پروفائلز میں خوش آمدید</translation>
<translation id="8211983866539058675">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE"/> پر Growser کھولیں گے تو آپ کو ٹیب گروپس استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
