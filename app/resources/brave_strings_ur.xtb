<translation id="5524150602137990006">‏HTTPS دستیاب نہ ہونے پر، Growser آپ کو وارننگ دیے بغیر ایک غیر محفوظ کنکشن استعمال کرے گا</translation>
<translation id="6797402139308059782">‏Growser کو پس منظر میں چلنے دیں</translation>
<translation id="1448049584457347995">‏Growser کو محفوظ تر بنانے کیلئے، ہم نے کچھ ایکسٹینشنز کو غیر فعال کر دیا ہے جو <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> میں مندرج نہیں ہیں اور ہو سکتا ہے ان کو آپ کے علم کے بغیر شامل کیا گیا ہو۔</translation>
<translation id="5994491947936308173">‏فوری رسائی کے لیے Growser کو اپنے ٹاسک بار میں پن کرنے کی خاطر ونڈو اطلاع میں <ph name="BEGIN_BOLD"/>ہاں<ph name="END_BOLD"/> پر کلک کریں۔</translation>
<translation id="5875673934455379806">‏Growser کو دوبارہ انسٹال کریں</translation>
