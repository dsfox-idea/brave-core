<translation id="2182657378556811785">‏تقریباً اپ ٹو ڈیٹ! اپ ڈیٹ کرنے کو مکمل کرنے کیلئے Growser کو دوبارہ شروع کریں۔</translation>
<translation id="6311668361877328515">‏‫Growser کے V8 انجن کے ساتھ سائٹس کو تیز رفتار بناتا ہے لیکن Growser کو حملوں کے خلاف قدرے کم مزاحم بناتا ہے</translation>
<translation id="1299765473362724475">‏وارننگ: Growser ایکسٹینشنز کو آپ کی براؤزنگ سرگزشت ریکارڈ کرنے سے نہیں روک سکتا۔ اس ایکسٹینشن کو پوشیدگی وضع میں غیر فعال کرنے کے لیے اس اختیار کو غیر منتخب کریں۔</translation>
<translation id="7402642357351265733">‏اگر آپ Growser کے استعمال کی رپورٹس کا بھی اشتراک کرتے ہیں تو ان رپورٹس میں آپ کے ملاحظہ کردہ URLs شامل ہوں گے</translation>
<translation id="8142245354207161805">‏پروفائل دوسرے کمپیوٹر (<ph name="HOST_NAME"/>) پر دوسری Growser کارروائی (<ph name="PROCESS_ID"/>) کے ذریعہ زیر استعمال معلوم پڑتا ہے۔ Growser نے کارروائی کو مقفل کر دیا ہے تاکہ یہ خراب نہ ہو جائے۔ اگر آپ کو یقین ہے کہ کوئی دیگر کارروائیاں اس پروفائل کو استعمال نہیں کر رہی ہیں تو آپ پروفائل کو غیر مقفل کر کے Growser کو دوبارہ شروع کر سکتے ہیں۔</translation>
<translation id="4680828127924988555">انسٹالیشن منسوخ کریں</translation>
<translation id="2014343159590733363">‏آپ کا کچھ Growser ڈیٹا ابھی تک آپ کے Growser اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے کچھ منٹ انتظار کر کے دیکھیں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا حذف ہو جائے گا۔</translation>
<translation id="2408746614080689238">‏جب آپ سائن ان ہوتے ہیں، آپ Growser میں اپنے Growser اکاؤنٹ سے اپنے پاس ورڈز وغیرہ استعمال کر سکتے ہیں۔ <ph name="SHORTCUT"/> آپ کی Growser سروسز کی ترتیبات کو تبدیل کر سکتا ہے۔</translation>
<translation id="847561904663814268">‏کسی نے قبل ازیں اس کمپیوٹر پر Growser میں <ph name="ACCOUNT_EMAIL_LAST"/> کے بطور سائن ان کیا۔ اپنی معلومات علیحدہ رکھنے کیلئے براہ کرم ایک نیا Growser صارف بنائیں۔</translation>
<translation id="4724676981607797757">ایک غیر تعاون یافتہ پروٹوکول کی خرابی کی وجہ سے انسٹالیشن ناکام ہو گئی۔</translation>
<translation id="3834935463915107022">‏بہر حال Growser بند کریں؟</translation>
<translation id="8668413672647811944">‏Growser کے لیے ایک خاص سیکیورٹی اپ ڈیٹ ابھی ابھی لاگو کیا گیا ہے۔ ابھی دوبارہ شروع کریں اور ہم آپ کے ٹیبز کو بحال کر دیں گے۔</translation>
<translation id="4941816441131888792">‏آپ نے حال ہی میں ملاحظہ نہیں کیا ہے۔ ‫Growser نے <ph name="PERMISSION_1"/>، <ph name="PERMISSION_2"/> اور <ph name="COUNT"/> مزید کو ہٹا دیا۔</translation>
<translation id="844451748565342664">‏اگر Growser میں Gemini کھلا ہے تو نئے ٹیبز بناتے وقت سائیڈ پینل کھلا رہتا ہے</translation>
<translation id="215320507915280336">‏یہ وہی املا جانچ کنندہ استعمال کرتا ہے جسے Growser تلاش میں استعمال کیا جاتا ہے۔ آپ براؤزر میں جو متن ٹائپ کرتے ہیں، اسے Growser کو بھیجا جاتا ہے۔ آپ اس برتاؤ کو کسی بھی وقت ترتیبات میں تبدیل کر سکتے ہیں۔</translation>
