<translation id="3561569806301739367">‏<ph name="FILE_NAME"/> خطرناک ہو سکتی ہے، اس لیے Growser نے اسے مسدود کر دیا ہے۔</translation>
<translation id="3205074487970075628">‏Growser آپ کا کیمرا استعمال کر رہا ہے۔</translation>
<translation id="1819119299840995223">‏Growser پر ایک اور کارروائی کی جا رہی ہے۔ براہ کرم بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="8616874628011103667">‏اب آپ کے Growser اکاؤنٹ کے ساتھ اور اشتراک کردہ کمپیوٹرز پر Growser کا استعمال زيادہ آسان ہے۔</translation>
<translation id="5213389303624223677">‏‫Growser کو اپنے ڈیفالٹ براؤزر کے طور پر سیٹ کر کے ان خصوصیات تک آسان رسائی حاصل کریں جنہیں آپ جانتے، پسند کرتے اور ان پر بھروسہ کرتے ہیں۔</translation>
<translation id="4264606872840545968">‏‫Growser شارٹ کٹ</translation>
<translation id="6890616081898535725">‏Growser نے اس ڈاؤن لوڈ کو مسدود کر دیا کیونکہ فائل عام طور پر ڈاؤن لوڈ نہیں ہوتی ہے اور یہ خطرناک ہو سکتی ہے</translation>
