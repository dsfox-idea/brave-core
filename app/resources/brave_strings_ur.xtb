<translation id="7185585387858242335">‏شارٹ کٹس Growser میں کھلتے ہیں</translation>
<translation id="3617744907966785605">‏آپ کی تنظیم Growser کو بند کر دیتی ہے جب اسے <ph name="TIMEOUT_DURATION"/> کے لیے استعمال نہیں کیا جاتا ہے۔ براؤزنگ ڈیٹا کو حذف کر دیا گیا تھا۔ اس میں سرگزشت، آٹو فل اور ڈاؤن لوڈز شامل ہو سکتے ہیں۔</translation>
<translation id="8646609321956191980">‏ہر پروفائل میں بُک مارکس، سرگزشت اور پاس ورڈز وغیرہ جیسی Growser کی اپنی ذاتی معلومات ہوتی ہے</translation>
<translation id="6756656512757374876">‏اس بارے میں مزید جانیں کہ <ph name="BEGIN_LINK"/>Growser آپ کے ڈیٹا کو کس طرح نجی رکھتا ہے<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">‏اس ترتیب پر تبدیلیوں کا اطلاق Growser ری سٹارٹ ہونے کے بعد ہوگا۔</translation>
<translation id="3396870972301571614">‏‫Growser کے مرکزی مینیو میں ایکسٹینشنز پر کلک کر کے اپنی ایکسٹینشنز کا نظم کریں۔</translation>
<translation id="2535436634051789953">‏آپ دوسرے Growser پروفائل سے پاس ورڈز دیکھنے کے لیے سوئچ کر سکتے ہیں</translation>
<translation id="6376474391582629025">‏چلتے پھرتے بہترین AI ٹولز کا استعمال کرنے کے لیے Growser ایپ کا استعمال کریں</translation>
<translation id="2312399718665761438">‏ہجے کی غلطیاں ٹھیک کرنے کے لیے آپ ٹیکسٹ فیلڈز میں جو ٹیکسٹ ٹائپ کرتے ہیں Growser اسے Growser کو بھیجتا ہے</translation>
<translation id="3507835409099344374">‏Growser کی اطلاع کی ترتیبات پر جائیں</translation>
<translation id="6600016381025017075">اس صفحہ پر کچھ بھی تلاش کریں</translation>
<translation id="9156965752763025780">‏آپ کی تبدیلیاں Growser کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="3387992981600748596">‏‫Windows کے شروع ہونے پر Growser اب لانچ ہوتا ہے تاکہ آپ فوری طور پر براؤزنگ شروع کر سکیں۔ آپ اسے ترتیبات میں آف کر سکتے ہیں۔</translation>
<translation id="3119017564683030312">‏جہاں آپ نے چھوڑا تھا وہیں سے جاری رکھیں: Growser نے آپ کے آخری سیشن سے آپ کے ٹیبز کو بحال کیا۔ آپ اسے درج ذیل میں آف کر سکتے ہیں</translation>
<translation id="245693535809364497">‏Growser کو آپ کے اطراف کا 3D نقشہ تخلیق کرنے کے لیے کیمرے کی اجازت درکار ہے</translation>
<translation id="9210457680074341078">‏اگر آپ اپنے بُک مارکس کو اپنے Growser اکاؤنٹ میں بھی محفوظ کرتے ہیں تو آپ Growser میں پروڈکٹ کی قیمتوں کو ٹریک کر سکتے ہیں اور قیمت میں گراوٹ ہونے پر اطلاع حاصل کر سکتے ہیں</translation>
<translation id="6676384891291319759">انٹرنیٹ تک رسائی حاصل کریں</translation>
<translation id="1363996462118479832">‏ChromeOS سائن ان میں ایک خرابی کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="4694512973195649124">‏‫Growser سے اس ایپس کا ڈیٹا ہٹائیں</translation>
<translation id="1257247502847251159">‏Growser کو اس سائٹ کے لیے مائیکروفون کی اجازت درکار ہے</translation>
<translation id="6712881677154121168">ڈاؤن لوڈ سے متعلق خرابی: <ph name="DOWNLOAD_ERROR"/>۔</translation>
<translation id="1489465648257900784">‏آپ کا پروفائل استعمال نہیں کیا جا سکتا ہے کیونکہ یہ Growser کے ایک جدید تر ورژن سے ہے۔

ممکن ہے کچھ خصوصیات غیر دستیاب ہوں۔ براہ کرم ایک مختلف پروفائل ڈائریکٹری متعین کریں یا Growser کا ایک جدید تر ورژن استعمال کریں۔</translation>
<translation id="1505112054322049777">‏ذاتی نوعیت سازی اور دیگر خصوصیات حاصل کرنے کے لیے، ویب اور ایپ سرگرمی اور لنک کردہ Growser سروسز میں Growser شامل کریں</translation>
<translation id="6666624454809779082">‏Growser پہلے سے آپ کے کمپیوٹر پر سبھی صارفین کیلئے انسٹال ہے۔</translation>
<translation id="5848830584656405219">‏اپنے تمام آلات پر اپنے بُک مارکس اور مزید حاصل کرنے کے لیے، Growser میں سائن ان کریں۔ آپ کے سائن ان کرنے کے بعد یہ بُک مارک آپ کے Growser اکاؤنٹ میں محفوظ ہو جائے گا۔</translation>
<translation id="4020203987234748583">‏‫Growser کے V8 انجن کے ساتھ سائٹس کو تیز رفتار بناتا ہے لیکن Growser کو حملوں کے خلاف قدرے کم مزاحم بناتا ہے۔ یہ ترتیب آن ہے۔</translation>
<translation id="3848421741245997269">{count,plural, =1{‏آپ کا کچھ Growser ڈیٹا ابھی تک آپ کے Growser اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا (1 آئٹم) حذف ہو جائے گا۔}other{‏آپ کا کچھ Growser ڈیٹا ابھی تک آپ کے Growser اکاؤنٹ میں محفوظ نہیں ہوا ہے۔ سائن آؤٹ کرنے سے پہلے چند منٹ انتظار کرنے کی کوشش کریں۔ اگر آپ ابھی سائن آؤٹ کرتے ہیں تو یہ ڈیٹا ({count} آئٹمز) حذف ہو جائے گا۔}}</translation>
<translation id="3136039682492230890">‏Growser اس فائل کو اسکین کرنے کی تجویز کرتا ہے کیونکہ یہ خطرناک ہو سکتی ہے۔</translation>
<translation id="1547295885616600893">‏ChromeOS اضافی <ph name="BEGIN_LINK_CROS_OSS"/>اوپن سورس سافٹ ویئر<ph name="END_LINK_CROS_OSS"/> کے ذریعے ممکن ہو پایا ہے۔</translation>
<translation id="6831043979455480757">ترجمہ کریں</translation>
<translation id="8211837073776713955">‏Growser آپ کو بتاتا ہے کہ آیا آپ کے پاس ورڈز کے ساتھ کبھی چھیڑ چھاڑ کی گئی ہے</translation>
<translation id="684888714667046800">انٹرنیٹ سے منسلک ہونے سے قاصر ہے۔ اگر آپ فائر وال استعمال کرتے ہیں، تو براہ کرم یقینی بنائیں کہ <ph name="PRODUCT_EXE_NAME"/> ااجازت یافتہ کی فہرست میں ہے۔</translation>
