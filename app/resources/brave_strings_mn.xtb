<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="7099479769133613710">&amp;ChromeOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="2479110114759182442">Growser танд энэ өргөтгөлийг шалгахыг зөвлөж байна</translation>
<translation id="3814674848168165531">Сайт өөрийн хуудсан дээр холбооснуудыг нууцлалтайгаар урьдчилан ачаалахыг хүсэхэд Growser Growser-н серверүүдийг ашиглана. Энэ нь таны таниулбарыг урьдчилан ачаалсан сайтаас нуух ч Growser ямар сайтуудыг урьдчилан ачаалдгийг мэдэж авна.</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="7577672138294294152">Таны эцэг эх Growser-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="4408482856437790071">Growser-н тодорхой онцлог, өргөтгөлийг хайхын тулд хаяг оруулах хэсэгт товчлолыг нь сонгосон товчлуурт гарын товчийн хамт шивж оруулна уу</translation>
<translation id="5918095577778020936">Growser таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="112640046208448578">Зүйл болон газрыг таньж, текст хуулж эсвэл орчуулна. Таныг Зурган хайлтыг ашиглахад хуудасны дэлгэцийн агшныг сервер лүү илгээнэ. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">Growser таны өгөгдмөл хөтөч</translation>
<translation id="8522292744959221145">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK"/>Growser-д нэвтэрнэ үү<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">Growser цэсийг товшино уу</translation>
<translation id="1157985233335035034">Саяхан сонгосон хэлнүүд</translation>
<translation id="1184145431117212167">Таны Windows-н хувилбарыг дэмждэггүй тул суулгаж чадсангүй.</translation>
<translation id="8541922081612557424">Growser-ийн тухай</translation>
<translation id="987734326276404793">Утсан дээрээ Growser-р үнэ мөшгөх мэдэгдэл аваарай</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME"/>-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1232234696885483911">Таныг Зурган хайлтыг нээхэд хуудасны гарчиг, URL болон PDF зэрэг контентыг сервер лүү автоматаар илгээнэ. <ph name="LEARN_MORE"/></translation>
<translation id="1934377710648094656">Та нэвтэрсэн байхдаа Growser-д Growser Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. Үүнийг өөрчлөхийн тулд “Growser дахь таны бүртгэл” рүү очно уу.</translation>
<translation id="583633806828413086">Mac-н цэсийн мөрд Growser дахь Gemini-г харуулах</translation>
<translation id="1631493536097460865">Growser дахь Gemini-д дэлгэцийн хэсгийг сонгохын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="8799570501820813406">Энэ табыг идэвхгүй үед Growser-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="8767381092474532098">Энэ файл аюултай тул Growser энэ таталтыг блоклосон</translation>
<translation id="3256289531845594061"><ph name="USER_EMAIL"/>-р Gmail эсвэл YouTube зэрэг Growser-н үйлчилгээнд нэвтрэх үед та тухайн бүртгэлээр Growser-д автоматаар нэвтрэх боломжтой</translation>
<translation id="8508169558526580571">Утсан дээрээ Growser-г аваарай</translation>
<translation id="1290883685122687410">Тохируулгын алдаа: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">Growser-н шинэ профайлаа тохируулах</translation>
<translation id="4291722755910963157">Growser дахь Gemini-р туршиж үзэх</translation>
<translation id="878572309106296578">Growser-д Bluetooth төхөөрөмжүүдийг судлахад 
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="7562683844189283122">Утсан дээрээ Growser-д нэвтрэх</translation>
<translation id="1330562121671411446">Хэл илрүүлэх</translation>
<translation id="108284536240904209">Мөн Growser-с өгөгдөл устгах (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Бэхэлсэн! Та Зурган хайлтад самбар дээрх шинэ товчоос дахин хандах боломжтой</translation>
<translation id="1356661055722410047">Шинэ! Та дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="1383876407941801731">Хайлт</translation>
<translation id="3535301204632475895">Явж байх зуураа үргэлжлүүлэн үзэхийн тулд Growser аппыг ашиглаарай</translation>
<translation id="7009295044271335553">&amp;Growser-н профайлуудыг удирдах</translation>
<translation id="141901961143729572">Бодол санаагаа хуваалц</translation>
<translation id="3880714039086599943">Цонхоо хуваалцахын тулд Системийн тохиргоонд Growser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="1586284627848250203">Growser for Testing-р тусламж авах</translation>
<translation id="1497802159252041924">Суулгалтын алдаа: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Энэ хуудсыг хамгаалагдсан байна</translation>
<translation id="5147525139567260139">Growser-н таб хуваалцах</translation>
<translation id="721261350616678948">Growser-д нэвтрэх</translation>
<translation id="1547469039832541117">Тодруулсан ажлыг дуусгана.</translation>
<translation id="51545890371361355">Growser-г бэхлэх</translation>
<translation id="6570689355868013775">Growser-н аюулгүй байдлын хэрэгсэл</translation>
<translation id="1902837727299679178">Growser таны Нууц үгний менежерийн өгөгдлийг устгахыг хүсэж байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="1655849915812740665">Утсан дээрээ Growser аппаар Growser-н шилдэг зүйлсийг аваарай</translation>
<translation id="4449148723378534338">Growser-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1665602916345474427"><ph name="USER_NAME"/><ph name="USER_EMAIL"/>-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="509363484780540563">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Growser-г ашиглах боломжтой. Үүнийг мөн таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/>-н нэмэлт эрхээр хангадаг.</translation>
<translation id="8004287232784878841">Growser удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="4197839351786449392">Growser навигацуудыг HTTPS болгож сайжруулахаар оролдоно</translation>
<translation id="7814200940910057384">Growser-н өгөгдлийг устгасан</translation>
<translation id="9048361966237194186">Growser-г <ph name="REMAINING_TIME"/>-н дараа дахин эхлүүлнэ</translation>
<translation id="5524150602137990006">HTTPS боломжгүй үед Growser танд сануулалгүйгээр аюултай холболт ашиглана</translation>
<translation id="6797402139308059782">Growser-ыг арын орчинд ажиллуулах</translation>
<translation id="5994491947936308173">Growser-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэл дэх <ph name="BEGIN_BOLD"/>Тийм<ph name="END_BOLD"/> дээр товшино уу</translation>
<translation id="5875673934455379806">Growser-ыг дахин суулгах</translation>
<translation id="4529028207655448215">Growser <ph name="AUTHENTICATION_PURPOSE"/> оролдож байна</translation>
<translation id="7362761326208547489">Та дараагийн удаа <ph name="DEVICE_TYPE"/> дээрээ Growser-г нээхдээ Growser Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="1838374766361614909">Хайлтыг арилгах</translation>
<translation id="3541642064306182066">Интернэтээр үзсэн өгөгдлөө Growser Бүртгэлдээ үлдээж, зөвхөн энэ төхөөрөмжөөс устгахын тулд <ph name="BEGIN_LINK"/>Growser-с гарна уу<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ Growser-г татаарай.</translation>
<translation id="4559627161887338743">Та нэвтэрсэн Growser Бүртгэлүүдээ удирдах боломжтой. Таны Growser Бүртгэлүүдийг Growser хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE"/>-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN"/>Нэмэлт мэдээлэл авах<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Зурган хайлтаар хайх</translation>
<translation id="2963742289915075304"><ph name="EXISTING_USER"/> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Growser-д <ph name="USER_EMAIL_ADDRESS"/>-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE"/>-с хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="1880677175115548835">Текст сонгох</translation>
<translation id="4528406859989804913">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн Growser-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны Growser-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME"/> руу нэгдэх болно. Та энэ мэдээллийг Growser-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа Growser-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Growser саадгүй гүйлгэх, видеоны фреймийн хурд зэрэг арын үйл ажиллагаа болон визуал эффектийг хязгаарласнаар батарейн цэнэгийг хэмнэнэ. <ph name="BEGIN_LINK"/>Эрчим хүч хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK"/></translation>
<translation id="8643267611122541711">Growser Шинэчлэгч үйлчилгээ</translation>
<translation id="1649714546770135458">Үүнийг унтрааснаар та Gmail зэрэг Growser-н сайтуудад Growser-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="189297655255130768">Growser ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="8422047647688939115">Танай байгууллага болох <ph name="MANAGER"/> таныг Growser-д нэвтрэхийг шаардаж байна</translation>
<translation id="4035053306113201399">Шинэчлэлтийг хэрэгжүүлэхийн тулд ChromeOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="9048754176089806686">Файлын төрлийг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул Growser энэ таталтыг блоклосон</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE"/> минут үлдсэн</translation>
<translation id="1775322105159056176">Growser нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="197326043290947695">Зурган хайлтаар илүү ухаалгаар үзээрэй</translation>
<translation id="4372901050442507812">Growser зарим файлыг яагаад блоклодог болохыг мэдэж авна уу, шинэ табд нээгдэнэ</translation>
<translation id="2703425183860615504">Таны Growser программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны Growser-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг Growser-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="9220324636239049437">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Growser-д <ph name="USER_EMAIL"/>-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="2039417478970545937">Тохиргоо.</translation>
<translation id="5499149312981370855">Growser-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд Growser-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="5152523902653128156">Танд сайн нууц үг үүсгэх, хадгалах, автоматаар бөглөхөд туслахын тулд Growser-д суурилуулсан. Хялбар хандахын тулд товчлолыг нэмээрэй.</translation>
<translation id="6959434860418352144">Growser-д шинэ дүр төрх өгөхийн тулд Шинэ таб хуудсан дээрх Growser-г тусгайлан өөрчлөх товчин дээр товшино уу</translation>
<translation id="2472891440303445472">Файл нь хуурамч бөгөөд таны төхөөрөмжид гэнэтийн өөрчлөлт хийж магадгүй тул Growser энэ таталтыг блоклосон</translation>
<translation id="2054358978145431867">Та дараагийн удаа Growser iOS-г нээхдээ <ph name="FEATURE_NAME"/>-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="2726948994393234543">Таны Growser Бүртгэлдээ хадгалсан нууц үг болон Growser-н бусад өгөгдлийг энэ төхөөрөмжөөс хасна. Тэдгээрийг Growser-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{Growser-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{Growser-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="2125838419757773031">Хайх дэлгэцийн хэсэг сонгох</translation>
<translation id="2126108037660393668">Татсан файлын баталгаажуулалт амжилтгүй боллоо.</translation>
<translation id="2135919691573380097">Энэ сайтыг мэдээлэх</translation>
<translation id="2137162749895930932">Орчуулах дэлгэцийг хаах</translation>
<translation id="5789330946301045610">Сайт аюулгүй холболт ашиглахгүй байгаа бөгөөд файлыг оролдсон байж магадгүй тул Growser энэ таталтыг блоклосон</translation>
<translation id="2170098639895543546">Хуудсан дээрх дурын зүйлийг сонгоно уу</translation>
<translation id="142389341645668510">Growser-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="8745514854244955877">Growser - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Шалгалтын алдааг шинэчлэх: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">Growser-с бүртгэл хасах</translation>
<translation id="4022045673362955204">Growser аппыг ашиглан худалдан авалтын шилдэг хэрэгслүүдийг явж байх зуураа ашиглаарай</translation>
<translation id="5550942974310218641">iOS-т зориулсан Growser дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="6677253423995557759">Аюултай сайт. Growser мэдэгдлүүдийг хассан.</translation>
<translation id="2236949375853147973">Миний үйл ажиллагаа</translation>
<translation id="457168681575748148">Хаяг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Growser-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хаягийг Growser Бүртгэлд тань хадгална.</translation>
<translation id="5659384504794665581">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ Growser-ыг тохируулж болно.</translation>
<translation id="2752319862668322390">Growser-н Ур чадвар</translation>
<translation id="2283803047247799269">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{Growser таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Growser таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2307973900865360088">Суурилуулагчид байлгах</translation>
<translation id="7810992039564280750">URL-г Growser-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед Growser нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="2356070529366658676">Асуух</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="6485997157403727556">"<ph name="EXTENSION_NAME"/>" өргөтгөл таныг Growser-д нэвтрэхийг хүсэж байна</translation>
<translation id="7017760840808989683">Аппуудын хувьд Growser-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="8491912023989916905">Энэ өргөтгөлийг <ph name="USER_EMAIL_ADDRESS"/>-р ашиглахын тулд Growser-д нэвтэрнэ үү.</translation>
<translation id="8418845734693287262">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromeOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байсан}=1{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байна}other{# HID төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байна}}</translation>
<translation id="1248225940185478633">Growser-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2403703063067034158">Эхлэхэд алдаа гарлаа: одоогоор тохируулгын өөр нэг инстанс ажиллаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="5298352791080868905">Дурын аппаас холбоосыг Growser-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="2600233721598267627">Шуурхай тойм авах, араас нь лавлах асуулт асуухаар энэ баримт бичгийг Growser дахь Gemini-тай хуваалцахын тулд Хураангуйлах товчин дээр товшино уу</translation>
<translation id="2118275934191847461"><ph name="BEGIN_LINK"/>Growser-н хэрэгслийн<ph name="END_LINK"/> тусламжтайгаар та аюулгүй үзэх болон хяналтыг гартаа байлгах боломжтой</translation>
<translation id="7508460698788470991"><ph name="EXISTING_USER"/> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Growser-д <ph name="USER_EMAIL_ADDRESS"/>-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="2451727308784734061">Нууц үгний менежерт шуурхай очихын тулд товчлолоо ашиглана уу. Та товчлолоо компьютерын үндсэн нүүр эсвэл апп байршуулагч руугаа зөөх боломжтой.</translation>
<translation id="6381750314821942592">Growser-г удахгүй хаана</translation>
<translation id="6078442581074612226">Growser-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2513154137948333830">Дахин асаах шаардлагатай: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Зурган хайлтаар текст сонгоно уу</translation>
<translation id="70183448213529602">Growser одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="7798069806040634998">Файл татахын тулд Growser-д сангийн хандалт шаардлагатай</translation>
<translation id="8447483940522230788">Growser-ийн туслагч</translation>
<translation id="2575822587468774919">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгоно уу</translation>
<translation id="3830890663494219270">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="6908148552215338695">Growser-г татаж, Growser Бүртгэлдээ нэвтрэхийн тулд утсаараа QR кодыг скан хийнэ үү.</translation>
<translation id="6252796827759111076">Growser-г үргэлжлүүлэн ашиглах</translation>
<translation id="259935314519650377">Татсан суулгагчийг завсрын санах ойд хадгалж чадсангүй. Алдаа: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Систем</translation>
<translation id="7931230852267968641">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь Growser-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="2257221826278123061"><ph name="ACCOUNT_EMAIL"/> бүртгэлдээ Growser-н өгөгдлөө ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="7048234400304379082">Growser дахь Gemini-с гарах, түүн рүү буцахын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="5655607968417451974">Growser-г эхлүүлэх</translation>
<translation id="7387051847644272380">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. Growser-ыг дахин татаж авна уу.</translation>
<translation id="2648689842065142443">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Growser-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="1001521084148238686">Growser-г жижгэрүүлсэн байсан ч төхөөрөмж дээрээ Growser дахь Gemini-г ашиглахын тулд хялбархан хандаарай.</translation>
<translation id="6791166902140255175">Growser таб</translation>
<translation id="8372880274820509128">Таны аюулгүй байдлыг сайжруулахын тулд Growser таны өгөгдлийг шифрлэх болно.</translation>
<translation id="8752006915531191162">Growser Бүртгэлээ Growser-с хасахын тулд гарна уу</translation>
<translation id="5344406739101555055">Нууц үг, хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="2738871930057338499">Интернэтэд холбогдох боломжгүй байна. HTTP 403 хориотой. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2753623023919742414">Хайхын тулд товшино уу</translation>
<translation id="1312769823139326127">Growser-г өгөгдмөл PDF үзэгчээрээ тохируулах</translation>
<translation id="1187986649024576560">Энэ өргөтгөл хортой программ агуулж байгаа бөгөөд аюултай байна. Үүнийг Growser-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="5962774139606909656">Таны Growser</translation>
<translation id="2816462166102338036">Зурган хайлтаар энэ видеог хай</translation>
<translation id="1992849613617207128">iOS дээрх Growser-р камераараа бүтээгдэхүүн олж, үнийн бууралт болон илүү ихийг явж байх зуураа хянаарай.</translation>
<translation id="2841525013647267359">Дараах хэлээс орчуулах</translation>
<translation id="2846251086934905009">Суулгах үед алдаа гарлаа: Суулгагч дуусгаагүй. Суулгалтыг тасалсан.</translation>
<translation id="777113543093865885">Growser-аас устгах ...</translation>
<translation id="5265419033369521352">Таныг нэвтэрсэн үед Growser дээр таны аюулгүй байдлыг хангадаг бөгөөд Growser-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="2176825726964012531">Growser-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="2481553173340651149">Таны өгөгдлийг нэвтрэх үгээр тань шифрлэдэг. Growser Бүртгэлдээ Growser-н өгөгдлөө ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу.</translation>
<translation id="2945997411976714835">Суулгах үед алдаа гарлаа: Суулгагч явцыг эхлүүлж чадсангүй.</translation>
<translation id="2413255940314578781">iOS-т зориулсан Growser-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="3688936822855019158">Танай байгууллага Growser-г удирддаг</translation>
<translation id="8208853227947884571">Growser-г шинэчилсэн байна</translation>
<translation id="5122472867956731189">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед Growser URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="3963199983793987097">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="3003694935412297923">Бүх ажил</translation>
<translation id="7611046016537686219">{count,plural, =1{Зарим өгөгдлийг таны Growser Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Growser таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Зарим өгөгдлийг таны Growser Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Growser таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="4202995875619419215"><ph name="URL"/>-г Growser-д шинэ табд нээнэ үү.</translation>
<translation id="1266825212217391702">Ур чадвар зэрэг ХОУ-ы инновацыг таны Growser Бүртгэлд хадгалж, Growser Синкээс тусад нь удирддаг</translation>
<translation id="8880183781256147665">Growser-д өгөгдөл нэмэх нь ...</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
<translation id="3045032126857188731">Орчуулсан хэл: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Санал хүсэлтийн харилцах цонхыг хаах</translation>
<translation id="4503085212612536713">Growser-н бусад профайл</translation>
<translation id="2041039306630146369">Өргөтгөл нь танд Growser-г тусгайлан өөрчлөх боломжийг олгодог нэмэлт юм. Цэгцтэй байхаас эхлээд өдөр тутмын ажлыг хялбаршуулах хүртэл өргөтгөл танд Growser-г өөрийн болгоход тусалдаг.</translation>
<translation id="7918740962659365265">Алдаа ослын тайлан болон <ph name="UMA_LINK"/>-ыг Growser рүү илгээх замаар Growser-ыг улам сайжруулахад тусална уу.</translation>
<translation id="6828757829023033545">Growser-н аюулгүй байдлын онцлогуудыг явж байх зуураа авахын тулд Growser аппыг ашиглаарай</translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байсан}=1{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байна}other{# USB төхөөрөмжид нэг эсвэл түүнээс олон Growser-н өргөтгөл хандаж байна}}</translation>
<translation id="3700405816184340252">Growser-н түүх</translation>
<translation id="7365690458036015383">Програм суулгагч нь архивыг задалж үл чадсан тул Growser-г дахин татаж авна уу.</translation>
<translation id="310459126943037700">Ажил(ууд)-ыг дуусгаж чадсангүй.</translation>
<translation id="3104828284009500087">Хуудсан дээрх аливаа зүйлийг хайна уу</translation>
<translation id="6422885447166607802">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсэн байлгаарай. Та өгөгдмөл хөтчөө Growser болгон шинэчилж мэддэг, дуртай онцлогууддаа хялбархан хандаарай.</translation>
<translation id="8919461291440820124">Growser нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3130333203120345554">Шинэ хайлт</translation>
<translation id="3137969841538672700">Хайхын тулд чирнэ үү</translation>
<translation id="8372436892102763334">Энэ таб нэмэлт нөөц ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Growser-д энэ табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="5949068186379578553">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Growser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="4805806622840861220">Growser-г дахин эхлүүлэх</translation>
<translation id="3161522574479303604">Бүх хэл</translation>
<translation id="1742948938503172561">Growser-н шинэ профайлаа тохируулна уу</translation>
<translation id="2430807206104224491">Та таб сэлгэхгүйгээр ХОУ-ы горимтой үргэлжлүүлэн чатлах боломжтой. Эхлүүлэхийн тулд Growser-д нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="4805865169608137960">Growser Бүртгэлээ Growser-с хасахын тулд Тохиргооны хуудсанд Growser-с гарна уу</translation>
<translation id="1651639704310627074">Дараа нь Growser танаас хадгалсан мэдээллийг танд зориулж маягтыг автоматаар бөглөхөд ашигламаар байгаа эсэхийг асууж болно</translation>
<translation id="2585240446624043880">Growser нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="8414435293910785169">iOS дээрх Growser-р Growser-н ХОУ-ы дуртай хэрэгслүүдээ явж байх зуураа ашиглаарай.</translation>
<translation id="3286538390144397061">Одоо дахин эхлүүлнэ үү</translation>
<translation id="2339258256897053758">Growser-ийн API түлхүүр байхгүй байна. Growser-ийн зарим функц идэвхгүй болно.</translation>
<translation id="8926637909431618259">Growser-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="518125528057094977">Growser аюултай холболт ашиглан аливаа сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="8652321858775514885">Хэрэв та Growser-д нэвтэрсэн бол таныг Growser-н бүх цонхыг хаах үед Growser Бүртгэлээс тань бусад ихэнх сайтаас гаргана. Сайтад таныг санахыг зөвшөөрөхийн тулд <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">хайлтын хэсгийн баруун дээд булан: баруун <ph name="RIGHT"/>%, дээд <ph name="TOP"/>%</translation>
<translation id="7261356974224431851">Таны бүртгэлийн Growser-н өгөгдөл</translation>
<translation id="6610330853796830621">Утсан дээрээ Growser-р нууц үгнүүдээ ашиглах</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="2297290224191497273">Growser-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3412460710772753638">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="2491221873705777076">Утсан дээрээ Growser-р Сайжруулсан аюулгүй хөтчийг өргөтгөх</translation>
<translation id="7304389940068374923">Growser-г өөрийн болгоорой...</translation>
<translation id="5853262807109651878">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT"/> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Growser-д <ph name="USER_EMAIL"/>-р нэвтэрнэ үү.</translation>
<translation id="2024972335338126423"><ph name="SHORTCUT"/> Growser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="8703492925273919597">Growser-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="599091950194451698">Цонхоо хуваалцахын тулд Системийн тохиргоонд Growser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="1447863765638888625"><ph name="EXISTING_USER"/> аль хэдийн нэвтэрсэн байна.  Хөтчийн үзэлтээ тусдаа байлгахын тулд Growser-д <ph name="USER_EMAIL_ADDRESS"/>-р өөрийн профайлаар нэвтэрнэ үү.</translation>
<translation id="7624624622436403494">Хөдөлгөөнт төхөөрөмж дээр Growser хөтчийг татах QR код</translation>
<translation id="8478154085901340543">Сануулагч: Growser-н аюулгүй байдлын шилдэг онцлогууд таны халаасанд байна</translation>
<translation id="8981774130895723211">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Growser-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="2981961446160697133">Сайжруулсан хамгаалалт нь Growser-н танихгүй сайтуудын JavaScript-н оновчлолыг унтраадаг</translation>
<translation id="3597003331831379823">Нэмэлт эрхтэйгээр тохируулгыг ажиллуулж чадсангүй. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="4167284810587724062">Growser-д нэвтрэх</translation>
<translation id="3066805437003400520">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд Growser-д <ph name="USER_EMAIL"/>-р нэвтэрнэ үү.</translation>
<translation id="3667616615096815454">Суулгах боломжгүй. Аппликэйшнийг сервер танихгүй байна.</translation>
<translation id="1128485277465085828">Growser Бүртгэлийнхээ Growser-н бүх өгөгдлийг шифрлэхийн тулд <ph name="BEGIN_LINK"/>өөрийн нэвтрэх үгийг<ph name="END_LINK"/> ашиглана уу. Google Pay-н төлбөрийн хэрэгсэл, хаягийг шифрлэхгүй. Growser-н хөтчийн түүхийг синк хийхгүй.</translation>
<translation id="1807774211756215222">Холбоосыг шинэ Growser болон табад нээх</translation>
<translation id="387105482057676379">Хувийн болгох болон бусад зорилгоор Growser болон Growser-н бусад үйлчилгээг холбоно уу</translation>
<translation id="3729187154190517324">"Таб болон бусад зүйл нэмэх" товчийг ашиглан олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй.</translation>
<translation id="3867175562099983425">Growser-н профайлуудыг удирдах</translation>
<translation id="308146532933302843">Growser зарим татаж авсан файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="2189149060536531804">Та ямар нэг зүйлийг шалгах шаардлагатай бол Growser танд мэдэгдэнэ</translation>
<translation id="6324134303015966238">Growser таны зочлох магадлалтай хуудаснуудыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="3810973564298564668">удирдах</translation>
<translation id="4815742196440583661">Хадгалсан нууц үгнүүдээ ашиглахын тулд QR кодыг уншуулаад, iOS-т зориулсан Growser-г татаж, Growser Бүртгэлдээ нэвтэрнэ үү</translation>
<translation id="3846683726093018685">**Хураангуйлах:** 30-аас цөөн үгтэй нэг өгүүлбэрээр дэлгэцийн агшны агуулгын үндсэн сэдэв, зорилгыг тайлбарлана уу.

          **Асуулт санал болгох:** Хэрэглэгч дэлгэцийн агшныг илүү сайн ойлгохын тулд асууж болох 3-5 бодлогошруулах асуултын жагсаалтын тэмдэгтэй жагсаалт (bulleted list) үүсгэнэ үү. Эдгээр асуултын дор хаяж нэг нь визуал объект, үүний дизайн, байршлын талаарх тодорхой асуулт байх ёстой.</translation>
<translation id="5381622442243174305"><ph name="PAGE_TITLE"/> - Growser</translation>
<translation id="1118754729376002185">Growser-д энэ сайтын хувьд дотоод сүлжээний зөвшөөрөл шаардлагатай</translation>
<translation id="3885770153807205175">Хэл сонгогч</translation>
<translation id="6315734375101223238">Growser-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="7130675370997202556">Growser-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="3892148308691398805">Текстийг хуулах</translation>
<translation id="4920958997042285125"><ph name="EXISTING_USER"/> Growser-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд Growser танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="8744239658215739511">Growser-аа тусгайлан өөрчлөх</translation>
<translation id="3941890832296813527">Суулгах үед алдаа гарлаа: Суулгагчийн файлын нэр буруу эсвэл дэмжигдээгүй.</translation>
<translation id="8090497651549769448">Growser нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="4256965182800026277">Таны Growser Бүртгэлдээ хадгалсан нууц үг, төлбөрийн хэрэгсэл, хаягуудыг энэ төхөөрөмжөөс хасна. Тэдгээрийг Growser-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="395904275706073188">Хамгаалагдсан хуудсыг унших боломжгүй. Өөр хуудас туршиж үзнэ үү.</translation>
<translation id="4194619960643453552">Growser таныг хэрхэн аюулгүй байлгадаг болохыг мэдэж авна уу</translation>
<translation id="3967822245660637423">Татаж авч дууслаа</translation>
<translation id="1486377520191913768">Таныг хаяг оруулах хэсэг, хайх хэсэгт шивэх үед Growser зөвлөмж авахын тулд таны шивсэн зүйлийг танай байгууллагын хайлт, ХОУ, агентын хэрэгслүүд рүү илгээдэг.</translation>
<translation id="1311808042904310985">&amp;Growser for Testing-н тухай</translation>
<translation id="1152920704813762236">ChromeOS-н тухай</translation>
<translation id="8282895427217902177">Таныг сайтад зочлоход Growser таны IP хаягийг нуудаг нууцлалын серверээр дамжуулан URL-н будилуулсан хэсгийг <ph name="BEGIN_LINK"/>Growser-н аюулгүй хөтөч<ph name="END_LINK"/> рүү илгээнэ. Хэрэв сайт ямар нэг сэжигтэй зүйл хийвэл бүтэн URL, хуудасны контентын багахан хэсгийг мөн илгээнэ.</translation>
<translation id="4016217212818346953">Нууц үгний менежерээр аюулгүй байгаарай</translation>
<translation id="3703994572283698466">ChromeOS-г <ph name="BEGIN_LINK_LINUX_OSS"/>Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS"/> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS"/>нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS"/> боломжтой болгосон.</translation>
<translation id="4022972681110646219">Дэлгэцийг орчуулах</translation>
<translation id="4023601594785368013">Эх хэл: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">Дурын аппаас холбоосыг Growser-д нээнэ үү. Түүнчлэн хялбар хандахад зориулж үүнийг таны ажлын хэсэгт бэхэлдэг.</translation>
<translation id="6056473803837713617"><ph name="BEGIN_LINK"/>Одоогийн тохиргоог<ph name="END_LINK"/> мэдэгдэж Growser-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="4055805654398742145">Нууц үгний менежер</translation>
<translation id="6217792792122501564">{COUNT,plural, =1{Growser-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{Growser-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="5794951150713244901">Growser-н тухай хуудас руу очно уу</translation>
<translation id="10925962326134232">Хөтчидөө шинэ дүр төрх өгөхийн тулд Growser-г тусгайлан өөрчилнө үү</translation>
<translation id="6596295505984504022">Growser-аа тусгайлан өөрчлөх</translation>
<translation id="4148957013307229264">Суулгаж байна...</translation>
<translation id="4658486203392098459"><ph name="PAGE_TITLE"/> - Сүлжээнд нэвтрэх - Growser</translation>
<translation id="2871190378186459992">Growser-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="462105622535258178">Энэ өргөтгөл болон илүү ихийг бүх компьютер дээрээ авахын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="6670140629169983459">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд та <ph name="USER_EMAIL_ADDRESS"/>-р хэдийн нэвтэрсэн Growser профайл руугаа сэлгэнэ үү</translation>
<translation id="4222932583846282852">Цуцалж байна...</translation>
<translation id="4224210481850767180">Суулгах үйлдлийг цуцалсан.</translation>
<translation id="1853997773668795891">Та өөрийн Growser өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="4732930052828648898">Стандарт хамгаалалтаас илүүтэйгээр сайтуудын бусад өгөгдлийг задлан шинжилснээр танд аюултай сайтуудын талаар сануулах бөгөөд эдгээрт Growser-н өмнө нь мэдээгүй сайт ч багтана. Та Growser-н сануулгыг алгасахаар сонгох боломжтой.</translation>
<translation id="2201661640076600072">Growser-с гарах</translation>
<translation id="3262506503470845422">Growser-с тусламж авах</translation>
<translation id="4281844954008187215">Үйлчилгээний нөхцөл</translation>
<translation id="7691786510374174420">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ Growser яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="6368144843345980623">Growser-с нууц үг экспортлох</translation>
<translation id="4304713468139749426">Нууц үгний менежер</translation>
<translation id="4334241893986177674">Энэ дэлгэцийн агшнаас хайх</translation>
<translation id="242356249838681145">Windows-г эхлэх үед Growser-г эхлүүлэх</translation>
<translation id="4400772909124543403">Шинэчлэлт боломжгүй байна</translation>
<translation id="9183662282810237335">Ямар ч байсан Growser-с гарах уу?</translation>
<translation id="4413205837991854510">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="4065288863231444640">Growser-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{Growser танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK"/>Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK"/>}other{Growser танд эдгээрийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK"/>Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">Growser-ыг гүйцэтгэх ба хянах</translation>
<translation id="4427306783828095590">Сайжруулсан хамгаалалт нь фишинг болон хортой кодыг блоклохын тулд илүү ихийг хийдэг</translation>
<translation id="4434353761996769206">Суулгагчийн алдаа: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413"><ph name="MANAGER"/> Growser-г удирддаг</translation>
<translation id="3579012341787637143">Growser-н профайл нэмэх</translation>
<translation id="6786534271003695094">Growser for Testing-н тухай</translation>
<translation id="526235294307144732">Growser Бүртгэлийнхээ Growser-н өгөгдлийг ашиглах болон хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="4493028449971051158">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар дахин ажиллуулна уу.</translation>
<translation id="4501471624619070934">Энэ улсад хандалтыг хязгаарласан тул суулгаж чадсангүй.</translation>
<translation id="8594994021633965927">Энэ өргөтгөл өгөгдлийг хэрхэн цуглуулж, ашигладаг гэх мэт нууцлалын практикаа нийтлээгүй байна. Growser танд үүнийг хасахыг зөвлөж байна.</translation>
<translation id="7084397798469173252">Growser-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="137732229629632648">Таны орчин тойрныг зураглаж, гарыг тань тандахад Growser-д зөвшөөрөл шаардлагатай</translation>
<translation id="5036046007335188949">Та <ph name="USER_EMAIL_ADDRESS"/> хаягаараа Growser-н өөр профайлд аль хэдийн нэвтэрсэн байна</translation>
<translation id="1878185978731985193">Growser хуудаснуудыг урьдчилан ачаалах бөгөөд энэ нь үзэх, хайхыг илүү хурдан болгоно. <ph name="BEGIN_LINK"/>Хуудас урьдчилан ачаалах талаар нэмэлт мэдээлэл авах<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Хортой гэж бодож буй сайтыг мэдээлж, хүн бүрийн онлайн аюулгүй байдлыг сайжруулахад тусална уу.</translation>
<translation id="8669339108356170796">Та Safe Browsing-г унтраасан бөгөөд файлыг баталгаажуулах боломжгүй тул Growser энэ таталтыг блоклосон</translation>
<translation id="7583343841997441047">Утсан дээрээ Growser-р Google Lens-г туршиж үзэх</translation>
<translation id="4594305310729380060">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="3349475100979552835">Growser App</translation>
<translation id="4598116752460667024">Жагсаалтаас ямар нэг явцыг хайна уу.</translation>
<translation id="4970880042055371251">ChromeOS-н хувилбар</translation>
<translation id="2182657378556811785">Удахгүй шинэчилж дууслаа! Growser-н шинэчлэлийг дуусгахын тулд дахин ачаалж эхлүүлнэ үү.</translation>
<translation id="6311668361877328515">Growser-н V8 системээр сайтыг хурдасгах ч Growser-г халдлагад арай тэсвэр багатай болгоно</translation>
<translation id="7402642357351265733">Хэрэв та мөн Growser-н ашиглалтын тайланг хуваалцвал тэдгээр тайланд таны зочилсон URL багтана</translation>
<translation id="4673710618874938871"><ph name="USER_NAME"/>-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="8142245354207161805">Хувийн мэдээллийг (<ph name="HOST_NAME"/>) өөр компьютер дээр өөр Growser үйлдэлд (<ph name="PROCESS_ID"/>) ашиглаж байна гэж харагдаж байна. Growser-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж Growser-ыг дахин эхлүүлж болно.</translation>
<translation id="4680828127924988555">Суулгахыг цуцлах</translation>
<translation id="2014343159590733363">Таны Growser-н зарим өгөгдлийг одоогоор Growser Бүртгэлд тань хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="2408746614080689238">Та нэвтэрсэн байхдаа Growser-д Growser Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. <ph name="SHORTCUT"/> таны Growser-н үйлчилгээний тохиргоог өөрчлөх боломжтой.</translation>
<translation id="847561904663814268">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST"/> бүртгэлээр Growser-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд Growser-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4724676981607797757">Дэмжигдээгүй протоколын алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="3834935463915107022">Ямар ч байсан Growser-г орхих уу?</translation>
<translation id="8668413672647811944">Growser-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4941816441131888792">Та ойрын үед зочлоогүй байна. Growser <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> болон өөр <ph name="COUNT"/> зөвшөөрлийг хассан.</translation>
<translation id="844451748565342664">Хэрэв Growser дахь Gemini нээлттэй бол шинэ таб үүсгэхэд хажуугийн самбар нээлттэй хэвээр байна</translation>
<translation id="215320507915280336">Энэ нь Growser хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Growser-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="2899369907387169108">Growser-г бүртгэлгүйгээр ашиглах</translation>
<translation id="1912973375560256099">MDNS урсгалыг зөвшөөрөхийн тулд Growser-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="711601904575862069">&amp;Growser-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4918086044614829423">Хүлээн зөвшөөрөх</translation>
<translation id="4918844574251943176">Зургийг хуулсан</translation>
<translation id="8797356639448065696">Growser нь суурь горимд байна.</translation>
<translation id="1895567721497166950">Growser-н нэвтрэх харилцах цонхыг хаахын тулд товшино уу</translation>
<translation id="2692971232706994729">Та Growser профайлаар Growser-н бүх зүйлээ тусгаарлах боломжтой. Найз, гэр бүлийнхэндээ зориулж профайл үүсгэх эсвэл ажил, зугааг ялгаж салгаарай.</translation>
<translation id="7406627712452599344">Зочид Growser-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="844471735881341044">Таны Growser дахь бүртгэл</translation>
<translation id="5952898964075639679">Өөрийгөө Growser руу нэмэх</translation>
<translation id="504699503110800016">Урт цэсийг нээх</translation>
<translation id="4877750182157975795"><ph name="DEVICE_TYPE"/> дээрээ Growser-р Growser-н бүх дуртай зүйлдээ хандаарай</translation>
<translation id="1204184037023366446">Growser-д таны гарыг хянах зөвшөөрөл шаардлагатай</translation>
<translation id="5406591571925937375">Та ойрын үед зочлоогүй байна. Growser <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>-г хассан.</translation>
<translation id="5174969993834422967">Та ихэвчлэн мэдэгдлийг блоклодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд байршлын хэсгийн тань баруун дээд буланд байх мэдэгдлийн дүрс тэмдгийг товшино уу.</translation>
<translation id="5174983315706567306">Дискийн зай хангалтгүй байна.</translation>
<translation id="8157129267754368853">Growser бүртгэл дахин баталгаажуулахыг шаарддаг</translation>
<translation id="758175943316138760">iOS дээрх Growser-р яг орхисон газраасаа үргэлжлүүлээрэй.</translation>
<translation id="6234515504547364178">Growser-с гарах</translation>
<translation id="5234764350956374838">Хэрэгсэхгүй болго</translation>
<translation id="7690383309583926074">Growser аппыг аваад явж байх зуураа нууц үгээ хадгалаарай</translation>
<translation id="8586264863973514035">Өөрчлөлтөө хэрэгжүүлэхийн тулд Growser-г дахин ажиллуулна уу</translation>
