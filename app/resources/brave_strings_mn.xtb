<translation id="2491249190431914147">{0,plural, =1{Growser-г 1 цагийн дотор дахин ажиллуулна}other{Growser-г # цагийн дотор дахин ажиллуулна}}</translation>
<translation id="3793354223050135117">{0,plural, =1{Growser-г 1 минутын дотор дахин ажиллуулна}other{Growser-г # минутын дотор дахин ажиллуулна}}</translation>
<translation id="613909147715352806">{0,plural, =0{Growser-г одоо дахин ажиллуулна}=1{Growser-г 1 секундийн дотор дахин ажиллуулна}other{Growser-г # секундийн дотор дахин ажиллуулна}}</translation>
<translation id="965250208426515456">{COUNT, plural, =0 {Шинэчлэлт хэрэгжүүлэхийн тулд Growser-г дахин нээхийг администратор шаардаж байна} =1 {Шинэчлэлт хэрэгжүүлэхийн тулд Growser-г дахин нээхийг администратор шаардаж байна. Таны Нууцлалын цонх дахин нээгдэхгүй.} other {Шинэчлэлт хэрэгжүүлэхийн тулд Growser-г дахин нээхийг администратор шаардаж байна. Таны # Нууцлалын цонх дахин нээгдэхгүй.}}</translation>
<translation id="2931180980997688910">{COUNT, plural, =0 {Дэвшилтэт хамгаалалт шинэчлэлтийг хэрэгжүүлэхийн тулд Growser-г дахин нээхийг шаардаж байна} =1 {Дэвшилтэт хамгаалалт шинэчлэлтийг хэрэгжүүлэхийн тулд Growser-г дахин нээхийг шаардаж байна. Таны Нууцлалын цонх дахин нээгдэхгүй.} other {Дэвшилтэт хамгаалалт шинэчлэлтийг хэрэгжүүлэхийн тулд Growser-г дахин нээхийг шаардаж байна. Таны # Нууцлалын цонх дахин нээгдэхгүй.}}</translation>
<translation id="7647966250244920458">Growser-г эхлүүлж байна...</translation>
<translation id="1703246464233448026">Growser-г эхлүүлж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="4579792724359199960">Growser-н таб хуваалцах</translation>
<translation id="7852626102884722088">Growser-г автоматаар хаасан</translation>
<translation id="437858582924654858">Танай байгууллага Growser-г <ph name="TIMEOUT_DURATION"/>-н турш ашиглаагүй үед хаадаг. Интернэтээр үзсэн өгөгдлийг устгасан. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="5167454534917906339">Танай байгууллага Growser-г <ph name="TIMEOUT_DURATION"/>-н турш ашиглаагүй үед өгөгдлийг нь устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.</translation>
<translation id="6366172032470723642">Танай байгууллага Growser-г <ph name="TIMEOUT_DURATION"/>-н турш ашиглаагүй үед хаадаг.</translation>
<translation id="6054526434774152867">Growser-г удахгүй хаана</translation>
<translation id="3627058067394924065">Growser удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="5362825177670454785">Growser удахгүй хаах бөгөөд өгөгдлийг устгана</translation>
<translation id="6890068496140419087">{COUNT,plural, =1{Growser-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}other{Growser-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана.}}</translation>
<translation id="880802755497979140">{COUNT,plural, =1{Growser-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{Growser-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="5869235325726258967">{COUNT,plural, =1{Growser-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{Growser-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="8111900445721786828">Growser-г үргэлжлүүлэн ашиглах</translation>
<translation id="8542920192059400312">Таны эцэг эх Growser-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="8715818129986086186">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь Growser-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="7643432817438780110">Growser профайлд тавтай морилно уу</translation>
<translation id="5226489290885369540">Growser-г хэн ашиглаж байна вэ?</translation>
<translation id="6837913888298763198">Та Growser профайлаар Growser-н бүх зүйлээ тусгаарлах боломжтой. Найз, гэр бүлийнхэндээ зориулж профайл үүсгэх эсвэл ажил, зугааг ялгаж салгаарай.</translation>
<translation id="8262880716247261976">Growser-н шинэ профайлаа тохируулах</translation>
<translation id="6539809395143501177">Профайл тус бүр Growser-н өөрийн мэдээллийг агуулах бөгөөд үүнд хавчуурга, түүх, нууц үг болон бусад мэдээлэл багтана</translation>
<translation id="6359748718028735107">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Growser-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="5254830036533869365">Энэ бүртгэлтэй Growser-н профайл аль хэдийн энэ төхөөрөмж дээр байна</translation>
<translation id="7671828190113127067">Growser-г эхлүүлэх</translation>
<translation id="3109033858283726964">Growser-д нэвтрэх</translation>
<translation id="3194774009976956730">Таны Growser-г бэлэн болгоцгооё</translation>
<translation id="3040770245079391216">Growser-г өгөгдмөлөөр ашиглаж, бэхлээрэй</translation>
<translation id="9209134737432231581">Та мессеж, документ болон бусад аппын холбоосыг товших бүрдээ Growser-г ашиглана уу</translation>
<translation id="1402212206440388621">Дурын аппаас холбоосыг Growser-д нээнэ үү. Түүнчлэн хялбар хандахад зориулж үүнийг таны ажлын хэсэгт бэхэлдэг.</translation>
<translation id="7559168009716862834">Компьютерын дэлгэц доторх Growser-н лого.</translation>
<translation id="1935622100168295198">Growser-г өөрчилж, хянана уу. Growser-г өгөгдмөлөөрөө тохируулна уу.</translation>
<translation id="982715935470582799">Growser-г өгөгдмөлөөрөө тохируулах</translation>
<translation id="5550473017271508801">Growser-г өгөгдмөлөөр тохируулж, ажлын хэсэгт бэхэлнэ үү</translation>
<translation id="7562201679288302002">Дурын аппаас холбоосыг Growser-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="455043483084727114">Та энд Growser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="2577604806976743079"><ph name="SHORTCUT"/> Growser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="8615520477965823239">Та өөр Growser профайлаас нууц үгнүүдийг харахын тулд шилжих боломжтой</translation>
<translation id="842256045450098075">Growser Бүртгэлээ Growser-с хасахын тулд гарна уу</translation>
<translation id="6677784415412949473">Growser Бүртгэлээ Growser-с хасахын тулд Тохиргооны хуудсанд Growser-с гарна уу</translation>
<translation id="8235635284210221172">Танд сайн нууц үг үүсгэх, хадгалах, автоматаар бөглөхөд туслахын тулд Growser-д суурилуулсан. Хялбар хандахын тулд товчлолыг нэмээрэй.</translation>
<translation id="4166648098896027129">Growser дахь Gemini-р байгаа газраасаа хүссэн зүйлээ асуугаарай</translation>
<translation id="6168558359146786659">Growser-г өөрийн болгох</translation>
<translation id="2789075374752545467">Таныг Growser дахин эхлүүлэхэд өөрчлөлт идэвхжинэ.</translation>
<translation id="519862482935410613">Growser-д Bluetooth төхөөрөмжүүдийг судлахад 
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3879869835592882268">Growser-н хамгийн хүчирхэг аюулгүй байдлыг аваарай</translation>
<translation id="2018156653799562033">Windows-г эхлэх үед Growser-г эхлүүлэх</translation>
<translation id="6194017441174235829">Шууд үзэж эхлэхийн тулд Growser-г автоматаар эхлүүлнэ үү.</translation>
<translation id="3927803834677784549">Шуурхай үзэж эхлээрэй: Growser одоо Windows-г эхлэх үед эхлэх боломжтой боллоо.</translation>
<translation id="6362404093595382654">Growser одоо Windows-г эхлэх үед эхэлдэг болсон тул та шуурхай үзэж эхлэх боломжтой боллоо. Та үүнийг тохиргооноос унтрааж болно.</translation>
<translation id="1459201843502305963">Growser-н V8 системээр сайтыг хурдасгах ч Growser-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо асаалттай байна.</translation>
<translation id="8148152948885197973">Growser-н V8 системээр сайтыг хурдасгах ч Growser-г халдлагад арай тэсвэр багатай болгоно. Энэ тохиргоо унтраалттай байна.</translation>
<translation id="3256611564871760291">Growser-н V8 системээр сайтыг хурдасгах ч Growser-г халдлагад арай тэсвэр багатай болгоно</translation>
<translation id="8218123929138221080">Growser илүү хурдан ажилладаг бөгөөд JavaScript-г ашигладаг онцлогууд зориулалтын дагуу ажиллах ёстой</translation>
<translation id="3531624950074038621">Гүйцэтгэлийг багасгах ч Growser-г халдлагад илүү тэсвэртэй болгоно</translation>
<translation id="299509295551938426">Growser Шинэчлэгч үйлчилгээ</translation>
<translation id="4068751299154562321">Growser Шинэчлэгч дотоод үйлчилгээ</translation>
<translation id="6016191786267407731">Таны Growser программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны Growser-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг Growser-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="638207715601170321">Энэ табыг идэвхгүй үед Growser-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="1309483419808224148">Growser-г илүү хурдан болгоорой</translation>
<translation id="5153670453251236235">Эдгээр таб нэмэлт нөөцүүдийг ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Growser-д эдгээр табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="2829313098211569787">Энэ таб нэмэлт нөөц ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Growser-д энэ табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="1891457457620013910">{NUM_TABS,plural, =1{Growser таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Growser таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2066016210194753134">Growser-д нээх товчлол</translation>
<translation id="343431853267837448">Growser-н өгөгдлийг устгасан</translation>
<translation id="2016973756696213156">Growser дахь Gemini-р туршиж үзэх</translation>
<translation id="3446744630960564006">Танд хэрэг болох бүрд Growser дахь Gemini-г шуурхай нээгээрэй</translation>
<translation id="1985505085856398819">Системийн жижиг тэмдэг бүхий хэсэгт Growser дахь Gemini-г харуулж, товчлуурын шууд холбоосыг асаана уу</translation>
<translation id="7843414100742664106">Системийн жижиг тэмдэг бүхий хэсэгт Growser дахь Gemini-г харуулах</translation>
<translation id="5912735934441585874">Growser-г жижгэрүүлсэн байсан ч төхөөрөмж дээрээ Growser дахь Gemini-г ашиглахын тулд хялбархан хандаарай.</translation>
<translation id="635775285804478675">Товчлуурын шууд холбоосоор Growser дахь Gemini-г нээгээрэй.</translation>
<translation id="6403063362298585665">Хэрэв Growser дахь Gemini нээлттэй бол шинэ таб үүсгэхэд хажуугийн самбар нээлттэй хэвээр байна</translation>
<translation id="3816137493832455715">Growser дахь Gemini-д дэлгэцийн хэсгийг сонгохын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="4869198816388260769">Энэ өргөтгөл болон илүү ихийг бүх компьютер дээрээ авахын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="3143930395666972687">Энэ хавчуурга болон бусад зүйлийг бүх төхөөрөмж дээрээ авахын тулд Growser-д нэвтэрнэ үү</translation>
<translation id="4626379744082113715">Хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Growser-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хавчуургыг Growser Бүртгэлд тань хадгална.</translation>
<translation id="5399404694319519684">Та одоо Growser-н бусад онцлогийг ашиглах боломжтой боллоо</translation>
<translation id="6243750565468992770">Таны Growser дахь бүртгэл</translation>
<translation id="285864776837103618">iOS-т зориулсан Growser дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="7183287313310808593">Утсан дээрээ Growser-р Сайжруулсан аюулгүй хөтчийг өргөтгөх</translation>
<translation id="6665383679021314581">iOS-т зориулсан Growser-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="7909057381664913954">Утсан дээрээ Growser-р нууц үгнүүдээ ашиглах</translation>
<translation id="1262698330790070522">Growser аппыг авах</translation>
<translation id="1369136842285731495">Хөдөлгөөнт төхөөрөмж дээр Growser хөтчийг татах QR код</translation>
<translation id="1839309260370506060">Та дараагийн удаа Growser iOS-г нээхдээ <ph name="FEATURE_NAME"/>-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="3957046550690757228">Та дараагийн удаа <ph name="DEVICE_TYPE"/> дээрээ Growser-г нээхдээ Growser Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="4913468027546625856">Growser iOS апп дээр харж буй зүйлээ камераараа худалдан авч, орчуулж, тодорхойлоорой</translation>
<translation id="5334429916836219509">Утсан дээрээ Growser-р Google Lens-г туршиж үзэх</translation>
<translation id="2393075722810632447">Хадгалсан нууц үгнүүдээ ашиглахын тулд QR кодыг уншуулаад, iOS-т зориулсан Growser-г татаж, Growser Бүртгэлдээ нэвтэрнэ үү</translation>
<translation id="4853439800347640587">Үнэ хянаж, аливаа сайт дээр үнэ буурахад мэдэгдэл авахын тулд утсан дээрээ Growser-г татаарай</translation>
<translation id="5026029776800944167">Утсан дээрээ Growser-р үнэ мөшгөх мэдэгдэл аваарай</translation>
<translation id="1827860507749134214">Та дараагийн удаа <ph name="DEVICE_TYPE"/> дээрээ Growser-г нээхэд үнэ мөшгөх дохиог идэвхжүүлэх сануулга харагдана.</translation>
<translation id="7260886862936286198">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ Growser-г татаарай.</translation>
<translation id="3179906250938065566">Та дараагийн удаа <ph name="DEVICE_TYPE"/> дээрээ Growser-г нээхэд табын бүлгийг ашиглах сануулга харагдана.</translation>
<translation id="3670946997425275779">Growser-г татаж, Growser Бүртгэлдээ нэвтрэхийн тулд утсаараа QR кодыг скан хийнэ үү.</translation>
<translation id="8016699923481728837">Утсан дээрээ Growser аппаар Growser-н шилдэг ХОУ-ы хэрэгслүүдийг ашиглаарай</translation>
<translation id="6085139155476935700">iOS дээрх Growser-р Growser-н ХОУ-ы дуртай хэрэгслүүдээ явж байх зуураа ашиглаарай.</translation>
<translation id="85912115868085406"><ph name="DEVICE_TYPE"/> дээрээ Growser аппыг ашиглахдаа ХОУ-ы хүчийг аваарай</translation>
<translation id="7502110432835833029">Хамгийн сайн ХОУ-ы хэрэгслүүдийг явж байх зуураа ашиглахын тулд Growser аппыг ашиглаарай</translation>
<translation id="4872784071286727545">Утсан дээрээ Growser аппаар Growser-н шилдэг зүйлсийг аваарай</translation>
<translation id="1665059346664283754">Growser-р Growser Драйв, YouTube зэрэг дуртай апп дээрээ явж байх зуураа саадгүй ажиллаарай.</translation>
<translation id="5910135615577427412"><ph name="DEVICE_TYPE"/> дээрээ Growser аппаар Growser-н шилдэг зүйлсийг аваарай</translation>
<translation id="6333239663501390375"><ph name="DEVICE_TYPE"/> дээрээ Growser-р Growser-н бүх дуртай зүйлдээ хандаарай</translation>
<translation id="7510190804000607802">Сануулагч: Growser-н шилдэг зүйлс таны халаасанд</translation>
<translation id="8546612205554583655">Утсан дээрээ Growser аппыг ашиглан явж байх зуураа Growser-н аюулгүй байдлын шилдэг онцлогуудыг аваарай</translation>
<translation id="6240129247678023389">Growser-р Growser-н аюулгүй байдлын шилдэг онцлогуудыг явж байх зуураа аваарай.</translation>
<translation id="5102419700069897472"><ph name="DEVICE_TYPE"/> дээрээ Growser аппыг ашиглан Growser-н аюулгүй байдлын онцлогуудыг явж байх зуураа аваарай</translation>
<translation id="8211080268209414722">Growser-н аюулгүй байдлын онцлогуудыг явж байх зуураа авахын тулд Growser аппыг ашиглаарай</translation>
<translation id="354621070532799440">Сануулагч: Growser-н аюулгүй байдлын шилдэг онцлогууд таны халаасанд байна</translation>
<translation id="6395357110827382630">Утсан дээрээ Growser аппаар сонирхож буй зүйлсийнхээ үнэ буурсан талаарх сэрэмжлүүлгийг аваарай</translation>
<translation id="2888272008248198017">iOS дээрх Growser-р камераараа бүтээгдэхүүн олж, үнийн бууралт болон илүү ихийг явж байх зуураа хянаарай.</translation>
<translation id="8988632212716006521">Та <ph name="DEVICE_TYPE"/> дээрээ Growser аппыг ашиглахдаа онлайн худалдан авалтаас илүү ихийг аваарай</translation>
<translation id="5919080786404908840">Growser аппыг ашиглан худалдан авалтын шилдэг хэрэгслүүдийг явж байх зуураа ашиглаарай</translation>
<translation id="1777651200954348103">Утсан дээрээ Growser аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="5424525786912503458">iOS дээрх Growser-р яг орхисон газраасаа үргэлжлүүлээрэй.</translation>
<translation id="1207412468280310003"><ph name="DEVICE_TYPE"/> дээрээ Growser аппыг ашиглан нууц үг, таб болон бусад зүйлээ явж байх зуураа аваарай</translation>
<translation id="8718912430754999757">Явж байх зуураа үргэлжлүүлэн үзэхийн тулд Growser аппыг ашиглаарай</translation>
<translation id="8909343812503299574">Таны хайлтын системийг Growser-с гадуур өөрчилсөн. Таныг хамгаалахын тулд Growser үүнийг эх өгөгдмөл тохиргоо руу нь шинэчилсэн. <ph name="LEARN_MORE_LINK"/></translation>
<translation id="785283387498656820">Аюулгүй байдлын үүднээс таныг анх удаа сайтад зочлоход Growser JavaScript-н оновчлолыг унтраадаг.

Хэрэв энэ хуудас хүлээлтийн дагуу ажиллахгүй байвал оновчлолыг зөвшөөрч үзнэ үү.</translation>
<translation id="4165169774507632897">Growser дансандаа нэвтрэх</translation>
<translation id="8633519672432360220">Таны ажлыг Growser дээр хамгаалсан</translation>
<translation id="2298918301821382774">Таны Growser дээрх ажлыг хамгаалахын тулд таныг Growser-д нэвтрэхэд танай байгууллага тодорхой мэдээллийг харах, удирдах боломжтой болно.</translation>
<translation id="5670438198445413111">Гэнэтийн алдаанаас болж суулгах ажиллагаа амжилтгүй боллоо. Growser-ыг дахин татаж авна уу.</translation>
<translation id="4217571870635786043">Заавар</translation>
</translationbundle>