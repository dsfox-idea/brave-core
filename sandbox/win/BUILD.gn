assert(is_win)

# growser (#64): the interception sources themselves are compiled into
# //sandbox/win:sandbox through sources.gni, so this target only carries their
# test. Depending on that component is what lets the test call the Target*
# entry points with a fake original API.
source_set("unit_tests") {
  testonly = true

  sources = [ "src/module_file_name_interception_unittest.cc" ]

  deps = [
    "//base",
    "//sandbox/win:sandbox",
    "//testing/gtest",
  ]
}
