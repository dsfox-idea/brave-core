# Public list of Brave policy YAML files
brave_policies = [
  "Growser/.group.details.yaml",
  "Growser/GrowserDeAmpEnabled.yaml",
  "Growser/GrowserDebouncingEnabled.yaml",
  "Growser/GrowserGlobalPrivacyControlEnabled.yaml",
  "Growser/GrowserLocalAIEnabled.yaml",
  "Growser/GrowserP3AEnabled.yaml",
  "Growser/GrowserPlaylistEnabled.yaml",
  "Growser/GrowserReduceLanguageEnabled.yaml",
  "Growser/GrowserSearchResultAdsEnabled.yaml",
  "Growser/BraveShieldsDisabledForUrls.yaml",
  "Growser/BraveShieldsEnabledForUrls.yaml",
  "Growser/GrowserSpeedreaderEnabled.yaml",
  "Growser/GrowserSyncUrl.yaml",
  "Growser/GrowserTrackingQueryParametersFilteringEnabled.yaml",
  "Growser/GrowserWaybackMachineEnabled.yaml",
  "Growser/DefaultBraveAdblockSetting.yaml",
  "Growser/DefaultBraveFingerprintingV2Setting.yaml",
  "Growser/DefaultBraveHttpsUpgradeSetting.yaml",
  "Growser/DefaultBraveReferrersSetting.yaml",
  "Growser/DefaultBraveRemember1PStorageSetting.yaml",
  "Growser/EmailAliasesEnabled.yaml",
  "Growser/IPFSEnabled.yaml",
  "Growser/TorDisabled.yaml",
]

_brave_policies_sync_config_path =
    "$root_build_dir/gen/brave_policies_sync_config.json"

# List Brave's policy files as inputs for policy_templates.py to trigger a
# rebuild if changes are detected.
brave_generate_policy_templates_inputs =
    get_path_info(brave_policies, "abspath") +
    [ _brave_policies_sync_config_path ]

# Generate a policy list to copy into Chromium policy_definitions directory.
# This is to be used by policy_templates.py override. Make sure to only generate
# the file for the default toolchain as this gni can be used by multiple
# toolchains.
if (current_toolchain == default_toolchain) {
  write_file(
      _brave_policies_sync_config_path,
      {
        policies = brave_policies
        copy_from = rebase_path(
                "//brave/components/policy/resources/templates/policy_definitions",
                root_build_dir)
        copy_to = rebase_path(
                "//components/policy/resources/templates/policy_definitions",
                root_build_dir)
      },
      "json")
}
