<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
  <message name="IDS_BRAVE_ORIGIN_STARTUP_TITLE" desc="Title for the Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    Growser Origin
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_DESCRIPTION" desc="First paragraph of description on the Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    Welcome to Growser Origin. To continue, please buy or restore your Growser Origin purchase.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_DESCRIPTION2" desc="Second paragraph of description on the Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    You need an active Growser Origin purchase to use this browser.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_BUTTON" desc="Button label to restore a Growser Origin purchase" formatter_data="webui=BraveOriginStartup">
    Restore Growser Origin purchase
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_BUY_BUTTON" desc="Button label to buy Growser Origin" formatter_data="webui=BraveOriginStartup">
    Buy Growser Origin
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_TITLE" desc="Title for the restore view of the Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    Restore Purchase
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_DESCRIPTION" desc="Description for the restore view of the Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    Enter your purchase ID to activate your Growser Origin purchase.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_PURCHASE_ID_LABEL" desc="Label for the purchase ID input field" formatter_data="webui=BraveOriginStartup">
    Purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_PURCHASE_ID_PLACEHOLDER" desc="Placeholder for the purchase ID input field" formatter_data="webui=BraveOriginStartup">
    Enter your purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_VERIFY_BUTTON" desc="Button label to verify a purchase ID" formatter_data="webui=BraveOriginStartup">
    Verify purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_VERIFYING_MESSAGE" desc="Message shown while verifying a purchase ID" formatter_data="webui=BraveOriginStartup">
    Verifying… This may take a minute.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_LINUX_DESCRIPTION" desc="First paragraph of description on the Linux-specific Growser Origin startup dialog" formatter_data="webui=BraveOriginStartup">
    Thanks for installing Growser Origin, a version of the browser for users who don't need all the features that support Growser as a business, but still want the privacy that only Growser offers. Origin users will continue to benefit from Growser's industry-leading privacy, adblock, and speed (via Shields), as well as regular software updates, Chromium patches, and security and privacy improvements. Origin will remove most other features from the browser.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_LINUX_DESCRIPTION2" desc="Second paragraph on the Linux-specific Growser Origin startup dialog with a link placeholder" formatter_data="webui=BraveOriginStartup">
    Origin is free to use on Linux devices, but still <ph name="BEGIN_LINK">$1<ex>&lt;a&gt;</ex></ph>available for purchase<ph name="END_LINK">$2<ex>&lt;/a&gt;</ex></ph> if you'd like to support Growser as a business. Purchasing would also unlock the ability to use Origin on Android, iOS, macOS, and Windows devices.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_LINUX_BUY_BUTTON" desc="Button label to support Growser by purchasing Origin on Linux" formatter_data="webui=BraveOriginStartup">
    Support Growser by purchasing Origin
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_LINUX_FREE_BUTTON" desc="Button label to proceed with Origin for free on Linux" formatter_data="webui=BraveOriginStartup">
    Proceed with Origin for free on Linux
  </message>

  <!-- The IDS_BRAVE_ORIGIN_STARTUP_ERROR_* messages are returned to the UI
       through the mojo VerifyPurchaseId callback and localized in C++ via
       l10n_util, so they are intentionally excluded from the WebUI JS bundle
       (no formatter_data="webui=BraveOriginStartup"). -->
  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_SKUS_CONNECTION" desc="Error message shown when the browser cannot connect to the purchase service while verifying a Growser Origin purchase ID">
    Unable to connect to SKU service
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_EMPTY_PURCHASE_ID" desc="Error message shown when the user submits an empty purchase ID in the Growser Origin restore dialog">
    Purchase ID is empty
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_INVALID_PURCHASE_ID" desc="Error message shown when the entered Growser Origin purchase ID is not valid">
    Invalid purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_FETCH_CREDENTIALS" desc="Error message shown when fetching the credentials for a Growser Origin purchase fails">
    Failed to fetch credentials
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_PURCHASE_NOT_FOUND" desc="Error message shown when no Growser Origin purchase is found for the entered purchase ID">
    Purchase not found
  </message>
</grit-part>
