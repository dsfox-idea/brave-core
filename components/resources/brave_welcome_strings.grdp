<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
  <message name="IDS_BRAVE_WELCOME_TITLE" desc="A title for screen on the first step of welcome page">
  Privacy. By Default.
</message>

<message name="IDS_BRAVE_WELCOME_DESC" desc="A subtitle for screen on the first step of welcome page">
  Get Growser protection on every link you click. Just set Growser as default and browse. Privately.
</message>

<message name="IDS_BRAVE_WELCOME_IMPORT_SETTINGS_TITLE" desc="A title for screen to select browser">
  Import Settings
</message>

<message name="IDS_BRAVE_WELCOME_IMPORT_SETTINGS_DESC" desc="A subtitle for screen to select browser">
  Easily import bookmarks, extensions, even saved passwords from your old browser.
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_PROFILE_LABEL" desc="A title for screen to select one or more profiles">
  Select profile to import
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_PROFILE_DESC" desc="A subtitle for screen to select one or more profiles">
  The browser you chose has multiple profiles. Select the profile(s) you'd like to import.
</message>

<message name="IDS_BRAVE_WELCOME_IMPORT_BUTTON_LABEL" desc="A button that triggers importing single profile from the selected browser">
  Import
</message>

<message name="IDS_BRAVE_WELCOME_IMPORT_PROFILES_BUTTON_LABEL" desc="A button that triggers importing bulk profiles from the selected browser">
  Import profiles
</message>

<!-- growser (#92): the crash-reporting choice, made where a person can see it -->
<message name="IDS_BRAVE_WELCOME_CRASH_REPORTS_LABEL" desc="Label of the checkbox on the first welcome screen that decides whether crash reports are sent">
  Send crash reports
</message>

<message name="IDS_BRAVE_WELCOME_CRASH_REPORTS_DESC" desc="Description under the crash reports checkbox on the first welcome screen">
  A report is a snapshot of the browser taken at the moment it stopped working. It goes to us and to nobody else, and you can change this later in settings.
</message>

<message name="IDS_BRAVE_WELCOME_SKIP_BUTTON_LABEL" desc="A button to skip the current step">
  Skip
</message>

<message name="IDS_BRAVE_WELCOME_BACK_BUTTON_LABEL" desc="A button that goes back from selecting profile">
  Back
</message>

<message name="IDS_BRAVE_WELCOME_NEXT_BUTTON_LABEL" desc="A button that changes the current screen and moves forward with the steps">
  Next
</message>

<message name="IDS_BRAVE_WELCOME_SET_DEFAULT_BUTTON_LABEL" desc="A button that sets Growser browser as default">
  Set Growser as default browser
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_ALL_BUTTON_LABEL" desc="A button label to select all profiles">
  Select All
</message>

<message name="IDS_BRAVE_WELCOME_SETUP_COMPLETE_LABEL" desc="A title for screen when user has completed all the steps">
  Setup complete
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_THEME_LABEL" desc="A title for screen to select color theme">
  Choose your theme
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_THEME_NOTE" desc="A note for user to change theme in settings">
  You can change this at any time in Growser settings.
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_THEME_SYSTEM_LABEL" desc="A label to match system setting">
  Match system setting
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_THEME_LIGHT_LABEL" desc="A label for light theme setting">
  Light mode
</message>

<message name="IDS_BRAVE_WELCOME_SELECT_THEME_DARK_LABEL" desc="A label for dark theme setting">
  Dark mode
</message>

<if expr="enable_web_discovery">
<message name="IDS_BRAVE_WELCOME_HELP_WDP_TITLE" desc="A title in 'help wdp' page">
  Want better search results?
</message>

<message name="IDS_BRAVE_WELCOME_HELP_WDP_SUBTITLE" desc="A subtitle in 'help wdp' page">
  Join the movement, contribute to Growser Search.
</message>

<message name="IDS_BRAVE_WELCOME_HELP_WDP_DESCRIPTION" desc="A description in 'help wdp' page">
  Help us fix the web by participating in Growser’s Web Discovery Project. By sharing completely anonymous search signals, you can help Growser grow the search index.
</message>

<message name="IDS_BRAVE_WELCOME_HELP_WDP_LEARN_MORE" desc="Text for 'Learn More' link in 'help wdp' page">
  Learn More.
</message>

<message name="IDS_BRAVE_WELCOME_HELP_WDP_ACCEPT" desc="A label for Accept button in 'help wdp' page">
  Sure, I'll help
</message>

<message name="IDS_BRAVE_WELCOME_HELP_WDP_REJECT" desc="A label 'help wdp' page">
  Maybe later
</message>
</if>

<message name="IDS_WELCOME_HEADER" desc="A message which will appear as the header on the Welcome UI if the user has never run Growser before.">
  Welcome to Growser
</message>

</grit-part>
