<grit-part>
  <!-- growser (#87): the query-filter rules, bundled. The component that
       normally delivers them is served by go-updater.brave.com, which answers
       a fork "403 Missing auth header", so without this the browser strips no
       tracking parameters at all. Refreshed by scripts/update-vendored-data.py
       from the upstream data repository, github.com/brave/adblock-lists. -->
  <include name="IDR_QUERY_FILTER_JSON" file="../query_filter/resources/query-filter.json" type="BINDATA" compress="gzip" />
</grit-part>
