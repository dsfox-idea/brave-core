import("//brave/build/config.gni")
import("//build/buildflag_header.gni")

declare_args() {
  service_key_stt = ""
}

# growser (#120): the official-build key assert is lifted - this fork ships
# no Brave STT key on purpose; the service fails closed on the empty value
# (proven by months of non-official operation), and officialness is about
# the optimization tier, not about Brave's service entitlements.

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [ "SERVICE_KEY_STT=\"$service_key_stt\"" ]
}

component("speech_to_text") {
  output_name = "speech_to_text"
  defines = [ "IS_SPEECH_TO_TEXT_IMPL" ]

  sources = [
    "features.cc",
    "features.h",
  ]

  public_deps = [
    ":buildflags",
    "//base",
  ]
}
