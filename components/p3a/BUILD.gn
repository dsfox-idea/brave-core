import("//brave/components/p3a/buildflags/buildflags.gni")
import("//build/buildflag_header.gni")
import("//testing/test.gni")

# growser (#98): with enable_p3a=false only the pieces the rest of the tree
# consumes stay - pref names/registration (day_zero watches kP3AEnabled via a
# registrar, an unregistered pref is a CHECK crash), the log stores whose
# prefs existing profiles carry, and the header-only histogram helpers. The
# engine - service, message manager, uploader, constellation rust lib, nitro
# attestation, remote config, component installer - compiles out.
static_library("p3a") {
  sources = [
    "features.cc",
    "features.h",
    "metric_log_store.cc",
    "metric_log_store.h",
    "metric_log_type.cc",
    "metric_log_type.h",
    "pref_names.h",
    "rotation_scheduler.cc",
    "rotation_scheduler.h",
    "switches.h",
    "utils.h",
  ]

  public_deps = [
    "//brave/components/p3a/buildflags",
    "//brave/components/p3a_utils",
  ]

  deps = [
    "//base",
    "//components/metrics",
    "//components/prefs",
  ]

  if (enable_p3a) {
    sources += [
      "component_installer.cc",
      "component_installer.h",
      "constellation_helper.cc",
      "constellation_helper.h",
      "constellation_log_store.cc",
      "constellation_log_store.h",
      "histograms_braveizer.cc",
      "histograms_braveizer.h",
      "message_manager.cc",
      "message_manager.h",
      "metric_config.cc",
      "metric_config.h",
      "metric_config_utils.cc",
      "metric_config_utils.h",
      "metric_names.h",
      "network_annotations.cc",
      "network_annotations.h",
      "nitro_utils/attestation.cc",
      "nitro_utils/attestation.h",
      "nitro_utils/cose.cc",
      "nitro_utils/cose.h",
      "p3a_config.cc",
      "p3a_config.h",
      "p3a_message.cc",
      "p3a_message.h",
      "p3a_service.cc",
      "p3a_service.h",
      "region.cc",
      "region.h",
      "remote_config_manager.cc",
      "remote_config_manager.h",
      "scheduler.cc",
      "scheduler.h",
      "star_randomness_meta.cc",
      "star_randomness_meta.h",
      "star_randomness_points.cc",
      "star_randomness_points.h",
      "uploader.cc",
      "uploader.h",
    ]

    deps += [
      "constellation/rs/cxx:rust_lib",
      "//brave/brave_domains",
      "//brave/components/brave_component_updater/browser:public",
      "//brave/components/brave_origin/buildflags",
      "//brave/components/brave_stats/browser",
      "//brave/components/version_info",
      "//brave/vendor/brave_base",
      "//components/cbor",
      "//components/component_updater",
      "//components/country_codes",
      "//net",
      "//services/network:network_service",
      "//services/network/public/cpp",
      "//url",
    ]

    if (is_ios) {
      deps += [ "//ios/web/public/thread" ]
    } else {
      deps += [
        "//brave/components/brave_referrals/common",
        "//brave/components/misc_metrics:default_browser_monitor",
        "//content/public/browser",
        "//content/public/common",
      ]
    }
  }
}

source_set("unit_tests") {
  testonly = true
  # rotation_scheduler_unittest constructs a P3AConfig, so it can only build
  # with the engine; the store test has no engine dependency and always runs.
  sources = [ "metric_log_store_unittest.cc" ]
  deps = [
    "//base/test:test_support",
    "//brave/components/constants",
    "//brave/components/p3a",
    "//brave/components/p3a_utils",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]

  if (enable_p3a) {
    sources += [
      "constellation_helper_unittest.cc",
      "constellation_log_store_unittest.cc",
      "message_manager_unittest.cc",
      "metric_config_unittest.cc",
      "metric_names_unittest.cc",
      "nitro_utils/attestation_unittest.cc",
      "nitro_utils/cose_unittest.cc",
      "p3a_message_unittest.cc",
      "p3a_service_unittest.cc",
      "region_unittest.cc",
      "remote_config_manager_unittest.cc",
      "rotation_scheduler_unittest.cc",
      "scheduler_unittest.cc",
      "star_randomness_test_util.cc",
      "star_randomness_test_util.h",
    ]
    deps += [
      "constellation/rs/cxx:rust_lib",
      "//brave/components/brave_stats/browser",
      "//components/cbor",
      "//net",
      "//services/network:test_support",
      "//services/network/public/cpp",
    ]
    if (!is_ios) {
      deps += [
        "//brave/components/brave_referrals/common",
        "//content/test:test_support",
      ]
    }
  }
}
