<!DOCTYPE translationbundle>
<translationbundle lang="uz">
<translation id="130631256467250065">O‘zgartirishlar qurimla qaytadan ishga tushirilganda kuchga kiradi.</translation>
<translation id="2470048290583727811">Growser maslahati: Parollarni saqlang</translation>
<translation id="6451924152958941455">Bularni oching:
          Growser menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          va sozlamalarda “proksi-serversiz” yoki “bevosita” ulanish belgilanganini tekshiring.</translation>
<translation id="7999989146447764333">Growser‘da xatoliklar haqidagi hisobot funksiyasi mavjud emas.</translation>
<translation id="1953231710324290369">Xavfsiz Growser sahifasini ko‘rmoqdasiz.</translation>
<translation id="907470742420136113">Growser toʻlov usuli kiritilishi sozlamasini oʻzgaritishga urinmoqda.</translation>
<translation id="4847979153841887006">Growser logotipi</translation>
<translation id="6093965249696204223">Growser maslahati: Saytlarni kuchaytirilgan rejimda xavfsiz kezish</translation>
<translation id="336808635693308470">Growser toʻlov usullarini oʻzgartirishga urinmoqda.</translation>
<translation id="7932149101545999102">Growser yaratilishida <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> ochiq kodli loyiha va boshqa <ph name="BEGIN_LINK_OSS"/>ochiq kodli dasturiy ta’minotning<ph name="END_LINK_OSS"/> katta o‘rni bor.</translation>
<translation id="303960458633076466">Bu sahifa Growser tomonidan bloklandi</translation>
<translation id="2017237562285586622">Himoya devori va antivirus dasturlari sozlamalarida Growser tarmoqqa ulanishiga ruxsat bering.</translation>
<translation id="4949828774841497663">Ilovalar &gt; tizim sozlamalari &gt; tarmoq sahifasini ochib,
          faol tarmoqni tanlang, keyin Tafsilotlar... tugmasini bosing va tanlanishi mumkin har qanday
          proksi tanlovini bekor qiling.</translation>
<translation id="3269554930871094325">Bularni oching:
          Growser menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Tarmoq va internet &gt; Proksi-server
          va keyin “Sozlamalarni avtomatik aniqlash” tanlovini bekor qiling.</translation>
<translation id="6159073403999048272">Bu sahifalar Growser dastur ishlab chiquvchilari foydalanishi uchun moʻljallangan va faol ishlatish yoki sinovdan oʻtkazish mumkin emas. Ularni yoqish uchun <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> havolasiga oʻting, debag sahifalarini yoqish uchun tugmani bosib, keyin yana bu sahifaga oʻting.</translation>
<translation id="2765022094254723779">Growser paydo boʻlishida boshqa <ph name="BEGIN_LINK_OSS"/>ochiq kodli dastur<ph name="END_LINK_OSS"/> taʼminotining katta oʻrni bor.</translation>
<translation id="9156965752763025780">O‘zgartirishlar Growser qaytadan ishga tushirilganda kuchga kiradi.</translation>
<translation id="8828443087767259398">Growser ulanishi uchun Bluetooth orqali kirish ruxsati 
 kerak. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser paydo boʻlishida <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> ochiq kodli dastur loyihasining katta oʻrni bor.</translation>
<translation id="4068928808254189629">Bu yerga o‘ting
          Growser menyusi &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          va "<ph name="NO_PREFETCH_DESCRIPTION"/>"dan tanlanishni olib tashlang.
          Shunda muammo hal bo‘lmasa, samaradorlikni oshirish uchun
          yana shu parametrni tanlashni tavsiya qilamiz.</translation>
<translation id="4159376633403260073">Xavfsiz Growser for Testing sahifasidasiz.</translation>
<translation id="88187049159266777">Growser faoliyati noto‘g‘ri yakunlandi.</translation>
<translation id="8208548103319284047">Growser maslahati: Lens bilan qidiring</translation>
</translationbundle>