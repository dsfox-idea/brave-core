<!DOCTYPE translationbundle>
<translationbundle lang="no">
<translation id="130631256467250065">Endringene trer i kraft neste gang du starter enheten på nytt.</translation>
<translation id="2470048290583727811">Growser-tips: Lagre passord</translation>
<translation id="6451924152958941455">Gå til
          Growser-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og sørg for at konfigurasjonen din er angitt til «ingen mellomtjener» eller «direkte».</translation>
<translation id="7999989146447764333">Krasjrapportering er ikke tilgjengelig i Growser.</translation>
<translation id="1953231710324290369">Du ser på en sikker Growser-side</translation>
<translation id="907470742420136113">Growser prøver å endre innstillingene for utfylling av betalingsmåter.</translation>
<translation id="4847979153841887006">Growser-logo</translation>
<translation id="6093965249696204223">Growser-tips: Safe Browsing med økt beskyttelse</translation>
<translation id="336808635693308470">Growser prøver å redigere betalingsmåter.</translation>
<translation id="7932149101545999102">Growser er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> og annen <ph name="BEGIN_LINK_OSS"/>åpen kilde-programvare<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Denne siden er blokkert av Growser</translation>
<translation id="2017237562285586622">Tillat at Growser bruker nettverket, i brannmur- eller
          antivirusinnstillingene dine.</translation>
<translation id="4949828774841497663">Gå til Programmer &gt; Systeminnstillinger &gt; Nettverk, velg det aktive nettverket, klikk på «Detaljer…»-knappen, og fjern avmerkingen for eventuelle proxy-tjenere som muligens er valgt.</translation>
<translation id="3269554930871094325">Gå til
          Growser-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nettverk og internett &gt; Proxy-tjener
          og velg bort «Oppdag innstillinger automatisk».</translation>
<translation id="6159073403999048272">Disse sidene er beregnet for bruk av Growser-utviklere. Det kan hende at de ikke aktivt vedlikeholdes eller testes. For å slå dem på, gå til <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klikk på knappen for å slå på feilsøkingssider, og gå til denne siden igjen.</translation>
<translation id="2765022094254723779">Growser er også gjort mulig av annen <ph name="BEGIN_LINK_OSS"/>programvare med åpen kildekode<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Endringene dine trer i kraft neste gang du starter Growser.</translation>
<translation id="8828443087767259398">Growser trenger Bluetooth-tilgang for å fortsette tilkoblingen. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">Gå til
        Growser-menyen &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og fjern avmerkingen for «<ph name="NO_PREFETCH_DESCRIPTION"/>».
        Hvis dette ikke løser problemet, bør du aktivere dette alternativet
        på nytt for bedre ytelse.</translation>
<translation id="4159376633403260073">Du ser på en sikker side for Growser for testing</translation>
<translation id="88187049159266777">Growser ble ikke avsluttet på riktig måte.</translation>
<translation id="8208548103319284047">Growser-tips: Søk med Lens</translation>
