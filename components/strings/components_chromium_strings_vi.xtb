<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="130631256467250065">Thay đổi của bạn sẽ có hiệu lực vào lần tiếp theo bạn khởi động lại thiết bị của mình.</translation>
<translation id="2470048290583727811">Mẹo khi dùng Growser: Lưu mật khẩu</translation>
<translation id="6451924152958941455">Chuyển đến
          trình đơn Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          và đảm bảo cấu hình của bạn được đặt thành "không có proxy" hoặc "trực tiếp".</translation>
<translation id="7999989146447764333">Báo cáo sự cố hiện không khả dụng trong Growser.</translation>
<translation id="1953231710324290369">Bạn đang xem trang Growser an toàn</translation>
<translation id="907470742420136113">Growser đang cố gắng sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="4847979153841887006">Biểu trưng Growser</translation>
<translation id="6093965249696204223">Mẹo khi dùng Growser: Duyệt web an toàn có tăng cường bảo vệ</translation>
<translation id="336808635693308470">Growser đang cố gắng chỉnh sửa phương thức thanh toán.</translation>
<translation id="7932149101545999102">Growser trở nên khả thi là nhờ dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> và các <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="303960458633076466">Trang này bị Growser chặn</translation>
<translation id="2017237562285586622">Cho phép Growser truy cập mạng trong cài đặt tường lửa hoặc diệt vi-rút 
        của bạn.</translation>
<translation id="4949828774841497663">Chuyển đến phần Ứng dụng &gt; Cài đặt hệ thống &gt; Mạng, chọn
          mạng đang hoạt động, nhấp vào nút Chi tiết..., rồi bỏ chọn mọi máy chủ proxy
          có thể đã được chọn.</translation>
<translation id="3269554930871094325">Chuyển đến
          trình đơn Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mạng và Internet &gt; Proxy
          rồi bỏ chọn "Tự động phát hiện chế độ cài đặt".</translation>
<translation id="6159073403999048272">Các trang này dành cho nhà phát triển Growser sử dụng và có thể không được duy trì hoặc kiểm tra liên tục. Để kích hoạt các trang này, hãy chuyển đến <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, nhấp vào nút để kích hoạt trang gỡ lỗi, rồi chuyển đến trang này một lần nữa.</translation>
<translation id="2765022094254723779">Growser cũng được cung cấp thông qua <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="9156965752763025780">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại Growser.</translation>
<translation id="8828443087767259398">Growser cần có quyền truy cập Bluetooth để tiếp tục 
 ghép nối. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser được cung cấp thông qua dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">Chuyển đến
          menu Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          và bỏ chọn "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Nếu cách này không giải quyết được sự cố thì chúng tôi khuyên bạn nên chọn lại tùy chọn này
          để cải thiện hiệu suất.</translation>
<translation id="4159376633403260073">Bạn đang xem một trang Growser for Testing an toàn</translation>
<translation id="88187049159266777">Growser không tắt đúng cách.</translation>
<translation id="8208548103319284047">Mẹo dùng Growser: Tìm kiếm bằng Ống kính</translation>
</translationbundle>