<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="130631256467250065">تسري التغييرات في المرة التالية التي تعيد فيها تشغيل الجهاز.</translation>
<translation id="2470048290583727811">‏نصيحة من Growser: حفظ كلمات المرور أولوية</translation>
<translation id="6451924152958941455">‏يُرجى الانتقال إلى
          قائمة Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          والتأكّد من ضبط الإعدادات على "بلا خادم وكيل" أو "مباشر.".</translation>
<translation id="7999989146447764333">‏تقارير الأعطال غير متاحة في Growser.</translation>
<translation id="1953231710324290369">‏أنت تعرض صفحة Growser آمنة</translation>
<translation id="907470742420136113">‏يحاول Growser تعديل إعدادات ميزة "الملء التلقائي" لبيانات طُرق الدفع.</translation>
<translation id="4847979153841887006">‏شعار Growser</translation>
<translation id="6093965249696204223">‏نصيحة من Growser: حان وقت "الحماية المحسّنة للتصفّح الآمن"</translation>
<translation id="336808635693308470">‏يحاول Growser تعديل طُرق الدفع.</translation>
<translation id="7932149101545999102">‏أصبح Growser الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> و<ph name="BEGIN_LINK_OSS"/>برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">‏تم حظر هذه الصفحة بواسطة متصفّح Growser.</translation>
<translation id="2017237562285586622">‏اسمح لـ Growser بالدخول إلى الشبكة من خلال إعدادات جدار الحماية أو
        برنامج مكافحة الفيروسات.</translation>
<translation id="4949828774841497663">‏يُرجى الانتقال إلى "التطبيقات" (Applications) &gt; "إعدادات النظام" (System Settings) &gt; "الشبكة" (Network)، ثم اختيار
          الشبكة النشطة، والنقر على زر "التفاصيل…" (Details…‎) وإلغاء اختيار أي خوادم وكيلة
          سبق اختيارها.</translation>
<translation id="3269554930871094325">‏يُرجى الانتقال إلى
          قائمة Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          الشبكة والإنترنت &gt; الخادم الوكيل
          وإلغاء اختيار "رصد الإعدادات تلقائيًا".</translation>
<translation id="6159073403999048272">‏هذه الصفحات مخصّصة لمطوّري Growser، وقد لا تتم صيانتها أو اختبارها بشكلٍ منتظم. لتفعيلها، يُرجى الانتقال إلى <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> والنقر على زر تفعيل صفحات تصحيح الأخطاء، ثم الانتقال إلى هذه الصفحة مرة أخرى.</translation>
<translation id="2765022094254723779">‏أصبح Growser متاحًا من خلال <ph name="BEGIN_LINK_OSS"/>برنامج آخر مفتوح المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Growser.</translation>
<translation id="8828443087767259398">‏يجب منح Growser الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">‏أصبح Growser متاحًا من خلال مشروع <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> المفتوح المصدر.</translation>
<translation id="4068928808254189629">‏انتقل إلى
        قائمة Growser &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        وألغ اختيار "<ph name="NO_PREFETCH_DESCRIPTION"/>"
        في حالة ما إذا لم يؤد ذلك إلى حل المشكلة، نوصي بتحديد هذا الخيار
        مرة أخرى من أجل أداء أفضل.</translation>
<translation id="4159376633403260073">‏أنت تعرض صفحة Growser for Testing آمنة.</translation>
<translation id="88187049159266777">‏لم يغلق Growser بشكل صحيح.</translation>
<translation id="8208548103319284047">‏نصيحة من Growser: البحث باستخدام "عدسة Growser"</translation>
</translationbundle>