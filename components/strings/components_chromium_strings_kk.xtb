<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="2470048290583727811">Growser-мен жұмыс істеу бойынша кеңес: құпия сөздерді сақтаңыз</translation>
<translation id="6451924152958941455">"Growser мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>"
          тармағына өтіп, конфигурация "прокси-серверсіз" немесе "тікелей" күйіне орнатылғанын тексеріңіз.</translation>
<translation id="7999989146447764333">Бұзылу туралы хабарлау мүмкіндігі Growser қызметінде қолжетімді емес.</translation>
<translation id="1953231710324290369">Қауіпсіз Growser бетін көрудесіз</translation>
<translation id="907470742420136113">Growser төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="4847979153841887006">Growser логотипі</translation>
<translation id="6093965249696204223">Growser-мен жұмыс істеу бойынша кеңес: Күшейтілген Safe Browsing</translation>
<translation id="336808635693308470">Growser төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="7932149101545999102">Growser қолданбасына <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS"/>ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS"/> арқылы қол жеткізілді.</translation>
<translation id="303960458633076466">Бұл бетке Growser тарапынан тыйым салынған.</translation>
<translation id="2017237562285586622">Брандмауэр немесе антивирус параметрлерінде Growser жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="4949828774841497663">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі" тармағына өтіп, белсенді желіні таңдаңыз да, "Мәліметтер..." түймесін басып, бұрын таңдалған прокси-серверлерді таңдаудан алыңыз.</translation>
<translation id="3269554930871094325">"Growser мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Желі және интернет &gt; Прокси-сервер"
          тармағына өтіп, "Параметрлерді автоматты түрде анықтау" опциясын таңдаудан алыңыз.</translation>
<translation id="6159073403999048272">Бұл беттер Growser әзірлеушілерінің қолданысына арналған және белсенді түрде жүргізілмеуі не сыналмауы мүмкін. Оларды қосу үшін <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> сайтына өтіп, түзету беттерін қосатын түймені басып, осы бетке қайтып келіңіз.</translation>
<translation id="2765022094254723779">Сонымен қатар Growser басқа <ph name="BEGIN_LINK_OSS"/>ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS"/> арқылы қолжетімді болады.</translation>
<translation id="9156965752763025780">Өзгертулеріңіз Growser келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="8828443087767259398">Жұптауды жалғастыру үшін Growser-ге Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser браузері <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="4068928808254189629">Growser мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION"/>" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="4159376633403260073">Қауіпсіз Growser for Testing бетін көріп отырсыз.</translation>
<translation id="88187049159266777">Growser дұрыс өшірілмеді.</translation>
<translation id="8208548103319284047">Growser кеңесі: Lens арқылы іздеңіз</translation>
</translationbundle>