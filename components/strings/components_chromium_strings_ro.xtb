<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ro">
<translation id="130631256467250065">Modificările dvs. se vor aplica următoarea dată când reporniți dispozitivul.</translation>
<translation id="2470048290583727811">Sfat pentru Growser: salvează parolele</translation>
<translation id="6451924152958941455">Accesează
          meniul Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          și asigură-te că ai setat pentru configurație valoarea Fără proxy sau Directă.</translation>
<translation id="7999989146447764333">Raportarea blocărilor nu este disponibilă în Growser.</translation>
<translation id="1953231710324290369">Se afișează o pagină Growser securizată</translation>
<translation id="907470742420136113">Growser încearcă să modifice setările pentru completarea metodelor de plată.</translation>
<translation id="4847979153841887006">Sigla Growser</translation>
<translation id="6093965249696204223">Sfat pentru Growser: Navigarea sigură îmbunătățită</translation>
<translation id="336808635693308470">Growser încearcă să modifice metodele de plată.</translation>
<translation id="7932149101545999102">Growser există mulțumită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> și a altor <ph name="BEGIN_LINK_OSS"/>produse software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Pagina a fost blocată de Growser</translation>
<translation id="2017237562285586622">Din setările pentru firewall sau antivirus, permite browserului Growser să acceseze
          rețeaua.</translation>
<translation id="4949828774841497663">Accesează Aplicații &gt; Setări de sistem &gt; Rețea, selectează rețeaua
          activă, dă clic pe butonul Detalii... și debifează orice proxy
          care ar fi fost selectat.</translation>
<translation id="3269554930871094325">Accesează
          meniul Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rețea și internet &gt; Proxy
          și debifează opțiunea Detectează automat setările.</translation>
<translation id="6159073403999048272">Aceste pagini sunt destinate utilizării de către dezvoltatorii Growser și este posibil să nu fie întreținute sau testate în mod activ. Pentru a le activa, accesează <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, dă clic pe butonul pentru a activa paginile de remediere a erorilor, apoi accesează din nou această pagină.</translation>
<translation id="2765022094254723779">Growser acceptă și alte opțiuni de <ph name="BEGIN_LINK_OSS"/>software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Modificările dvs. vor intra în vigoare următoarea dată când reporniți Growser.</translation>
<translation id="8828443087767259398">Growser are nevoie de acces la Bluetooth pentru a continua conectarea. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser există datorită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">Accesează
          meniul Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          și debifează „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
          Dacă această acțiune nu rezolvă problema, îți recomandăm să selectezi din nou
          această opțiune pentru performanță îmbunătățită.</translation>
<translation id="4159376633403260073">Se afișează o pagină Growser for Testing</translation>
<translation id="88187049159266777">Growser nu s-a închis corect.</translation>
<translation id="8208548103319284047">Sfat pentru Growser: caută cu Lens</translation>
</translationbundle>