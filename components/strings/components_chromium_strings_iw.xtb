<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="130631256467250065">השינויים ייכנסו לתוקף בפעם הבאה שהמכשיר יופעל מחדש.</translation>
<translation id="2470048290583727811">‏טיפ ל-Growser: שמירת סיסמאות</translation>
<translation id="6451924152958941455">‏צריך להיכנס אל
          תפריט Growser‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ולבדוק שהתצורה מוגדרת לאפשרות no proxy (ללא שרת proxy‏) או direct (ישיר).</translation>
<translation id="7999989146447764333">‏דיווח על התרסקויות אינו זמין ב-Growser.</translation>
<translation id="1953231710324290369">‏זהו דף מאובטח של Growser</translation>
<translation id="907470742420136113">‏Growser מנסה לשנות את ההגדרות למילוי אמצעי התשלום.</translation>
<translation id="4847979153841887006">‏לוגו של Growser</translation>
<translation id="6093965249696204223">‏טיפ ל-Growser: הגרסה המשופרת של הגלישה הבטוחה</translation>
<translation id="336808635693308470">‏Growser מנסה לערוך את אמצעי התשלום.</translation>
<translation id="7932149101545999102">‏Growser קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/> Growser‏<ph name="END_LINK_CHROMIUM"/> ו<ph name="BEGIN_LINK_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_OSS"/> אחרות.</translation>
<translation id="303960458633076466">‏הדף הזה נחסם על ידי Growser</translation>
<translation id="2017237562285586622">‏שינוי הגדרות חומת האש או האנטי-וירוס כדי לאפשר ל-Growser
          לגשת לרשת.</translation>
<translation id="4949828774841497663">‏עוברים אל "אפליקציות" &gt; "הגדרות המערכת" &gt; "רשת", ובוחרים את
          הרשת הפעילה, לוחצים על הכפתור "פרטים…" ומבטלים את הבחירה בכל שרתי ה-proxy
          שנבחרו.</translation>
<translation id="3269554930871094325">‏צריך להיכנס אל
          תפריט Growser‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ‏&gt;
          Network &amp; internet (רשת ואינטרנט) &gt; Proxy (שרת proxy)
          ולבטל את הבחירה באפשרות Automatically detect settings (זיהוי אוטומטי של ההגדרות).</translation>
<translation id="6159073403999048272">‏הדפים האלה מיועדים למפתחי Growser. יכול להיות שהם לא מתוחזקים או נבדקים באופן פעיל. כדי להפעיל אותם, עוברים לכתובת <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, לוחצים על הכפתור כדי להפעיל את מצב ניפוי הבאגים בדפים, ואז מנווטים בחזרה לדף הזה.</translation>
<translation id="2765022094254723779">‏Growser קיים גם הודות ל<ph name="BEGIN_LINK_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_OSS"/> אחרת.</translation>
<translation id="9156965752763025780">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Growser‏.</translation>
<translation id="8828443087767259398">‏ל-Growser נדרשת גישה ל-Bluetooth כדי להמשיך 
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">‏Growser קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">‏יש להיכנס אל
        תפריט Growser &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ולבטל את הבחירה באפשרות '<ph name="NO_PREFETCH_DESCRIPTION"/>'.
        אם פעולה זו אינה פותרת את הבעיה, מומלץ לבחור שוב באפשרות זו
        לקבלת ביצועים משופרים.</translation>
<translation id="4159376633403260073">‏זהו דף מאובטח של Growser for Testing</translation>
<translation id="88187049159266777">‏כיבוי Growser לא בוצע כהלכה.</translation>
<translation id="8208548103319284047">‏טיפ ל-Growser: חיפוש באמצעות Lens</translation>
</translationbundle>