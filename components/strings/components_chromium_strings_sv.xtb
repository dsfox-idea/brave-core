<!DOCTYPE translationbundle>
<translationbundle lang="sv">
<translation id="130631256467250065">Dina ändringar börjar gälla nästa gång du startar om enheten.</translation>
<translation id="2470048290583727811">Tips för Growser: Spara lösenord</translation>
<translation id="6451924152958941455">Öppna Growser-menyn &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          och se till att konfigurationen är inställd på ingen proxy eller direkt.</translation>
<translation id="7999989146447764333">Felrapportering är inte tillgängligt i Growser.</translation>
<translation id="1953231710324290369">Du visar en säker Growser-sida</translation>
<translation id="907470742420136113">Growser försöker ändra inställningarna för att fylla i betalningsmetoder.</translation>
<translation id="4847979153841887006">Growser-logotyp</translation>
<translation id="6093965249696204223">Tips för Growser: Förbättrad säker webbsökning</translation>
<translation id="336808635693308470">Growser försöker redigera betalningsmetoder.</translation>
<translation id="7932149101545999102">Growser finns tack vare projektet <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> med öppen källkod och <ph name="BEGIN_LINK_OSS"/>andra program med öppen källkod<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Den här sidan har blockerats av Growser</translation>
<translation id="2017237562285586622">Tillåt att Growser får åtkomst till nätverket i inställningarna för brandväggen eller
        antivirusprogrammet.</translation>
<translation id="4949828774841497663">Öppna Program &gt; Systeminställningar &gt; Nätverk, välj det
          aktiva nätverket, klicka på knappen Information … och avmarkera
          eventuella proxyservrar.</translation>
<translation id="3269554930871094325">Öppna
          Growser-menyn &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nätverk och internet &gt; Proxy
          och avmarkera Upptäck inställningar automatiskt.</translation>
<translation id="6159073403999048272">Dessa sidor är avsedda för Growser-utvecklare och kanske inte underhålls eller testas aktivt. Om du vill aktivera dem navigerar du till <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klickar på knappen för att aktivera felsökningssidor och navigerar sedan till den här sidan igen.</translation>
<translation id="2765022094254723779">Growser möjliggörs även av andra <ph name="BEGIN_LINK_OSS"/>program med öppen källkod<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Ändringarna tillämpas nästa gång du startar om Growser.</translation>
<translation id="8828443087767259398">Growser behöver åtkomst för Bluetooth för att fortsätta 
 parkoppla. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser finns tack vare det öppna källkodsprojektet <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">Öppna
        Growser-menyn &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        och avmarkera <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Om det inte hjälper rekommenderar vi att du markerar det
        här alternativet igen så att funktionaliteten förbättras.</translation>
<translation id="4159376633403260073">Du visar en säker Growser for Testing-sida</translation>
<translation id="88187049159266777">Growser stängdes inte ordentligt.</translation>
<translation id="8208548103319284047">Tips för Growser: Sök med Lens</translation>
</translationbundle>