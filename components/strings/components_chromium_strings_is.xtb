<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="130631256467250065">Breytingarnar taka gildi næst þegar þú endurræsir tækið.</translation>
<translation id="2470048290583727811">Growser-ráð: Vistaðu aðgangsorð</translation>
<translation id="6451924152958941455">Farðu í
          valmynd Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og gakktu úr skugga um að stillt sé á „ekki proxy“ eða „beint“.</translation>
<translation id="7999989146447764333">Hrunskýrslur eru ekki í boði í Growser.</translation>
<translation id="1953231710324290369">Þú ert að skoða örugga Growser síðu</translation>
<translation id="907470742420136113">Growser er að reyna að breyta stillingum fyrir útfyllingu greiðslumáta.</translation>
<translation id="4847979153841887006">Growser lógóið</translation>
<translation id="6093965249696204223">Growser-ráð: Enn öruggari vefskoðun</translation>
<translation id="336808635693308470">Growser er að reyna að breyta greiðslumátum.</translation>
<translation id="7932149101545999102">Opna kóðaverkefnið <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> og annar <ph name="BEGIN_LINK_OSS"/>opinn hugbúnaður<ph name="END_LINK_OSS"/> gerir Growser mögulegt.</translation>
<translation id="303960458633076466">Growser setti þessa síðu á bannlista</translation>
<translation id="2017237562285586622">Veittu Growser aðgang að netkerfinu þínu í eldveggsstillingunum þínum eða
          vírusvarnarstillingunum.</translation>
<translation id="4949828774841497663">Farðu í Forrit &gt; Kerfisstillingar &gt; Netkerfi og veldu
          virkt netkerfi, smelltu á hnappinn Upplýsingar... og afveldu alla staðgengla
          sem kunna að hafa verið valdir.</translation>
<translation id="3269554930871094325">Farðu í
          valmynd Growser&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netkerfi og internet &gt; Proxy
          og afveldu „Greina stillingar sjálfkrafa“.</translation>
<translation id="6159073403999048272">Þessar síður eru ætlaðar til notkunar hjá þróunaraðilum Growser og er e.t.v. ekki haldið við eða prófaðar reglulega. Til að kveikja á þeim skaltu fara á <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, smella á hnappinn til að kveikja á villuleitarsíðum og fara síðan aftur á þessa síðu.</translation>
<translation id="2765022094254723779">Growser virkar einnig í krafti annars <ph name="BEGIN_LINK_OSS"/>hugbúnaðar með opinn kóða<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Breytingar þínar munu taka gildi næst þegar þú endurræsir Growser.</translation>
<translation id="8828443087767259398">Growser þarf Bluetooth-aðgang til að halda pörun 
 áfram. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser virkar í krafti verkefnis <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> um opinn kóða.</translation>
<translation id="4068928808254189629">Farðu í
        valmynd Growser &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og taktu valið af „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
        Ef þetta leysir ekki málið mælum við með að gera þennan valkost
        virkan á ný til að auka afköst.</translation>
<translation id="4159376633403260073">Þú ert að skoða örugga Growser for Testing-síðu</translation>
<translation id="88187049159266777">Growser lokaðist ekki á réttan hátt.</translation>
<translation id="8208548103319284047">Ábending frá Growser: Leitaðu með linsu</translation>
<translation id="9122678272144989782">Farðu í
        valmynd Growser &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og taktu valið af „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
        Ef þetta leysir ekki málið mælum við með að gera þennan valkost
        virkan á ný til að auka afköst.</translation>
<translation id="2882078239398351755">Veittu Growser aðgang að netkerfinu þínu í eldveggsstillingunum þínum eða
          vírusvarnarstillingunum.</translation>
<translation id="8471644664201723566">Growser setti þessa síðu á bannlista</translation>
<translation id="861477934338853116">Farðu í
          valmynd Growser&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netkerfi og internet &gt; Proxy
          og afveldu „Greina stillingar sjálfkrafa“.</translation>
<translation id="83976548415855667">Growser er að reyna að breyta stillingum fyrir útfyllingu greiðslumáta.</translation>
<translation id="1293089755325634113">Growser er að reyna að breyta greiðslumátum.</translation>
<translation id="2789075374752545467">Breytingar þínar munu taka gildi næst þegar þú endurræsir Growser.</translation>
<translation id="8380983195362077210">Hrunskýrslur eru ekki í boði í Growser.</translation>
<translation id="4489288117933602961">Growser lógóið</translation>
<translation id="2565262760220782272">Þú ert að skoða örugga Growser síðu</translation>
