<!DOCTYPE translationbundle>
<translationbundle lang="cs">
<translation id="130631256467250065">Změny se projeví po příštím restartu zařízení.</translation>
<translation id="2470048290583727811">Tip pro Growser: Ukládání hesel</translation>
<translation id="6451924152958941455">Přejděte do nabídky Growser &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> a zajistěte, aby konfigurace byla nastavená na možnost „bez proxy“ nebo „přímé“.</translation>
<translation id="7999989146447764333">Hlášení o selhání není v prohlížeči Growser k dispozici.</translation>
<translation id="1953231710324290369">Prohlížíte si zabezpečenou stránku vygenerovanou prohlížečem Growser</translation>
<translation id="907470742420136113">Growser se pokouší upravit nastavení vyplňování platebních metod.</translation>
<translation id="4847979153841887006">Logo Growser</translation>
<translation id="6093965249696204223">Tip pro Growser: Vylepšené Bezpečné prohlížení</translation>
<translation id="336808635693308470">Growser se pokouší upravit platební metody.</translation>
<translation id="7932149101545999102">Growser staví na projektu s otevřeným zdrojovým kódem <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> a využívá i další <ph name="BEGIN_LINK_OSS"/>software s otevřeným zdrojovým kódem<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Tato stránka je blokována prohlížečem Growser</translation>
<translation id="2017237562285586622">V nastavení firewallu a antivirového programu povolte prohlížeči Growser přístup k síti.</translation>
<translation id="4949828774841497663">Přejděte do části Aplikace &gt; Nastavení systému &gt; Síť, vyberte aktivní síť, klikněte na tlačítko Podrobnosti… a zrušte výběr všech proxy serverů, které jsou vybrány.</translation>
<translation id="3269554930871094325">Přejděte do nabídky Growser &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Síť a internet &gt; Proxy a zrušte výběr možnosti Automaticky zjišťovat nastavení.</translation>
<translation id="6159073403999048272">Tyto stránky jsou určeny pro vývojáře prohlížeče Growser a nemusí být aktivně udržovány ani testovány. Pokud je chcete povolit, přejděte na adresu <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknutím na příslušné tlačítko povolte ladicí stránky a pak znovu přejděte na tuto stránku.</translation>
<translation id="2765022094254723779">Growser využívá také další <ph name="BEGIN_LINK_OSS"/>open source software<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Změny se projeví po příštím restartu prohlížeče Growser.</translation>
<translation id="8828443087767259398">Growser potřebuje přístup k Bluetooth, aby bylo možné
 pokračovat v párování. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser staví na open source projektu <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="4068928808254189629">Přejděte do nabídky Growser &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="ADVANCED_TITLE"/> a zrušte výběr možnosti <ph name="NO_PREFETCH_DESCRIPTION"/>. Pokud to však problém nevyřeší, doporučujeme vám tuto možnost znovu vybrat (za účelem zlepšení výkonu).</translation>
<translation id="4159376633403260073">Prohlížíte si zabezpečenou stránku Growser for Testing</translation>
<translation id="88187049159266777">Aplikace Growser nebyla řádně ukončena.</translation>
<translation id="8208548103319284047">Tip pro Growser: Vyhledávejte pomocí Lens</translation>
</translationbundle>