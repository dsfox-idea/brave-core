<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr">
<translation id="130631256467250065">Промене ће ступити на снагу када следећи пут поново покренете уређај.</translation>
<translation id="2470048290583727811">Напомена за Growser: Сачувајте лозинке</translation>
<translation id="6451924152958941455">Идите у
          Growser мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          и проверите да ли је конфигурација подешена на „no proxy“ (без проксија) или „direct“ (директно).</translation>
<translation id="7999989146447764333">Извештавање о отказивањима није доступно у Growser-у.</translation>
<translation id="1953231710324290369">Гледате безбедну Growser страницу.</translation>
<translation id="907470742420136113">Growser покушава да измени подешавања за попуњавање начина плаћања.</translation>
<translation id="4847979153841887006">Growser логотип</translation>
<translation id="6093965249696204223">Напомена за Growser: Побољшано безбедно прегледање</translation>
<translation id="336808635693308470">Growser покушава да измени начине плаћања.</translation>
<translation id="7932149101545999102">Growser омогућавају <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> пројекат отвореног кода и други <ph name="BEGIN_LINK_OSS"/>софтвер отвореног кода<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Growser блокира ову страницу</translation>
<translation id="2017237562285586622">Дозволите Growser-у да приступа мрежи у заштитном зиду или антивирусним
          подешавањима.</translation>
<translation id="4949828774841497663">Идите у Applications (Апликације) &gt; System Settings (Подешавања система) &gt; Network (Мрежа), па изаберите
          активну мрежу, кликните на дугме Details... (Детаљи), а затим поништите избор свих проксија
          који су изабрани.</translation>
<translation id="3269554930871094325">Идите у
          Growser мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Мрежа и интернет &gt; Прокси
          и поништите избор опције Аутоматски откриј подешавања.</translation>
<translation id="6159073403999048272">Ове странице су намењене програмерима Growser-а и можда се не одржавају нити тестирају активно. Да бисте их омогућили, идите на <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, кликните на дугме да бисте омогућили странице за отклањање грешака, па поново идите на ову страницу.</translation>
<translation id="2765022094254723779">Growser омогућава и други <ph name="BEGIN_LINK_OSS"/>софтвер отвореног кода<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Промене ће ступити на снагу када следећи пут поново покренете Growser.</translation>
<translation id="8828443087767259398">Growser захтева приступ Bluetooth-у ради настављања са 
 упаривањем. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser омогућава <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> пројекат отвореног кода.</translation>
<translation id="4068928808254189629">Отворите
          Growser мени &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          и опозовите избор опције „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          Ако вам то не реши проблем, препоручујемо да поново изаберете
          ову опцију ради бољих перформанси.</translation>
<translation id="4159376633403260073">Прегледате безбедну Growser for Testing страницу</translation>
<translation id="88187049159266777">Growser се није исправно затворио.</translation>
<translation id="8208548103319284047">Савет за Growser: Претражујте помоћу Објектива</translation>
</translationbundle>