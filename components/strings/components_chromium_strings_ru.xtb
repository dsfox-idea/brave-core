<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ru">
<translation id="130631256467250065">Изменения вступят в силу после перезагрузки устройства.</translation>
<translation id="2470048290583727811">Совет по работе с Growser: сохраняйте пароли</translation>
<translation id="6451924152958941455">Откройте
          меню Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          и убедитесь, что в конфигурации отключено использование прокси-сервера или выбрано подключение напрямую.</translation>
<translation id="7999989146447764333">В Growser отсутствует функция отчета об ошибках.</translation>
<translation id="1953231710324290369">Вы просматриваете безопасную страницу Growser</translation>
<translation id="907470742420136113">Growser пытается изменить настройки заполнения способов оплаты.</translation>
<translation id="4847979153841887006">Логотип Growser</translation>
<translation id="6093965249696204223">Совет по работе с Growser: используйте улучшенный Безопасный просмотр</translation>
<translation id="336808635693308470">Growser пытается изменить способы оплаты.</translation>
<translation id="7932149101545999102">Growser обязан своим появлением проекту с открытым исходным кодом <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> и другому <ph name="BEGIN_LINK_OSS"/>программному обеспечению с открытым исходным кодом<ph name="END_LINK_OSS"/>.</translation>
<translation id="303960458633076466">Эта страница была заблокирована браузером Growser.</translation>
<translation id="2017237562285586622">Разрешите доступ к сети для Growser
          в настройках брандмауэра или антивируса.</translation>
<translation id="4949828774841497663">Перейдите в раздел "Приложения &gt; Системные настройки &gt; Сеть", выберите активную сеть, нажмите "Подробнее" и снимите флажки напротив всех прокси-серверов, которые используются.</translation>
<translation id="3269554930871094325">Откройте
          меню Growser &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Сеть и интернет &gt; Прокси-сервер
          и отключите параметр "Определять параметры автоматически".</translation>
<translation id="6159073403999048272">Эти страницы, предназначенные для разработчиков Growser, могут тестироваться или поддерживаться нерегулярно. Чтобы включить их, перейдите по адресу <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, нажмите на кнопку включения отладочных страниц, а затем вернитесь сюда.</translation>
<translation id="2765022094254723779">Growser также работает благодаря <ph name="BEGIN_LINK_OSS"/>программному обеспечению с открытым исходным кодом<ph name="END_LINK_OSS"/>.</translation>
<translation id="9156965752763025780">Изменения вступят в силу при следующем входе в Growser.</translation>
<translation id="8828443087767259398">Чтобы продолжить подключение, предоставьте браузеру Growser доступ к Bluetooth. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="6477625882876869143">Growser создан на основе проекта <ph name="BEGIN_LINK_CHROMIUM"/>Growser<ph name="END_LINK_CHROMIUM"/> с открытым исходным кодом.</translation>
<translation id="4068928808254189629">Откройте меню Growser, нажмите "<ph name="SETTINGS_TITLE"/>" &gt; "<ph name="ADVANCED_TITLE"/>" и снимите флажок "<ph name="NO_PREFETCH_DESCRIPTION"/>". Если устранить проблему не удалось, снова установите флажок, чтобы страницы загружались быстрее.</translation>
<translation id="4159376633403260073">Вы просматриваете безопасную страницу Growser для тестирования</translation>
<translation id="88187049159266777">Работа Growser была завершена некорректно.</translation>
<translation id="8208548103319284047">Совет по работе с Growser: используйте Объектив для поиска информации</translation>
<translation id="9122678272144989782">Откройте меню Growser, нажмите "<ph name="SETTINGS_TITLE"/>" &gt; "<ph name="ADVANCED_TITLE"/>" и снимите флажок "<ph name="NO_PREFETCH_DESCRIPTION"/>". Если устранить проблему не удалось, снова установите флажок, чтобы страницы загружались быстрее.</translation>
<translation id="2882078239398351755">Разрешите доступ к сети для Growser
          в настройках брандмауэра или антивируса.</translation>
<translation id="8471644664201723566">Эта страница была заблокирована браузером Growser.</translation>
<translation id="2789075374752545467">Изменения вступят в силу при следующем входе в Growser.</translation>
<translation id="8380983195362077210">В Growser отсутствует функция отчета об ошибках.</translation>
<translation id="4489288117933602961">Логотип Growser</translation>
<translation id="2565262760220782272">Вы просматриваете безопасную страницу Growser</translation>
<translation id="2466261746375432309">Работа Growser была завершена некорректно.</translation>
<translation id="8414085925866363227">Чтобы продолжить подключение, предоставьте браузеру Growser доступ к Bluetooth. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="3821064557386673653">Эти страницы, предназначенные для разработчиков Growser, могут тестироваться или поддерживаться нерегулярно. Чтобы включить их, перейдите по адресу <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, нажмите на кнопку включения отладочных страниц, а затем вернитесь сюда.</translation>
<translation id="2150418414318386558">Совет по работе с Growser: сохраняйте пароли</translation>
<translation id="5134589678962904918">Совет по работе с Growser: используйте улучшенный Безопасный просмотр</translation>
<translation id="2129138083015832125">Совет по работе с Growser: используйте Объектив для поиска информации</translation>
</translationbundle>