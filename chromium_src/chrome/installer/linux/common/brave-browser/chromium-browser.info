# This file provides common configuration information for building
# chromium-browser packages for various platforms.
#
# Growser-197: every field here was Brave. This file IS the Linux package -
# the deb name, the directory it installs into, the launcher script, the
# desktop menu entry and the application id a desktop environment keys on are
# all generated from it. A package built from the previous version installed
# as Brave, into /opt/brave.com/brave, quoting the Brave support address, onto
# machines that may already have Brave in that directory.
#
# NO APOSTROPHES ANYWHERE IN THIS FILE, INCLUDING COMMENTS. It is read with
# shlex.split (chrome/installer/linux/common/installer.py, parse_shell), which
# does not skip comments and treats a single quote as an opening quote. One
# apostrophe in a comment ends the build with "ValueError: No closing
# quotation" pointing at shlex, several frames from anything that mentions
# this file.
#
# It is also static, so it cannot read brave_product_name from GN and these
# values have to agree with it by hand. Today that is growser
# (out/Release/args_generated.gni). PACKAGE must equal it: GN names the deb
# from brave_linux_package_name while the installer scripts name their
# contents from PACKAGE here, and nothing enforces the agreement.

# Base name of the package.
#
# It MUST differ from PROGNAME below, and that is not a style rule. installer.py
# stages the browser as PROGNAME and the wrapper script as PACKAGE, into the
# same directory:
#
#     <progname>.stripped        -> PROGNAME   the browser, ~300 MB
#     installer/common/wrapper   -> PACKAGE    the launcher, 1 KB
#
# With both set to "growser" the wrapper overwrote the browser and the package
# shipped a launcher that exec-ed itself: no executable in it at all, 42 MB
# where it should have been nearly 120, and running it gave "shell level (1000)
# too high". Chrome uses google-chrome/chrome and Brave brave-browser/brave for
# exactly this reason.
#
# Which of the two carries the prefix is free, and Growser-222 gives it to
# PROGNAME. PACKAGE is the name a person types - apt and dnf take it, and
# usr_bin_symlink_name is derived from it (installer.py), so it is also
# /usr/bin/growser. PROGNAME only ever appears inside /opt/growser, where
# nobody reads it. The prefix still earns its keep the second way it always
# did: xdg-icon-resource refuses an icon name with no vendor prefix and fails
# the postinst, and the icon name follows PACKAGE - so "growser" alone would
# have been refused if the vendor were not already in INSTALLDIR's path. That
# is checked by installing, not by reading.
PACKAGE="growser"

# Filename of the main executable (for generating launcher scripts, etc.).
# The build writes <PROGNAME>.stripped and <PROGNAME>_sandbox.stripped, so
# chrome/installer/linux/BUILD.gn names those two outputs from this and the
# two must be changed together.
PROGNAME=dsfox-growser

# Base directory for package installation.
INSTALLDIR=/opt/growser

# Directory for device policy enrollments.
ENROLLMENTDIR=/etc/growser/policies/enrollment

# Display string for desktop menu/icon.
MENUNAME="Growser Web Browser"

# Brief package description.
SHORTDESC="Web browser that blocks ads and trackers"

# Detailed package description.
FULLDESC="Growser is a Chromium-based browser that blocks advertising and tracking by default, and does not report what you browse to anyone."

# Package maintainer information.
MAINTNAME="Growser"
MAINTMAIL="support@growser.org"
PRODUCTURL="https://growser.org/"

# Must match MAC_BUNDLE_ID in app/theme/brave/BRANDING - one product should
# not answer to two application ids across platforms.
RDN="com.growser.Browser"
