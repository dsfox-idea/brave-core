# Upstream defines the variables below in a .gni file. We want to overwrite
# them. It would be nice if we could just have top-level assignments of the form
# `variable = value` here and then import(...) this file at the end of
# upstream's .gni file. Unfortunately, GN does not let import(...) change
# existing values. But forward_variables_from(...) is not limited in this way.
# So we define our values in a scope here, then use forward_variables_from(...)
# in upstream's .gni file to apply the changes from this scope.

import("//brave/components/brave_origin/buildflags/buildflags.gni")
import("//build/config/chrome_build.gni")
import("//build/util/branding.gni")

brave_updater_branding = {
  browser_name = "Growser"
  browser_product_name = chrome_product_full_name
  crash_product_name = "GrowserUpdater"
  crash_upload_url = "https://growser-crashes.humans.top"
  help_center_url = "https://growser.org/"
  updater_company_full_name = "Growser"
  updater_company_short_name = "Growser"
  updater_company_short_name_uppercase = "GROWSER"
  updater_copyright = "Copyright 2026 Growser. All rights reserved."
  updater_product_full_name = "GrowserUpdater"
  # growser: still Brave's Apple team identifier, and it must not stay that way -
  # it is what macOS checks when the updater talks to its privileged helper, so
  # a signed build with somebody else's team id is a signed build that cannot
  # update itself. Changing it belongs with the macOS signing work (#35), on the
  # machine that has the certificate; from here it would be a guess.
  mac_team_identifier = "KL8N8XSYF4"
  grdfile_name = "brave_strings"

  # The updater (Omaha 4) is shared between Brave Browser and Brave Origin.
  # It manages multiple applications, so we don't need separate updater
  # installations - just different app registrations within the same updater.
  # The following vars are intentionally the same for both brands:
  keystone_app_name = "GrowserUpdate"
  keystone_bundle_identifier = "org.growser.Keystone"
  mac_updater_bundle_identifier = "org.growser.GrowserUpdater"
  privileged_helper_bundle_name = "GrowserUpdaterPrivilegedHelper"
  updater_app_icon_path = "//brave/app/theme/brave/mac/app.icns"

  # growser: the macOS BROWSER bundle identifier below is still Brave's. Renaming
  # it moves the profile, the keychain entries and the notification permissions
  # of every macOS install, exactly as the Windows rename did - so it is done
  # once, deliberately, on the macOS machine, and not from here where it cannot
  # be tested. Tracked with #35.
  #
  # Brave Origin uses a separate browser bundle identifier for side-by-side
  # installation with Brave Browser.
  if (is_brave_origin_branded) {
    mac_browser_bundle_identifier = "com.brave.Browser.origin"
  } else {
    mac_browser_bundle_identifier = "com.brave.Browser"
  }
  privileged_helper_name =
      "${mac_browser_bundle_identifier}.UpdaterPrivilegedHelper"

