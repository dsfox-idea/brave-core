 // applying Creators Update (build 15063).
 constexpr wchar_t kGroup[] = L"Notifications";
 
+// growser (#132): the AUMID of the MSIX package this process runs from, or an
+// empty string when the process is not packaged. Windows accepts no other id
+// from inside a package, and a packaged build has none of the registry state
+// that the installer-based path derives its id - and its readiness - from.
+std::wstring GetPackageAppUserModelId() {
+  UINT32 length = 0;
+  if (::GetCurrentApplicationUserModelId(&length, nullptr) !=
+      ERROR_INSUFFICIENT_BUFFER) {
+    // APPMODEL_ERROR_NO_PACKAGE for every non-packaged build.
+    return std::wstring();
+  }
+  std::wstring app_user_model_id(length, L'\0');
+  if (::GetCurrentApplicationUserModelId(&length, app_user_model_id.data()) !=
+      ERROR_SUCCESS) {
+    return std::wstring();
+  }
+  // On success `length` counts the terminating null, which the string owns.
+  app_user_model_id.resize(length ? length - 1 : 0);
+  return app_user_model_id;
+}
