diff --git a/chrome/installer/linux/common/rpm.include b/chrome/installer/linux/common/rpm.include
index 9b87ef588baa2afd7f690917a8bb3ed5d9ce49e8..d9a97a446868c64cd2cdb6db18bf47776777954f 100644
--- a/chrome/installer/linux/common/rpm.include
+++ b/chrome/installer/linux/common/rpm.include
@@ -4,15 +4,20 @@
 # Install the repository signing key (see also:
 # https://www.google.com/linuxrepositories/)
 install_rpm_key() {
-  # The version of the gpg-pubkey package is the short key ID for rpm < 6.0
-  # (gpg-pubkey-d38b4796-570c8cd3) and the full key fingerprint for rpm >= 6.0
-  # (gpg-pubkey-eb4c1bfd4f042f6dddccec917721f63bd38b4796-570c8cd3), so look for
-  # either form rather than hardcoding a package name.
+  # Growser-207: from key.include, not hardcoded. Upstream's pattern names
+  # GOOGLE's key package, and the code below does not merely test for it - it
+  # ERASES the packages it matches before importing. On any machine with
+  # Chrome installed, our postinst would have removed Google signing key.
+  # Growser-335: like upstream's, the pattern accepts both package names, the
+  # short key id (rpm < 6.0) and the full fingerprint (rpm >= 6.0).
   # Use an explicit query format since the default is configurable via the
-  # %_query_all_fmt rpm macro.
+  # %_query_all_fmt rpm macro. An empty pattern would match, and so erase,
+  # every key package on the machine.
+  if [ -z "$PGP_KEY_PACKAGE_REGEX" ]; then
+    return
+  fi
   KEY_PACKAGES=$(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' gpg-pubkey \
-    2>/dev/null | grep -Ei \
-    '^gpg-pubkey-(eb4c1bfd4f042f6dddccec917721f63b)?d38b4796-570c8cd3$')
+    2>/dev/null | grep -Ei "$PGP_KEY_PACKAGE_REGEX")
 
   # Check to see if all keys already exist.
   # Make sure all the most recent signing subkeys are installed.
@@ -120,7 +125,20 @@ YUM_REPO_FILE="/etc/yum.repos.d/@@PACKAGE.repo"
 ZYPPER_REPO_FILE="/etc/zypp/repos.d/@@PACKAGE.repo"
 
 install_yum() {
-  install_rpm_key
+  # Growser-218: install_rpm_key is NOT called, and the function's own comment
+  # says why it cannot work: "if this is run during the package install, it
+  # will fail because rpm can't recursively run rpm, but it should work when
+  # run later as part of the installed cron job". We ship no cron job (#207),
+  # so that later run never happens and the import can only ever fail - which
+  # it did loudly, printing
+  #
+  #     error: /tmp/google.sig.XXXXXX: key 1 import failed.
+  #
+  # on every successful install. The key a person actually needs arrives
+  # through gpgkey= in the .repo file written below, and dnf fetches and uses
+  # it: that is what verified the package on Fedora 43. An error printed by a
+  # transaction that succeeded is worse than no message, because it teaches
+  # people to read past errors.
 
   if [ ! "$REPOCONFIG" ]; then
     return 0
@@ -133,7 +151,7 @@ name=@@PACKAGE
 baseurl=$REPOCONFIG/$DEFAULT_ARCH
 enabled=1
 gpgcheck=1
-gpgkey=https://dl.google.com/linux/linux_signing_key.pub
+gpgkey=https://growser.org/growser-signing-key.pub
 REPOCONTENT
   fi
 }
@@ -154,7 +172,7 @@ enabled=1
 autorefresh=1
 baseurl=$REPOCONFIG/$DEFAULT_ARCH
 gpgcheck=1
-gpgkey=https://dl.google.com/linux/linux_signing_key.pub
+gpgkey=https://growser.org/growser-signing-key.pub
 type=rpm-md
 keeppackages=0
 REPOCONTENT
