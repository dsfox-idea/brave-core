+    # with the exact SDK the baselines came from, and protects nothing. The
+    # generated sources are still compared byte for byte. Chromium itself
+    # already skips .tlb when PRINTING the diff below - this drops it from the
+    # comparison that decides the exit code.
+    mismatch = [f for f in mismatch if not f.endswith('.tlb')]
