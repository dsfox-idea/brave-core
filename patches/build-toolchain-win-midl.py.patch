diff --git a/build/toolchain/win/midl.py b/build/toolchain/win/midl.py
index 9c0d0a4ccff686b7a2885104fe13d4cf5c406d67..517773aeccf593abbd83992649309a52c8251f56 100644
--- a/build/toolchain/win/midl.py
+++ b/build/toolchain/win/midl.py
@@ -448,6 +448,17 @@ def main(arch, gendir, outdir, dynamic_guids, tlb, h, dlldata, iid, proxy,
   _, mismatch, errors = filecmp.cmpfiles(midl_output_dir, outdir, common_files)
   assert not errors
 
+  # A .tlb is a binary type library: a midl.exe from a different Windows SDK
+  # emits a handful of differing bytes (version/ordering noise) while the
+  # generated .h/.c stay byte-identical - observed as 10 bytes out of 2732 with
+  # SDK 10.0.26100.7705. The build consumes the CHECKED-IN outputs (see "Copy
+  # checked-in outputs to final location" above); midl.exe is run only to verify
+  # them, so failing on a .tlb-only difference blocks every build that does not
+  # use the exact SDK the baselines were generated with, without protecting
+  # anything. The generated sources are still compared byte for byte. Chromium
+  # itself already skips .tlb when printing the diff, acknowledging it is binary.
+  mismatch = [f for f in mismatch if not f.endswith('.tlb')]
+
   if mismatch:
     print('midl.exe output different from files in %s, see %s' %
           (outdir, midl_output_dir))
