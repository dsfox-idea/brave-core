diff --git a/chrome/installer/linux/rpm/chrome.spec.template b/chrome/installer/linux/rpm/chrome.spec.template
index c76a259c77fa4f22432c986ab549ffb1f83cf32d..86a751c9df5a323cfa0eb530390efb1b15fce030 100644
--- a/chrome/installer/linux/rpm/chrome.spec.template
+++ b/chrome/installer/linux/rpm/chrome.spec.template
@@ -16,6 +16,17 @@ Url             : @@PRODUCTURL
 Packager        : @@MAINTNAME <@@MAINTMAIL>
 
 Provides        : @@rpm_provides = %{version}
+# Growser-222: the package was growser-browser. Without this an existing
+# install stays, owning the same /opt/growser as the new one - rpm then
+# refuses with a file conflict for every file in it.
+#
+# <= rather than <, and that was measured: with < the rule reads
+# "growser-browser < 26.909.0", which does not match an installed
+# growser-browser 26.909.0, so a rebuild at the same version cannot be
+# installed over its predecessor at all. Releases always differ in version and
+# would have hidden this; the deb side has the same guard unversioned.
+Provides        : growser-browser = %{version}
+Obsoletes       : growser-browser <= %{version}
 Requires        : @@rpm_depends
 Requires(post)  : %{_sbindir}/update-alternatives
 Requires(preun) : %{_sbindir}/update-alternatives
@@ -58,11 +69,14 @@ if [ -z "@@INSTALLDIR" -o ! -d "@@staging_dir/@@INSTALLDIR" ] ; then
 fi
 
 install -m 755 -d \
-  "$RPM_BUILD_ROOT/etc" \
   "$RPM_BUILD_ROOT/opt" \
   "$RPM_BUILD_ROOT/usr"
 # This is hard coded for now
-cp -a "@@staging_dir/etc/" "$RPM_BUILD_ROOT/"
+# Growser-207: and no etc/. The daily cron was the only thing staged there, so
+# after it went the copy aborted the build - "cannot stat rpm-staging-stable/
+# etc/". Deleted rather than guarded with a test for the directory: if upstream
+# stages something into etc again, this patch conflicts at the merge and
+# somebody looks at it, which a silent `[ -d ] &&` would not arrange.
 cp -a "@@staging_dir/opt/" "$RPM_BUILD_ROOT/"
 cp -a "@@staging_dir/usr/" "$RPM_BUILD_ROOT/"
 
@@ -85,7 +99,6 @@ rm -rf "$RPM_BUILD_ROOT"
 
 # Be explicit about the files we scatter throughout the system we don't
 # accidentally "own" stuff that's not ours (crbug.com/40194046).
-/etc/cron.daily/@@PACKAGE
 %ghost %attr(755,root,root) /usr/bin/@@package_orig
 /usr/bin/@@usr_bin_symlink_name
 /usr/share/appdata/@@PACKAGE.appdata.xml
@@ -129,6 +142,18 @@ if [ ! -e "$DEFAULTS_FILE" ]; then
   echo 'repo_add_once="true"' > "$DEFAULTS_FILE"
 fi
 
+# Growser-207: read it. Brave commented this line out so that installing their
+# browser would not add GOOGLE's repository (brave/brave-browser#1967) - and
+# with the line gone `repo_add_once` is never set, so the whole block below is
+# dead code and no repository is ever configured.
+#
+# REPOCONFIG is OURS now (https://growser.org/rpm/stable), so the reason is
+# spent and only the cost is left: a package that configures no repository can
+# never be updated, and the browser has no other update channel on Linux.
+#
+# Measured rather than reasoned: a clean install on Fedora 43 left no
+# /etc/yum.repos.d/growser-browser.repo at all, and `dnf` had never heard of
+# us. The block below writes it.
 . "$DEFAULTS_FILE"
 
 if [ "$repo_add_once" = "true" ]; then
