diff --git a/chrome/installer/linux/rpm/chrome.spec.template b/chrome/installer/linux/rpm/chrome.spec.template
index c76a259c77fa4f22432c986ab549ffb1f83cf32d..266c7f79289a65e9cef4e9ab7201e47fd84dc1cf 100644
--- a/chrome/installer/linux/rpm/chrome.spec.template
+++ b/chrome/installer/linux/rpm/chrome.spec.template
@@ -58,11 +58,14 @@ if [ -z "@@INSTALLDIR" -o ! -d "@@staging_dir/@@INSTALLDIR" ] ; then
 fi
 
 install -m 755 -d \
-  "$RPM_BUILD_ROOT/etc" \
   "$RPM_BUILD_ROOT/opt" \
   "$RPM_BUILD_ROOT/usr"
 # This is hard coded for now
-cp -a "@@staging_dir/etc/" "$RPM_BUILD_ROOT/"
+# Growser-207: and no etc/. The daily cron was the only thing staged there, so
+# after it went the copy aborted the build - "cannot stat rpm-staging-stable/
+# etc/". Deleted rather than guarded with a test for the directory: if upstream
+# stages something into etc again, this patch conflicts at the merge and
+# somebody looks at it, which a silent `[ -d ] &&` would not arrange.
 cp -a "@@staging_dir/opt/" "$RPM_BUILD_ROOT/"
 cp -a "@@staging_dir/usr/" "$RPM_BUILD_ROOT/"
 
@@ -85,7 +88,6 @@ rm -rf "$RPM_BUILD_ROOT"
 
 # Be explicit about the files we scatter throughout the system we don't
 # accidentally "own" stuff that's not ours (crbug.com/40194046).
-/etc/cron.daily/@@PACKAGE
 %ghost %attr(755,root,root) /usr/bin/@@package_orig
 /usr/bin/@@usr_bin_symlink_name
 /usr/share/appdata/@@PACKAGE.appdata.xml
@@ -129,7 +131,8 @@ if [ ! -e "$DEFAULTS_FILE" ]; then
   echo 'repo_add_once="true"' > "$DEFAULTS_FILE"
 fi
 
-. "$DEFAULTS_FILE"
+# Don't install the Chrome repo (brave/brave-browser#1967)
+#. "$DEFAULTS_FILE"
 
 if [ "$repo_add_once" = "true" ]; then
   determine_rpm_package_manager
