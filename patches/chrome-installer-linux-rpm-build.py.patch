diff --git a/chrome/installer/linux/rpm/build.py b/chrome/installer/linux/rpm/build.py
index ec41903e6de422c0a8bbc598ce2f9805b7bedc90..bc5fe5452c567fd73028b168495f4feb8fef3a3e 100755
--- a/chrome/installer/linux/rpm/build.py
+++ b/chrome/installer/linux/rpm/build.py
@@ -30,10 +30,20 @@ def gen_spec(
         spec_file.unlink()
 
     config.rpm_package_filename = f"{config.package_orig}-{config.channel}"
+    if config.channel == "stable": config.rpm_package_filename = config.package_orig
 
-    script_dir = pathlib.Path(__file__).parent.absolute()
+    # Growser-207: template from the STAGED tree, as debian/build.py does
+    # (output_dir / f"installer/debian/{script}") and as main() below already
+    # does for rpmrepo.cron - this one line was the odd one out in its own file.
+    #
+    # @@include@@ resolves relative to the file doing the including, so reading
+    # the template from the source directory made ../common/ mean the SOURCE
+    # common/, and every packaging file replaced by the gn staging swap was
+    # ignored on the rpm path alone. Measured rather than reasoned: one build
+    # produced a .deb carrying our repository signing key and an .rpm carrying
+    # Google's, from a single staged key.include.
     installer.process_template(
-        script_dir / "chrome.spec.template",
+        config.output_dir / "installer/rpm/chrome.spec.template",
         spec_file,
         config.get_template_context(),
     )
@@ -79,6 +89,7 @@ def main() -> None:
     script_dir = pathlib.Path(__file__).parent.absolute()
     output_dir = pathlib.Path(args.output_dir).absolute()
     channel = args.channel
+    if channel in ("unstable", "dev", "alpha"): channel = "dev"
 
     staging_dir = output_dir / f"rpm-staging-{channel}"
     tmp_file_dir = output_dir / f"rpm-tmp-{channel}"
@@ -122,6 +133,8 @@ def main() -> None:
         with rpm_common_deps_file.open("r") as f:
             depends = f.read().replace("\n", ",")
         config.rpm_depends = depends
+        # Ensure that our signing key is up-to-date (brave/brave-browser#4205).
+        config.rpm_depends = f"brave-keyring >= 1.11-1, {depends}"
 
         if config.info_vars["PACKAGE"] != config.usr_bin_symlink_name:
             symlink = config.usr_bin_symlink_name
