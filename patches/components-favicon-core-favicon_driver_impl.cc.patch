+void FaviconDriverImpl::SetLargeIconPolicy(LargeIconPolicy policy) {
+  large_icon_policy_ = std::move(policy);
+}
+
+bool FaviconDriverImpl::WantsLargeIcons(const GURL& page_url) const {
+  return large_icon_policy_ && large_icon_policy_.Run(page_url);
+}
+
 void FaviconDriverImpl::FetchFavicon(const GURL& page_url,
                                      bool is_same_document) {
   for (const std::unique_ptr<FaviconHandler>& handler : handlers_)
     handler->FetchFavicon(page_url, is_same_document);
+
+  // Gated here as well as in OnUpdateCandidates, so a page outside the board
+  // costs not even the history lookup - and so a handler never sees
+  // candidates for a page it was not started on.
+  if (WantsLargeIcons(page_url)) {
+    for (const std::unique_ptr<FaviconHandler>& handler : large_handlers_)
+      handler->FetchFavicon(page_url, is_same_document);
+  }
 }
 
