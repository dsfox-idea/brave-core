   } else {
     handlers_.push_back(std::make_unique<FaviconHandler>(
         favicon_service_, this, FaviconDriverObserver::NON_TOUCH_16_DIP));
+    // growser (#90): desktop stores only the 16 dip favicon, which is all the
+    // tab strip needs and far too little for the new tab board - a 32 pixel
+    // icon blown up to a tile looks exactly as poor as it is. This second
+    // handler also collects the largest apple-touch-icon and web manifest icon
