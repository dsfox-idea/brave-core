diff --git a/third_party/libxslt/src/libxslt/pattern.c b/third_party/libxslt/src/libxslt/pattern.c
index 581f17919fe3a15e9326c45117c1961e634df3a1..362713ebcf5fd1208732f6295a6eac9897dcf4b4 100644
--- a/third_party/libxslt/src/libxslt/pattern.c
+++ b/third_party/libxslt/src/libxslt/pattern.c
@@ -581,6 +581,17 @@ xsltTestCompMatchDirect(xsltTransformContextPtr ctxt, xsltCompMatchPtr comp,
 	    nocache = 1;
 
 	if (nocache == 0) {
+	    /*
+	     * Growser-418: Chromium 9a132c143ee (CVE-2026-125350), carried
+	     * until upstream reaches 158.0.8127.30.
+	     * xmlXPathEval can re-enter this function for the same cache
+	     * slot, e.g. through a lazily evaluated global variable whose
+	     * value runs xsl:number. The nested call may free or replace
+	     * the cached object, so re-read it instead of using the value
+	     * read before the evaluation.
+	     */
+	    list = (xmlXPathObjectPtr)
+		XSLT_RUNTIME_EXTRA_LST(ctxt, sel->lenExtra);
 	    if (list != NULL)
 		xmlXPathFreeObject(list);
 	    list = newlist;
