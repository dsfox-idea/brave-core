index 5e0f458c31aa4ab0ce29323817f4cb93bfa0199f..363a336c7599e7bbcf5e09891c3277e92a1f7da7 100644
--- a/chrome/browser/browser_process_impl.cc
+++ b/chrome/browser/browser_process_impl.cc
@@ -1610,6 +1610,7 @@ void BrowserProcessImpl::PreMainMessageLoopRun() {
   os_crypt_async_ =
       std::make_unique<os_crypt_async::OSCryptAsync>(std::move(providers));
 
+#if !BUILDFLAG(IS_MAC)
   // Trigger async initialization of OSCrypt key providers.
   os_crypt_async_->GetInstance(base::BindOnce(
       [](base::TimeTicks start_time,
@@ -1618,6 +1619,16 @@ void BrowserProcessImpl::PreMainMessageLoopRun() {
                                 base::TimeTicks::Now() - start_time);
       },
       base::TimeTicks::Now()));
+#else
+  // growser: on macOS the only registered key provider reads the login
+  // keychain, so an eager init makes EVERY startup touch the keychain -
+  // and for a binary whose code signature is not in the item's ACL that
+  // is a password prompt on every fresh build, before any feature that
+  // needs encryption has run (and before the cookie-encryption opt-in
+  // promo gets to explain it). Initialization is lazy instead: the first
+  // real consumer (a saved-password decryption, the opt-in cookie store)
+  // pays the one-time cost, when the user has context for it.
+#endif
 
   // browser_policy_connector() is created very early because local_state()
