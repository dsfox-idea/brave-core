+  cat >"$PREFERENCES_FILE.$$.tmp" <<EOF
+### THIS FILE IS AUTOMATICALLY CONFIGURED ###
+# Changes to this file will not be preserved.
+Package: @@PACKAGE
+Pin: origin "growser.org"
+Pin-Priority: 990
+
+Package: @@PACKAGE
+Pin: origin "ru.growser.org"
+Pin-Priority: 990
+EOF
