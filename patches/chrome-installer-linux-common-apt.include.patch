       sed -i -e \
@@ -101,6 +122,9 @@ create_sources_lists() {
 clean_sources_lists() {
   find_apt_sources
   rm -f "$SOURCES_FILE"
+  # Growser-224: the pin goes with the sources it pins. Left behind it would
+  # be a rule about a repository the machine no longer has.
+  rm -f "$PREFERENCES_FILE"
 }
 
