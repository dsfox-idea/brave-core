+# Growser-207: OUR repository signing key, not Google's. key.include is baked
+# into both package scriptlets, and the rpm one imports it with `rpm --import`
+# on install - so whatever is here becomes a key the user's machine trusts for
+# packages. Upstream's value is Google's, which is correct for Chrome and is a
+# supply-chain change we must never make on somebody's machine.
+#
+# The URL is the one the .repo file we write also names, so the key a user is
+# offered and the key baked into the package are the same by construction
+# rather than by anybody remembering to update both.
+KEY_URL = "https://growser.org/growser-signing-key.pub"
+KEY_FINGERPRINT = "98819EF6618B88A1FA2774882DD213595059E6FD"
 
 KEY_INCLUDE_TEMPLATE = """\
 # This file is automatically generated by update_key_include.py
@@ -69,7 +78,14 @@ def main():
 
     # Download latest key
     print(f"Downloading key from {KEY_URL}...")
-    with urllib.request.urlopen(KEY_URL) as response:
+    # Growser-207: with a User-Agent. growser.org is behind Cloudflare, which
+    # answers urllib's default agent with 403 while the identical request from
+    # curl succeeds - and the body says so where the status alone does not.
+    # Upstream needs no such thing because dl.google.com does not challenge.
+    request = urllib.request.Request(
+        KEY_URL, headers={"User-Agent": "Mozilla/5.0 (compatible; growser-build)"}
+    )
+    with urllib.request.urlopen(request) as response:
         latest_key_armored = response.read().decode("utf-8")
 
