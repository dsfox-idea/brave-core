// This is for _Global_ swift flags and will be applied to _all_ targets.
// Configuration inheritence only works through Xcode defined levels, not configuration files.
// So need to use unique name and utilize in subclasses
// (e.g. can't use $(inherited) to 'pull' these changes, into sub-configurations)

brave_ios_marketing_version = 0.0
brave_version_build = 0

#include "../../../../../out/ios_current_link/args.xcconfig"

// Growser-284: our namespace (growser#223). One line carries the app, every
// extension and both app groups.
FRAMEWORK_BASE_BUNDLE_ID = org.growser
BASE_BUNDLE_ID = $(FRAMEWORK_BASE_BUNDLE_ID).ios

// Growser-284: our team, the one that signs the macOS release.
DEVELOPMENT_TEAM = C3DL5896VG

// Growser-284: our scheme. The system routes a scheme to whichever app claims
// it, so brave:// with Brave installed beside us would be a coin toss.
BRAVE_URL_SCHEME = growser
