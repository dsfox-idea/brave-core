if (!is_android) {
  source_set("new_tab") {
    sources = [
      "new_tab_shows_navigation_throttle.h",
      "new_tab_shows_options.h",
    ]
    public_deps = [
      "//base",
      "//content/public/browser",
      "//url",
    ]

    # Growser-119: the warm New Tab Page; Growser-90: the tile icons and the
    # board hosts.
    sources += [
      "board_hosts.h",
      "tile_icon_fetcher.h",
      "warm_new_tab_page_activator.h",
      "warm_new_tab_page_manager.h",
      "warm_new_tab_page_manager_factory.h",
    ]
    public_deps += [
      "//components/keyed_service/core",
      "//services/data_decoder/public/cpp",
      "//services/network/public/cpp",
      "//skia",
    ]

    if (is_win) {
      sources += [ "background_color_tab_helper.h" ]
      public_deps += [ "//chrome/browser/ui/tabs:tabs_public" ]
    }
  }

  source_set("impl") {
    visibility = [ "//brave/browser:core" ]

    sources = [
      "new_tab_shows_navigation_throttle.cc",
      "new_tab_shows_options.cc",
    ]

    public_deps = [ ":new_tab" ]

    deps = [
      "//base",
      "//brave/app:brave_generated_resources_grit",
      "//brave/components/constants",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui/webui/ntp",
      "//chrome/common",
      "//components/prefs",
      "//content/public/browser",
      "//ui/base",
      "//url",
    ]

    # Growser-119: the warm New Tab Page; Growser-90: the tile icons and the
    # board hosts.
    sources += [
      "board_hosts.cc",
      "tile_icon_fetcher.cc",
      "warm_new_tab_page_activator.cc",
      "warm_new_tab_page_manager.cc",
      "warm_new_tab_page_manager_factory.cc",
    ]
    deps += [
      "//chrome/browser/headless",
      "//chrome/browser/new_tab_page/prefs",
      "//chrome/browser/ntp_tiles",
      "//chrome/browser/ui",

      # Growser-174: SupportsWindowFeature moved out of Browser and into this
      # target in Chromium 153; //chrome/browser/ui depends on it privately, so
      # including its header needs a dep of our own.
      "//chrome/browser/ui/window_feature_controller",
      "//components/favicon/core",
      "//components/history/core/browser",
      "//components/ntp_tiles",
      "//components/pref_registry",
      "//components/tab_groups",
      "//components/tabs:public",
      "//content/public/common",
    ]

    if (is_win) {
      sources += [ "background_color_tab_helper.cc" ]
      deps += [
        "//chrome/browser/ui/color:color_headers",
        "//ui/color",
      ]
    }
  }
}

source_set("browser_tests") {
  testonly = true

  if (is_win) {
    sources = [ "background_color_tab_helper_browsertest.cc" ]
    deps = [
      "//chrome/browser",
      "//chrome/browser:browser_process",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/themes",
      "//chrome/browser/ui",
      "//chrome/browser/ui/views/frame:browser_view_header",
      "//chrome/test:test_support",
      "//chrome/test:test_support_ui",
    ]

    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  }
}

source_set("unittest") {
  testonly = true

  if (!is_android) {
    sources = [
      "board_hosts_unittest.cc",
      "new_tab_shows_options_unittest.cc",
      "tile_icon_fetcher_unittest.cc",
      "warm_new_tab_page_manager_unittest.cc",
    ]
    deps = [
      ":new_tab",
      "//base",
      "//base/test:test_support",
      "//brave/browser",
      "//brave/common",
      "//brave/components/constants",
      "//chrome/common",
      "//chrome/test:test_support",
      "//components/history/core/browser",
      "//components/prefs",
      "//content/test:test_support",
      "//testing/gtest",
      "//url",
    ]
  }
}
