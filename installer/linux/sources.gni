# Growser-197: the product name only. This file is imported by brave_build.gni
# and so runs before almost everything - importing config.gni here is an import
# loop, which is why the name has a file of its own.
import("//brave/build/config/product_name.gni")
import("//brave/components/brave_origin/buildflags/buildflags.gni")

if (is_brave_origin_branded) {
  _linux_branding_dir = "brave-origin"
} else {
  _linux_branding_dir = "brave-browser"
}

common_packaging_files_sources = [
  "//brave/LICENSE",
  "//brave/chromium_src/chrome/app/resources/manpage.1.in",
  "//brave/chromium_src/chrome/installer/linux/common/$_linux_branding_dir/appdata.xml.template",
  "//brave/chromium_src/chrome/installer/linux/common/$_linux_branding_dir/chromium-browser.info",

  # Growser-207: our repository signing key, in place of the one Chromium
  # ships. Chromium generates common/key.include by downloading GOOGLE's
  # signing key, and nothing in brave-core replaces it - so a package built
  # without this line installs Google key material into a file named
  # growser.gpg. Generated by scripts/linux/make-key-include.py; the private
  # half never enters this repository.
  #
  # The swap works because the copy action stages these by BASENAME into
  # $root_out_dir/installer/common/, so a file of the same name replaces
  # Chromium one once theirs is excluded below.
  "//brave/chromium_src/chrome/installer/linux/common/key.include",
]

common_packaging_files_excluded_sources = [
  "//chrome/app/resources/manpage.1.in",
  "common/appdata.xml.template",
  "common/chromium-browser.info",
  "common/key.include",  # Growser-207
]

brave_packaging_files_executables = [
  # Growser-197: the names copy_exe/copy_sandbox actually produce. On Linux
  # $brave_exe is $brave_product_name (build/config.gni), and that is the one
  # of the two this file can reach without an import loop.
  "$root_out_dir/$brave_product_name",
  "$root_out_dir/${brave_product_name}_sandbox",
]

excluded_packaging_files_executables = [
  "$root_out_dir/chrome",
  "$root_out_dir/chrome_sandbox",
]

brave_installer_deps = [
  "//brave/build/linux:copy_exe",
  "//brave/build/linux:copy_sandbox",
]

strip_chrome_binary_deps = [ "//brave/build/linux:copy_exe" ]

strip_chrome_sandbox_deps = [ "//brave/build/linux:copy_sandbox" ]
