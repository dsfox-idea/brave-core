import("//brave/build/config.gni")  # Growser-197: for $brave_exe
import("//brave/build/linux/channels.gni")

assert(is_linux)

group("brave") {
  public_deps = [
    ":copy_exe",
    ":copy_sandbox",
  ]
}

copy("copy_exe") {
  sources = [ "$root_out_dir/chrome" ]

  # Growser-197: this is the file the rest of the graph refers to as
  # "$root_out_dir/$brave_exe" (brave/BUILD.gn:555, installer/linux). Naming
  # it literally here made the two disagree as soon as brave_product_name was
  # not "brave", and gn refused the build outright:
  #   ERROR Input to target not generated by a dependency.
  #     //out/Release/growser ... but no targets in the build generate that file.
  outputs = [ "$root_out_dir/$brave_exe" ]

  deps = [ "//chrome:chrome_initial" ]
}

copy("copy_sandbox") {
  sources = [ "$root_out_dir/chrome_sandbox" ]

  outputs = [ "$root_out_dir/${brave_exe}_sandbox" ]  # Growser-197

  deps = [ "//sandbox/linux:chrome_sandbox" ]
}

config("linux_channel_names") {
  defines = [
    "BRAVE_LINUX_CHANNEL_STABLE=\"$brave_linux_channel_stable\"",
    "BRAVE_LINUX_CHANNEL_DEV=\"$brave_linux_channel_dev\"",
    "BRAVE_LINUX_CHANNEL_NIGHTLY=\"$brave_linux_channel_nightly\"",
    "LINUX_CHANNEL_STABLE=\"$linux_channel_stable\"",
    "LINUX_CHANNEL_BETA=\"$linux_channel_beta\"",
    "LINUX_CHANNEL_DEV=\"$linux_channel_dev\"",
  ]
}
